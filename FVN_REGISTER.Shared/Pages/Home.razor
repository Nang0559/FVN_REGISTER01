@page "/"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Shared.Components
@using FVN_REGISTER.Shared.Services.Dashboards
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable
@inject IDashboardClientService DashboardService
@inject ICurrentUserClientService CurrentUserService
@inject ISnackbar Snackbar
@inject ISecurityClientService SecurityService
@inject NavigationManager Navigation

<PageTitle>@Language.T("home.title")</PageTitle>

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="190px" Style="border-radius:24px" Class="mb-4" />
        <MudGrid Spacing="3">
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="110px" Style="border-radius:18px" /></MudItem>
            }
        </MudGrid>
    </MudContainer>
}
else if (_model != null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
        <MudPaper Elevation="0" Class="pa-6 mb-5" Style="border-radius:24px; background:linear-gradient(135deg, rgba(25,118,210,.12), rgba(0,150,136,.08)); border:1px solid rgba(25,118,210,.10)">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">@Language.T("common.fvnRegisterWorkspace")</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:850">@Language.T("home.greeting"), @(CurrentUserService.User?.FullName ?? Language.T("common.user"))</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">@Language.T("home.workspaceDescription")</MudText>
                </div>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Campaign" OnClick="@(() => Navigation.NavigateTo("/thong-tin-cong-khai"))">@Language.T("home.information")</MudButton>
                    @if (Can(SecurityFunctionCodes.LeaveCreate))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EventAvailable" OnClick="@(() => Navigation.NavigateTo("/leave/create"))">@Language.T("home.createLeave")</MudButton>
                    }
                    @if (Can(SecurityFunctionCodes.OTCreate))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Schedule" OnClick="@(() => Navigation.NavigateTo("/ot/create"))">@Language.T("home.createOt")</MudButton>
                    }
                    @if (CurrentUserService.User?.Functions.Contains(SecurityFunctionCodes.TripCreate) == true)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.FlightTakeoff" OnClick="@(() => Navigation.NavigateTo("/trip/create"))">@Language.T("home.createTrip")</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:750">@Language.T("home.workCenter")</MudText>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">@Language.T("home.actionCenterDescription")</MudAlert>
        <MudGrid Spacing="3" Class="mb-5">
            @if (_model.PendingApprovals.Any())
            {
                <MudItem xs="12" sm="3"><MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/work/inbox"))"><MudCardContent Class="pa-5"><MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Primary" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">@Language.T("home.approval")</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("home.approvalDescription")</MudText></MudCardContent></MudCard></MudItem>
            }
            @if (Can(SecurityFunctionCodes.LeaveView))
            {
                <MudItem xs="12" sm="3"><MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/history/leave"))"><MudCardContent Class="pa-5"><MudIcon Icon="@Icons.Material.Filled.EventAvailable" Color="Color.Success" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">@Language.T("home.myLeave")</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("home.myLeaveDescription")</MudText></MudCardContent></MudCard></MudItem>
            }
            @if (Can(SecurityFunctionCodes.OTView))
            {
                <MudItem xs="12" sm="3"><MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/history/ot"))"><MudCardContent Class="pa-5"><MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">@Language.T("home.myOt")</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("home.myOtDescription")</MudText></MudCardContent></MudCard></MudItem>
            }
            @if (Can(SecurityFunctionCodes.WorkCalendarView))
            {
                <MudItem xs="12" sm="3"><MudCard Elevation="1" Style="height:100%; border-radius:18px; cursor:pointer" @onclick="@(() => Navigation.NavigateTo("/calendar"))"><MudCardContent Class="pa-5"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Info" Size="Size.Large" /><MudText Typo="Typo.h6" Class="mt-3">@Language.T("home.workCalendar")</MudText><MudText Typo="body2" Class="mud-text-secondary">@Language.T("home.workCalendarDescription")</MudCardContent></MudCard></MudItem>
            }
        </MudGrid>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:750">@Language.T("home.personalOverview")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("home.updatedAt", _loadedAt?.ToString("dd/MM/yyyy HH:mm"))</MudText>
        </MudStack>

        @if (Can(SecurityFunctionCodes.EquipmentView))
        {
            <EquipmentDashboardTile />
        }

        @if (Can(SecurityFunctionCodes.EquipmentView))
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius:18px">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.h6">@Language.T("home.equipment")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("home.equipmentDescription")</MudText>
                    </div>
                    @if (Can(SecurityFunctionCodes.EquipmentImport))
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="@(() => Navigation.NavigateTo("/equipment/workspace"))">@Language.T("home.importExcel")</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Devices" OnClick="@(() => Navigation.NavigateTo("/equipment"))">@Language.T("home.openEquipment")</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }

        <DashboardOverview Data="_model" />
    </MudContainer>
}
else if (_guestFallback)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8"><MudPaper Outlined="true" Class="pa-6" Style="border-radius:20px"><MudText Typo="Typo.h5">@Language.T("home.publicInformation")</MudText><MudText Typo="Typo.body2" Class="mt-2 mb-4 mud-text-secondary">@Language.T("home.publicOnlyDescription")</MudText><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Campaign" OnClick="@(() => Navigation.NavigateTo("/thong-tin-cong-khai"))">@Language.T("home.openPublicInformation")</MudButton></MudPaper></MudContainer>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6"><MudAlert Severity="Severity.Error">@_errorMessage</MudAlert></MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6"><MudAlert Severity="Severity.Info">@Language.T("home.dashboardEmpty")</MudAlert></MudContainer>
}

@code {
    private DashboardResponse? _model;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _guestFallback;
    private DateTime? _loadedAt;
    private PermissionSnapshotDto? _permissions;
    private readonly CancellationTokenSource _cts = new();

    private bool Can(int functionCode) => _permissions?.Has(functionCode) == true;

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        try
        {
            await Language.InitializeAsync(_cts.Token);
            await CurrentUserService.InitializeAsync();
            if (!CurrentUserService.IsLoggedIn) { _errorMessage = Language.T("home.sessionInvalid"); return; }

            // Use the same effective Role -> Function/Action snapshot as the API.
            // Do not infer UI visibility from PermissionCode/IsAdmin.
            var permissionResult = await SecurityService.GetMyPermissionsAsync(_cts.Token);
            if (permissionResult.IsSuccess)
                _permissions = permissionResult.Data;

            var result = await DashboardService.GetDashboardDataAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null) { _model = result.Data; _loadedAt = DateTime.Now; }
            else if (result.IsUnauthorized) _errorMessage = Language.T("home.sessionExpired");
            else
            {
                var message = result.Message ?? Language.T("home.loadFailed");
                if (message.Contains("chưa được cấp quyền xem Dashboard", StringComparison.OrdinalIgnoreCase)) _guestFallback = true;
                else _errorMessage = message;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex) { _errorMessage = Language.T("home.loadError", ex.Message); Snackbar.Add(_errorMessage, Severity.Error); }
        finally { _isLoading = false; }
    }

    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Language.LanguageChanged -= OnLanguageChanged; _cts.Cancel(); _cts.Dispose(); }
}
