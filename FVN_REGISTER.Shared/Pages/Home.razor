@page "/"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Contract.Dtos.Actions
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Shared.Components
@using FVN_REGISTER.Shared.Components.Calendar
@using FVN_REGISTER.Shared.Services.Dashboards
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable
@inject IDashboardClientService DashboardService
@inject ICurrentUserClientService CurrentUserService
@inject ISnackbar Snackbar
@inject ISecurityClientService SecurityService
@inject NavigationManager Navigation

<PageTitle>@Language.T("home.title")</PageTitle>

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="190px" Style="border-radius:24px" Class="mb-4" />
        <MudGrid Spacing="3">
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="110px" Style="border-radius:18px" /></MudItem>
            }
        </MudGrid>
    </MudContainer>
}
else if (_model != null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
        <MudPaper Elevation="0" Class="pa-6 mb-5" Style="border-radius:24px; background:linear-gradient(135deg, rgba(25,118,210,.12), rgba(0,150,136,.08)); border:1px solid rgba(25,118,210,.10)">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Primary">@Language.T("common.fvnRegisterWorkspace")</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:850">@Language.T("home.greeting"), @(CurrentUserService.User?.FullName ?? Language.T("common.user"))</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">@Language.T("home.workspaceDescription")</MudText>
                </div>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Campaign" OnClick="OpenPath_thong_tin_cong_khai">@Language.T("home.information")</MudButton>
                    @if (CanPersonal(SecurityFunctionCodes.LeaveCreate))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EventAvailable" OnClick="OpenPath_leave_create">@Language.T("home.createLeave")</MudButton>
                    }
                    @if (CanPersonal(SecurityFunctionCodes.OTCreate))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Schedule" OnClick="OpenPath_ot_create">@Language.T("home.createOt")</MudButton>
                    }
                    @if (CanPersonal(SecurityFunctionCodes.TripCreate))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.FlightTakeoff" OnClick="OpenPath_trip_create">@Language.T("home.createTrip")</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3" Class="mb-5">
            <MudItem xs="12" md="6">
                <MudCard Elevation="2" Style="height:100%; border-radius:18px; overflow:hidden">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Style="font-weight:750">@Language.T("home.myTasks")</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("home.myTasksDescription")</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (_model.ActionCount.TotalOpenCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_model.ActionCount.TotalOpenCount</MudChip>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        @if (_model.Actions.Any())
                        {
                            <MudList T="ActionItemDto" Dense="true">
                                @foreach (var action in _model.Actions.Take(6))
                                {
                                    <MudListItem T="ActionItemDto" OnClick="@(() => OpenAction(action))">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2"><b>@action.Title</b></MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@action.Summary</MudText>
                                            </MudStack>
                                            <MudChip T="string" Size="Size.Small">@action.ModuleCode</MudChip>
                                        </MudStack>
                                    </MudListItem>
                                    <MudDivider />
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">@Language.T("home.myTasksEmpty")</MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenPath_work_inbox">@Language.T("dashboard.viewAll")</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            @if (CanSeeMyCalendar)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Style="height:100%; border-radius:18px; overflow:hidden">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Style="font-weight:750">@Language.T("home.myCalendar")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("home.myCalendarDescription")</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenPath_calendar">@Language.T("dashboard.viewAll")</MudButton>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent Class="pa-2">
                            <WorkCalendar ModuleContext="ALL" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:750">@Language.T("home.personalOverview")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("home.updatedAt", _loadedAt?.ToString("dd/MM/yyyy HH:mm"))</MudText>
        </MudStack>

        @if (CanPersonal(SecurityFunctionCodes.EquipmentView))
        {
            <EquipmentDashboardTile />
        }

        @if (CanManagement(SecurityFunctionCodes.EquipmentView))
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius:18px">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.h6">@Language.T("home.equipment")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("home.equipmentDescription")</MudText>
                    </div>
                    @if (CanManagement(SecurityFunctionCodes.EquipmentImport))
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="OpenPath_equipment_workspace">@Language.T("home.importExcel")</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Devices" OnClick="OpenPath_equipment">@Language.T("home.openEquipment")</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }

        <DashboardOverview Data="_model" />
    </MudContainer>
}
else if (_guestFallback)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8"><MudPaper Outlined="true" Class="pa-6" Style="border-radius:20px"><MudText Typo="Typo.h5">@Language.T("home.publicInformation")</MudText><MudText Typo="Typo.body2" Class="mt-2 mb-4 mud-text-secondary">@Language.T("home.publicOnlyDescription")</MudText><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Campaign" OnClick="OpenPath_thong_tin_cong_khai">@Language.T("home.openPublicInformation")</MudButton></MudPaper></MudContainer>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6"><MudAlert Severity="Severity.Error">@_errorMessage</MudAlert></MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-6"><MudAlert Severity="Severity.Info">@Language.T("home.dashboardEmpty")</MudAlert></MudContainer>
}

@code {
    private DashboardResponse? _model;
    private bool _isLoading = true;
    private string? _errorMessage;
    private bool _guestFallback;
    private DateTime? _loadedAt;
    private PermissionSnapshotDto? _permissions;
    private readonly CancellationTokenSource _cts = new();

    private bool Can(int functionCode) => _permissions?.Has(functionCode) == true;
    private bool CanPersonal(int functionCode) => _permissions?.HasPersonal(functionCode) == true;
    private bool CanManagement(int functionCode) => _permissions?.HasManagement(functionCode) == true;
    private bool CanSeeMyCalendar =>
        CanPersonal(SecurityFunctionCodes.CalendarView)
        || CanPersonal(SecurityFunctionCodes.LeaveView)
        || CanPersonal(SecurityFunctionCodes.LeaveCreate)
        || CanPersonal(SecurityFunctionCodes.OTView)
        || CanPersonal(SecurityFunctionCodes.OTCreate)
        || CanPersonal(SecurityFunctionCodes.TripView)
        || CanPersonal(SecurityFunctionCodes.TripCreate);

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        try
        {
            await Language.InitializeAsync(_cts.Token);
            await CurrentUserService.InitializeAsync();
            if (!CurrentUserService.IsLoggedIn) { _errorMessage = Language.T("home.sessionInvalid"); return; }

            // Use the same effective Role -> Function/Action snapshot as the API.
            // Do not infer UI visibility from PermissionCode/IsAdmin.
            var permissionResult = await SecurityService.GetMyPermissionsAsync(_cts.Token);
            if (permissionResult.IsSuccess)
                _permissions = permissionResult.Data;

            var result = await DashboardService.GetDashboardDataAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null) { _model = result.Data; _loadedAt = DateTime.Now; }
            else if (result.IsUnauthorized) _errorMessage = Language.T("home.sessionExpired");
            else
            {
                var message = result.Message ?? Language.T("home.loadFailed");
                if (message.Contains("chưa được cấp quyền xem Dashboard", StringComparison.OrdinalIgnoreCase)) _guestFallback = true;
                else _errorMessage = message;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
        catch (Exception ex) { _errorMessage = Language.T("home.loadError", ex.Message); Snackbar.Add(_errorMessage, Severity.Error); }
        finally { _isLoading = false; }
    }

    private void OpenPath_thong_tin_cong_khai() => Navigation.NavigateTo("/thong-tin-cong-khai");
    private void OpenPath_leave_create() => Navigation.NavigateTo("/leave/create");
    private void OpenPath_ot_create() => Navigation.NavigateTo("/ot/create");
    private void OpenPath_trip_create() => Navigation.NavigateTo("/trip/create");
    private void OpenPath_work_inbox() => Navigation.NavigateTo("/work/inbox");
    private void OpenAction(ActionItemDto action)
    {
        if (!string.IsNullOrWhiteSpace(action.DetailRoute))
            Navigation.NavigateTo(action.DetailRoute);
        else
            Navigation.NavigateTo("/work/inbox");
    }
    private void OpenPath_history_leave() => Navigation.NavigateTo("/history/leave");
    private void OpenPath_history_ot() => Navigation.NavigateTo("/history/ot");
    private void OpenPath_calendar() => Navigation.NavigateTo("/calendar");
    private void OpenPath_equipment_workspace() => Navigation.NavigateTo("/equipment/workspace");
    private void OpenPath_equipment() => Navigation.NavigateTo("/equipment");

    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Language.LanguageChanged -= OnLanguageChanged; _cts.Cancel(); _cts.Dispose(); }
}
