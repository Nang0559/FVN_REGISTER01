@page "/equipment/inspection"
@page "/equipment/inspection/{TaskId:int}"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Equipment
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits AppComponentBase
@inject FVN_REGISTER.Shared.Services.Equipment.IEquipmentClientService EquipmentClient
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Components

<PageTitle>@Language.T("equipment.kiemTraThietBi")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div><MudText Typo="Typo.h4">@Language.T("equipment.kiemTraThietBi")</MudText><MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("equipment.checklistDuocTaoTuDong")</MudText></div>
        <MudButton Variant="Variant.Outlined" OnClick="LoadAsync">@Language.T("common.refresh")</MudButton>
    </MudStack>

    @if (_tasks.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">@Language.T("equipment.hienKhongCoChecklistCan")</MudAlert>
    }
    else
    {
        <MudTable Items="_tasks" Hover="true" Dense="true" Class="mt-4">
            <HeaderContent><MudTh>@Language.T("equipment.han")</MudTh><MudTh>@Language.T("equipment.title")</MudTh><MudTh>@Language.T("common.checklist")</MudTh><MudTh>@Language.T("common.status")</MudTh><MudTh>@Language.T("hrm.result")</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.DueAt.ToString("dd/MM/yyyy HH:mm")</MudTd><MudTd>@context.EquipmentCode</MudTd><MudTd>@context.TemplateName v@context.TemplateVersion</MudTd><MudTd>@context.Status</MudTd><MudTd>@context.Result</MudTd><MudTd><MudButton Size="Size.Small" OnClick="@(() => OpenTaskAsync(context.Id))">@Language.T("common.mo")</MudButton></MudTd></RowTemplate>
        </MudTable>
    }

    @if (_task != null)
    {
        <MudPaper Class="pa-5 mt-5" Outlined="true">
            <MudText Typo="Typo.h5">@_task.EquipmentCode – @_task.EquipmentName</MudText>
            <MudText Typo="Typo.body2">@Language.T("equipment.checklistVHan", _task.TemplateName, _task.TemplateVersion, _task.DueAt.ToString("dd/MM/yyyy HH:mm"))</MudText>
            <MudDivider Class="my-4" />
            @foreach (var item in _task.Items)
            {
                <MudPaper Class="pa-3 my-3" Outlined="true">
                    <MudText Typo="Typo.subtitle1">@item.ItemLabel @if (item.IsRequired) { <span>*</span> }</MudText>
                    @if (item.InputType == "Number")
                    {
                        <MudNumericField T="decimal?" @bind-Value="item.ValueNumber" Label="@item.Unit" Variant="Variant.Outlined" />
                    }
                    else if (item.InputType == "Text")
                    {
                        <MudTextField @bind-Value="item.ValueText" Label='@Language.T("common.note")' Variant="Variant.Outlined" />
                    }
                    else
                    {
                        <MudRadioGroup T="bool?" @bind-Value="item.Passed">
                            <MudRadio Value="@((bool?)true)">@Language.T("equipment.dat")</MudRadio>
                            <MudRadio Value="@((bool?)false)">@Language.T("equipment.khongDat")</MudRadio>
                            <MudRadio Value="@((bool?)null)">N/A</MudRadio>
                        </MudRadioGroup>
                    }
                    <MudTextField @bind-Value="item.Note" Label='@Language.T("common.note")' Variant="Variant.Outlined" Class="mt-2" />
                    @if (item.RequireImage)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">@Language.T("equipment.hangMucYeuCauToi", item.MinImages)</MudAlert>
                        <InputFile OnChange="@(e => UploadEvidenceAsync(item, e))" accept="image/*" capture="environment" />
                        @foreach (var image in item.Evidence)
                        {
                            <MudChip T="string" Class="ma-1">@image.FileName</MudChip>
                        }
                    }
                </MudPaper>
            }
            <MudSelect T="string" @bind-Value="_task.Result" Label="@Language.T("equipment.ketQuaTong")" Variant="Variant.Outlined">
                <MudSelectItem Value="@("Passed")">@Language.T("equipment.dat")</MudSelectItem>
                <MudSelectItem Value="@("Failed")">@Language.T("equipment.khongDat")</MudSelectItem>
                <MudSelectItem Value="@("Conditional")">@Language.T("equipment.datCoDieuKien")</MudSelectItem>
            </MudSelect>
            <MudStack Row="true" Class="mt-4">
                @if (_task.Status != "Approved" && _task.Status != "WaitingApproval")
                {
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">@Language.T("equipment.guiPheDuyet")</MudButton>
                }
                @if (_task.Status == "WaitingApproval")
                {
                    <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="ApproveAsync">@Language.T("approval.title")</MudButton>
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="RejectAsync">@Language.T("common.reject")</MudButton>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "equipmentId")]
    public int? EquipmentId { get; set; }
    [Parameter] public int? TaskId { get; set; }
    private List<EquipmentInspectionTaskDto> _tasks = new();
    private EquipmentInspectionTaskDto? _task;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (TaskId.HasValue)
            await OpenTaskAsync(TaskId.Value);
    }

    private async Task LoadAsync()
    {
        var r = await EquipmentClient.GetInspectionTasksAsync();
        if (r.IsSuccess) _tasks = (r.Data ?? new()).Where(x => !EquipmentId.HasValue || x.EquipmentId == EquipmentId.Value).ToList(); else Snackbar.Add(r.Message ?? Language.T("equipment.khongTaiDuocChecklist"), Severity.Error);
        if (_task != null)
        {
            var current = await EquipmentClient.GetInspectionTaskAsync(_task.Id);
            if (current.IsSuccess) _task = current.Data;
        }
    }
    private async Task OpenTaskAsync(int id)
    {
        var r = await EquipmentClient.GetInspectionTaskAsync(id);
        if (r.IsSuccess) _task = r.Data; else Snackbar.Add(r.Message ?? Language.T("equipment.khongTaiDuocChecklist"), Severity.Error);
    }
    private async Task UploadEvidenceAsync(EquipmentInspectionItemResultDto item, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || _task == null) return;
        var r = await EquipmentClient.UploadInspectionEvidenceAsync(_task.Id, item.ItemId, file);
        if (r.IsSuccess)
        {
            item.Evidence.Add(r.Data!);
            Snackbar.Add(Language.T("equipment.daLuuHinhAnhKiem"), Severity.Success);
        }
        else Snackbar.Add(r.Message ?? Language.T("equipment.khongTaiDuocHinhAnh"), Severity.Error);
    }
    private async Task SubmitAsync()
    {
        if (_task == null) return;
        var r = await EquipmentClient.SubmitInspectionAsync(new EquipmentInspectionSubmitRequest { TaskId=_task.Id, Result=_task.Result, Items=_task.Items });
        Snackbar.Add(r.IsSuccess ? Language.T("equipment.daGuiChecklistChoApprove") : (r.Message ?? Language.T("equipment.khongTheGuiChecklist")), r.IsSuccess ? Severity.Success : Severity.Error);
        if (r.IsSuccess) { _task = r.Data; await LoadAsync(); }
    }
    private async Task ApproveAsync()
    {
        if (_task == null) return;
        var r = await EquipmentClient.ApproveInspectionAsync(_task.Id);
        Snackbar.Add(r.IsSuccess ? Language.T("equipment.daApproveChecklist") : (r.Message ?? Language.T("equipment.khongTheApprove")), r.IsSuccess ? Severity.Success : Severity.Error);
        if (r.IsSuccess) { _task = r.Data; await LoadAsync(); }
    }
    private async Task RejectAsync()
    {
        if (_task == null) return;
        var reason = Language.T("equipment.yeuCauKiemTraLai");
        var r = await EquipmentClient.RejectInspectionAsync(_task.Id, reason);
        Snackbar.Add(r.IsSuccess ? Language.T("equipment.daTuChoiChecklist") : (r.Message ?? Language.T("equipment.khongTheTuChoi")), r.IsSuccess ? Severity.Success : Severity.Error);
        if (r.IsSuccess) { _task = r.Data; await LoadAsync(); }
    }
}