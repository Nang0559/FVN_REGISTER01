@page "/endpoint-governance"
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.Security
@using Microsoft.AspNetCore.Components.Forms
@inject IEndpointGovernanceClientService Governance
@inject ISecurityClientService Security
@inject ISnackbar Snackbar

<PageTitle>@Language.T("endpoint.title")</PageTitle>
<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
<MudStack Spacing="3">
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"><div><MudText Typo="Typo.h5">@Language.T("endpoint.title")</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("endpoint.softwareServiceCatalogChuanVersion")</MudText></div><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync">@Language.T("common.refresh")</MudButton></MudStack>
@if (_loading){<MudProgressLinear Indeterminate="true"/>}else{
<MudTabs Rounded="true" Elevation="1">
<MudTabPanel Text="@Language.T("endpoint.catalog2")" Icon="@Icons.Material.Filled.LibraryBooks"><MudStack Spacing="3" Class="pa-3">
<MudPaper Class="pa-4"><MudText Typo="Typo.h6">@Language.T("endpoint.taoDraftCatalog")</MudText><MudGrid Class="mt-2">
<MudItem xs="12" sm="3"><MudSelect T="EndpointGovernanceItemType" Label="@Language.T("endpoint.loaiCatalog")" @bind-Value="_editorType"><MudSelectItem Value="@EndpointGovernanceItemType.Software">@Language.T("endpoint.software2")</MudSelectItem><MudSelectItem Value="@EndpointGovernanceItemType.WindowsService">@Language.T("endpoint.windowsService")</MudSelectItem></MudSelect></MudItem>
<MudItem xs="12" sm="3"><MudTextField Label="@Language.T("endpoint.policyCode")" @bind-Value="_policyCode"/></MudItem><MudItem xs="12" sm="3"><MudTextField Label="@Language.T("endpoint.policyName")" @bind-Value="_policyName"/></MudItem><MudItem xs="12" sm="3"><MudSelect T="EndpointTargetType" Label="@Language.T("endpoint.target")" @bind-Value="_targetType">@foreach(var value in Enum.GetValues<EndpointTargetType>()){<MudSelectItem Value="@value">@value</MudSelectItem>}</MudSelect></MudItem></MudGrid>
<MudDivider Class="my-3"/><MudText Typo="Typo.subtitle2">@Language.T("endpoint.nhapThuCong")</MudText><MudGrid Class="mt-1">
<MudItem xs="12" sm="3"><MudTextField Label='@Language.T("common.name")' @bind-Value="_newName"/></MudItem><MudItem xs="12" sm="3"><MudTextField Label="@Language.T("endpoint.publisher")" @bind-Value="_newPublisher"/></MudItem><MudItem xs="12" sm="3"><MudTextField Label="@Language.T("endpoint.versionConstraint")" Placeholder="*, =1.2.3, >=140.0" @bind-Value="_newVersionConstraint"/></MudItem><MudItem xs="12" sm="2"><MudSwitch Color="Color.Primary" @bind-Value="_newAllowed">@Language.T("endpoint.allowed")</MudSwitch></MudItem><MudItem xs="12" sm="1"><MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Disabled="!CanManage" OnClick="AddManualItem"/></MudItem></MudGrid>
<MudTable Items="_items" Dense="true" Hover="true" Class="mt-3"><HeaderContent><MudTh>@Language.T("common.name")</MudTh><MudTh>@Language.T("endpoint.publisher")</MudTh><MudTh>@Language.T("common.version")</MudTh><MudTh>@Language.T("endpoint.allowed")</MudTh><MudTh/></HeaderContent><RowTemplate><MudTd>@context.Name</MudTd><MudTd>@context.Publisher</MudTd><MudTd>@context.VersionConstraint</MudTd><MudTd>@(context.IsAllowed?Language.T("common.yes"):Language.T("common.no"))</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="!CanManage" OnClick="@(()=>_items.Remove(context))"/></MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-3">@Language.T("endpoint.chuaCoItem")</MudText></NoRecordsContent></MudTable>
<MudPaper Class="pa-3 mt-3" Outlined="true"><MudText Typo="Typo.subtitle2">@Language.T("endpoint.checklistTruocKhiDuaCatalog")</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("endpoint.checklistDuocLuuCungCatalog")</MudText><MudCheckBox T="bool" @bind-Value="_checkIdentity">@Language.T("endpoint.tenDinhDanhItemDa")</MudCheckBox><MudCheckBox T="bool" @bind-Value="_checkPublisher">@Language.T("endpoint.publisherNguonPhatHanhDa")</MudCheckBox><MudCheckBox T="bool" @bind-Value="_checkVersion">@Language.T("endpoint.versionRangeDuocXacDinh")</MudCheckBox><MudCheckBox T="bool" @bind-Value="_checkScope">@Language.T("endpoint.targetWorkstationServerDaDuoc")</MudCheckBox><MudCheckBox T="bool" @bind-Value="_checkEvidence">@Language.T("endpoint.nguonEvidenceVaLyDo")</MudCheckBox><MudCheckBox T="bool" @bind-Value="_checkOwner">@Language.T("endpoint.daXacDinhNguoiBo")</MudCheckBox></MudPaper>
<MudStack Row="true" Spacing="2" Class="mt-3"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanManage || _items.Count==0 || !ChecklistCompleted" OnClick="SaveDraftAsync">@Language.T("endpoint.luuDraftVersion")</MudButton><InputFile OnChange="OnFileSelected" accept=".xlsx,.xls"/><MudButton Variant="Variant.Outlined" Disabled="!CanManage || _file is null" OnClick="PreviewExcelAsync">@Language.T("endpoint.previewExcel")</MudButton><MudButton Variant="Variant.Outlined" Disabled="!CanManage || _file is null || !ChecklistCompleted" OnClick="ImportExcelAsync">@Language.T("endpoint.importExcelDraft")</MudButton></MudStack></MudPaper>
@if(_preview is not null){<MudAlert Severity="@(_preview.Errors.Count==0?Severity.Success:Severity.Warning)">@Language.T("endpoint.previewDongLoi", _preview.FileName, _preview.RowCount, _preview.Errors.Count)</MudAlert>}
<MudPaper Class="pa-4"><MudText Typo="Typo.h6">@Language.T("endpoint.catalogVersions")</MudText><MudTable Items="_policies" Dense="true" Hover="true" Striped="true" Class="mt-2"><HeaderContent><MudTh>@Language.T("common.code2")</MudTh><MudTh>@Language.T("endpoint.name")</MudTh><MudTh>@Language.T("endpoint.type")</MudTh><MudTh>@Language.T("endpoint.target")</MudTh><MudTh>@Language.T("common.version")</MudTh><MudTh>@Language.T("common.checklist")</MudTh><MudTh>@Language.T("endpoint.workflow")</MudTh><MudTh>@Language.T("common.publish")</MudTh><MudTh>@Language.T("common.action2")</MudTh></HeaderContent><RowTemplate><MudTd>@context.PolicyCode</MudTd><MudTd>@context.PolicyName</MudTd><MudTd>@context.ItemType</MudTd><MudTd>@context.TargetType</MudTd><MudTd>v@context.Version</MudTd><MudTd>@(context.ChecklistCompleted?"OK":Language.T("endpoint.thieu"))</MudTd><MudTd>@context.WorkflowStatus</MudTd><MudTd>@(context.IsPublished?"Published":"Draft")</MudTd><MudTd>@if(!context.IsPublished&&CanSubmit(context.ItemType)&&(context.WorkflowStatus=="Draft"||context.WorkflowStatus=="Rejected")){<MudButton Size="Size.Small" Disabled="!context.ChecklistCompleted" OnClick="@(()=>SubmitAsync(context))">Submit</MudButton>}@if(!context.IsPublished&&CanPublish(context.ItemType)&&context.WorkflowStatus=="Approved"){<MudButton Size="Size.Small" Color="Color.Success" Disabled="!context.ChecklistCompleted" OnClick="@(()=>PublishAsync(context))">Publish</MudButton>}</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-3">@Language.T("endpoint.chuaCoCatalog")</MudText></NoRecordsContent></MudTable></MudPaper>
</MudStack></MudTabPanel>
<MudTabPanel Text="@Language.T("endpoint.requests")" Icon="@Icons.Material.Filled.Assignment">@if(CanReview){<MudPaper Class="ma-3 pa-3"><MudTextField Label="@Language.T("endpoint.securityReviewComment")" @bind-Value="_reviewComment" Lines="2"/></MudPaper>}<MudTable Items="_requests" Dense="true" Hover="true" Striped="true" Class="pa-3"><HeaderContent><MudTh>ID</MudTh><MudTh>@Language.T("common.type")</MudTh><MudTh>@Language.T("endpoint.endpoint")</MudTh><MudTh>@Language.T("endpoint.item")</MudTh><MudTh>@Language.T("endpoint.workflow")</MudTh><MudTh>@Language.T("endpoint.security")</MudTh><MudTh>@Language.T("endpoint.tao")</MudTh><MudTh/></HeaderContent><RowTemplate><MudTd>@context.Id</MudTd><MudTd>@context.RequestType</MudTd><MudTd>@context.EndpointDeviceId</MudTd><MudTd>@context.ItemName</MudTd><MudTd>@context.WorkflowStatus</MudTd><MudTd>@context.SecurityReviewStatus</MudTd><MudTd>@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd><MudTd>@if(CanReview&&context.SecurityReviewStatus=="Pending"){<MudButtonGroup Size="Size.Small"><MudButton Color="Color.Success" OnClick="@(()=>ReviewAsync(context,true))">Approve</MudButton><MudButton Color="Color.Error" OnClick="@(()=>ReviewAsync(context,false))">Reject</MudButton></MudButtonGroup>}</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@Language.T("endpoint.khongCoRequestPhuHop")</MudText></NoRecordsContent></MudTable></MudTabPanel>
<MudTabPanel Text='@Language.T("endpoint.compliance")' Icon="@Icons.Material.Filled.Security"><MudStack Spacing="2" Class="pa-3"><MudStack Row="true" Spacing="2"><MudSwitch Color="Color.Primary" @bind-Value="_openOnly">@Language.T("endpoint.chiCanhBaoDangMo")</MudSwitch><MudButton Variant="Variant.Outlined" OnClick="LoadFindingsAsync">@Language.T("common.taiLai")</MudButton></MudStack><MudTable Items="_findings" Dense="true" Hover="true" Striped="true"><HeaderContent><MudTh>@Language.T("hrm.result")</MudTh><MudTh>@Language.T("endpoint.endpoint")</MudTh><MudTh>@Language.T("common.type")</MudTh><MudTh>@Language.T("endpoint.observed")</MudTh><MudTh>@Language.T("common.version")</MudTh><MudTh>@Language.T("endpoint.policy")</MudTh><MudTh>@Language.T("common.code")</MudTh><MudTh>@Language.T("endpoint.thoiDiem")</MudTh></HeaderContent><RowTemplate><MudTd><MudChip T="string" Color="@FindingColor(context.Result)" Size="Size.Small">@context.Result</MudChip></MudTd><MudTd>@context.EndpointDeviceId</MudTd><MudTd>@context.ItemType</MudTd><MudTd>@context.ObservedName</MudTd><MudTd>@context.ObservedVersion</MudTd><MudTd>v@context.PolicyVersion</MudTd><MudTd>@context.FindingCode</MudTd><MudTd>@context.EvaluatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-4">@Language.T("endpoint.khongCoFinding")</MudText></NoRecordsContent></MudTable></MudStack></MudTabPanel>
</MudTabs>}
</MudStack></MudContainer>

@code{
private bool _loading=true,_openOnly=true;private HashSet<int> _permissions=new();private List<EndpointGovernancePolicyDto> _policies=new();private List<EndpointGovernanceRequestDto> _requests=new();private List<EndpointComplianceFindingDto> _findings=new();private EndpointGovernanceItemType _editorType=EndpointGovernanceItemType.Software;private EndpointTargetType _targetType=EndpointTargetType.Both;private string _policyCode="ENDPOINT-SW",_policyName="Software Allowlist",_newName=string.Empty;private string? _newPublisher,_newVersionConstraint="*",_reviewComment;private bool _newAllowed=true;private bool _checkIdentity,_checkPublisher,_checkVersion,_checkScope,_checkEvidence,_checkOwner;private IBrowserFile? _file;private EndpointGovernanceExcelPreviewDto? _preview;private readonly List<EditorItem> _items=new();
private bool ChecklistCompleted=>_checkIdentity&&_checkPublisher&&_checkVersion&&_checkScope&&_checkEvidence&&_checkOwner;private bool CanManage=>_permissions.Contains(_editorType==EndpointGovernanceItemType.Software?SecurityFunctionCodes.EndpointSoftwareCatalogManage:SecurityFunctionCodes.EndpointServiceCatalogManage);private bool CanReview=>_permissions.Contains(SecurityFunctionCodes.EndpointSoftwareSecurityReview)||_permissions.Contains(SecurityFunctionCodes.EndpointServiceSecurityReview)||_permissions.Contains(SecurityFunctionCodes.EndpointInstallRequestApprove)||_permissions.Contains(SecurityFunctionCodes.EndpointExceptionApprove);private bool CanSubmit(EndpointGovernanceItemType type)=>_permissions.Contains(type==EndpointGovernanceItemType.Software?SecurityFunctionCodes.EndpointSoftwarePolicySubmit:SecurityFunctionCodes.EndpointServicePolicySubmit);private bool CanPublish(EndpointGovernanceItemType type)=>_permissions.Contains(type==EndpointGovernanceItemType.Software?SecurityFunctionCodes.EndpointSoftwarePolicyApprove:SecurityFunctionCodes.EndpointServicePolicyApprove);
protected override async Task OnInitializedAsync()=>await ReloadAsync();
private async Task ReloadAsync(){_loading=true;try{var permissions=await Security.GetMyPermissionsAsync();_permissions=permissions.Data?.FunctionCodes??new();var policies=await Governance.GetPoliciesAsync();_policies=policies.Data??new();var requests=await Governance.GetRequestsAsync(!CanReview);_requests=requests.Data??new();await LoadFindingsAsync();}finally{_loading=false;}}
private async Task LoadFindingsAsync(){var response=await Governance.GetFindingsAsync(null,_openOnly);_findings=response.Data??new();}
private void AddManualItem(){if(!CanManage||string.IsNullOrWhiteSpace(_newName))return;if(_items.Any(x=>x.Name.Equals(_newName.Trim(),StringComparison.OrdinalIgnoreCase))){Snackbar.Add(Language.T("endpoint.itemDaTonTaiTrong"),Severity.Warning);return;}_items.Add(new EditorItem{Name=_newName.Trim(),Publisher=_newPublisher?.Trim(),VersionConstraint=string.IsNullOrWhiteSpace(_newVersionConstraint)?"*":_newVersionConstraint.Trim(),IsAllowed=_newAllowed});_newName=string.Empty;_newPublisher=null;_newVersionConstraint="*";_newAllowed=true;}
private async Task SaveDraftAsync(){if(!CanManage||_items.Count==0||!ChecklistCompleted)return;var items=_items.Select(x=>new EndpointGovernancePolicyItemDto(0,_editorType,x.Name.Trim().ToUpperInvariant(),x.Name.Trim(),x.Publisher,x.VersionConstraint,x.IsAllowed,x.Remark)).ToList();var note=Language.T("endpoint.catalogChecklistIdentity");var response=await Governance.CreateVersionAsync(new EndpointGovernancePolicyUpsertRequest(_policyCode.Trim(),_policyName.Trim(),_editorType,_targetType,null,items,true,note));if(response.IsSuccess){Snackbar.Add(Language.T("endpoint.daTaoDraftVersionSau"),Severity.Success);await ReloadAsync();}else Snackbar.Add(response.Message,Severity.Error);}
private async Task PreviewExcelAsync(){if(_file is null||!CanManage)return;var response=await Governance.PreviewExcelAsync(_file,_editorType,_targetType);if(!response.IsSuccess){Snackbar.Add(response.Message,Severity.Error);return;}_preview=response.Data;if(_preview is not null&&_preview.Errors.Count==0){_items.Clear();_items.AddRange(_preview.Rows.Where(x=>string.IsNullOrWhiteSpace(x.Error)).Select(x=>new EditorItem{Name=x.Name,Publisher=x.Publisher,VersionConstraint=x.VersionConstraint,IsAllowed=x.IsAllowed,Remark=x.Remark}));}}
private async Task ImportExcelAsync(){if(_file is null||!CanManage||!ChecklistCompleted)return;var response=await Governance.ImportExcelAsync(_file,_policyCode.Trim(),_policyName.Trim(),_editorType,_targetType,null);if(response.IsSuccess){Snackbar.Add(Language.T("endpoint.daImportThanhDraftVersion"),Severity.Success);await ReloadAsync();}else Snackbar.Add(response.Message,Severity.Error);}
private async Task SubmitAsync(EndpointGovernancePolicyDto policy){if(!policy.ChecklistCompleted)return;var response=await Governance.SubmitAsync(policy.Id);if(response.IsSuccess){Snackbar.Add(Language.T("endpoint.daSubmitCommonApproval"),Severity.Success);await ReloadAsync();}else Snackbar.Add(response.Message,Severity.Error);}
private async Task PublishAsync(EndpointGovernancePolicyDto policy){if(!policy.ChecklistCompleted)return;var response=await Governance.PublishAsync(policy.Id);if(response.IsSuccess){Snackbar.Add(Language.T("endpoint.daPublishV", policy.PolicyCode, policy.Version),Severity.Success);await ReloadAsync();}else Snackbar.Add(response.Message,Severity.Error);}
private async Task ReviewAsync(EndpointGovernanceRequestDto request,bool approved){var response=await Governance.ReviewAsync(request.Id,approved,_reviewComment);if(response.IsSuccess){Snackbar.Add(approved?Language.T("endpoint.daSecurityApproveRequest"):Language.T("endpoint.daSecurityRejectRequest"),approved?Severity.Success:Severity.Warning);_reviewComment=null;await ReloadAsync();}else Snackbar.Add(response.Message,Severity.Error);}
private void OnFileSelected(InputFileChangeEventArgs args)=>_file=args.File;private static Color FindingColor(EndpointComplianceResult result)=>result switch{EndpointComplianceResult.Compliant=>Color.Success,EndpointComplianceResult.NonCompliant=>Color.Error,EndpointComplianceResult.Exception=>Color.Warning,_=>Color.Info};private sealed class EditorItem{public string Name{get;set;}=string.Empty;public string? Publisher{get;set;}public string? VersionConstraint{get;set;}public bool IsAllowed{get;set;}public string? Remark{get;set;}}
}
