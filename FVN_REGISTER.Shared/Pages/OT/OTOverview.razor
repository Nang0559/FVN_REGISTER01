@page "/ot"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Contract.Dtos.Calendar
@using FVN_REGISTER.Shared.Services.Calendar
@using FVN_REGISTER.Shared.Services.Execution
@using FVN_REGISTER.Shared.Services.Users
@using Microsoft.AspNetCore.Components
@using FVN_REGISTER.Shared.Handlers
@using FVN_REGISTER.Shared.Components.Calendar
@inherits AppComponentBase
@inject IHttpClientWithAuth Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IWorkCalendarClientService CalendarService
@inject IExecutionReconciliationClientService ExecutionService
@inject ICurrentUserClientService CurrentUser

<PageTitle>@Language.T("ot.otTongQuan")</PageTitle>
<ModuleOverview Title="@Language.T("ot.otTongQuan")" Description="@Language.T("ot.tongHopTrangThaiOt")" CreateUrl="/ot/create" HistoryUrl="/ot/history" ModulePrefix="/ot" />
<MudContainer MaxWidth="MaxWidth.Large" Class="pb-6">
    <MudText Typo="Typo.h5" Style="font-weight:800" Class="mb-1">OT thực tế chưa được duyệt</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Thống kê theo ký hiệu làm thêm (OT) trên lịch, bao gồm các ký hiệu như K0.75.</MudText>

    <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius:18px">
        <MudGrid>
            <MudItem xs="12" sm="4"><MudDatePicker Label="Từ ngày" @bind-Date="_from" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="4"><MudDatePicker Label="Đến ngày" @bind-Date="_to" Variant="Variant.Outlined" MaxDate="DateTime.Today" /></MudItem>
            <MudItem xs="12" sm="4" Class="d-flex align-center"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="_loading" OnClick="LoadAsync">Thống kê</MudButton></MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudPaper Outlined="true" Class="pa-4" Style="border-radius:18px">
                    <MudText Typo="Typo.subtitle2">Ngày có OT chưa duyệt</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:850">@_rows.Count</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Outlined="true" Class="pa-4" Style="border-radius:18px">
                    <MudText Typo="Typo.subtitle2">Tổng giờ OT theo ký hiệu lịch</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:850">@_rows.Sum(x => x.OTHours).ToString("0.##")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Outlined="true" Class="pa-4" Style="border-radius:18px">
            <MudText Typo="Typo.h6" Class="mb-3">Chi tiết OT chưa có đơn được duyệt</MudText>
            @if (_rows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Không có ngày nào có ký hiệu OT chưa được duyệt trong khoảng đã chọn.</MudAlert>
            }
            else
            {
                <MudTable Items="_rows" Dense="true" Hover="true" Bordered="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Ngày</MudTh><MudTh>Ca</MudTh><MudTh>Ký hiệu OT</MudTh><MudTh>Vào</MudTh><MudTh>Ra</MudTh><MudTh Class="text-right">Giờ OT</MudTh><MudTh>Thao tác</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ngày">@context.WorkDate.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Ca">@context.ShiftAbbr</MudTd>
                        <MudTd DataLabel="Ký hiệu OT"><MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">@context.OtSymbol</MudChip></MudTd>
                        <MudTd DataLabel="Vào">@context.CheckInTime?.ToString("HH:mm")</MudTd>
                        <MudTd DataLabel="Ra">@context.CheckOutTime?.ToString("HH:mm")</MudTd>
                        <MudTd DataLabel="Giờ OT" Class="text-right">@context.OTHours.ToString("0.##")</MudTd>
                        <MudTd DataLabel="Thao tác">
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                @if (GetCalendarDay(context) is { } calendarDay)
                                {
                                    @if (calendarDay.CanRegisterOT)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.MoreTime" OnClick="@(() => OpenOtRegistration(context))">Đăng ký OT</MudButton>
                                    }
                                    @foreach (var item in GetOtActions(calendarDay))
                                    {
                                        <MudButton @key="item.Action.Code" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Chat" OnClick="@(() => HandleCalendarActionAsync(calendarDay, item.Issue, item.Action))">@item.Action.Title</MudButton>
                                    }
                                }
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    private DateTime? _from = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _to = DateTime.Today;
    private List<UnapprovedAttendanceOTDto> _rows = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private readonly List<CalendarDayDto> _calendarDays = new();
    private string? _employeeCode;

    private CalendarDayDto? GetCalendarDay(UnapprovedAttendanceOTDto row)
        => _calendarDays.FirstOrDefault(x => x.Date == DateOnly.FromDateTime(row.WorkDate));

    private static IEnumerable<(CalendarIssueDto Issue, CalendarActionOptionDto Action)> GetOtActions(CalendarDayDto day)
        => day.Issues
            .Where(issue => issue.Actions.Count > 0)
            .SelectMany(issue => issue.Actions
                .Where(action => action.Code is "OPEN_HR_FEEDBACK" or "OPEN_SUPERVISOR_FEEDBACK")
                .Select(action => (Issue: issue, Action: action)));

    private void OpenOtRegistration(UnapprovedAttendanceOTDto row)
        => NavigationManager.NavigateTo($"/ot/create?date={row.WorkDate:yyyy-MM-dd}");

    private async Task HandleCalendarActionAsync(CalendarDayDto day, CalendarIssueDto issue, CalendarActionOptionDto action)
    {
        var request = new CalendarActionRequestDto
        {
            Date = day.Date,
            IssueCode = issue.Code,
            ActionCode = action.Code,
            RequestId = action.RequestId,
            ReconciliationId = action.ReconciliationId,
            DetailRoute = action.DetailRoute
        };

        switch (request.ActionCode)
        {
            case "OPEN_OT":
                NavigationManager.NavigateTo($"/ot/create?date={day.Date:yyyy-MM-dd}");
                return;
            case "OPEN_EXECUTION_RESULT":
            case "OPEN_OT_REQUEST":
                if (!string.IsNullOrWhiteSpace(request.DetailRoute))
                    NavigationManager.NavigateTo(request.DetailRoute);
                return;
            case "OPEN_HR_FEEDBACK":
                await OpenHrFeedbackAsync(request);
                break;
            case "OPEN_SUPERVISOR_FEEDBACK":
                await OpenSupervisorFeedbackAsync(request);
                break;
        }
    }

    private async Task OpenHrFeedbackAsync(CalendarActionRequestDto request)
    {
        if (string.IsNullOrWhiteSpace(_employeeCode))
        {
            Snackbar.Add("Không xác định được nhân viên đăng nhập.", Severity.Error);
            return;
        }

        long reconciliationId;
        if (request.ReconciliationId is long existingId)
        {
            reconciliationId = existingId;
        }
        else
        {
            var ensure = await ExecutionService.EnsureAttendanceFeedbackAsync(request.Date);
            if (!ensure.IsSuccess || ensure.Data is null)
            {
                Snackbar.Add(ensure.Message ?? "Không thể tạo yêu cầu phản hồi HR.", Severity.Error);
                return;
            }
            reconciliationId = ensure.Data.Id;
        }

        var result = await CalendarService.GetForEmployeeAsync(
            _employeeCode, request.Date.ToDateTime(TimeOnly.MinValue), request.Date.ToDateTime(TimeOnly.MinValue));
        if (!result.IsSuccess || result.Data is null)
        {
            Snackbar.Add(result.Message ?? "Không thể tải dữ liệu chấm công.", Severity.Error);
            return;
        }

        var selectedDay = result.Data.Days.FirstOrDefault(x => x.Date == request.Date);
        var issue = selectedDay?.Issues.FirstOrDefault(x => x.Code == request.IssueCode);
        var action = issue?.Actions.FirstOrDefault(x => x.Code == request.ActionCode);
        if (selectedDay is null || issue is null || action is null)
        {
            Snackbar.Add("Không tìm thấy thao tác phản hồi HR trên lịch của ngày này.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(CalendarAttendanceFeedbackDialog.Day)] = selectedDay,
            [nameof(CalendarAttendanceFeedbackDialog.Issue)] = issue,
            [nameof(CalendarAttendanceFeedbackDialog.Action)] = action,
            [nameof(CalendarAttendanceFeedbackDialog.ReconciliationId)] = reconciliationId
        };
        await DialogService.ShowAsync<CalendarAttendanceFeedbackDialog>(
            Language.T("calendar.feedbackTitle"), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        await LoadAsync();
    }

    private async Task OpenSupervisorFeedbackAsync(CalendarActionRequestDto request)
    {
        if (string.IsNullOrWhiteSpace(_employeeCode))
        {
            Snackbar.Add("Không xác định được nhân viên đăng nhập.", Severity.Error);
            return;
        }

        var result = await CalendarService.GetForEmployeeAsync(
            _employeeCode, request.Date.ToDateTime(TimeOnly.MinValue), request.Date.ToDateTime(TimeOnly.MinValue));
        var attendance = result.IsSuccess
            ? result.Data?.Days.FirstOrDefault(x => x.Date == request.Date)?.Attendance
            : null;

        var parameters = new DialogParameters
        {
            [nameof(CalendarSupervisorFeedbackDialog.Date)] = request.Date,
            [nameof(CalendarSupervisorFeedbackDialog.CheckIn)] = attendance?.CheckIn,
            [nameof(CalendarSupervisorFeedbackDialog.CheckOut)] = attendance?.CheckOut
        };
        var dialog = await DialogService.ShowAsync<CalendarSupervisorFeedbackDialog>(
            "Phản hồi cấp trên", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false })
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_employeeCode))
        {
            await CurrentUser.InitializeAsync();
            _employeeCode = CurrentUser.User?.EmployeeCode?.Trim();
        }

        if (_from is null || _to is null || _from.Value.Date > _to.Value.Date)
        {
            Snackbar.Add("Khoảng ngày không hợp lệ.", Severity.Warning);
            return;
        }
        _loading = true;
        try
        {
            var result = await Http.GetAsync<List<UnapprovedAttendanceOTDto>>(
                $"api/OT/unapproved-attendance?fromDate={_from.Value:yyyy-MM-dd}&toDate={_to.Value:yyyy-MM-dd}",
                showLoading: false);
            if (result.IsSuccess && result.Data is not null) _rows = result.Data;
            else Snackbar.Add(result.Message ?? "Không thể tải thống kê OT.", Severity.Error);

            _calendarDays.Clear();
            if (!string.IsNullOrWhiteSpace(_employeeCode))
            {
                var calendar = await CalendarService.GetForEmployeeAsync(
                    _employeeCode, _from.Value.Date, _to.Value.Date);
                if (calendar.IsSuccess && calendar.Data is not null)
                    _calendarDays.AddRange(calendar.Data.Days);
            }
        }
        finally { _loading = false; }
    }
}
