@page "/public-forms"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.PublicForms
@using FVN_REGISTER.Shared.Handlers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject IHttpClientWithAuth Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
<PageTitle>@Language.T("nav.publicForms")</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MudText Typo="Typo.h5"><b>@Language.T("public.bieuMauDangMo")</b></MudText>
    <MudSpacer />
    @if (_caps.CanManageForms)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EditNote" OnClick="@(() => Navigation.NavigateTo("/admin/public-forms"))">@Language.T("nav.publicFormsManage")</MudButton>
    }
    @if (_caps.CanViewResults)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Assessment" OnClick="@(() => Navigation.NavigateTo("/admin/public-forms/submissions"))">@Language.T("public.tongHopDangKyBieu")</MudButton>
    }
</MudStack>
@if(_loading){<MudProgressLinear Indeterminate="true" />}
else if(!string.IsNullOrWhiteSpace(_error)){<MudAlert Severity="Severity.Warning">@_error</MudAlert>}
else if(!_items.Any()){<MudAlert Severity="Severity.Info">@Language.T("public.hienKhongCoBieuMau")</MudAlert>}
else
{
 <MudGrid>
 @foreach(var f in _items)
 {
  <MudItem xs="12" md="6"><MudCard Class="pa-4" Elevation="2"><MudText Typo="Typo.h6">@f.Title</MudText><MudText Color="Color.Secondary">@f.Description</MudText><MudText Typo="Typo.caption">@Language.T("public.deadline", f.EndAt?.ToString("dd/MM/yyyy HH:mm") ?? Language.T("public.noLimit"))</MudText><MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/public-forms/{f.Id}")">@Language.T("workspace.register")</MudButton></MudCard></MudItem>
 }
 </MudGrid>
}
@code{private List<PublicFormDto> _items=new();private bool _loading=true;private string? _error;private PublicCapabilitiesDto _caps=new();protected override async Task OnInitializedAsync(){var c=await Http.GetAsync<PublicCapabilitiesDto>("api/public-forms/capabilities",showLoading:false);if(c.IsSuccess&&c.Data!=null)_caps=c.Data;var r=await Http.GetAsync<List<PublicFormDto>>("api/public-forms/available");if(r.IsSuccess)_items=r.Data??new();else if(!_caps.CanManageForms)_error=r.Message;_loading=false;}}
