@page "/change-password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FVN_REGISTER.Shared.Services.Users
@inherits AppComponentBase

@inject IAuthClientService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-6">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Đổi mật khẩu</MudText>

        <MudForm @ref="_form">
            <MudTextField T="string" Label="Mật khẩu hiện tại" Variant="Variant.Outlined"
                          InputType="InputType.Password" @bind-Value="_currentPassword" Required="true" />

            <MudTextField T="string" Label="Mật khẩu mới" Variant="Variant.Outlined" Class="mt-4"
                          InputType="InputType.Password" @bind-Value="_newPassword" Required="true" />

            <MudTextField T="string" Label="Xác nhận mật khẩu mới" Variant="Variant.Outlined" Class="mt-4"
                          InputType="InputType.Password" @bind-Value="_confirmPassword" Required="true" />

            <div class="d-flex align-center justify-space-between mt-6">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Hủy bỏ</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit"
                           Disabled="_processing">
                    @(_processing ? "Đang xử lý..." : "Cập nhật")
                </MudButton>
            </div>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _processing;
    private readonly CancellationTokenSource _cts = new();

    private async Task Submit()
    {
        if (_form != null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid) return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Mật khẩu mới và xác nhận không khớp!", Severity.Error);
            return;
        }

        _processing = true;
        try
        {
            var result = await AuthService.ChangePassword(
                _currentPassword,
                _newPassword,
                _cts.Token);

            if (result.IsSuccess)
            {
                Snackbar.Add("Đổi mật khẩu thành công. Vui lòng đăng nhập lại!", Severity.Success);
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Không thể đổi mật khẩu.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[AUTH] ChangePassword page error");
            Snackbar.Add("Lỗi hệ thống khi đổi mật khẩu.", Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/");

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
