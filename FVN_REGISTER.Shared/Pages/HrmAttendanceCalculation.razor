@page "/hrm/attendance-calculation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Contract.Dtos.HrmSync
@using FVN_REGISTER.Shared.Services.Departments
@using FVN_REGISTER.Shared.Services.HrmSync
@inject IJSRuntime JS
@inject IDepartmentManagementClientService Departments
@inject IHrmAttendanceCalculationClientService Calculation
@inject ISnackbar Snackbar
@inject ISecurityClientService SecurityService
@rendermode InteractiveServer

<MudPaper Class="pa-6">
 @if (!_canCalculate) { <MudAlert Severity="Severity.Error">@Language.T("hrm.banKhongCoQuyenThuc")</MudAlert> } else {
 <MudText Typo="Typo.h5">@Language.T("hrm.calculate")</MudText>
 <MudText Typo="Typo.body2" Class="mb-4">@Language.T("hrm.fvnDocDuLieuHrm")</MudText>
 <MudGrid>
  <MudItem xs="12" md="4">
   <MudSelect T="string" Label='@Language.T("nav.departments")' @bind-Value="_deptCode" Variant="Variant.Outlined" Clearable="true">
    @foreach(var d in _departments){<MudSelectItem Value="@d.DeptCode">@d.DeptCode - @d.DeptName</MudSelectItem>}
   </MudSelect>
  </MudItem>
  <MudItem xs="12" md="3"><MudDatePicker Label='@Language.T("common.startDate")' @bind-Date="_fromDate" Variant="Variant.Outlined"/></MudItem>
  <MudItem xs="12" md="3"><MudDatePicker Label='@Language.T("common.endDate")' @bind-Date="_toDate" Variant="Variant.Outlined"/></MudItem>
  <MudItem xs="12" md="2" Class="d-flex align-center"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_running" OnClick="CalculateAsync">@Language.T("hrm.tinhGio")</MudButton></MudItem>
 </MudGrid>
 @if(_running){<MudProgressLinear Indeterminate="true" Class="mt-4"/>}
 @if(_result is not null)
{
 <MudAlert Severity="Severity.Success" Class="mt-4">@Language.T("hrm.batchDongNhanVien", _result.CalculationBatchId, _result.CalculatedRows, _result.EmployeeCount)</MudAlert>
 <MudStack Row="true" Spacing="2" Class="mt-3">
  <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_exporting" OnClick="ExportAttendanceAsync">
   @Language.T("hrm.xuatChamCong")
  </MudButton>
  <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="_exporting" OnClick="ExportOtAsync">
   @Language.T("hrm.xuatTinhOt")
  </MudButton>
 </MudStack>
}
}
</MudPaper>

@code {
 private List<DepartmentDto> _departments=new();
 private string? _deptCode;
 private DateTime? _fromDate=DateTime.Today;
 private DateTime? _toDate=DateTime.Today;
 private bool _running;
 private bool _canCalculate;
 private bool _exporting;
 private HrmAttendanceCalculationResultDto? _result;
 protected override async Task OnInitializedAsync()
 {
  var permissions = await SecurityService.GetMyPermissionsAsync();
  _canCalculate = permissions.IsSuccess && permissions.Data?.Has(SecurityFunctionCodes.AttendanceCalculate) == true;
  if (!_canCalculate) return;
  var r=await Departments.GetListAsync(true);
  if(r.IsSuccess&&r.Data is not null) _departments=r.Data;
 }
 private async Task ExportAttendanceAsync()
 {
  if (_result is null) return;
  _exporting = true;
  try
  {
   var r = await Calculation.ExportAttendanceAsync(_result.CalculationBatchId);
   if (r.IsSuccess && r.Data is not null)
   {
    await JS.InvokeVoidAsync("hrmAttendanceExport.download", r.Data, $"BangChamCong_{_result.FromDate:yyyyMMdd}_{_result.ToDate:yyyyMMdd}.xls");
    Snackbar.Add(Language.T("hrm.daXuatBangChamCong"), Severity.Success);
   }
   else Snackbar.Add(r.Message ?? Language.T("hrm.xuatChamCongThatBai"), Severity.Error);
  }
  finally { _exporting = false; }
 }

 private async Task ExportOtAsync()
 {
  if (_result is null) return;
  _exporting = true;
  try
  {
   var r = await Calculation.ExportOtAsync(_result.CalculationBatchId);
   if (r.IsSuccess && r.Data is not null)
   {
    await JS.InvokeVoidAsync("hrmAttendanceExport.download", r.Data, $"BangLamThem_{_result.FromDate:yyyyMMdd}_{_result.ToDate:yyyyMMdd}.xls");
    Snackbar.Add(Language.T("hrm.daXuatBangTinhOt"), Severity.Success);
   }
   else Snackbar.Add(r.Message ?? Language.T("hrm.xuatOtThatBai"), Severity.Error);
  }
  finally { _exporting = false; }
 }

 private async Task CalculateAsync()
 {
  if(_fromDate is null||_toDate is null||_fromDate>_toDate){Snackbar.Add(Language.T("common.khoangNgayKhongHopLe"),Severity.Warning);return;}
  _running=true; _result=null;
  try
  {
   var r=await Calculation.CalculateAsync(new HrmAttendanceCalculationRequestDto{DeptCode=int.TryParse(_deptCode,out var deptValue)?deptValue:(int?)null,FromDate=_fromDate.Value,ToDate=_toDate.Value});
   if(r.IsSuccess&&r.Data is not null){_result=r.Data;Snackbar.Add(Language.T("hrm.daTinhGioXong"),Severity.Success);}
   else Snackbar.Add(r.Message??Language.T("hrm.tinhGioThatBai"),Severity.Error);
  }
  finally{_running=false;}
 }
}