@page "/hrm/attendance-calculation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Contract.Dtos.HrmSync
@using FVN_REGISTER.Shared.Services.Departments
@using FVN_REGISTER.Shared.Services.HrmSync
@inject IJSRuntime JS
@inject IHttpClientWithAuth Http
@inject IDepartmentManagementClientService Departments
@inject IHrmAttendanceCalculationClientService Calculation
@inject ISnackbar Snackbar
@inject ISecurityClientService SecurityService
@rendermode InteractiveServer

<MudPaper Class="pa-6">
 @if (!_canCalculate) { <MudAlert Severity="Severity.Error">@Language.T("hrm.banKhongCoQuyenThuc")</MudAlert> } else {
 <MudText Typo="Typo.h5">@Language.T("hrm.calculate")</MudText>
 <MudText Typo="Typo.body2" Class="mb-4">@Language.T("hrm.fvnDocDuLieuHrm")</MudText>
 <MudGrid>
  <MudItem xs="12" md="4">
   <MudSelect T="int?" Label='@Language.T("nav.departments")' @bind-Value="_deptCode" Variant="Variant.Outlined" Clearable="true">
    @foreach(var d in _departments){<MudSelectItem T="int?" Value="@((int?)d.DeptCode)">@d.DeptCode - @d.DeptName</MudSelectItem>}
   </MudSelect>
  </MudItem>
  <MudItem xs="12" md="3"><MudDatePicker Label='@Language.T("common.startDate")' @bind-Date="_fromDate" Variant="Variant.Outlined"/></MudItem>
  <MudItem xs="12" md="3"><MudDatePicker Label='@Language.T("common.endDate")' @bind-Date="_toDate" Variant="Variant.Outlined"/></MudItem>
  <MudItem xs="12" md="2" Class="d-flex align-center"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_running" OnClick="CalculateAsync">@Language.T("hrm.tinhGio")</MudButton></MudItem>
 </MudGrid>
 @if(_running)
 {
  <MudProgressLinear Value="_jobProgress" Class="mt-4" />
  <MudText Typo="Typo.caption" Class="mt-1">@_jobStatus — @_jobCompletedDates / @_jobTotalDates ngày. Có thể rời trang; job vẫn chạy trên server.</MudText>
 }
 @if(!string.IsNullOrWhiteSpace(_jobError))
 {
  <MudAlert Severity="Severity.Error" Class="mt-3">@_jobError</MudAlert>
 }
 @if(_completedJobId.HasValue)
 {
  <MudAlert Severity="Severity.Success" Class="mt-4">
   Đã hoàn tất job @ShortJobId(_completedJobId.Value) (@_completedFrom?.ToString("dd/MM/yyyy") → @_completedTo?.ToString("dd/MM/yyyy")). Kết quả đã được lưu; có thể xuất Excel theo toàn bộ job.
  </MudAlert>
  <MudStack Row="true" Spacing="2" Class="mt-3">
   <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_exporting" OnClick="ExportAttendanceAsync">
    @Language.T("hrm.xuatChamCong")
   </MudButton>
   <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="_exporting" OnClick="ExportOtAsync">
    @Language.T("hrm.xuatTinhOt")
   </MudButton>
  </MudStack>
}
}
</MudPaper>

@code {
 private List<DepartmentDto> _departments=new();
 private int? _deptCode;
 private DateTime? _fromDate=DateTime.Today;
 private DateTime? _toDate=DateTime.Today;
 private bool _running;
 private bool _canCalculate;
 private bool _exporting;
 private HrmAttendanceCalculationJobClientService? _jobClient;
 private readonly CancellationTokenSource _disposeCts = new();
 private Guid? _completedJobId;
 private DateTime? _completedFrom;
 private DateTime? _completedTo;
 private string? _jobStatus;
 private string? _jobError;
 private int _jobCompletedDates;
 private int _jobTotalDates;
 private double _jobProgress;
 protected override async Task OnInitializedAsync()
 {
  _jobClient = new HrmAttendanceCalculationJobClientService(Http);
  var permissions = await SecurityService.GetMyPermissionsAsync();
  _canCalculate = permissions.IsSuccess && permissions.Data?.Has(SecurityFunctionCodes.AttendanceCalculate) == true;
  if (!_canCalculate) return;
  var r=await Departments.GetListAsync(true);
  if(r.IsSuccess&&r.Data is not null) _departments=r.Data;
 }
 private async Task ExportAttendanceAsync()
 {
  if (!_completedJobId.HasValue) return;
  _exporting = true;
  try
  {
   var r = await Calculation.ExportAttendanceByJobAsync(_completedJobId.Value, _disposeCts.Token);
   if (r.IsSuccess && r.Data is not null)
   {
    await JS.InvokeVoidAsync("hrmAttendanceExport.download", r.Data, $"BangChamCong_{_completedFrom:yyyyMMdd}_{_completedTo:yyyyMMdd}.xls");
    Snackbar.Add(Language.T("hrm.daXuatBangChamCong"), Severity.Success);
   }
   else Snackbar.Add(r.Message ?? Language.T("hrm.xuatChamCongThatBai"), Severity.Error);
  }
  finally { _exporting = false; }
 }

 private async Task ExportOtAsync()
 {
  if (!_completedJobId.HasValue) return;
  _exporting = true;
  try
  {
   var r = await Calculation.ExportOtByJobAsync(_completedJobId.Value, _disposeCts.Token);
   if (r.IsSuccess && r.Data is not null)
   {
    await JS.InvokeVoidAsync("hrmAttendanceExport.download", r.Data, $"BangLamThem_{_completedFrom:yyyyMMdd}_{_completedTo:yyyyMMdd}.xls");
    Snackbar.Add(Language.T("hrm.daXuatBangTinhOt"), Severity.Success);
   }
   else Snackbar.Add(r.Message ?? Language.T("hrm.xuatOtThatBai"), Severity.Error);
  }
  finally { _exporting = false; }
 }

 private async Task CalculateAsync()
 {
  if(_jobClient is null || _fromDate is null || _toDate is null || _fromDate > _toDate)
  {
   Snackbar.Add(Language.T("common.khoangNgayKhongHopLe"), Severity.Warning);
   return;
  }
  if((_toDate.Value.Date - _fromDate.Value.Date).TotalDays > 92)
  {
   Snackbar.Add("Mỗi job tính công tối đa 93 ngày. Hãy chia nhỏ khoảng ngày.", Severity.Warning);
   return;
  }

  _running = true;
  _completedJobId = null;
  _completedFrom = null;
  _completedTo = null;
  _jobError = null;
  _jobProgress = 0;
  _jobCompletedDates = 0;
  _jobTotalDates = 0;
  try
  {
   var started = await _jobClient.StartAsync(new HrmAttendanceCalculationJobCommandDto
   {
    DeptCode = _deptCode,
    FromDate = _fromDate.Value.Date,
    ToDate = _toDate.Value.Date,
    ReopenPayrollPeriod = false
   }, _disposeCts.Token);

   if (!started.IsSuccess || started.Data is null)
   {
    _jobError = started.Message ?? "Không thể đưa phép tính vào hàng đợi.";
    Snackbar.Add(_jobError, Severity.Error);
    return;
   }

   var jobId = started.Data.JobId;
   var job = started.Data;
   while (!_disposeCts.IsCancellationRequested)
   {
    _jobStatus = job.DisplayStatus;
    _jobCompletedDates = job.CompletedDateCount;
    _jobTotalDates = job.TotalDateCount;
    _jobProgress = job.TotalDateCount <= 0 ? 0 : Math.Min(100, job.CompletedDateCount * 100d / job.TotalDateCount);
    await InvokeAsync(StateHasChanged);

    if (job.Status == "Completed")
    {
     _completedJobId = job.JobId;
     _completedFrom = job.FromDate;
     _completedTo = job.ToDate;
     Snackbar.Add(Language.T("hrm.daTinhGioXong"), Severity.Success);
     return;
    }

    if (job.Status is "Failed" or "Cancelled" or "Terminated")
    {
     _jobError = job.ErrorMessage ?? $"Job kết thúc với trạng thái {job.Status}.";
     Snackbar.Add(_jobError, Severity.Error);
     return;
    }

    await Task.Delay(TimeSpan.FromSeconds(1), _disposeCts.Token);
    var latest = await _jobClient.GetAsync(jobId, _disposeCts.Token);
    if (!latest.IsSuccess || latest.Data is null)
    {
     _jobError = latest.Message ?? "Không đọc được trạng thái job.";
     Snackbar.Add(_jobError, Severity.Error);
     return;
    }
    job = latest.Data;
   }
  }
  catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
  {
   // The UI poll is cancelled when the page is disposed; the persisted SQL job is not cancelled.
  }
  catch (Exception ex)
  {
   _jobError = ex.Message;
   Snackbar.Add(_jobError, Severity.Error);
  }
  finally
  {
   _running = false;
  }
 }

 private static string ShortJobId(Guid id) => id.ToString("N")[..8];

 public void Dispose()
 {
  _disposeCts.Cancel();
  _disposeCts.Dispose();
 }
}