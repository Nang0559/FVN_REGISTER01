@page "/equipment/workspace"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Contract.Dtos.Equipment
@using FVN_REGISTER.Contract.Dtos.EquipmentImport
@using FVN_REGISTER.Shared.Services.Equipment
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits AppComponentBase
@inject IEquipmentClientService EquipmentClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Language.T("equipment.nhapDuLieuTuExcel")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-5">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800">@Language.T("equipment.nhapDuLieuTuExcel")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("equipment.phongBanChonMauDu")</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Schema" OnClick="@(() => Navigation.NavigateTo("/equipment/schema-management"))">@Language.T("equipment.quanLyMauDuLieu2")</MudButton>
    </MudStack>

    @if (!_ready)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!_access)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@Language.T("equipment.taiKhoanChuaDuocCap2")</MudAlert>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-5 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">@Language.T("equipment.t1ChonPhongBanVa")</MudText>
            <MudSelect T="string" Label='@Language.T("common.department")' @bind-Value="_deptCode" Variant="Variant.Outlined" Dense="true">
                @foreach (var dept in _departments)
                {
                    <MudSelectItem Value="@dept.DeptCode">@dept.DeptCode – @dept.DeptName</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="LoadSchemasAsync" Disabled="@string.IsNullOrWhiteSpace(_deptCode)">@Language.T("equipment.taiMauDuLieu")</MudButton>

            @if (_schemas.Count > 0)
            {
                <MudSelect T="int?" Label="@Language.T("equipment.mauDuLieuPhienBan")" @bind-Value="_schemaId" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @foreach (var item in _schemas.Where(x => x.Status == "Active"))
                    {
                        <MudSelectItem T="int?" Value="@((int?)item.Id)">@item.SchemaName — v@item.Version — @item.OwnerName</MudSelectItem>
                    }
                </MudSelect>
                @if (_schema != null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        @Language.T("equipment.dangSuDung") <b>@_schema.SchemaName — v@_schema.Version</b>@Language.T("equipment.nguoiTaoSoTruong", _schema.OwnerName, _schema.Fields.Count)
                    </MudAlert>
                }
            }
            else if (!string.IsNullOrWhiteSpace(_deptCode))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@Language.T("equipment.phong") <b>@_deptCode</b> @Language.T("equipment.chuaCoMauDuLieu")</MudAlert>
            }
        </MudPaper>

        @if (_schema != null)
        {
            <MudPaper Outlined="true" Class="pa-5 mb-4">
                <MudText Typo="Typo.h6">@Language.T("equipment.t2CauTrucDuocDung")</MudText>
                <MudTable Items="_schema.Fields.Where(x => x.IsActiveField && x.IsImportable).OrderBy(x => x.DisplayOrder)" Dense="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>@Language.T("equipment.truongDuLieu")</MudTh><MudTh>@Language.T("equipment.kieuDuLieu")</MudTh><MudTh>@Language.T("common.required")</MudTh><MudTh>@Language.T("equipment.doDai")</MudTh><MudTh>@Language.T("equipment.giaTriMacDinh")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FieldLabel <span class="mud-text-secondary">(@context.FieldKey)</span></MudTd>
                        <MudTd>@DataTypeText(context.DataType)</MudTd>
                        <MudTd>@(context.IsRequired ? Language.T("common.yes") : Language.T("common.no"))</MudTd>
                        <MudTd>@context.MaxLength</MudTd>
                        <MudTd>@context.DefaultValue</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-5">
                <MudText Typo="Typo.h6">@Language.T("equipment.t3ChonFileExcelVa")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@Language.T("equipment.fileDuocKiemTraTheo")</MudText>
                <MudCheckBox T="bool" @bind-Value="_assignToEmployee" Label="@Language.T("equipment.giaoThietBiChoNhan")" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.caption" Class="d-block mb-2">@Language.T("equipment.khiBatExcelBatBuoc") <b>@Language.T("equipment.maNhanVienEmployeecode")</b> @Language.T("equipment.vaHeThongSeDoi")</MudText>
                <InputFile OnChange="OnFileSelected" accept=".xls,.xlsx,.xlsm" />
                @if (_file != null)
                {
                    <MudAlert Severity="Severity.Info" Class="my-3">@Language.T("equipment.daChonBytes", _file.Name, _file.Size)</MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StageAsync" Disabled="_uploading">@(_uploading ? Language.T("equipment.dangKiemTra2") : Language.T("equipment.kiemTraVaXemTruoc"))</MudButton>
                }

                @if (_batch != null)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1">@Language.T("equipment.loNhap", _batch.Id)</MudText>
                    <MudText>@Language.T("common.trangThai2", BatchStatusText(_batch.Status))</MudText>
                    <MudText>@Language.T("equipment.tongHopLeLoi", _batch.TotalRows, _batch.ValidRows, _batch.InvalidRows)</MudText>
                    @if (_batch.Rows.Any(x => !string.IsNullOrWhiteSpace(x.ErrorMessage)))
                    {
                        <MudAlert Severity="Severity.Error" Class="my-3">
                            @foreach (var row in _batch.Rows.Where(x => !string.IsNullOrWhiteSpace(x.ErrorMessage)).Take(20))
                            {
                                <div>@Language.T("equipment.dong", row.RowNumber, row.ErrorMessage)</div>
                            }
                        </MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Class="mt-3" Disabled="@(_batch.InvalidRows > 0 || _batch.Status != "Ready")" OnClick="CommitAsync">@Language.T("equipment.nhapDuLieuVaoHe")</MudButton>
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private bool _ready;
    private bool _access;
    private bool _uploading;
    private bool _assignToEmployee;
    private string _deptCode = string.Empty;
    private int? _schemaId;
    private List<DepartmentDto> _departments = new();
    private List<EquipmentSchemaSummaryDto> _schemas = new();
    private EquipmentSchemaDto? _schema;
    private EquipmentImportBatchDto? _batch;
    private IBrowserFile? _file;

    protected override async Task OnInitializedAsync()
    {
        var access = await EquipmentClient.HasImportAccessAsync();
        _access = access.IsSuccess && access.Data;
        if (_access)
        {
            var departments = await EquipmentClient.GetEquipmentDepartmentsAsync();
            if (departments.IsSuccess) _departments = departments.Data ?? new();
            if (_departments.Count > 0) _deptCode = _departments[0].DeptCode;
            await LoadSchemasAsync();
        }
        _ready = true;
    }

    private async Task LoadSchemasAsync()
    {
        _schema = null;
        _schemaId = null;
        _batch = null;
        if (string.IsNullOrWhiteSpace(_deptCode)) return;
        var list = await EquipmentClient.GetSchemasAsync(_deptCode);
        if (!list.IsSuccess)
        {
            Snackbar.Add(list.Message ?? Language.T("equipment.khongTaiDuocMauDu"), Severity.Error);
            return;
        }
        _schemas = list.Data ?? new();
        var active = _schemas.Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.Version).ToList();
        if (active.Count == 1) _schemaId = active[0].Id;
        else if (active.Count > 1) Snackbar.Add(Language.T("equipment.phongNayCoNhieuMau"), Severity.Info);
        await LoadSelectedSchemaAsync();
    }

    private async Task LoadSelectedSchemaAsync()
    {
        _schema = null;
        if (!_schemaId.HasValue) return;
        var result = await EquipmentClient.GetSchemaAsync(_schemaId.Value);
        if (result.IsSuccess) _schema = result.Data;
        else Snackbar.Add(result.Message ?? Language.T("equipment.khongTaiDuocMauDu"), Severity.Error);
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _file = e.File;

    private async Task StageAsync()
    {
        if (_file == null || string.IsNullOrWhiteSpace(_deptCode) || !_schemaId.HasValue) return;
        _uploading = true;
        try
        {
            var result = await EquipmentClient.StageImportAsync(_deptCode, _schemaId, _file, _assignToEmployee);
            if (result.IsSuccess)
            {
                _batch = result.Data;
                Snackbar.Add(Language.T("equipment.excelDaDuocKiemTra"), Severity.Success);
            }
            else Snackbar.Add(result.Message ?? Language.T("equipment.khongTheKiemTraExcel"), Severity.Error);
        }
        finally { _uploading = false; }
    }

    private async Task CommitAsync()
    {
        if (_batch == null) return;
        var result = await EquipmentClient.CommitImportAsync(_batch.Id);
        Snackbar.Add(result.IsSuccess ? Language.T("equipment.daNhapDuLieuThanh") : (result.Message ?? Language.T("equipment.khongTheNhapDuLieu")), result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess) await LoadSelectedSchemaAsync();
    }

    private string DataTypeText(string? type) => type?.ToLowerInvariant() switch
    {
        "integer" => Language.T("equipment.soNguyen"),
        "number" or "decimal" => Language.T("equipment.soThapPhan"),
        "currency" => Language.T("equipment.tienTe"),
        "date" => Language.T("ot.date"),
        "datetime" => Language.T("equipment.ngayGio"),
        "boolean" => Language.T("equipment.dungSai"),
        "email" => "Email",
        "choice" => Language.T("equipment.danhSachLuaChon"),
        _ => Language.T("equipment.vanBan")
    };

    private string BatchStatusText(string? status) => status?.ToLowerInvariant() switch
    {
        "ready" => Language.T("equipment.sanSangNhap"),
        "needsreview" => Language.T("equipment.canXuLyLoi"),
        "imported" => Language.T("equipment.daNhap"),
        _ => Language.T("equipment.dangKiemTra")
    };
}
