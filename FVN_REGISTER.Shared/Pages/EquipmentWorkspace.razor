@page "/equipment/workspace"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Contract.Dtos.Equipment
@using FVN_REGISTER.Contract.Dtos.EquipmentImport
@using FVN_REGISTER.Shared.Services.Equipment
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inherits AppComponentBase
@inject IEquipmentClientService EquipmentClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@Language.T("equipment.nhapDuLieuTuExcel")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-5">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800">@Language.T("equipment.nhapDuLieuTuExcel")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("equipment.phongBanChonMauDu")</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Schema" OnClick="@(() => Navigation.NavigateTo("/equipment/schema-management"))">@Language.T("equipment.quanLyMauDuLieu2")</MudButton>
    </MudStack>

    @if (!_ready)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!_access)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@Language.T("equipment.taiKhoanChuaDuocCap2")</MudAlert>
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-5 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">@Language.T("equipment.t1ChonPhongBanVa")</MudText>
            <MudSelect T="int?" Label='@Language.T("common.department")' @bind-Value="_deptCode" Variant="Variant.Outlined" Dense="true">
                @foreach (var dept in _departments)
                {
                    <MudSelectItem T="int?" Value="@((int?)dept.DeptCode)">@dept.DeptCode – @dept.DeptName</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="LoadSchemasAsync" Disabled="@(_deptCode == null)">@Language.T("equipment.taiMauDuLieu")</MudButton>

            @if (_schemas.Any(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase)))
            {
                <MudSelect T="int?" Label="@Language.T("equipment.mauDuLieuPhienBan")" @bind-Value="_schemaId" @bind-Value:after="LoadSelectedSchemaAsync" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @foreach (var item in _schemas.Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudSelectItem T="int?" Value="@((int?)item.Id)">@item.SchemaName — v@item.Version — @item.CreatedByUserName</MudSelectItem>
                    }
                </MudSelect>
                @if (_schema != null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        @Language.T("equipment.dangSuDung") <b>@_schema.SchemaName — v@_schema.Version</b>@Language.T("equipment.nguoiTaoSoTruong", _schema.CreatedByUserName, _schema.Fields.Count)
                    </MudAlert>
                }
            }
            else if (_schemas.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">
                    Phòng ban này đã có @_schemas.Count mẫu dữ liệu nhưng tất cả đang ở trạng thái Bản nháp. Vào Quản lý mẫu dữ liệu, mở mẫu do bạn tạo và chọn "Đưa vào sử dụng" để mẫu xuất hiện tại đây.
                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Schema" OnClick="@(() => Navigation.NavigateTo("/equipment/schema-management"))">Quản lý mẫu dữ liệu</MudButton>
                </MudAlert>
            }
            else if (_deptCode != null)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3">@Language.T("equipment.phong") <b>@_deptCode</b> @Language.T("equipment.chuaCoMauDuLieu")</MudAlert>
            }
        </MudPaper>

        @if (_schema != null)
        {
            <MudPaper Outlined="true" Class="pa-5 mb-4">
                <MudText Typo="Typo.h6">@Language.T("equipment.t2CauTrucDuocDung")</MudText>
                <MudTable Items="_schema.Fields.OrderBy(x => x.DisplayOrder)" Dense="true" Class="mt-3">
                    <HeaderContent>
                        <MudTh>@Language.T("equipment.truongDuLieu")</MudTh><MudTh>Cột Excel / vị trí</MudTh><MudTh>Liên kết trường nghiệp vụ</MudTh><MudTh>@Language.T("equipment.kieuDuLieu")</MudTh><MudTh>@Language.T("common.required")</MudTh><MudTh>@Language.T("equipment.doDai")</MudTh><MudTh>@Language.T("equipment.giaTriMacDinh")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FieldLabel <span class="mud-text-secondary">(@context.FieldKey)</span></MudTd>
                        <MudTd>@(context.HeaderName ?? "—") <span class="mud-text-secondary">(#@(context.SourceColumnIndex + 1))</span></MudTd>
                        <MudTd>
                            @if (!string.IsNullOrWhiteSpace(context.TargetProperty))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@TargetPropertyText(context.TargetProperty)</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Chưa liên kết</MudChip>
                            }
                        </MudTd>
                        <MudTd>@DataTypeText(context.DataType)</MudTd>
                        <MudTd>@(context.IsRequired ? Language.T("common.yes") : Language.T("common.no"))</MudTd>
                        <MudTd>@context.MaxLength</MudTd>
                        <MudTd>@context.DefaultValue</MudTd>
                    </RowTemplate>
                </MudTable>
                @if (!_schema.Fields.Any(x => string.Equals(x.TargetProperty, "EquipmentCode", StringComparison.OrdinalIgnoreCase))
                    || !_schema.Fields.Any(x => string.Equals(x.TargetProperty, "EquipmentName", StringComparison.OrdinalIgnoreCase))
                    || !_schema.Fields.Any(x => string.Equals(x.TargetProperty, "OperatingResponsibleDeptCode", StringComparison.OrdinalIgnoreCase)))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">
                        Schema chưa liên kết đủ Mã thiết bị, Tên thiết bị và Phòng ban sử dụng. Hãy cấu hình liên kết trong Quản lý mẫu dữ liệu trước khi import.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mt-3">
                        Kiểm tra các liên kết bên trên trước khi chọn file. Muốn thay đổi liên kết, mở Quản lý mẫu dữ liệu, tạo phiên bản mới, cấu hình cột Excel → trường nghiệp vụ rồi kích hoạt phiên bản đó.
                    </MudAlert>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Schema" Class="mt-2"
                           OnClick="@(() => Navigation.NavigateTo("/equipment/schema-management"))">Cấu hình liên kết trường</MudButton>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-5">
                <MudText Typo="Typo.h6">@Language.T("equipment.t3ChonFileExcelVa")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@Language.T("equipment.fileDuocKiemTraTheo")</MudText>
                <MudCheckBox T="bool" @bind-Value="_assignToEmployee" Label="@Language.T("equipment.giaoThietBiChoNhan")" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.caption" Class="d-block mb-2">@Language.T("equipment.khiBatExcelBatBuoc") <b>@Language.T("equipment.maNhanVienEmployeecode")</b> @Language.T("equipment.vaHeThongSeDoi")</MudText>
                <InputFile OnChange="OnFileSelected" accept=".xls,.xlsx,.xlsm" />
                @if (_file != null)
                {
                    <MudAlert Severity="Severity.Info" Class="my-3">@Language.T("equipment.daChonBytes", _file.Name, _file.Size)</MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StageAsync" Disabled="_uploading">@(_uploading ? Language.T("equipment.dangKiemTra2") : Language.T("equipment.kiemTraVaXemTruoc"))</MudButton>
                }

                @if (_batch != null)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1">@Language.T("equipment.loNhap", _batch.Id)</MudText>
                    <MudText>@Language.T("common.trangThai2", BatchStatusText(_batch.Status))</MudText>
                    <MudText>@Language.T("equipment.tongHopLeLoi", _batch.TotalRows, _batch.ValidRows, _batch.InvalidRows)</MudText>
                    <MudStepper linear="false" Class="my-4">
                        <MudStep Title="Kiểm tra Excel" Completed="true">
                            <MudText Typo="Typo.body2">File đã được đưa vào staging và kiểm tra dữ liệu.</MudText>
                        </MudStep>
                        <MudStep Title="Duyệt kết quả">
                            <MudText Typo="Typo.body2">Rà soát từng dòng hợp lệ, lỗi và xung đột trước khi xác nhận.</MudText>
                        </MudStep>
                        <MudStep Title="Tạo bản nháp">
                            <MudText Typo="Typo.body2">Các dòng được chấp nhận sẽ cần chuyển thành bản nháp đăng ký hoặc yêu cầu thay đổi thiết bị.</MudText>
                        </MudStep>
                        <MudStep Title="Gửi phê duyệt">
                            <MudText Typo="Typo.body2">Danh mục chính thức chỉ được cập nhật sau khi hoàn tất phê duyệt.</MudText>
                        </MudStep>
                    </MudStepper>
                    <MudGrid Class="my-2">
                        <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Tổng số dòng</MudText><MudText Typo="Typo.h5">@_batch.TotalRows</MudText></MudPaper></MudItem>
                        <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Dòng hợp lệ</MudText><MudText Typo="Typo.h5" Color="Color.Success">@_batch.ValidRows</MudText></MudPaper></MudItem>
                        <MudItem xs="12" sm="4"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.caption">Dòng lỗi</MudText><MudText Typo="Typo.h5" Color="@(_batch.InvalidRows > 0 ? Color.Error : Color.Default)">@_batch.InvalidRows</MudText></MudPaper></MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-2">Chi tiết kiểm tra theo từng dòng</MudText>
                    @if (_batch.Rows.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Batch chưa có chi tiết từng dòng. Hãy làm mới kết quả; nếu vẫn trống, cần kiểm tra API trả dữ liệu staging.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_batch.Rows.OrderBy(x => x.RowNumber)" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent><MudTh>Dòng Excel</MudTh><MudTh>Kết quả kiểm tra</MudTh><MudTh>Chi tiết / lỗi</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Dòng Excel">@context.RowNumber</MudTd>
                                <MudTd DataLabel="Kết quả kiểm tra">
                                    @if (string.Equals(context.Status, "Valid", StringComparison.OrdinalIgnoreCase)) { <MudChip T="string" Size="Size.Small" Color="Color.Success">Hợp lệ</MudChip> }
                                    else if (string.Equals(context.Status, "Invalid", StringComparison.OrdinalIgnoreCase)) { <MudChip T="string" Size="Size.Small" Color="Color.Error">Lỗi</MudChip> }
                                    else { <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.Status</MudChip> }
                                </MudTd>
                                <MudTd DataLabel="Chi tiết / lỗi">
                                    @if (!string.IsNullOrWhiteSpace(context.ErrorMessage)) { <MudText Color="Color.Error" Typo="Typo.body2">@context.ErrorMessage</MudText> }
                                    else { <MudText Typo="Typo.body2" Class="mud-text-secondary">Không phát hiện lỗi ở bước staging.</MudText> }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                        Xác nhận sẽ tạo bản nháp đăng ký cho thiết bị mới và bản nháp thay đổi có snapshot cho thiết bị đã tồn tại. Thao tác này không sửa danh mục chính thức và không tự gửi duyệt; bản nháp tiếp tục qua luồng phê duyệt thiết bị hiện hữu.
                    </MudAlert>
                    <MudStack Row="true" Spacing="2" Class="mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FactCheck"
                                   Disabled="@(_uploading || _batch.ValidRows <= 0 || string.Equals(_batch.Status, "Imported", StringComparison.OrdinalIgnoreCase))"
                                   OnClick="ConfirmBatchAsync">Xác nhận batch và tạo bản nháp</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_uploading" OnClick="RefreshBatchAsync">Làm mới kết quả kiểm tra</MudButton>
                    </MudStack>
                    @if (_commitResult != null)
                    {
                        <MudAlert Severity="@(_commitResult.Errors.Count == 0 ? Severity.Success : Severity.Warning)" Class="mt-3">
                            Batch @_commitResult.BatchId: đã tạo @_commitResult.ImportedRows bản nháp; bỏ qua @_commitResult.SkippedRows dòng.
                            @if (_commitResult.Errors.Count > 0)
                            {
                                <MudStack Spacing="1">
                                    @foreach (var error in _commitResult.Errors)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Error">@error</MudText>
                                    }
                                </MudStack>
                            }
                        </MudAlert>
                    }
                }
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private bool _ready;
    private bool _access;
    private bool _uploading;
    private bool _assignToEmployee;
    private int? _deptCode;
    private int? _schemaId;
    private List<DepartmentDto> _departments = new();
    private List<ExcelSchemaSummaryDto> _schemas = new();
    private ExcelSchemaDto? _schema;
    private ExcelImportBatchDto? _batch;\n    private ExcelImportCommitResultDto? _commitResult;
    private IBrowserFile? _file;

    protected override async Task OnInitializedAsync()
    {
        var access = await EquipmentClient.HasImportAccessAsync();
        _access = access.IsSuccess && access.Data;
        if (_access)
        {
            var departments = await EquipmentClient.GetEquipmentDepartmentsAsync();
            if (departments.IsSuccess) _departments = departments.Data ?? new();
            if (_departments.Count > 0) _deptCode = _departments[0].DeptCode;
            await LoadSchemasAsync();
        }
        _ready = true;
    }

    private async Task LoadSchemasAsync()
    {
        _schema = null;
        _schemaId = null;
        _batch = null;
        if (_deptCode == null) return;
        var list = await EquipmentClient.GetSchemasAsync(_deptCode);
        if (!list.IsSuccess)
        {
            Snackbar.Add(list.Message ?? Language.T("equipment.khongTaiDuocMauDu"), Severity.Error);
            return;
        }
        _schemas = list.Data ?? new();
        var active = _schemas.Where(x => string.Equals(x.Status, "Active", StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.Version).ToList();
        if (active.Count == 1) _schemaId = active[0].Id;
        else if (active.Count > 1) Snackbar.Add(Language.T("equipment.phongNayCoNhieuMau"), Severity.Info);
        await LoadSelectedSchemaAsync();
    }

    private async Task LoadSelectedSchemaAsync()
    {
        _schema = null;
        if (!_schemaId.HasValue) return;
        var result = await EquipmentClient.GetSchemaAsync(_schemaId.Value);
        if (result.IsSuccess) _schema = result.Data;
        else Snackbar.Add(result.Message ?? Language.T("equipment.khongTaiDuocMauDu"), Severity.Error);
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _file = e.File;

    private async Task StageAsync()
    {
        if (_file == null || _deptCode == null || !_schemaId.HasValue) return;
        _uploading = true;
        try
        {
            var result = await EquipmentClient.StageImportAsync(_deptCode.Value, _schemaId, _file, _assignToEmployee);
            if (result.IsSuccess)
            {
                _batch = result.Data;
                Snackbar.Add(Language.T("equipment.excelDaDuocKiemTra"), Severity.Success);
            }
            else Snackbar.Add(result.Message ?? Language.T("equipment.khongTheKiemTraExcel"), Severity.Error);
        }
        finally { _uploading = false; }
    }

    private async Task ConfirmBatchAsync()
    {
        if (_batch is null || _uploading) return;
        _uploading = true;
        _commitResult = null;
        try
        {
            var result = await EquipmentClient.CommitImportAsync(_batch.Id);
            if (!result.IsSuccess || result.Data is null)
            {
                Snackbar.Add(result.Message ?? "Không thể xác nhận batch.", Severity.Error);
                return;
            }
            _commitResult = result.Data;
            Snackbar.Add($"Đã tạo {_commitResult.ImportedRows} bản nháp; bỏ qua {_commitResult.SkippedRows} dòng.", 
                _commitResult.Errors.Count == 0 ? Severity.Success : Severity.Warning);
            await RefreshBatchAsync();
        }
        finally { _uploading = false; }
    }

    private async Task RefreshBatchAsync()
    {
        if (_batch is null) return;
        var result = await EquipmentClient.GetImportBatchAsync(_batch.Id);
        if (result.IsSuccess && result.Data is not null)
            _batch = result.Data;
        else
            Snackbar.Add(result.Message ?? "Không thể tải lại kết quả staging.", Severity.Error);
    }

    private string TargetPropertyText(string? target) => target?.Trim() switch
    {
        "EquipmentCode" => "Mã thiết bị",
        "EquipmentName" => "Tên thiết bị",
        "ManagedByEmployeeCode" => "Kỹ thuật viên quản lý",
        "OperatingResponsibleEmployeeCode" => "Người sử dụng thiết bị",
        "OperatingResponsibleDeptCode" => "Phòng ban sử dụng",
        "ResponsibleEmployeeCode" => "Người phụ trách nghiệp vụ",
        "AssetCode" => "Mã tài sản",
        "SerialNumber" => "Số serial",
        "Specification" => "Thông số",
        "PurchasePrice" => "Nguyên giá",
        "PurchaseDate" => "Ngày mua",
        "ExpectedDepreciationDate" => "Ngày khấu hao dự kiến",
        "Location" => "Vị trí",
        "Note" => "Ghi chú",
        _ => target ?? "Chưa liên kết"
    };

    private string DataTypeText(string? type) => type?.ToLowerInvariant() switch
    {
        "integer" => Language.T("equipment.soNguyen"),
        "number" or "decimal" => Language.T("equipment.soThapPhan"),
        "currency" => Language.T("equipment.tienTe"),
        "date" => Language.T("ot.date"),
        "datetime" => Language.T("equipment.ngayGio"),
        "boolean" => Language.T("equipment.dungSai"),
        "email" => "Email",
        "choice" => Language.T("equipment.danhSachLuaChon"),
        _ => Language.T("equipment.vanBan")
    };

    private string BatchStatusText(string? status) => status?.ToLowerInvariant() switch
    {
        "ready" => Language.T("equipment.sanSangNhap"),
        "needsreview" => Language.T("equipment.canXuLyLoi"),
        "imported" => Language.T("equipment.daNhap"),
        _ => Language.T("equipment.dangKiemTra")
    };
}
