@page "/admin/departments"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Shared.Dialogs.Departments
@using FVN_REGISTER.Shared.Services.Departments
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

@inject IDepartmentManagementClientService DepartmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Quản lý Bộ phận - FCC</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Large" />
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700">Quản lý Bộ Phận</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Cấu hình danh sách bộ phận trong công ty</MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness" OnClick="OpenCreateDialog">
        Thêm Bộ Phận
    </MudButton>
</MudStack>

<MudPaper Elevation="1" Class="pa-3 mb-4" Style="border-radius:12px">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudSelect T="bool?" Label="Lọc theo trạng thái" Value="_filterActive" ValueChanged="OnActiveFilterChanged"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="bool?" Value="@((bool?)true)">Đang hoạt động</MudSelectItem>
                <MudSelectItem T="bool?" Value="@((bool?)false)">Đã ngừng hoạt động</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetFilter" FullWidth="true">Xem tất cả</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px; overflow:hidden">
        <MudTable Items="_departments" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Mã bộ phận</MudTh>
                <MudTh>Tên bộ phận</MudTh>
                <MudTh Style="text-align:center">Nhân viên</MudTh>
                <MudTh>Ngày tạo</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Style="text-align:center">Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudText Typo="Typo.body2" Style="font-weight:600">@context.DeptCode</MudText></MudTd>
                <MudTd>@context.DeptName</MudTd>
                <MudTd Style="text-align:center">@context.EmployeeCount</MudTd>
                <MudTd>@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                        @(context.IsActive ? "Đang hoạt động" : "Đã ngừng")
                    </MudChip>
                </MudTd>
                <MudTd Style="text-align:center">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenEditDialog(context))" />
                    <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.ToggleOff : Icons.Material.Filled.ToggleOn)" Size="Size.Small"
                                   Color="@(context.IsActive ? Color.Warning : Color.Success)" OnClick="@(() => ToggleDepartment(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Color="Color.Secondary" Class="pa-6">Không có bộ phận.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<DepartmentDto> _departments = new();
    private bool _isLoading = true;
    private bool? _filterActive;

    private static readonly DialogOptions DialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var result = await DepartmentService.GetListAsync(_filterActive);
            if (result.IsSuccess && result.Data != null)
                _departments = result.Data;
            else
                Snackbar.Add(result.Message ?? "Lỗi tải dữ liệu", Severity.Error);
        }
        finally { _isLoading = false; }
    }

    private Task OnActiveFilterChanged(bool? value)
    {
        _filterActive = value;
        return LoadAsync();
    }

    private Task ResetFilter()
    {
        _filterActive = null;
        return LoadAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(DepartmentManagementEditDialog.Model)] = new DepartmentUpsertDto { IsActive = true }
        };
        var dialog = await DialogService.ShowAsync<DepartmentManagementEditDialog>(string.Empty, parameters, DialogOptions);
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add("Đã thêm bộ phận thành công!", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditDialog(DepartmentDto item)
    {
        var model = new DepartmentUpsertDto
        {
            Id = item.Id,
            DeptCode = item.DeptCode,
            DeptName = item.DeptName,
            IsActive = item.IsActive
        };
        var parameters = new DialogParameters { [nameof(DepartmentManagementEditDialog.Model)] = model };
        var dialog = await DialogService.ShowAsync<DepartmentManagementEditDialog>(string.Empty, parameters, DialogOptions);
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add("Đã cập nhật bộ phận thành công!", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ToggleDepartment(DepartmentDto item)
    {
        var result = await DepartmentService.ToggleAsync(item.Id);
        Snackbar.Add(result.Message ?? (result.IsSuccess ? "Đã cập nhật" : "Có lỗi xảy ra"), result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess) await LoadAsync();
    }

    private async Task ConfirmDelete(DepartmentDto item)
    {
        var parameters = new DialogParameters
        {
            [nameof(DepartmentManagementDeleteConfirmDialog.Department)] = item
        };
        var dialog = await DialogService.ShowAsync<DepartmentManagementDeleteConfirmDialog>(string.Empty, parameters, DialogOptions);
        if ((await dialog.Result) is not { Canceled: false }) return;

        var result = await DepartmentService.DeleteAsync(item.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add("Đã xóa bộ phận", Severity.Success);
            await LoadAsync();
        }
        else Snackbar.Add(result.Message ?? "Lỗi xóa", Severity.Error);
    }
}
