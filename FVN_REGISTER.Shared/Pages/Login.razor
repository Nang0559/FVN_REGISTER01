@page "/login"
@using FVN_REGISTER.Contract.Requests.Auths
@using FVN_REGISTER.Contract.Dtos.Authentication
@using FVN_REGISTER.Contract.Requests.Users
@using FVN_REGISTER.Shared.Layout
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils

@layout EmptyLayout
@inherits AppComponentBase
@implements IDisposable
@inject ICurrentUserClientService CurrentUserService
@inject CustomAuthStateProvider AuthStateProvider
@inject IAuthClientService AuthService
@inject IPasswordResetRequestClientService PasswordResetRequestService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height:100vh">
    <MudPaper Elevation="4" Class="pa-8" Width="100%" Style="max-width:400px; border-radius:12px">
        <div class="d-flex justify-end">
            <MudSelect T="LanguageCode" Value="@Language.Current" ValueChanged="SetLanguageAsync"
                       Label="@Language.T("common.language")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="LanguageCode.Vi">@Language.T("language.vi")</MudSelectItem>
                <MudSelectItem Value="LanguageCode.Ja">@Language.T("language.ja")</MudSelectItem>
            </MudSelect>
        </div>

        <div class="d-flex flex-column align-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="mt-2" Style="font-weight:bold; color:#1E88E5">e-Approval System</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("login.system")</MudText>
        </div>

        <EditForm Model="@_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <MudTextField T="string" Label="@Language.T("login.username")"
                          @bind-Value="_model.UserName"
                          For="@(() => _model.UserName)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                          Class="mb-4" />

            <MudTextField T="string" Label="@Language.T("login.password")"
                          @bind-Value="_model.Password"
                          For="@(() => _model.Password)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          InputType="@_passwordInput"
                          Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          Class="mb-6" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Size="Size.Large" Disabled="_isProcessing">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">@Language.T("login.authenticating")</MudText>
                }
                else
                {
                    <MudText>@Language.T("login.submit")</MudText>
                }
            </MudButton>
        </EditForm>

        @if (_twoFactorPending)
        {
            <MudPaper Class="pa-4 mt-4" Outlined="true" Style="border-radius:12px">
                <MudText Typo="Typo.h6">@Language.T("login.twoFactor")</MudText>
                @if (_twoFactorSetup != null)
                {
                    <MudAlert Severity="Severity.Info" Class="my-3">
                        @Language.T("login.twoFactorRequired")
                    </MudAlert>
                    @if (!string.IsNullOrWhiteSpace(_twoFactorSetup.QrCodeDataUri))
                    {
                        <div class="d-flex justify-center my-3">
                            <MudImage Src="@_twoFactorSetup.QrCodeDataUri"
                                      Alt="@Language.T("login.twoFactor")"
                                      Width="220" Height="220" ObjectFit="ObjectFit.Contain" />
                        </div>
                    }
                    <MudText Typo="Typo.caption">@Language.T("login.account")</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2"><b>@_twoFactorSetup.Account</b></MudText>
                    <MudText Typo="Typo.caption">@Language.T("login.secret")</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2"><b>@_twoFactorSetup.Secret</b></MudText>
                    <MudExpansionPanels Class="mt-2">
                        <MudExpansionPanel Text="@Language.T("login.manualUri")">
                            <MudText Typo="Typo.caption" Style="word-break:break-all">@_twoFactorSetup.OtpAuthUri</MudText>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
                <MudTextField T="string" Label="@Language.T("login.code")" @bind-Value="_twoFactorCode"
                              Variant="Variant.Outlined" Margin="Margin.Dense" InputMode="InputMode.numeric"
                              MaxLength="6" Class="mt-3" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="VerifyTwoFactorAsync" Disabled="_isProcessing || _twoFactorCode.Length != 6">
                    @Language.T("login.verify")
                </MudButton>
            </MudPaper>
        }

        <div class="mt-6 d-flex flex-column align-center gap-2">
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.LockReset" OnClick="ToggleForgotPassword">
                @Language.T("login.forgot")
            </MudButton>

            @if (_showForgotPassword)
            {
                <MudPaper Elevation="0" Class="pa-4 mt-1"
                          Style="width:100%; border:1px solid var(--mud-palette-lines-default); border-radius:12px">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700">@Language.T("login.forgotTitle")</MudText>
                        <MudText Typo="Typo.body2">@Language.T("login.forgotDescription")</MudText>

                        <MudTextField T="string" Label="@Language.T("login.employeeCode")"
                                      @bind-Value="_forgotEmployeeCode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" Disabled="_sendingResetRequest"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" />

                        <MudTextField T="string" Label="@Language.T("login.optionalNote")"
                                      @bind-Value="_forgotRequestNote" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Lines="2" Disabled="_sendingResetRequest" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitForgotPasswordRequestAsync"
                                   Disabled="_sendingResetRequest || string.IsNullOrWhiteSpace(_forgotEmployeeCode)">
                            @(_sendingResetRequest ? Language.T("login.sending") : Language.T("login.sendToIT"))
                        </MudButton>

                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ToggleForgotPassword">
                            @Language.T("common.close")
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }

            <MudButton Variant="Variant.Text" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Campaign" Href="/thong-tin-cong-khai">
                @Language.T("login.publicInfo")
            </MudButton>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private LoginRequestDto _model = new();
    private bool _isProcessing;
    private bool _passwordVisibility;
    private bool _showForgotPassword;
    private string _forgotEmployeeCode = string.Empty;
    private string? _forgotRequestNote;
    private bool _sendingResetRequest;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private bool _twoFactorPending;
    private string _twoFactorChallenge = string.Empty;
    private string _twoFactorCode = string.Empty;
    private TwoFactorSetupDto? _twoFactorSetup;

    protected override async Task OnInitializedAsync()
    {
        Language.LanguageChanged += OnLanguageChanged;
        await Language.InitializeAsync();
        await base.OnInitializedAsync();
    }

    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private async Task SetLanguageAsync(LanguageCode language)
    {
        await Language.SetLanguageAsync(language);
    }

    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;

    private void ToggleForgotPassword() => _showForgotPassword = !_showForgotPassword;

    private async Task SubmitForgotPasswordRequestAsync()
    {
        var employeeCode = _forgotEmployeeCode.Trim();
        if (string.IsNullOrWhiteSpace(employeeCode)) return;
        _sendingResetRequest = true;
        try
        {
            var result = await PasswordResetRequestService.SubmitAsync(new FVN_REGISTER.Contract.Requests.Users.PasswordResetRequestCreateDto
            {
                EmployeeCode = employeeCode,
                RequestNote = string.IsNullOrWhiteSpace(_forgotRequestNote) ? null : _forgotRequestNote.Trim()
            });
            if (result.IsSuccess)
            {
                Snackbar.Add(Language.T("login.requestSent"), Severity.Success);
                _forgotEmployeeCode = string.Empty;
                _forgotRequestNote = null;
                _showForgotPassword = false;
            }
            else Snackbar.Add(result.Message ?? Language.T("login.requestFailed"), Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Login] Forgot password request failed");
            Snackbar.Add(Language.T("login.requestFailed"), Severity.Error);
        }
        finally { _sendingResetRequest = false; }
    }

    private void TogglePasswordVisibility()
    {
        _passwordVisibility = !_passwordVisibility;
        _passwordInput = _passwordVisibility ? InputType.Text : InputType.Password;
        _passwordInputIcon = _passwordVisibility ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task VerifyTwoFactorAsync()
    {
        if (string.IsNullOrWhiteSpace(_twoFactorChallenge) || _twoFactorCode.Length != 6) return;
        _isProcessing = true;
        try
        {
            var request = new TwoFactorVerifyRequest { ChallengeToken = _twoFactorChallenge, Code = _twoFactorCode, RememberMe = _model.RememberMe };
            var result = _twoFactorSetup != null
                ? await AuthService.ConfirmTwoFactorSetupAsync(request)
                : await AuthService.VerifyTwoFactorAsync(request);
            if (result.IsSuccess && result.Data != null && !string.IsNullOrWhiteSpace(result.Data.Token))
            {
                await CompleteLoginAsync(result.Data);
                return;
            }
            Snackbar.Add(result.Message ?? Language.T("login.twoFactorInvalid"), Severity.Error);
        }
        finally { _isProcessing = false; }
    }

    private async Task CompleteLoginAsync(AuthResultDto data)
    {
        await CurrentUserService.InitializeAsync(data.Token!);
        if (AuthStateProvider is CustomAuthStateProvider provider) provider.NotifyUserLogin(data.Token!);
        Snackbar.Add(Language.T("login.twoFactorSuccess"), Severity.Success);
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private async Task HandleLogin()
    {
        _isProcessing = true;
        try
        {
            var result = await AuthService.Login(_model.UserName, _model.Password);
            if (result.IsSuccess && result.Data != null && result.Data.RequiresTwoFactor)
            {
                _twoFactorPending = true;
                _twoFactorChallenge = result.Data.TwoFactorChallengeToken ?? string.Empty;
                _twoFactorCode = string.Empty;
                if (result.Data.TwoFactorSetupRequired)
                {
                    var setup = await AuthService.SetupTwoFactorAsync(_twoFactorChallenge);
                    if (setup.IsSuccess) _twoFactorSetup = setup.Data;
                    else Snackbar.Add(setup.Message ?? Language.T("message.loadFailed"), Severity.Error);
                }
                else
                {
                    _twoFactorSetup = null;
                    Snackbar.Add(Language.T("login.twoFactorReady"), Severity.Info);
                }
            }
            else if (result.IsSuccess && result.Data != null && !string.IsNullOrWhiteSpace(result.Data.Token))
            {
                await CompleteLoginAsync(result.Data);
            }
            else Snackbar.Add(result.Message ?? Language.T("login.invalidCredentials"), Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[{Component}] Login failed", ComponentName);
            Snackbar.Add(Language.T("login.connectFailed"), Severity.Error);
        }
        finally { _isProcessing = false; }
    }
}
