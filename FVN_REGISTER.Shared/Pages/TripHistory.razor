@page "/trip/history"
@attribute [Authorize]
@namespace FVN_REGISTER.Shared.Pages
@using FVN_REGISTER.Contract.Dtos.Trips
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.Trips
@using Microsoft.AspNetCore.Authorization
@inject ITripClientService TripService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inherits AppComponentBase

<PageTitle>@Language.T("nav.tripHistory")</PageTitle>

<MudStack Spacing="2">
    <MudPaper Class="pa-3" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Class="mr-2" />
                    @Language.T("trip.history")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Language.T("trip.theoDoiCacDangKy")
                </MudText>
            </div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Href="/trip/create">
                @Language.T("trip.create")
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        </MudPaper>
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            @Language.T("trip.chuaCoDangKyCong")
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-2" Elevation="1">
            <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@Language.T("common.maDon")</MudTh>
                    <MudTh>@Language.T("common.thoiGian")</MudTh>
                    <MudTh>@Language.T("trip.diaDiem")</MudTh>
                    <MudTh>@Language.T("trip.khachHangDoiTac")</MudTh>
                    <MudTh>@Language.T("common.chiPhi")</MudTh>
                    <MudTh>@Language.T("common.status")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel='@Language.T("common.maDon")'>
                        <MudText Typo="Typo.body2">@context.TripCode</MudText>
                    </MudTd>
                    <MudTd DataLabel='@Language.T("common.thoiGian")'>
                        @context.StartDate.ToString("dd/MM/yyyy")
                        <span>→</span>
                        @context.EndDate.ToString("dd/MM/yyyy")
                    </MudTd>
                    <MudTd DataLabel='@Language.T("trip.diaDiem")'>@context.Destination</MudTd>
                    <MudTd DataLabel='@Language.T("trip.khachHangDoiTac")'>@(context.CustomerOrPartner ?? "—")</MudTd>
                    <MudTd DataLabel='@Language.T("common.chiPhi")'>
                        @(context.EstimatedCost.HasValue ? context.EstimatedCost.Value.ToString("N0") + " ₫" : "—")
                    </MudTd>
                    <MudTd DataLabel='@Language.T("common.status")'>
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.RequestStatus)" Label="true">
                            @GetStatusText(context.RequestStatus)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @if (context.RequestStatus == ApprovalStatus.Draft || context.RequestStatus == ApprovalStatus.NeedsRevision)
                        {
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => Submit(context))">
                                @Language.T("common.guiDuyet")
                            </MudButton>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary" OnClick="@(() => View(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">@Language.T("common.khongCoDuLieu")</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private readonly List<TripRequestDto> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await TripService.GetMineAsync();
            _items.Clear();
            if (result.IsSuccess && result.Data != null)
                _items.AddRange(result.Data ?? new List<TripRequestDto>());
            else if (!result.IsSuccess)
                Snackbar.Add(result.Message ?? Language.T("trip.khongTheTaiLichSu"), Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Submit(TripRequestDto item)
    {
        if (_loading) return;

        _loading = true;
        try
        {
            var result = await TripService.SubmitAsync(item.Id);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("trip.khongTheGuiDangKy"), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("trip.daGuiDangKyCong"), Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void View(TripRequestDto item)
        => Navigation.NavigateTo($"/trip/{item.Id}");

    private static Color GetStatusColor(ApprovalStatus status) => status switch
    {
        ApprovalStatus.Approved => Color.Success,
        ApprovalStatus.Rejected => Color.Error,
        ApprovalStatus.Cancelled => Color.Default,
        ApprovalStatus.InProgress => Color.Info,
        ApprovalStatus.NeedsRevision => Color.Warning,
        ApprovalStatus.Draft => Color.Default,
        _ => Color.Warning
    };

    private string GetStatusText(ApprovalStatus status) => status switch
    {
        ApprovalStatus.Approved => Language.T("leave.statusApproved"),
        ApprovalStatus.Rejected => Language.T("common.reject"),
        ApprovalStatus.Cancelled => Language.T("leave.statusCancelled"),
        ApprovalStatus.InProgress => Language.T("leave.statusInProgress"),
        ApprovalStatus.NeedsRevision => Language.T("trip.canChinhSua"),
        ApprovalStatus.Draft => Language.T("leave.statusDraft"),
        _ => Language.T("leave.statusPending")
    };
}
