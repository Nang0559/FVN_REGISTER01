@page "/approvals"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Components.OT
@using FVN_REGISTER.Shared.Dialogs.Approvals
@using FVN_REGISTER.Shared.Dialogs
@using FVN_REGISTER.Shared.Services.Approvals
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IApprovalListClientService ApprovalService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@Language.T("approval.title")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">@Language.T("approval.danhSachChoPheDuyet")</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @Language.T("approval.tongDonNghiPhepOt", _allItems.Count(), _allItems.Count(x => x.Kind == RequestModule.Leave), _allItems.Count(x => x.Kind == RequestModule.Overtime), _allItems.Count(x => x.Kind == RequestModule.Trip))
            @if (_loadedAt.HasValue) { <span> — @_loadedAt.Value.ToString("HH:mm:ss")</span> }
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_search" Placeholder="@Language.T("common.timTenMaNv")" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Style="min-width:220px" />
        <MudSelect T="RequestModule?" @bind-Value="_kindFilter" Label="@Language.T("approval.loaiDon")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Leave)">@Language.T("nav.reportLeave")</MudSelectItem>
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Overtime)">@Language.T("nav.reportOt")</MudSelectItem>
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Trip)">@Language.T("trip.title")</MudSelectItem>
        </MudSelect>
        <MudSwitch @bind-Value="_onlyCanApprove" Color="Color.Primary" Label='@Language.T("access.pending")' Size="Size.Small" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading">@Language.T("common.refresh")</MudButton>
    </MudStack>
</MudStack>

@if (_selectedItems.Count > 0)
{
    <MudPaper Elevation="3" Class="pa-3 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText>@Language.T("approval.daChon") <b>@_selectedItems.Count</b> @Language.T("approval.don")</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="OnBatchApprove" Disabled="_processing">@Language.T("common.approve")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="OpenBatchRejectDialog" Disabled="_processing">@Language.T("common.reject")</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _selectedItems.Clear())">@Language.T("approval.boChon")</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}

<MudPaper Elevation="2">
    <MudTable Items="FilteredItems" @bind-SelectedItems="_selectedItems" MultiSelection="true" Hover="true" Dense="true"
              Breakpoint="Breakpoint.Sm" T="PendingApprovalItemDto" Loading="_loading">
        <HeaderContent>
            <MudTh>@Language.T("ot.employee")</MudTh><MudTh>@Language.T("approval.loaiDon")</MudTh><MudTh>@Language.T("common.thoiGian")</MudTh><MudTh>@Language.T("common.soLuong")</MudTh>
            <MudTh>@Language.T("common.tienTrinh")</MudTh><MudTh>@Language.T("approval.capCho")</MudTh><MudTh>@Language.T("security.actions")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel='@Language.T("common.employee")'>
                <MudStack Spacing="0"><MudText Typo="Typo.body2"><b>@context.EmployeeName</b></MudText><MudText Typo="Typo.caption">@context.EmployeeCode — @context.DeptName</MudText></MudStack>
            </MudTd>
            <MudTd DataLabel='@Language.T("common.type")'>
                <MudChip T="string" Size="Size.Small" Color="@GetKindColor(context.Kind)">@GetKindDisplay(context.Kind)</MudChip>
            </MudTd>
            <MudTd DataLabel='@Language.T("common.thoiGian")'>
                @if (context.FromDate.HasValue)
                {
                    <MudText Typo="Typo.body2">@context.FromDate.Value.ToString("dd/MM/yyyy")</MudText>
                    @if (context.ToDate.HasValue && context.ToDate.Value.Date != context.FromDate.Value.Date)
                    { <MudText Typo="Typo.caption">→ @context.ToDate.Value.ToString("dd/MM/yyyy")</MudText> }
                }
                <MudText Typo="Typo.caption">@Language.T("approval.gui", context.SubmittedAt?.ToString("dd/MM HH:mm") ?? "—")</MudText>
            </MudTd>
            <MudTd DataLabel='@Language.T("common.soLuong")'><b>@context.TotalUnits.ToString("N1")</b> @GetUnitLabel(context.Kind)</MudTd>
            <MudTd DataLabel='@Language.T("common.tienTrinh")'><OTApprovalProgressBar Steps="@context.ApprovalSteps" /></MudTd>
            <MudTd DataLabel='@Language.T("approval.capCho")'>
                @if (GetCurrentApprovalLevel(context) > 0)
                { <span>@Language.T("approval.levelN", GetCurrentApprovalLevel(context))@if (!string.IsNullOrWhiteSpace(GetCurrentApproverName(context))){ <span> — @GetCurrentApproverName(context)</span> }</span> }
                else { <span>—</span> }
            </MudTd>
            <MudTd DataLabel='@Language.T("common.action")'>
                @if (context.CanApprove)
                {
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => OnApproveSingle(context))" Disabled="_processing" />
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnRejectSingle(context))" Disabled="_processing" />
                    </MudStack>
                }
                else { <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" /> }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-6" Color="Color.Secondary">@Language.T("approval.khongCoDonNaoCho")</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private bool _loading;
    private bool _processing;
    private DateTime? _loadedAt;
    private string _search = string.Empty;
    private RequestModule? _kindFilter;
    private bool _onlyCanApprove;
    private List<PendingApprovalGroupDto> _groups = new();
    private HashSet<PendingApprovalItemDto> _selectedItems = new();
    private readonly CancellationTokenSource _cts = new();

    private IEnumerable<PendingApprovalItemDto> _allItems => _groups.SelectMany(x => x.Requests);

    private IEnumerable<PendingApprovalItemDto> FilteredItems => _allItems.Where(x =>
        (!_kindFilter.HasValue || x.Kind == _kindFilter.Value) &&
        (!_onlyCanApprove || x.CanApprove) &&
        (string.IsNullOrWhiteSpace(_search) ||
         x.EmployeeName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         x.EmployeeCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         x.DeptName.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _selectedItems.Clear();
        try
        {
            var result = await ApprovalService.GetPendingAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null)
            {
                _groups = result.Data;
                _loadedAt = DateTime.Now;
            }
            else Snackbar.Add(result.Message ?? Language.T("common.loiTaiDuLieu2"), Severity.Error);
        }
        catch (Exception ex) { Logger.LogError(ex, "[APPROVAL] Load error"); Snackbar.Add(Language.T("common.loiTaiDuLieu2"), Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OnApproveSingle(PendingApprovalItemDto item) => await ApproveItems(new[] { item });

    private async Task OnBatchApprove()
    {
        var items = _selectedItems.Where(x => x.CanApprove).ToList();
        if (items.Count == 0) { Snackbar.Add(Language.T("approval.khongCoDonCoQuyen"), Severity.Warning); return; }
        await ApproveItems(items);
    }

    private async Task ApproveItems(IEnumerable<PendingApprovalItemDto> items)
    {
        _processing = true;
        try
        {
            foreach (var group in items.GroupBy(x => new { x.Kind, Level = GetCurrentApprovalLevel(x) }))
            {
                var r = await ApprovalService.ApproveAsync(group.Select(x => x.RequestId).ToList(), group.Key.Kind, group.Key.Level, null, _cts.Token);
                if (!r.IsSuccess) Snackbar.Add(r.Message ?? Language.T("approval.loiPheDuyet"), Severity.Error);
            }
            await LoadAsync();
        }
        finally { _processing = false; }
    }

    private async Task OnRejectSingle(PendingApprovalItemDto item) => await RejectItems(new[] { item }, false);

    private async Task OpenBatchRejectDialog()
    {
        var items = _selectedItems.Where(x => x.CanApprove).ToList();
        if (items.Count == 0) { Snackbar.Add(Language.T("approval.khongCoDonCoQuyen2"), Severity.Warning); return; }
        await RejectItems(items, true);
    }

    private async Task RejectItems(IEnumerable<PendingApprovalItemDto> items, bool batch)
    {
        var list = items.ToList();
        var parameters = new DialogParameters { [nameof(RejectDialog.Items)] = list, [nameof(RejectDialog.IsBatchMode)] = batch };
        var dialog = await DialogService.ShowAsync<RejectDialog>(batch ? Language.T("approval.tuChoiDon", list.Count) : Language.T("common.tuChoiDon"), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result?.Canceled == true) return;
        var comment = result?.Data as string ?? string.Empty;
        if (string.IsNullOrWhiteSpace(comment)) return;

        _processing = true;
        try
        {
            foreach (var group in list.GroupBy(x => new { x.Kind, Level = GetCurrentApprovalLevel(x) }))
            {
                var r = await ApprovalService.RejectAsync(group.Select(x => x.RequestId).ToList(), group.Key.Kind, group.Key.Level, comment, _cts.Token);
                if (!r.IsSuccess) Snackbar.Add(r.Message ?? Language.T("approval.loiTuChoi"), Severity.Error);
            }
            await LoadAsync();
        }
        finally { _processing = false; }
    }

    private static int GetCurrentApprovalLevel(PendingApprovalItemDto item) =>
        item.ApprovalSteps
            .OrderBy(x => x.Level)
            .FirstOrDefault(x => x.IsRequired && x.IsApproved == null)?.Level ?? 0;

    private static string? GetCurrentApproverName(PendingApprovalItemDto item)
    {
        var level = GetCurrentApprovalLevel(item);
        return level <= 0
            ? null
            : item.ApprovalSteps.FirstOrDefault(x => x.Level == level)?.ApproverName;
    }

    private string GetUnitLabel(RequestModule kind) => kind switch
    {
        RequestModule.Overtime => Language.T("calendar.hours"),
        RequestModule.Trip => Language.T("dashboard.days"),
        _ => Language.T("dashboard.days")
    };

    private static Color GetKindColor(RequestModule kind) => kind switch
    {
        RequestModule.Overtime => Color.Warning,
        RequestModule.Trip => Color.Success,
        _ => Color.Info
    };

    private string GetKindDisplay(RequestModule kind) => kind switch
    {
        RequestModule.Overtime => "OT",
        RequestModule.Trip => Language.T("dashboard.tripType"),
        RequestModule.Leave => Language.T("dashboard.leaveType"),
        _ => kind.ToString()
    };

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}
