@page "/approvals"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Components.OT
@using FVN_REGISTER.Shared.Dialogs.Approvals
@using FVN_REGISTER.Shared.Dialogs
@using FVN_REGISTER.Shared.Services.Approvals
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IApprovalListClientService ApprovalService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Phê duyệt</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">Danh sách chờ phê duyệt</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Tổng @_allItems.Count() đơn — Nghỉ phép @_allItems.Count(x => x.Kind == RequestModule.Leave) — OT @_allItems.Count(x => x.Kind == RequestModule.Overtime) — Công tác @_allItems.Count(x => x.Kind == RequestModule.Trip)
            @if (_loadedAt.HasValue) { <span> — @_loadedAt.Value.ToString("HH:mm:ss")</span> }
        </MudText>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_search" Placeholder="Tìm tên / mã NV..." Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Style="min-width:220px" />
        <MudSelect T="RequestModule?" @bind-Value="_kindFilter" Label="Loại đơn" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Leave)">Nghỉ phép</MudSelectItem>
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Overtime)">OT</MudSelectItem>
            <MudSelectItem T="RequestModule?" Value="@((RequestModule?)RequestModule.Trip)">Công tác</MudSelectItem>
        </MudSelect>
        <MudSwitch @bind-Value="_onlyCanApprove" Color="Color.Primary" Label="Chờ tôi duyệt" Size="Size.Small" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading">Làm mới</MudButton>
    </MudStack>
</MudStack>

@if (_selectedItems.Count > 0)
{
    <MudPaper Elevation="3" Class="pa-3 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText>Đã chọn <b>@_selectedItems.Count</b> đơn</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="OnBatchApprove" Disabled="_processing">Duyệt</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="OpenBatchRejectDialog" Disabled="_processing">Từ chối</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _selectedItems.Clear())">Bỏ chọn</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}

<MudPaper Elevation="2">
    <MudTable Items="FilteredItems" @bind-SelectedItems="_selectedItems" MultiSelection="true" Hover="true" Dense="true"
              Breakpoint="Breakpoint.Sm" T="PendingApprovalItemDto" Loading="_loading">
        <HeaderContent>
            <MudTh>Nhân viên</MudTh><MudTh>Loại đơn</MudTh><MudTh>Thời gian</MudTh><MudTh>Số lượng</MudTh>
            <MudTh>Tiến trình</MudTh><MudTh>Cấp chờ</MudTh><MudTh>Thao tác</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nhân viên">
                <MudStack Spacing="0"><MudText Typo="Typo.body2"><b>@context.EmployeeName</b></MudText><MudText Typo="Typo.caption">@context.EmployeeCode — @context.DeptName</MudText></MudStack>
            </MudTd>
            <MudTd DataLabel="Loại">
                <MudChip T="string" Size="Size.Small" Color="@GetKindColor(context.Kind)">@GetKindDisplay(context.Kind)</MudChip>
            </MudTd>
            <MudTd DataLabel="Thời gian">
                @if (context.FromDate.HasValue)
                {
                    <MudText Typo="Typo.body2">@context.FromDate.Value.ToString("dd/MM/yyyy")</MudText>
                    @if (context.ToDate.HasValue && context.ToDate.Value.Date != context.FromDate.Value.Date)
                    { <MudText Typo="Typo.caption">→ @context.ToDate.Value.ToString("dd/MM/yyyy")</MudText> }
                }
                <MudText Typo="Typo.caption">Gửi: @(context.SubmittedAt?.ToString("dd/MM HH:mm") ?? "—")</MudText>
            </MudTd>
            <MudTd DataLabel="Số lượng"><b>@context.TotalUnits.ToString("N1")</b> @GetUnitLabel(context.Kind)</MudTd>
            <MudTd DataLabel="Tiến trình"><OTApprovalProgressBar Steps="@context.ApprovalSteps" /></MudTd>
            <MudTd DataLabel="Cấp chờ">
                @if (GetCurrentApprovalLevel(context) > 0)
                { <span>Cấp @GetCurrentApprovalLevel(context)@if (!string.IsNullOrWhiteSpace(GetCurrentApproverName(context))){ <span> — @GetCurrentApproverName(context)</span> }</span> }
                else { <span>—</span> }
            </MudTd>
            <MudTd DataLabel="Thao tác">
                @if (context.CanApprove)
                {
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => OnApproveSingle(context))" Disabled="_processing" />
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnRejectSingle(context))" Disabled="_processing" />
                    </MudStack>
                }
                else { <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" /> }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-6" Color="Color.Secondary">Không có đơn nào chờ phê duyệt.</MudText></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }" /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private bool _loading;
    private bool _processing;
    private DateTime? _loadedAt;
    private string _search = string.Empty;
    private RequestModule? _kindFilter;
    private bool _onlyCanApprove;
    private List<PendingApprovalGroupDto> _groups = new();
    private HashSet<PendingApprovalItemDto> _selectedItems = new();
    private readonly CancellationTokenSource _cts = new();

    private IEnumerable<PendingApprovalItemDto> _allItems => _groups.SelectMany(x => x.Requests);

    private IEnumerable<PendingApprovalItemDto> FilteredItems => _allItems.Where(x =>
        (!_kindFilter.HasValue || x.Kind == _kindFilter.Value) &&
        (!_onlyCanApprove || x.CanApprove) &&
        (string.IsNullOrWhiteSpace(_search) ||
         x.EmployeeName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         x.EmployeeCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         x.DeptName.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _selectedItems.Clear();
        try
        {
            var result = await ApprovalService.GetPendingAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null)
            {
                _groups = result.Data;
                _loadedAt = DateTime.Now;
            }
            else Snackbar.Add(result.Message ?? "Lỗi tải dữ liệu", Severity.Error);
        }
        catch (Exception ex) { Logger.LogError(ex, "[APPROVAL] Load error"); Snackbar.Add("Lỗi tải dữ liệu", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OnApproveSingle(PendingApprovalItemDto item) => await ApproveItems(new[] { item });

    private async Task OnBatchApprove()
    {
        var items = _selectedItems.Where(x => x.CanApprove).ToList();
        if (items.Count == 0) { Snackbar.Add("Không có đơn có quyền phê duyệt.", Severity.Warning); return; }
        await ApproveItems(items);
    }

    private async Task ApproveItems(IEnumerable<PendingApprovalItemDto> items)
    {
        _processing = true;
        try
        {
            foreach (var group in items.GroupBy(x => new { x.Kind, Level = GetCurrentApprovalLevel(x) }))
            {
                var r = await ApprovalService.ApproveAsync(group.Select(x => x.RequestId).ToList(), group.Key.Kind, group.Key.Level, null, _cts.Token);
                if (!r.IsSuccess) Snackbar.Add(r.Message ?? "Lỗi phê duyệt", Severity.Error);
            }
            await LoadAsync();
        }
        finally { _processing = false; }
    }

    private async Task OnRejectSingle(PendingApprovalItemDto item) => await RejectItems(new[] { item }, false);

    private async Task OpenBatchRejectDialog()
    {
        var items = _selectedItems.Where(x => x.CanApprove).ToList();
        if (items.Count == 0) { Snackbar.Add("Không có đơn có quyền từ chối.", Severity.Warning); return; }
        await RejectItems(items, true);
    }

    private async Task RejectItems(IEnumerable<PendingApprovalItemDto> items, bool batch)
    {
        var list = items.ToList();
        var parameters = new DialogParameters { [nameof(RejectDialog.Items)] = list, [nameof(RejectDialog.IsBatchMode)] = batch };
        var dialog = await DialogService.ShowAsync<RejectDialog>(batch ? $"Từ chối {list.Count} đơn" : "Từ chối đơn", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result?.Canceled == true) return;
        var comment = result?.Data as string ?? string.Empty;
        if (string.IsNullOrWhiteSpace(comment)) return;

        _processing = true;
        try
        {
            foreach (var group in list.GroupBy(x => new { x.Kind, Level = GetCurrentApprovalLevel(x) }))
            {
                var r = await ApprovalService.RejectAsync(group.Select(x => x.RequestId).ToList(), group.Key.Kind, group.Key.Level, comment, _cts.Token);
                if (!r.IsSuccess) Snackbar.Add(r.Message ?? "Lỗi từ chối", Severity.Error);
            }
            await LoadAsync();
        }
        finally { _processing = false; }
    }

    private static int GetCurrentApprovalLevel(PendingApprovalItemDto item) =>
        item.ApprovalSteps
            .OrderBy(x => x.Level)
            .FirstOrDefault(x => x.IsRequired && x.IsApproved == null)?.Level ?? 0;

    private static string? GetCurrentApproverName(PendingApprovalItemDto item)
    {
        var level = GetCurrentApprovalLevel(item);
        return level <= 0
            ? null
            : item.ApprovalSteps.FirstOrDefault(x => x.Level == level)?.ApproverName;
    }

    private static string GetUnitLabel(RequestModule kind) => kind switch
    {
        RequestModule.Overtime => "giờ",
        RequestModule.Trip => "ngày",
        _ => "ngày"
    };

    private static Color GetKindColor(RequestModule kind) => kind switch
    {
        RequestModule.Overtime => Color.Warning,
        RequestModule.Trip => Color.Success,
        _ => Color.Info
    };

    private static string GetKindDisplay(RequestModule kind) => kind switch
    {
        RequestModule.Overtime => "OT",
        RequestModule.Trip => "Công tác",
        RequestModule.Leave => "Nghỉ phép",
        _ => kind.ToString()
    };

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}
