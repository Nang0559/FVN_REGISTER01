@page "/equipment/handover"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<PageTitle>@Language.T("equipment.handover")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Outlined="true" Class="pa-6">
        <MudText Typo="Typo.h5">@Language.T("equipment.banGiaoThietBiDa")</MudText>
        <MudText Class="mt-3">
            @Language.T("equipment.thayDoiNguoiPhuTrach")
        </MudText>
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => Navigation.NavigateTo("/security/access-change"))">
            @Language.T("equipment.moPhieuThayDoiQuyen")
        </MudButton>
    </MudPaper>
</MudContainer>
