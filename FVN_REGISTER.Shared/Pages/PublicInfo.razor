@page "/thong-tin-cong-khai"
@page "/public-information"
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Dtos.PublicForms
@using FVN_REGISTER.Contract.Dtos.PublicInformation
@using Microsoft.JSInterop
@using FVN_REGISTER.Shared.Handlers
@inherits AppComponentBase
@inject IHttpClientWithAuth Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>@Language.T("nav.publicInformation")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800">@Language.T("nav.publicInformation")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("public.thongBaoQuyDinhVa")</MudText>
        </div>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @if (_caps.CanRegister)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Assignment"
                           OnClick="GoRegistration">
                    @Language.T("public.dangKyThongTin")
                </MudButton>
            }
            @if (_caps.CanManageInformation)
            {
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Campaign"
                           OnClick="GoManageInformation">
                    @Language.T("public.quanLyNoiDungCong")
                </MudButton>
            }
            @if (_caps.CanManageForms)
            {
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.EditNote"
                           OnClick="GoManageForms">
                    @Language.T("nav.publicFormsManage")
                </MudButton>
            }
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
        <MudSkeleton Height="120px" Class="mb-3" />
        <MudSkeleton Height="120px" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Warning">@_error</MudAlert>
    }
    else if (_items.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Class="mt-3">@Language.T("public.hienChuaCoThongTin")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("public.cacThongBaoHoacQuy")</MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var item in _items)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="h-100" Style="border-radius:18px">
                        <MudCardContent Class="pa-5">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                                <MudChip T="string" Size="Size.Small" Color="@(item.IsImportant ? Color.Error : Color.Primary)">@GetTypeName(item.Type)</MudChip>
                                @if (item.IsImportant)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Language.T("public.quanTrong")</MudChip>
                                }
                                <MudSpacer />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.PublishedAt?.ToString("dd/MM/yyyy HH:mm")</MudText>
                            </MudStack>
                            <MudText Typo="Typo.h6" Style="font-weight:750">@item.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">@item.Summary</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Content))
                            {
                                <MudText Typo="Typo.body2" Class="mt-4" Style="white-space:pre-line">@item.Content</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.AttachmentUrl))
                            {
                                <MudButton Href="@item.AttachmentUrl" Target="_blank" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AttachFile" Class="mt-3">@Language.T("public.xemTaiLieu")</MudButton>
                            }
                            @if (item.Attachments.Count > 0)
                            {
                                <MudStack Spacing="1" Class="mt-3">
                                    @foreach (var file in item.Attachments)
                                    {
                                        var itemId = item.Id; var attachment = file;
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@AttachmentIcon(attachment)"
                                                   Style="justify-content:flex-start;text-transform:none"
                                                   OnClick="@(() => DownloadAsync(itemId, attachment))">
                                            @attachment.FileName
                                        </MudButton>
                                    }
                                </MudStack>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private readonly List<PublicInformationDto> _items = new();
    private PublicCapabilitiesDto _caps = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadCapabilitiesAsync();
            // Same DTO the API returns: no private copy to drift out of sync (Id is int, flag is IsImportant...).
            var result = await Http.GetAsync<List<PublicInformationDto>>("api/public-information");
            if (!result.IsSuccess)
            {
                _error = result.Message ?? Language.T("public.khongTheTaiThongTin");
                return;
            }

            _items.AddRange(result.Data ?? new());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[PUBLIC-INFO] Load error");
            _error = Language.T("public.khongTheKetNoiDen");
        }
        finally { _loading = false; }
    }

    // Operators assigned in Admin/Security are NOT part of the RBAC snapshot, so ask the API what this user may do.
    private async Task LoadCapabilitiesAsync()
    {
        var info = await Http.GetAsync<PublicCapabilitiesDto>("api/public-information/capabilities", showLoading: false);
        var forms = await Http.GetAsync<PublicCapabilitiesDto>("api/public-forms/capabilities", showLoading: false);
        _caps = new PublicCapabilitiesDto
        {
            CanManageInformation = info.IsSuccess && info.Data?.CanManageInformation == true,
            CanRegister = forms.IsSuccess && forms.Data?.CanRegister == true,
            CanManageForms = forms.IsSuccess && forms.Data?.CanManageForms == true,
            CanViewResults = forms.IsSuccess && forms.Data?.CanViewResults == true
        };
    }

    private void GoManageInformation() => Navigation.NavigateTo("/admin/public-information");
    private void GoManageForms() => Navigation.NavigateTo("/admin/public-forms");

    private void GoRegistration()
    {
        // Public Information and Public Registration Forms remain separate modules.
        // The public-information page is only the entry point; submissions are stored
        // by the Public Forms module, not in F03PublicInformation.
        Navigation.NavigateTo("/public-forms");
    }

    // Keep in sync with the type list in Admin/PublicInformation.razor.
    private string GetTypeName(string? type) => type switch
    {
        "News" => Language.T("public.tinTuc"),
        "HRContent" => Language.T("public.noiDungHr"),
        "CompanyInfo" => Language.T("public.thongTinCongTy"),
        "PublicContent" => Language.T("public.noiDungDuocCongKhai"),
        _ => Language.T("common.thongBao")
    };

    private static string AttachmentIcon(AttachmentDto file) => (file.FileExtension ?? string.Empty).ToLowerInvariant() switch
    {
        ".pdf" => Icons.Material.Filled.PictureAsPdf,
        ".jpg" or ".jpeg" or ".png" => Icons.Material.Filled.Image,
        _ => Icons.Material.Filled.AttachFile
    };

    private async Task DownloadAsync(int itemId, AttachmentDto file)
    {
        var response = await Http.GetFileAsync($"api/public-information/{itemId}/attachments/{file.FileId}");
        if (!response.IsSuccess || response.Data == null)
        {
            Snackbar.Add(response.Message ?? Language.T("public.taiFileThatBai"), Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("fvnFileDownload.downloadBase64", file.FileName, "application/octet-stream", Convert.ToBase64String(response.Data));
    }
}
