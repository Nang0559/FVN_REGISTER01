@* FVN_REGISTER.Shared/Pages/Admin/EmailTemplates.razor *@
@page "/admin/email-templates"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Contract.Dtos.EmailTemplates
@using FVN_REGISTER.Shared.Services.Emails
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Shared.Utils.Helpers
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Contract.Dtos.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inherits AppComponentBase
@implements IDisposable

@inject IEmailTemplateClientService TemplateService
@inject ICurrentUserClientService CurrentUser
@inject ISecurityClientService SecurityService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý Email Template</PageTitle>

@* ── Kiểm tra quyền ── *@
@if (!CanManage)
{
    <MudAlert Severity="Severity.Error">Bạn không có quyền truy cập trang này.</MudAlert>
    return;
}

@* ── Quill CSS + JS (load 1 lần) ── *@
<style>
    .ql-editor {
        min-height: 320px;
        font-family: inherit;
        font-size: 14px;
    }
    .ql-toolbar.ql-snow {
        border-radius: 4px 4px 0 0;
        border-color: rgba(0,0,0,0.23);
        background: var(--mud-palette-background-grey, #f5f5f5);
    }
    .ql-container.ql-snow {
        border-radius: 0 0 4px 4px;
        border-color: rgba(0,0,0,0.23);
    }
    .ql-container.ql-snow:focus-within {
        border-color: var(--mud-palette-primary);
        box-shadow: 0 0 0 1px var(--mud-palette-primary);
    }
    /* Variable chip nằm trong alert */
    .var-chip {
        cursor: pointer;
        font-family: monospace;
        font-size: 12px;
        margin: 2px;
        padding: 2px 8px;
        border: 1px solid var(--mud-palette-primary);
        border-radius: 12px;
        color: var(--mud-palette-primary);
        display: inline-block;
        transition: background 0.2s;
    }
    .var-chip:hover {
        background: var(--mud-palette-primary);
        color: white;
    }
    /* Preview iframe */
    .email-preview-frame {
        width: 100%;
        min-height: 400px;
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 4px;
    }
</style>

@* ── Header ── *@
<MudStack Row="true" AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" />
            Quản lý Email Template
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Cấu hình nội dung email thông báo hệ thống
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => OpenEditor(null))">
        Thêm template
    </MudButton>
</MudStack>

@* ── Table ── *@
@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="2">
        <MudTable Items="_templates" Dense="true" Hover="true"
                  Filter="FilterFunc" @ref="_table">
            <ToolBarContent>
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Tìm theo Code hoặc Subject..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<EmailTemplateDto,object>(x=>x.Code)">Code</MudTableSortLabel></MudTh>
                <MudTh>Tiêu đề</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<EmailTemplateDto,object>(x=>x.CreatedAt ?? DateTime.MinValue)">Ngày tạo</MudTableSortLabel></MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Label="true">
                        @context.Code
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2">@context.Subject</MudText>
                </MudTd>
                <MudTd>
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Label="true">
                            Đang hoạt động
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Label="true">
                            Vô hiệu hóa
                        </MudChip>
                    }
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.caption">
                        @(context.CreatedAt?.ToString("dd/MM/yyyy") ?? "—")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small" Color="Color.Primary" title="Chỉnh sửa"
                                       OnClick="@(() => OpenEditor(context))" />
                        <MudIconButton
                            Icon="@(context.IsActive
                                ? Icons.Material.Filled.ToggleOff
                                : Icons.Material.Filled.ToggleOn)"
                            Size="Size.Small"
                            Color="@(context.IsActive ? Color.Warning : Color.Success)" title="@(context.IsActive ? "Vô hiệu hóa" : "Kích hoạt")"
                            OnClick="@(() => ToggleTemplate(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small" Color="Color.Info" title="Xem trước"
                                       OnClick="@(() => PreviewTemplate(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small" Color="Color.Default" title="Nhân bản"
                                       OnClick="@(() => DuplicateTemplate(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary" Class="pa-4">Không có template nào.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@* ════════════════════════════════════════════════
   EDITOR DIALOG — FULL RICH EDITOR
   ════════════════════════════════════════════════ *@
<MudDialog @bind-Visible="_showEditor"
           Options="@(new DialogOptions {
               MaxWidth    = MaxWidth.ExtraLarge,
               FullWidth   = true,
               CloseButton = true,
               BackdropClick = false
           })">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.EditNote" Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(_editModel.Id == 0 ? "Thêm template mới" : $"Sửa: {_editModel.Code}")
            </MudText>
            @if (_editModel.Id > 0)
            {
                <MudChip T="string" Size="Size.Small"
                         Color="@(_editModel.IsActive ? Color.Success : Color.Default)"
                         Label="true">
                    @(_editModel.IsActive ? "Đang hoạt động" : "Vô hiệu hóa")
                </MudChip>
            }
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudGrid>
            @* ── Row 1: Code + Subject + Switch ── *@
            <MudItem xs="12" sm="3">
                <MudTextField Label="Mã template (*)"
                              @bind-Value="_editModel.Code"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="@(_editModel.Id > 0)"
                              HelperText="VD: LEAVE_APPROVAL_REQUEST"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Code"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" sm="7">
                <MudTextField Label="Tiêu đề email (*)"
                              @bind-Value="_editModel.Subject"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="Hỗ trợ {{VariableName}} — VD: Đơn nghỉ phép của {{EmployeeName}}"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Title"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudSwitch @bind-Value="_editModel.IsActive"
                           Color="Color.Success"
                           Label="Kích hoạt" />
            </MudItem>

            @* ── Row 2: Variable hints ── *@
            @{
                var hints = GetVariableHints(_editModel.Code ?? "");
            }
            @if (hints.Any())
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Class="py-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="0">
                            <MudText Typo="Typo.caption" Class="mr-2">
                                <strong>Biến khả dụng</strong> (click để chèn vào editor):
                            </MudText>
                            @foreach (var h in hints)
                            {
                                <span class="var-chip" @onclick="@(() => InsertVariableToEditor(h))">
                                    &#123;&#123;@h&#125;&#125;
                                </span>
                            }
                        </MudStack>
                    </MudAlert>
                </MudItem>
            }

            @* ── Row 3: Editor tabs ── *@
            <MudItem xs="12">
                <MudTabs @ref="_editorTabs"
                         Elevation="0"
                         Rounded="false"
                         ApplyEffectsToContainer="true"
                         ActivePanelIndexChanged="OnTabChanged" Class="pt-2">

                    @* TAB 1: Rich Editor *@
                    <MudTabPanel Text="Trình soạn thảo"
                                 Icon="@Icons.Material.Filled.FormatColorText"
                                 BadgeColor="Color.Primary">
                        @* Quill toolbar *@
                        <div id="@_toolbarId"
                             style="border:1px solid rgba(0,0,0,0.23);
                                    border-bottom:none;
                                    border-radius:4px 4px 0 0;
                                    background:var(--mud-palette-background-grey,#f5f5f5);
                                    flex-wrap:wrap;">
                            <span class="ql-formats">
                                <select class="ql-header">
                                    <option value="1">Tiêu đề 1</option>
                                    <option value="2">Tiêu đề 2</option>
                                    <option value="3">Tiêu đề 3</option>
                                    <option selected>Thường</option>
                                </select>
                                <select class="ql-font"></select>
                                <select class="ql-size">
                                    <option value="small">Nhỏ</option>
                                    <option selected>Thường</option>
                                    <option value="large">Lớn</option>
                                    <option value="huge">Rất lớn</option>
                                </select>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-bold" title="Đậm"></button>
                                <button class="ql-italic" title="Nghiêng"></button>
                                <button class="ql-underline" title="Gạch chân"></button>
                                <button class="ql-strike" title="Gạch ngang"></button>
                            </span>
                            <span class="ql-formats">
                                <select class="ql-color" title="Màu chữ"></select>
                                <select class="ql-background" title="Màu nền"></select>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-list" value="ordered" title="Danh sách có số"></button>
                                <button class="ql-list" value="bullet" title="Danh sách dấu chấm"></button>
                                <button class="ql-indent" value="-1" title="Giảm thụt lề"></button>
                                <button class="ql-indent" value="+1" title="Tăng thụt lề"></button>
                            </span>
                            <span class="ql-formats">
                                <select class="ql-align" title="Căn lề"></select>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-link" title="Chèn link"></button>
                                <button class="ql-image" title="Chèn hình"></button>
                                <button class="ql-blockquote" title="Trích dẫn"></button>
                                <button class="ql-code-block" title="Khối code"></button>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-script" value="sub" title="Chỉ số dưới"></button>
                                <button class="ql-script" value="super" title="Chỉ số trên"></button>
                            </span>
                            <span class="ql-formats">
                                <button class="ql-clean" title="Xóa định dạng"></button>
                            </span>
                        </div>
                        @* Quill editor area *@
                        <div id="@_editorId"
                             style="min-height:320px;
                                    border:1px solid rgba(0,0,0,0.23);
                                    border-radius:0 0 4px 4px;">
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            💡 Tip: Chọn text rồi click biến ở trên để chèn nhanh. Hoặc gõ thẳng {{TênBiến}} vào editor.
                        </MudText>
                    </MudTabPanel>

                    @* TAB 2: HTML thuần *@
                    <MudTabPanel Text="HTML / CSS"
                                 Icon="@Icons.Material.Filled.Code">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                            Chỉnh sửa trực tiếp HTML + inline CSS. Thay đổi ở đây sẽ đồng bộ sang editor.
                        </MudText>
                        <div style="position:relative;">
                            <MudTextField @bind-Value="_editModel.Body"
                                          Lines="22"
                                          FullWidth="true"
                                          Variant="Variant.Outlined"
                                          Style="font-family: 'Consolas', 'Monaco', monospace;
                                                 font-size: 12px;
                                                 line-height: 1.5;"
                                          Immediate="true"
                                          OnBlur="OnHtmlBlur" />
                        </div>
                        <MudStack Row="true" Class="mt-2" Spacing="2">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.FormatIndentIncrease"
                                       OnClick="FormatHtml">
                                Format HTML
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                                       OnClick="InsertEmailBoilerplate">
                                Chèn khung email chuẩn
                            </MudButton>
                        </MudStack>
                    </MudTabPanel>

                    @* TAB 3: Preview *@
                    <MudTabPanel Text="Xem trước"
                                 Icon="@Icons.Material.Filled.Visibility">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            Preview email với dữ liệu mẫu (biến được thay bằng giá trị mô phỏng).
                        </MudText>

                        @* Subject preview *@
                        <MudPaper Elevation="0" Class="pa-2 mb-3"
                                  Style="background:var(--mud-palette-background-grey);
                                         border-radius:4px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Subject"
                                         Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">
                                    <strong>Tiêu đề:</strong>
                                    @ReplacePreviewVars(_editModel.Subject ?? "")
                                </MudText>
                            </MudStack>
                        </MudPaper>

                        @* Body preview inside iframe-like container *@
                        <div style="border:1px solid rgba(0,0,0,0.12);
                                    border-radius:4px;
                                    min-height:400px;
                                    padding:24px;
                                    background:white;
                                    font-family: Arial, sans-serif;
                                    overflow-y:auto;
                                    max-height:500px;">
                            @((MarkupString)ReplacePreviewVars(_editModel.Body ?? "<em style='color:#999'>Chưa có nội dung</em>"))
                        </div>

                        @* Preview vars *@
                        @if (hints.Any())
                        {
                            <MudExpansionPanels Class="mt-2" Elevation="0">
                                <MudExpansionPanel Text="Giá trị mẫu đang dùng để preview" Dense="true">
                                    <MudGrid Spacing="1">
                                        @foreach (var h in hints)
                                        {
                                            <MudItem xs="6" sm="4">
                                                <MudText Typo="Typo.caption">
                                                    <code>{{@h}}</code> → <em>@GetSampleValue(h)</em>
                                                </MudText>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    </MudTabPanel>

                </MudTabs>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseEditor" Variant="Variant.Text">Hủy</MudButton>
        <MudSpacer />
        <MudButton Color="Color.Info" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Visibility"
                   OnClick="GoToPreviewTab">
            Xem trước
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_isSaving"
                   OnClick="SaveTemplate">
            @(_isSaving ? "Đang lưu..." : "Lưu template")
        </MudButton>
    </DialogActions>
</MudDialog>

@* ── Preview standalone Dialog ── *@
<MudDialog @bind-Visible="_showPreview"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" />
            Xem trước: @_previewModel?.Code
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_previewModel != null)
        {
            <MudPaper Elevation="0" Class="pa-2 mb-3"
                      Style="background:var(--mud-palette-background-grey); border-radius:4px;">
                <MudText Typo="Typo.body2">
                    <strong>Tiêu đề:</strong> @_previewModel.Subject
                </MudText>
            </MudPaper>
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px;
                        min-height:300px; padding:24px; background:white;
                        font-family: Arial, sans-serif; overflow-y:auto; max-height:600px;">
                @((MarkupString)(_previewModel.Body ?? "<em>Chưa có nội dung</em>"))
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPreview = false)">Đóng</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => { _showPreview = false; OpenEditor(_previewModel); })">
            Chỉnh sửa
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ── State ──────────────────────────────────────────────────────────
    private List<EmailTemplateDto> _templates = new();
    private EmailTemplateDto _editModel        = new();
    private EmailTemplateDto? _previewModel;
    private MudTable<EmailTemplateDto>? _table;
    private MudTabs? _editorTabs;
    private bool _isLoading   = true;
    private bool CanManage;
    private bool _isSaving;
    private bool _showEditor;
    private bool _showPreview;
    private bool _editorReady;
    private string _searchText = "";
    private readonly CancellationTokenSource _cts = new();

    // Unique ID cho mỗi lần mở editor (tránh conflict nếu mở nhiều lần)
    private string _editorId  = "quill-editor-body";
    private string _toolbarId = "quill-toolbar-main";

    // ── Lifecycle ──────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var permissions = await SecurityService.GetMyPermissionsAsync();
        CanManage = permissions.IsSuccess && permissions.Data?.Has(SecurityFunctionCodes.EmailTemplateManage) == true;
        if (!CanManage) return;
        await LoadTemplates();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Inject Quill CSS + JS dynamically nếu chưa có
            await JS.InvokeVoidAsync("eval", @"
                if (!document.getElementById('quill-css')) {
                    var link = document.createElement('link');
                    link.id   = 'quill-css';
                    link.rel  = 'stylesheet';
                    link.href = 'https://cdn.quilljs.com/1.3.7/quill.snow.css';
                    document.head.appendChild(link);
                }
                if (!document.getElementById('quill-js')) {
                    var script = document.createElement('script');
                    script.id  = 'quill-js';
                    script.src = 'https://cdn.quilljs.com/1.3.7/quill.min.js';
                    document.head.appendChild(script);
                }
            ");
        }

        // Khởi tạo Quill sau khi dialog mở và DOM render xong
        if (_showEditor && !_editorReady)
        {
            await Task.Delay(400); // chờ DOM + Quill JS load
            await InitQuillAsync();
        }

        if (!_showEditor && _editorReady)
        {
            _editorReady = false;
        }
    }

    // ── Quill Init ─────────────────────────────────────────────────────
    private async Task InitQuillAsync()
    {
        try
        {
            var content = _editModel.Body ?? "";
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    try {{
                        // Destroy existing instance
                        var editorEl = document.getElementById('{_editorId}');
                        if (!editorEl) return;
                        editorEl.innerHTML = '';

                        var quill = new Quill('#{_editorId}', {{
                            modules: {{
                                toolbar: '#{_toolbarId}'
                            }},
                            theme: 'snow'
                        }});

                        // Set content
                        var delta = quill.clipboard.convert('{EscapeJs(content)}');
                        quill.setContents(delta, 'silent');

                        // Store globally
                        window['_fvnQuill'] = quill;
                    }} catch(e) {{
                        console.warn('Quill init error:', e);
                    }}
                }})();
            ");
            _editorReady = true;
            Logger.LogInformation("[EMAIL_TPL] Quill initialized");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[EMAIL_TPL] InitQuill error");
        }
    }

    private async Task SyncFromQuillAsync()
    {
        if (!_editorReady) return;
        try
        {
            var html = await JS.InvokeAsync<string>("eval",
                "window['_fvnQuill'] ? window['_fvnQuill'].root.innerHTML : ''");
            if (!string.IsNullOrEmpty(html))
                _editModel.Body = html;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[EMAIL_TPL] SyncFromQuill error");
        }
    }

    private async Task InsertVariableToEditor(string varName)
    {
        var text = $"{{{{{varName}}}}}";
        if (_editorReady)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", $@"
                    (function() {{
                        var q = window['_fvnQuill'];
                        if (!q) return;
                        var range = q.getSelection(true);
                        var idx = range ? range.index : q.getLength();
                        q.insertText(idx, '{text}', 'user');
                        q.setSelection(idx + {text.Length}, 'silent');
                    }})();
                ");
            }
            catch { }
        }
        else
        {
            // Fallback: insert vào text field
            _editModel.Body = (_editModel.Body ?? "") + text;
        }
    }

    // ── Tab events ─────────────────────────────────────────────────────
    private async Task OnTabChanged(int idx)
    {
        // Tab 0 = Rich editor, Tab 1 = HTML, Tab 2 = Preview
        if (idx == 0 && _editorReady)
        {
            // Sync HTML → Quill khi quay lại rich editor
            await Task.Delay(100);
            var content = _editModel.Body ?? "";
            try
            {
                await JS.InvokeVoidAsync("eval", $@"
                    (function() {{
                        var q = window['_fvnQuill'];
                        if (!q) return;
                        var delta = q.clipboard.convert('{EscapeJs(content)}');
                        q.setContents(delta, 'silent');
                    }})();
                ");
            }
            catch { }
        }
        else if (idx == 1 || idx == 2)
        {
            // Sync Quill → HTML khi chuyển sang HTML tab hoặc Preview tab
            await SyncFromQuillAsync();
        }
    }

