    // ── Filter ──────────────────────────────────────────────────────────
    private bool FilterFunc(EmailTemplateDto item) =>
        string.IsNullOrEmpty(_searchText) ||
        (item.Code?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (item.Subject?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false);

    // ── Variable hints ──────────────────────────────────────────────────
    private List<string> GetVariableHints(string code) => code.ToUpper() switch
    {
        var c when c.Contains("LEAVE_APPROVAL_REQUEST") =>
            new() { "EmployeeName", "Role", "StartDate", "EndDate", "TotalDay", "Reason", "LeaveId" },
        var c when c.Contains("LEAVE_APPROVED") =>
            new() { "EmployeeName", "EmployeeCode", "Status", "DateNotify" },
        var c when c.Contains("LEAVE_REJECTED") || c.Contains("LEAVE_REJECT") =>
            new() { "EmployeeName", "EmployeeCode", "Status", "DateNotify", "Reason" },
        var c when c.Contains("LEAVE_REQUEST") =>
            new() { "EmployeeName", "EmployeeCode", "DeptName", "StartDate", "EndDate", "TotalDay", "Reason", "ApprovalUrl" },
        var c when c.Contains("LEAVE_REMINDER") =>
            new() { "LeaveId", "EmployeeCode", "EmployeeName" },
        var c when c.Contains("LEAVE_ESCALATED") =>
            new() { "EmployeeCode", "Level", "TimeoutDays" },
        var c when c.Contains("OT_REQUEST") =>
            new() { "EmployeeName", "OTDate", "StartTime", "EndTime", "TotalHours", "OTType", "Reason" },
        var c when c.Contains("OT_APPROVED") =>
            new() { "EmployeeName", "OTDate", "TotalHours", "ApproverName" },
        _ => new()
    };

    // ── Preview variable replacement ─────────────────────────────────────
    private string ReplacePreviewVars(string text)
    {
        var samples = GetSampleData(_editModel.Code ?? "");
        foreach (var kv in samples)
            text = text.Replace($"{{{{{kv.Key}}}}}", $"<span style='background:#fff3cd;padding:0 2px;border-radius:2px;'>{kv.Value}</span>");
        return text;
    }

    private string GetSampleValue(string varName) =>
        GetSampleData(_editModel.Code ?? "").GetValueOrDefault(varName, $"[{varName}]");

