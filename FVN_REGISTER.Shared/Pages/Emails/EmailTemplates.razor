    // ── Load ────────────────────────────────────────────────────────────
    private async Task LoadTemplates()
    {
        _isLoading = true;
        try
        {
            var result = await TemplateService.GetAllAsync(_cts.Token);
            if (result.IsSuccess && result.Data != null)
                _templates = result.Data;
            else
                Snackbar.Add(result.Message ?? "Lỗi tải template.", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[EMAIL_TPL] Load error");
            Snackbar.Add("Lỗi hệ thống.", Severity.Error);
        }
        finally { _isLoading = false; }
    }

    // ── Editor open/close ───────────────────────────────────────────────
    private void OpenEditor(EmailTemplateDto? item)
    {
        _editorReady = false;
        _editModel = item != null
            ? new EmailTemplateDto
            {
                Id       = item.Id,
                Code     = item.Code,
                Subject  = item.Subject,
                Body     = item.Body,
                IsActive = item.IsActive
            }
            : new EmailTemplateDto { IsActive = true };
        _showEditor = true;
    }

    private async Task CloseEditor()
    {
        await SyncFromQuillAsync(); // optional: không cần save
        _showEditor  = false;
        _editorReady = false;
    }

    // ── Save ────────────────────────────────────────────────────────────
    private async Task SaveTemplate()
    {
        // Sync content từ Quill trước khi lưu
        await SyncFromQuillAsync();

        if (string.IsNullOrWhiteSpace(_editModel.Code))
        { Snackbar.Add("Vui lòng nhập mã template.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_editModel.Subject))
        { Snackbar.Add("Vui lòng nhập tiêu đề.", Severity.Warning); return; }

        _isSaving = true;
        try
        {
            var result = await TemplateService.SaveAsync(_editModel, _cts.Token);
            if (result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? "Đã lưu!", Severity.Success);
                _showEditor  = false;
                _editorReady = false;
                await LoadTemplates();
            }
            else Snackbar.Add(result.Message ?? "Lỗi.", Severity.Error);
        }
        finally { _isSaving = false; }
    }

    // ── Toggle ──────────────────────────────────────────────────────────
    private async Task ToggleTemplate(EmailTemplateDto item)
    {
        var result = await TemplateService.ToggleAsync(item.Id, _cts.Token);
        Snackbar.Add(result.IsSuccess
            ? result.Message ?? "Đã cập nhật."
            : result.Message ?? "Lỗi.",
            result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess) await LoadTemplates();
    }

    // ── Preview ─────────────────────────────────────────────────────────
    private void PreviewTemplate(EmailTemplateDto item)
    {
        _previewModel = item;
        _showPreview  = true;
    }

    // ── Duplicate ───────────────────────────────────────────────────────
    private void DuplicateTemplate(EmailTemplateDto item)
    {
        OpenEditor(new EmailTemplateDto
        {
            Id       = 0,
            Code     = item.Code + "_COPY",
            Subject  = item.Subject,
            Body     = item.Body,
            IsActive = false
        });
    }

