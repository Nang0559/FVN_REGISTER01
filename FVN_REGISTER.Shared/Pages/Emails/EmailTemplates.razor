    // ── JS escape helper ────────────────────────────────────────────────
    private static string EscapeJs(string s) =>
        s.Replace("\\", "\\\\")
         .Replace("'", "\\'")
         .Replace("\r", "\\r")
         .Replace("\n", "\\n");

