@page "/equipment/scan/{Token}"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Equipment
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Shared.Components
@using FVN_REGISTER.Shared.Services.Approvals
@using FVN_REGISTER.Shared.Services.Equipment
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject IEquipmentClientService Equipment
@inject ICurrentUserClientService CurrentUser
@inject IApprovalRouteClientService ApprovalRouteClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_asset == null)
{
    <MudAlert Severity="Severity.Warning">@Language.T("equipment.khongTimThayThietBi2")</MudAlert>
}
else
{
    <MudText Typo="Typo.h5">@_asset.EquipmentName</MudText>
    <MudPaper Class="pa-4 my-3">
        <MudGrid>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.maThietBi")</b> @_asset.EquipmentCode</MudItem>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.maTaiSan2")</b> @_asset.AssetCode</MudItem>
            <MudItem xs="12" md="6"><b>Serial:</b> @_asset.SerialNumber</MudItem>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.boPhan")</b> @_asset.DeptCode</MudItem>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.giaMua")</b> @_asset.PurchasePrice.ToString("N0")</MudItem>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.ngayMua2")</b> @_asset.PurchaseDate.ToString("dd/MM/yyyy")</MudItem>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.khauHao")</b> @_asset.ExpectedDepreciationDate.ToString("dd/MM/yyyy")</MudItem>
            <MudItem xs="12" md="6"><b>@Language.T("equipment.viTri")</b> @_asset.Location</MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h6">@Language.T("equipment.lichSuSuaChuaDa")</MudText>
    <MudTable Items="_asset.RepairHistory" Dense="true" Hover="true">
        <HeaderContent><MudTh>@Language.T("ot.date")</MudTh><MudTh>@Language.T("public.content")</MudTh><MudTh>@Language.T("equipment.donVi")</MudTh><MudTh>@Language.T("common.chiPhi")</MudTh><MudTh>@Language.T("hrm.result")</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.RepairDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.RepairContent</MudTd>
            <MudTd>@context.RepairVendor</MudTd>
            <MudTd>@context.RepairCost?.ToString("N0")</MudTd>
            <MudTd>@context.RepairResult</MudTd>
        </RowTemplate>
    </MudTable>

    @if (_canRepair)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6">@Language.T("equipment.taoYeuCauSuaChua")</MudText>
        <MudGrid>
            <MudItem xs="12" md="4"><MudDatePicker @bind-Date="_repairDate" Label='@Language.T("common.modifiedAt")' /></MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="_repair.RepairContent" Label="@Language.T("equipment.noiDungSuaChua")" Required="true" /></MudItem>
            <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="_repair.RepairAssignmentType" Label="@Language.T("equipment.doiTuongChiuTrachNhiem")" Required="true"><MudSelectItem Value="@("Department")">@Language.T("nav.departments")</MudSelectItem><MudSelectItem Value="@("Employee")">@Language.T("ot.employee")</MudSelectItem></MudSelect></MudItem>
            @if (_repair.RepairAssignmentType == "Department")
            {
                <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="_repair.RepairResponsibleDeptCode" Label="@Language.T("equipment.boPhanSuaChua")" Required="true"><MudSelectItem Value="@string.Empty">@Language.T("equipment.chonBoPhan")</MudSelectItem>@foreach (var d in _repairAssignees.Select(x => x.DeptCode).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x)){<MudSelectItem Value="@d">@d</MudSelectItem>}</MudSelect></MudItem>
            }
            else if (_repair.RepairAssignmentType == "Employee")
            {
                <MudItem xs="12" md="4"><MudSelect T="string" @bind-Value="_repair.RepairAssigneeEmployeeCode" Label="@Language.T("equipment.nhanVienSuaChua")" Required="true"><MudSelectItem Value="@string.Empty">@Language.T("equipment.chonNhanVien")</MudSelectItem>@foreach (var e in _repairAssignees){<MudSelectItem Value="@e.EmployeeCode">@e.EmployeeCode - @e.EmployeeName (@e.DeptCode)</MudSelectItem>}</MudSelect></MudItem>
            }
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_repair.RepairVendor" Label="@Language.T("equipment.donViSuaChua")" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField @bind-Value="_repair.RepairCost" Label="@Language.T("common.chiPhi")" Min="0" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_repair.RepairResult" Label='@Language.T("hrm.result")' /></MudItem>
            <MudItem xs="12"><ApprovalRouteSelector @ref="_approvalSelector" Route="@_approvalRoute" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_repair.Note" Label='@Language.T("common.note")' /></MudItem>
            <MudItem xs="12"><MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateRepairAsync" Disabled="_busy">@Language.T("equipment.taoGuiYeuCauSua")</MudButton></MudItem>
        </MudGrid>
    }
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    private bool _loading = true;
    private bool _busy;
    private bool _canRepair;
    private EquipmentAssetDto? _asset;
    private DateTime? _repairDate = DateTime.Today;
    private CreateEquipmentRepairDto _repair = new();
    private ApprovalRoutePreviewDto? _approvalRoute;
    private ApprovalRouteSelector? _approvalSelector;
    private List<EquipmentHandoverEmployeeOptionDto> _repairAssignees = new();

    protected override async Task OnInitializedAsync()
    {
        var actions = await Equipment.GetActionsAsync();
        _canRepair = actions.IsSuccess && actions.Data?.Repair == true;
        var token = Uri.UnescapeDataString(Token);
        var result = await Equipment.ScanAsync(token);
        if (result.IsSuccess && result.Data != null)
        {
            _asset = result.Data;
            _canRepair = _canRepair || string.Equals(_asset.ResponsibleEmployeeCode, CurrentUser.User?.EmployeeCode, StringComparison.OrdinalIgnoreCase) || string.Equals(_asset.OperatingResponsibleEmployeeCode, CurrentUser.User?.EmployeeCode, StringComparison.OrdinalIgnoreCase);
            var assignees = await Equipment.GetRepairAssigneesAsync();
            if (assignees.IsSuccess) _repairAssignees = assignees.Data ?? new();
            _repair.AssetId = _asset.Id;
            if (_canRepair)
            {
                var route = await ApprovalRouteClient.GetPreviewAsync(FVN_REGISTER.Core.Enums.RequestModule.Equipment);
                if (route.IsSuccess) _approvalRoute = route.Data;
            }
        }
        _loading = false;
    }

    private async Task CreateRepairAsync()
    {
        if (_asset == null || !_canRepair) return;
        if (_repair.RepairAssignmentType != "Department" && _repair.RepairAssignmentType != "Employee") { Snackbar.Add(Language.T("equipment.phaiChonBoPhanHoac"), Severity.Warning); return; }
        if (_repair.RepairAssignmentType == "Department" && string.IsNullOrWhiteSpace(_repair.RepairResponsibleDeptCode)) { Snackbar.Add(Language.T("equipment.vuiLongChonBoPhan"), Severity.Warning); return; }
        if (_repair.RepairAssignmentType == "Employee" && string.IsNullOrWhiteSpace(_repair.RepairAssigneeEmployeeCode)) { Snackbar.Add(Language.T("equipment.vuiLongChonNhanVien"), Severity.Warning); return; }
        if (_approvalRoute == null || _approvalRoute.Levels.Count == 0)
        {
            Snackbar.Add(Language.T("equipment.chuaXacDinhDuocLuong"), Severity.Error);
            return;
        }
        _repair.RepairDate = _repairDate ?? DateTime.Today;
        _repair.ApprovalSelections = _approvalSelector?.GetSelections() ?? new();
        var required = _approvalRoute.Levels.Where(x => x.Required).Select(x => x.Level).ToHashSet();
        var selected = _repair.ApprovalSelections.Where(x => !string.IsNullOrWhiteSpace(x.ApproverCode)).Select(x => x.Level).ToHashSet();
        if (required.Any(level => !selected.Contains(level)))
        {
            Snackbar.Add(Language.T("equipment.vuiLongChonNguoiPhe"), Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            var result = await Equipment.CreateRepairAsync(_repair);
            if (!result.IsSuccess || result.Data == null)
            {
                Snackbar.Add(result.Message ?? Language.T("equipment.khongTheTaoYeuCau"), Severity.Error);
                return;
            }
            var submit = await Equipment.SubmitRepairAsync(result.Data.Id);
            Snackbar.Add(submit.IsSuccess ? Language.T("equipment.daGuiYeuCauSua") : submit.Message ?? Language.T("equipment.khongTheGuiDuyet"), submit.IsSuccess ? Severity.Success : Severity.Error);
            if (submit.IsSuccess) Navigation.NavigateTo("/equipment");
        }
        finally { _busy = false; }
    }
}
