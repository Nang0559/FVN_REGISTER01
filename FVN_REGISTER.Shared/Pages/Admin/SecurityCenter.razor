@page "/admin/security"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Contract.Dtos.Authentication
@using FVN_REGISTER.Contract.Dtos.Usermanagers
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils.Helpers
@using FVN_REGISTER.Core.Constants
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject ISecurityClientService SecurityService
@inject IUserManagementClientService UserService
@inject IPasswordResetRequestClientService PasswordResetRequestService
@inject ISnackbar Snackbar

<PageTitle>@Language.T("security.securityCenterFcc")</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800">@Language.T("security.title")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Language.T("security.quanLyTaiKhoanRole")
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync" Disabled="_loading">@Language.T("common.refresh")</MudButton>
    </MudStack>

    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    <MudTabs Elevation="0" Rounded="true" Class="pa-2">
        <MudTabPanel Text="@Language.T("security.usersEffectivePermission")" Icon="@Icons.Material.Filled.People">
            <MudGrid>
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudText Typo="Typo.h6">@Language.T("common.account")</MudText>
                            <MudSpacer />
                            <MudTextField @bind-Value="_search" Placeholder="@Language.T("security.timNhanVien")" Immediate="true"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudStack>

                        <MudTable T="UserAccountDto" Items="FilteredUsers" Hover="true" Dense="true" Loading="_loading"
                                  OnRowClick="@(args => SelectUser(args))">
                            <HeaderContent>
                                <MudTh>@Language.T("ot.employee")</MudTh>
                                <MudTh>@Language.T("ot.department")</MudTh>
                                <MudTh>@Language.T("security.roleChinh")</MudTh>
                                <MudTh>@Language.T("common.status")</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><b>@context.FullName</b><br /><MudText Typo="Typo.caption">@context.EmployeeCode</MudText></MudTd>
                                <MudTd>@context.DeptCode</MudTd>
                                <MudTd>@context.PermissionName</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                                        @(context.IsActive ? "Active" : "Inactive")
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px">
                        @if (_selected != null)
                        {
                            <MudText Typo="Typo.h6">@_selected.FullName</MudText>
                            <MudText Typo="Typo.caption">@_selected.EmployeeCode · @_selected.DeptCode</MudText>
                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.subtitle2" Class="mb-2">@Language.T("security.role")</MudText>
                            <MudSelect T="int" MultiSelection="true" SelectedValues="_selectedRoles"
                                       SelectedValuesChanged="RolesChanged" Variant="Variant.Outlined"
                                       Disabled="@(!CanAssignPermissions)">
                                @foreach (var role in _roles)
                                {
                                    <MudSelectItem T="int" Value="@role.RoleCode">@role.RoleCode - @role.RoleName</MudSelectItem>
                                }
                            </MudSelect>

                            @if (CanAssignPermissions)
                            {
                                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveRolesAsync" Disabled="_saving">
                                    @Language.T("security.luuRole")
                                </MudButton>
                            }

                            @if (CanResetPassword)
                            {
                                <MudDivider Class="my-4" />
                                <MudText Typo="Typo.subtitle2">@Language.T("security.hoTroIt")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @Language.T("security.resetMatKhauVeMat")
                            </MudText>
                            <MudTextField T="string"
                                          Label="@Language.T("security.maNhanVienCanReset")"
                                          @bind-Value="_resetEmployeeCode"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Badge"
                                          Class="mt-2" />
                                <MudButton Class="mt-2"
                                           Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.LockReset"
                                           OnClick="ResetPasswordToDefaultAsync"
                                           Disabled="_resettingPassword || string.IsNullOrWhiteSpace(_resetEmployeeCode)">
                                    @(_resettingPassword ? Language.T("security.dangReset") : Language.T("security.resetVeFvn123"))
                                </MudButton>
                            }

                            <MudDivider Class="my-4" />
                            <MudText Typo="Typo.subtitle2">@Language.T("security.effectivePermissions")</MudText>
                            @if (_snapshot != null)
                            {
                                @foreach (var group in _snapshot.Functions.GroupBy(x => x.ModuleCode))
                                {
                                    <MudText Typo="Typo.caption" Class="mt-3" Style="font-weight:700">@group.Key</MudText>
                                    @foreach (var f in group.OrderBy(x => x.DisplayOrder))
                                    {
                                        <MudChip T="string" Size="Size.Small" Class="ma-1" Color="Color.Success">
                                            @f.ActionCode · @(f.AccessMode ?? "-") · @(f.ScopeCode ?? "-")
                                        </MudChip>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <MudText Color="Color.Secondary">@Language.T("security.chonMotTaiKhoanDe3")</MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @if (CanResetPassword)
        {
        <MudTabPanel Text="@Language.T("security.quenMatKhau")" Icon="@Icons.Material.Filled.LockReset">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.h6">@Language.T("security.yeuCauQuenMatKhau")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @Language.T("security.userGuiYeuCauTu")
                        </MudText>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Color="@( _resetRequests.Count > 0 ? Color.Warning : Color.Default )">
                        @Language.T("security.choXuLy", _resetRequests.Count)
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadPasswordResetRequestsAsync"
                               Disabled="_loadingResetRequests">
                        @Language.T("common.refresh")
                    </MudButton>
                </MudStack>

                @if (_resetRequests.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @Language.T("security.hienKhongCoYeuCau")
                    </MudAlert>
                }
                else
                {
                    <MudTable T="PasswordResetRequestDto"
                              Items="_resetRequests"
                              Dense="true"
                              Hover="true"
                              Bordered="true"
                              Striped="true">
                        <HeaderContent>
                            <MudTh>@Language.T("common.employeeCode")</MudTh>
                            <MudTh>@Language.T("common.employeeName")</MudTh>
                            <MudTh>@Language.T("ot.department")</MudTh>
                            <MudTh>@Language.T("common.thoiGian")</MudTh>
                            <MudTh>@Language.T("common.note")</MudTh>
                            <MudTh Style="text-align:center">@Language.T("calendar.handle")</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><b>@context.EmployeeCode</b></MudTd>
                            <MudTd>@context.FullName</MudTd>
                            <MudTd>@context.DeptCode</MudTd>
                            <MudTd>@context.RequestedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
                            <MudTd>@(string.IsNullOrWhiteSpace(context.RequestNote) ? "-" : context.RequestNote)</MudTd>
                            <MudTd Style="text-align:center">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.LockReset"
                                           OnClick="@(() => ProcessPasswordResetRequestAsync(context, true))"
                                           Disabled="_processingResetRequestId == context.Id">
                                    @(_processingResetRequestId == context.Id ? Language.T("common.dangXuLy") : "Reset FVN@123")
                                </MudButton>
                                <MudButton Class="ms-2"
                                           Variant="Variant.Text"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => ProcessPasswordResetRequestAsync(context, false))"
                                           Disabled="_processingResetRequestId == context.Id">
                                    @Language.T("common.reject")
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudTabPanel>
        }

        @if (_myPermissions?.Has(SecurityFunctionCodes.SecurityManageRoles) == true)
        {
        <MudTabPanel Text='@Language.T("security.roles")' Icon="@Icons.Material.Filled.GridView">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px; overflow-x:auto">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.h6">@Language.T("security.maTranPhanQuyen")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @Language.T("security.moiOLaMotCapability")
                        </MudText>
                    </div>
                    <MudSpacer />
                    <MudChip T="string" Size="Size.Small">@_matrixFunctions.Count function/action</MudChip>
                </MudStack>

                @if (_matrixFunctions.Count > 0 && _roles.Count > 0)
                {
                    <MudTable Items="_matrixFunctions" Dense="true" Hover="true" Bordered="true" Striped="true">
                        <HeaderContent>
                            <MudTh Style="min-width:280px">@Language.T("security.functionAction")</MudTh>
                            @foreach (var role in _roles)
                            {
                                <MudTh Style="min-width:120px; text-align:center">
                                    <b>@role.RoleName</b><br />
                                    <MudText Typo="Typo.caption">@role.RoleCode</MudText>
                                </MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2">
                                    <b>@context.ModuleCode.@context.ActionCode</b>
                                    @if (context.IsSystemCritical)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />
                                            System Critical
                                        </MudChip>
                                    }
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Detail</MudText>
                            </MudTd>
                            @foreach (var role in _roles)
                            {
                                <MudTd Style="text-align:center; min-width:150px">
                                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                                        <MudCheckBox T="bool"
                                                     Value="@HasRoleFunction(role.RoleCode, context.FunctionCode)"
                                                     ValueChanged="@(value => ToggleRoleFunction(role.RoleCode, context.FunctionCode, value))"
                                                     Disabled="@(context.IsSystemCritical && role.RoleCode == 1)"
                                                     Color="Color.Primary" />
                                        @if (HasRoleFunction(role.RoleCode, context.FunctionCode))
                                        {
                                            <MudSelect T="string"
                                                       Value="@GetRoleFunctionMode(role.RoleCode, context.FunctionCode)"
                                                       ValueChanged="@(value => SetRoleFunctionMode(role.RoleCode, context.FunctionCode, value))"
                                                       Disabled="@(context.IsSystemCritical && role.RoleCode == 1)"
                                                       Dense="true"
                                                       Margin="Margin.Dense"
                                                       Variant="Variant.Outlined"
                                                       Style="width:135px">
                                                @foreach (var mode in AccessModeOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@mode">@mode</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudSelect T="string"
                                                       Value="@GetRoleFunctionScope(role.RoleCode, context.FunctionCode)"
                                                       ValueChanged="@(value => SetRoleFunctionScope(role.RoleCode, context.FunctionCode, value))"
                                                       Disabled="@(context.IsSystemCritical && role.RoleCode == 1)"
                                                       Dense="true"
                                                       Margin="Margin.Dense"
                                                       Variant="Variant.Outlined"
                                                       Style="width:135px">
                                                @foreach (var scope in ScopeOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@scope">@scope</MudSelectItem>
                                                }
                                            </MudSelect>
                                        }
                                    </MudStack>
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>

                    <MudDivider Class="my-4" />

                    @foreach (var role in _roles)
                    {
                        <MudPaper Class="pa-3 mb-2" Outlined="true" Style="border-radius:12px">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.subtitle1"><b>@role.RoleName</b> (@role.RoleCode)</MudText>
                                    <MudText Typo="Typo.caption">@role.Detail</MudText>
                                </div>
                                <MudSpacer />
                                <MudText Typo="Typo.caption">@Language.T("security.quyen", GetMatrixCount(role.RoleCode))</MudText>
                                <MudButton Variant="Variant.Filled" Size="Size.Small"
                                           Color="Color.Primary" Disabled="_savingRoleCode == role.RoleCode"
                                           OnClick="@(() => SaveRoleFunctionsAsync(role))">
                                    @Language.T("security.luu", role.RoleName)
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info">@Language.T("security.chuaCoRoleFunctionDe")</MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
        }
        @if (CanAssignPermissions)
        {
            <MudTabPanel
                Text="@Language.T("security.organizationScope")"
                Icon="@Icons.Material.Filled.AccountTree">
                <ManagedScopeEditor User="_selected" />
            </MudTabPanel>
            }

        @if (CanAssignPermissions)
        {
            <MudTabPanel Text="@Language.T("security.featureOperatorAssignment")" Icon="@Icons.Material.Filled.PersonAdd">
                <MudPaper Class="pa-4" Outlined="true" Style="border-radius:16px">
                    <MudText Typo="Typo.h6">@Language.T("security.chiDinhNguoiThaoTac")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        @Language.T("security.capabilityVanDoRbacQuyet")
                    </MudText>

                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudSelect T="int" Label="@Language.T("security.functionAction")" Variant="Variant.Outlined"
                                       Value="_operatorFunctionCode" ValueChanged="OperatorFunctionChanged">
                                @foreach (var f in _operatorFunctions)
                                {
                                    <MudSelectItem T="int" Value="@f.FunctionCode">
                                        @f.FunctionCode — @f.ModuleCode.@f.ActionCode
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            @if (IsGlobalOperatorFunction)
                            {
                                <MudTextField T="string"
                                              Label="@Language.T("security.resource")"
                                              Value="@OperatorResourceDescription"
                                              ReadOnly="true"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Public" />
                            }
                            else
                            {
                                <MudSelect T="int?" Label="@Language.T("security.doiTuongCuThe")" Variant="Variant.Outlined"
                                           Value="_operatorResourceId" ValueChanged="OperatorResourceChanged"
                                           Disabled="@(_operatorResources.Count == 0)">
                                    @foreach (var resource in _operatorResources)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)resource.Id)">
                                            @resource.Code — @resource.Name
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="FeatureOperatorEmployeeDto"
                                             Label="@Language.T("security.nhanVienThaoTac")"
                                             Placeholder="@Language.T("security.timNhanVien")"
                                             Value="_operatorEmployee"
                                             ValueChanged="OperatorEmployeeChanged"
                                             SearchFunc="SearchOperatorEmployeesAsync"
                                             ToStringFunc="FormatOperatorEmployee"
                                             MinCharacters="2"
                                             MaxItems="50"
                                             Clearable="true"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             Variant="Variant.Outlined"
                                             Dense="true">
                                <ItemTemplate Context="employee">
                                    <div>
                                        <b>@employee.EmployeeCode — @employee.EmployeeName</b>
                                        <div style="font-size:12px; opacity:.75">
                                            @employee.DeptCode — @employee.DeptName · @employee.PositionCode — @employee.PositionName
                                        </div>
                                    </div>
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        @OperatorAssignmentHint
                    </MudText>

                    <MudStack Row="true" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                   OnClick="AddFeatureOperatorAsync"
                                   Disabled="@(_savingOperator || string.IsNullOrWhiteSpace(_operatorEmployeeCode))">
                            @Language.T("common.chiDinh")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="LoadFeatureOperatorsAsync"
                                   Disabled="_loadingOperators">@Language.T("common.refresh")</MudButton>
                    </MudStack>

                    <MudDivider Class="my-4" />

                    <MudTable T="FeatureOperatorAssignmentDto" Items="_operatorAssignments"
                              Dense="true" Hover="true" Bordered="true" Striped="true">
                        <HeaderContent>
                            <MudTh>@Language.T("common.function")</MudTh>
                            <MudTh>@Language.T("security.resource")</MudTh>
                            <MudTh>@Language.T("ot.employee")</MudTh>
                            <MudTh>@Language.T("ot.department")</MudTh>
                            <MudTh>@Language.T("hrm.position")</MudTh>
                            <MudTh Style="text-align:center">@Language.T("calendar.handle")</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.FunctionCode</MudTd>
                            <MudTd>@context.ResourceType @(context.ResourceId.HasValue ? $"#{context.ResourceId}" : "· ALL")</MudTd>
                            <MudTd><b>@context.EmployeeCode</b> — @context.EmployeeName</MudTd>
                            <MudTd>@context.DeptCode — @context.DeptName</MudTd>
                            <MudTd>@context.PositionCode — @context.PositionName</MudTd>
                            <MudTd Style="text-align:center">
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                           OnClick="@(() => RemoveFeatureOperatorAsync(context))">
                                    @Language.T("security.boChiDinh")
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudTabPanel>
        }


        @if (_myPermissions?.Has(SecurityFunctionCodes.SecurityAudit) == true)
        {
            <MudTabPanel Text="@Language.T("security.securityAudit")" Icon="@Icons.Material.Filled.Security">
                <MudPaper Class="pa-4" Outlined="true" Style="border-radius:16px">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">@Language.T("security.securityAudit")</MudText>
                        <MudSpacer />
                        <MudTextField T="string" Label="@Language.T("security.timActorActionNoiDung")"
                                      @bind-Value="_auditSearch" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudButton Class="ms-2" Variant="Variant.Outlined" OnClick="LoadSecurityAuditAsync">
                            @Language.T("common.refresh")
                        </MudButton>
                    </MudStack>
                    <MudTable T="SecurityAuditEntryDto" Items="_auditEntries" Dense="true" Hover="true" Bordered="true" Striped="true">
                        <HeaderContent>
                            <MudTh>@Language.T("common.thoiGian")</MudTh>
                            <MudTh>@Language.T("common.user2")</MudTh>
                            <MudTh>@Language.T("common.action2")</MudTh>
                            <MudTh>@Language.T("public.content")</MudTh>
                            <MudTh>IP</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                            <MudTd>@context.UserName</MudTd>
                            <MudTd><b>@context.Action</b></MudTd>
                            <MudTd>@context.Description</MudTd>
                            <MudTd>@context.IpAddress</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudTabPanel>
        }

        @if (_myPermissions?.Has(SecurityFunctionCodes.ApprovalPolicyManage) == true)
        {
        <MudTabPanel Text="@Language.T("security.approvalPolicyEffectivePreview")" Icon="@Icons.Material.Filled.Policy">
            <MudStack Spacing="2">
                <MudPaper Class="pa-4" Outlined="true" Style="border-radius:16px">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">@Language.T("security.policies")</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Href="/admin/approval-policies">
                            @Language.T("security.moCauHinhApprovalPolicy")
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        @Language.T("security.approvalKhongDuocCapBoi")
                    </MudText>
                </MudPaper>
                <MudPaper Class="pa-4" Outlined="true" Style="border-radius:16px">
                    <EffectivePermissionPreview User="_selected" />
                </MudPaper>
            </MudStack>
        </MudTabPanel>
        }
        @if (CanManageTwoFactor)
        {
        <MudTabPanel Text='@Language.T("security.twoFactor")' Icon="@Icons.Material.Filled.Security">
            {
                <MudPaper Class="pa-4" Elevation="1" Style="border-radius:16px">
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        @Language.T("security.chiSuperadminCoQuyenCau")
                    </MudAlert>
                    <MudTextField @bind-Value="_twoFactorSearch" Placeholder="@Language.T("security.timMaNhanVienHo")" Immediate="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                    <MudTable T="TwoFactorAdminUserDto" Items="FilteredTwoFactorUsers" Hover="true" Dense="true" Loading="_loadingTwoFactor">
                        <HeaderContent>
                            <MudTh>@Language.T("ot.employee")</MudTh>
                            <MudTh>@Language.T("ot.department")</MudTh>
                            <MudTh>@Language.T("security.twoFactorRequired")</MudTh>
                            <MudTh>@Language.T("trip.registered")</MudTh>
                            <MudTh>@Language.T("security.actions")</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><b>@context.FullName</b><br /><MudText Typo="Typo.caption">@context.EmployeeCode</MudText></MudTd>
                            <MudTd>
                                <b>@context.DeptCode</b> — @context.DeptName<br />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PositionCode — @context.PositionName</MudText>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Required ? Color.Warning : Color.Default)">
                                    @(context.Required ? Language.T("security.batBuoc") : Language.T("common.no"))
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Enabled ? Color.Success : Color.Default)">
                                    @(context.Enabled ? Language.T("trip.registered") : Language.T("endpoint.chuaDangKy"))
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           Color="@(context.Required ? Color.Warning : Color.Primary)"
                                           OnClick="@(() => SetTwoFactorRequiredAsync(context))"
                                           Disabled="_savingTwoFactor">
                                    @(context.Required ? Language.T("security.tatBatBuoc") : Language.T("security.bat2fa"))
                                </MudButton>
                                @if (context.Enabled)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                               Class="ms-2"
                                               OnClick="@(() => ResetTwoFactorAsync(context))"
                                               Disabled="_savingTwoFactor">
                                        @Language.T("security.resetFactor")
                                    </MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>
        }

    </MudTabs>
</MudStack>

@code {
    private List<UserAccountDto> _users = new();
    private List<SecurityRoleDto> _roles = new();
    private List<SecurityFunctionDto> _matrixFunctions = new();
    private Dictionary<int, Dictionary<int, string>> _matrix = new();
    private Dictionary<int, Dictionary<int, string>> _matrixModes = new();

    private PermissionSnapshotDto? _snapshot;
    private UserAccountDto? _selected;
    private HashSet<int> _selectedRoles = new();
    private string _search = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _saving;
    private int? _savingRoleCode;
    private string _resetEmployeeCode = string.Empty;
    private bool _resettingPassword;
    private List<PasswordResetRequestDto> _resetRequests = new();
    private bool _loadingResetRequests;
    private PermissionSnapshotDto? _myPermissions;

    private readonly int[] _operatorFunctionCodes =
    {
        SecurityFunctionCodes.PublicInformationManage,
        SecurityFunctionCodes.ExecutionReview,
        SecurityFunctionCodes.PublicFormManage,
        SecurityFunctionCodes.PublicFormSubmissionView,
        SecurityFunctionCodes.PublicFormExport,
        SecurityFunctionCodes.EquipmentFormManage,
        SecurityFunctionCodes.EndpointSoftwareCatalogManage
    };
    private List<SecurityFunctionDto> _operatorFunctions = new();
    private List<FeatureOperatorEmployeeDto> _operatorEmployees = new();
    private List<FeatureOperatorResourceDto> _operatorResources = new();
    private List<FeatureOperatorAssignmentDto> _operatorAssignments = new();
    private int _operatorFunctionCode = 2801;
    private string _operatorResourceType = "PUBLIC_INFORMATION";
    private int? _operatorResourceId;
    private string _operatorEmployeeCode = string.Empty;
    private FeatureOperatorEmployeeDto? _operatorEmployee;
    private bool _loadingOperators;
    private bool _savingOperator;

    private const int UserManagementResetPasswordFunctionCode = 2405;
    private const int UserManagementAssignPermissionFunctionCode = 2406;

    private bool CanResetPassword
        => _myPermissions?.Has(UserManagementResetPasswordFunctionCode) == true;

    private bool CanAssignPermissions
        => _myPermissions?.Has(UserManagementAssignPermissionFunctionCode) == true;

    private int? _processingResetRequestId;
    private string _auditSearch = string.Empty;
    private List<SecurityAuditEntryDto> _auditEntries = new();
    private List<TwoFactorAdminUserDto> _twoFactorUsers = new();
    private string _twoFactorSearch = string.Empty;
    private bool _loadingTwoFactor;
    private bool _savingTwoFactor;
    private const int ManageTwoFactorFunctionCode = SecurityFunctionCodes.UserManagementManageTwoFactor;

    // 2FA administration is explicitly restricted to SuperAdmin.
    // Do not depend on the 2407 RoleFunction row here; older databases may
    // still be missing that compatibility grant while the account is SuperAdmin.
    private bool CanManageTwoFactor
        => _myPermissions?.Has(ManageTwoFactorFunctionCode) == true;

    private IEnumerable<TwoFactorAdminUserDto> FilteredTwoFactorUsers =>
        string.IsNullOrWhiteSpace(_twoFactorSearch)
            ? _twoFactorUsers
            : _twoFactorUsers.Where(x =>
                (x.EmployeeCode ?? string.Empty).Contains(_twoFactorSearch, StringComparison.OrdinalIgnoreCase) ||
                (x.FullName ?? string.Empty).Contains(_twoFactorSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<UserAccountDto> FilteredUsers =>
        string.IsNullOrWhiteSpace(_search)
            ? _users
            : _users.Where(x =>
                (x.EmployeeCode ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                (x.FullName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var myPermissions = await SecurityService.GetMyPermissionsAsync();
            if (!myPermissions.IsSuccess)
            {
                _error = myPermissions.Message;
                return;
            }

            _myPermissions = myPermissions.Data;

            if (_myPermissions?.Has(SecurityFunctionCodes.SecurityView) != true)
            {
                _error = Language.T("security.noPermission");
                return;
            }

            var users = await UserService.GetAllAsync();
            var roles = await SecurityService.GetRolesAsync();
            var functions = await SecurityService.GetFunctionsAsync();

            if (!users.IsSuccess) { _error = users.Message; return; }
            if (!roles.IsSuccess) { _error = roles.Message; return; }
            if (!functions.IsSuccess) { _error = functions.Message; return; }

            _users = users.Data ?? new();
            _roles = roles.Data ?? new();
            _matrixFunctions = functions.Data ?? new();
            _operatorFunctions = _matrixFunctions.Where(x => _operatorFunctionCodes.Contains(x.FunctionCode)).ToList();
            BuildMatrix();
            if (CanAssignPermissions)
                await LoadFeatureOperatorsAsync();
            if (CanResetPassword)
                await LoadPasswordResetRequestsAsync();
            if (_myPermissions?.Has(SecurityFunctionCodes.SecurityAudit) == true)
                await LoadSecurityAuditAsync();
            if (CanManageTwoFactor)
                await LoadTwoFactorUsersAsync();
        }
        finally { _loading = false; }
    }


    private async Task LoadTwoFactorUsersAsync()
    {
        _loadingTwoFactor = true;
        try
        {
            var result = await SecurityService.GetTwoFactorUsersAsync();
            if (result.IsSuccess)
                _twoFactorUsers = result.Data ?? new();
            else
                Snackbar.Add(result.Message ?? Language.T("security.khongTaiDuocDanhSach"), Severity.Error);
        }
        finally
        {
            _loadingTwoFactor = false;
        }
    }

    private async Task SetTwoFactorRequiredAsync(TwoFactorAdminUserDto user)
    {
        _savingTwoFactor = true;
        try
        {
            var result = await SecurityService.SetTwoFactorRequiredAsync(user.UserId, !user.Required);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheCapNhatChinh"), Severity.Error);
                return;
            }

            Snackbar.Add(
                user.Required
                    ? Language.T("security.daTatBatBuoc2fa", user.EmployeeCode)
                    : Language.T("security.daBatBatBuoc2fa", user.EmployeeCode),
                Severity.Success);
            await LoadTwoFactorUsersAsync();
        }
        finally
        {
            _savingTwoFactor = false;
        }
    }

    private async Task ResetTwoFactorAsync(TwoFactorAdminUserDto user)
    {
        _savingTwoFactor = true;
        try
        {
            var result = await SecurityService.ResetTwoFactorAsync(user.UserId);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheResetFactor"), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("security.daResetFactor2faCho", user.EmployeeCode), Severity.Success);
            await LoadTwoFactorUsersAsync();
        }
        finally
        {
            _savingTwoFactor = false;
        }
    }

    private async Task LoadSecurityAuditAsync()
    {
        var result = await SecurityService.GetSecurityAuditAsync(search: _auditSearch);
        if (result.IsSuccess) _auditEntries = result.Data ?? new();
        else Snackbar.Add(result.Message ?? Language.T("security.khongTaiDuocSecurityAudit"), Severity.Error);
    }

    private async Task LoadPasswordResetRequestsAsync()
    {
        _loadingResetRequests = true;
        try
        {
            var result = await PasswordResetRequestService.GetPendingAsync();
            if (result.IsSuccess)
                _resetRequests = result.Data ?? new();
        }
        finally
        {
            _loadingResetRequests = false;
        }
    }

    private async Task ProcessPasswordResetRequestAsync(
        PasswordResetRequestDto request,
        bool approve)
    {
        _processingResetRequestId = request.Id;
        try
        {
            var result = await PasswordResetRequestService.ProcessAsync(
                request.Id,
                new FVN_REGISTER.Contract.Requests.Users.PasswordResetRequestProcessDto
                {
                    Approve = approve,
                    ResultNote = approve
                        ? Language.T("security.itDaXacMinhVa")
                        : Language.T("security.itTuChoiYeuCau")
                });

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheXuLyYeu"), Severity.Error);
                return;
            }

            Snackbar.Add(
                approve
                    ? Language.T("security.daResetMatKhauCho2", request.EmployeeCode)
                    : Language.T("security.daTuChoiYeuCau", request.EmployeeCode),
                approve ? Severity.Success : Severity.Info);

            await LoadPasswordResetRequestsAsync();
        }
        finally
        {
            _processingResetRequestId = null;
        }
    }

    private bool IsGlobalOperatorFunction
        => _operatorFunctionCode is SecurityFunctionCodes.ExecutionReview
            or SecurityFunctionCodes.EndpointSoftwareCatalogManage;

    private string OperatorResourceDescription
        => _operatorFunctionCode switch
        {
            SecurityFunctionCodes.ExecutionReview => Language.T("security.hrFeedbackToanModule"),
            SecurityFunctionCodes.EndpointSoftwareCatalogManage => Language.T("security.endpointSoftwareCatalogManage"),
            _ => Language.T("security.resource")
        };

    private string OperatorAssignmentHint
        => IsGlobalOperatorFunction
            ? "Quyền này áp dụng ở cấp module. Không cần chọn đối tượng cụ thể."
            : "Quyền này áp dụng theo đối tượng cụ thể. Hãy chọn resource trước khi chỉ định nhân viên.";

    private async Task<IEnumerable<FeatureOperatorEmployeeDto>> SearchOperatorEmployeesAsync(
        string value,
        CancellationToken ct)
    {
        var term = value?.Trim();
        if (string.IsNullOrWhiteSpace(term) || term.Length < 2)
            return Array.Empty<FeatureOperatorEmployeeDto>();

        var result = await SecurityService.GetFeatureOperatorEmployeesAsync(term, ct);
        if (!result.IsSuccess || result.Data == null)
            return Array.Empty<FeatureOperatorEmployeeDto>();

        return result.Data.Take(50);
    }

    private static string FormatOperatorEmployee(FeatureOperatorEmployeeDto? employee)
        => employee == null
            ? string.Empty
            : $"{employee.EmployeeCode} — {employee.EmployeeName} — {employee.DeptCode} — {employee.DeptName} — {employee.PositionCode} — {employee.PositionName}";

    private Task OperatorEmployeeChanged(FeatureOperatorEmployeeDto? value)
    {
        _operatorEmployee = value;
        _operatorEmployeeCode = value?.EmployeeCode ?? string.Empty;
        return Task.CompletedTask;
    }

    private static string GetResourceTypeForFunction(int functionCode)
        => functionCode switch
        {
            SecurityFunctionCodes.PublicInformationManage => "PUBLIC_INFORMATION",
            SecurityFunctionCodes.ExecutionReview => "EXECUTION_REVIEW",
            SecurityFunctionCodes.PublicFormManage
                or SecurityFunctionCodes.PublicFormSubmissionView
                or SecurityFunctionCodes.PublicFormExport => "PUBLIC_FORM",
            SecurityFunctionCodes.EquipmentFormManage => "EQUIPMENT_SCHEMA",
            SecurityFunctionCodes.EndpointSoftwareCatalogManage => "ENDPOINT_SOFTWARE_CATALOG",
            _ => string.Empty
        };

    private async Task OperatorResourceChanged(int? value)
    {
        _operatorResourceId = value;
        await LoadFeatureOperatorsAsync();
    }

    private async Task OperatorFunctionChanged(int value)
    {
        _operatorFunctionCode = value;
        _operatorResourceType = GetResourceTypeForFunction(value);
        _operatorResourceId = null;
        await LoadFeatureOperatorsAsync();
    }

    private async Task LoadFeatureOperatorsAsync()
    {
        _loadingOperators = true;
        try
        {
            var resources = await SecurityService.GetFeatureOperatorResourcesAsync(_operatorResourceType);
            _operatorResources = resources.IsSuccess ? resources.Data ?? new() : new();
            var assignments = await SecurityService.GetFeatureOperatorsAsync(
                _operatorFunctionCode,
                _operatorResourceType,
                _operatorResourceId);
            _operatorAssignments = assignments.IsSuccess ? assignments.Data ?? new() : new();


        }
        finally { _loadingOperators = false; }
    }

    private async Task AddFeatureOperatorAsync()
    {
        if (string.IsNullOrWhiteSpace(_operatorEmployeeCode)) return;
        _savingOperator = true;
        try
        {
            var result = await SecurityService.AddFeatureOperatorAsync(
                new SaveFeatureOperatorAssignmentRequest
                {
                    FunctionCode = _operatorFunctionCode,
                    ResourceType = _operatorResourceType,
                    ResourceId = IsGlobalOperatorFunction ? null : _operatorResourceId,
                    EmployeeCode = _operatorEmployeeCode
                });

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheChiDinhNguoi"), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("security.daChiDinhNguoiThao"), Severity.Success);
            await LoadFeatureOperatorsAsync();
        }
        finally { _savingOperator = false; }
    }

    private async Task RemoveFeatureOperatorAsync(FeatureOperatorAssignmentDto assignment)
    {
        var result = await SecurityService.RemoveFeatureOperatorAsync(assignment.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message ?? Language.T("common.khongTheBoChiDinh"), Severity.Error);
            return;
        }

        Snackbar.Add(Language.T("security.daBoChiDinh"), Severity.Success);
        await LoadFeatureOperatorsAsync();
    }

    private static readonly string[] ScopeOptions =
        { AuthorizationScopeCodes.Own, AuthorizationScopeCodes.Employee, AuthorizationScopeCodes.Department, AuthorizationScopeCodes.All };
    private static readonly string[] AccessModeOptions = { "Personal", "Management" };

    private void BuildMatrix()
    {
        _matrix = _roles.ToDictionary(
            r => r.RoleCode,
            r => r.FunctionScopes.ToDictionary(
                x => x.Key,
                x => string.IsNullOrWhiteSpace(x.Value) ? AuthorizationScopeCodes.Own : x.Value));
        _matrixModes = _roles.ToDictionary(
            r => r.RoleCode,
            r => r.FunctionAccessModes.ToDictionary(
                x => x.Key,
                x => string.IsNullOrWhiteSpace(x.Value) ? "Personal" : x.Value));
    }

    private bool HasRoleFunction(int roleCode, int functionCode)
        => _matrix.TryGetValue(roleCode, out var functions) && functions.ContainsKey(functionCode);

    private string GetRoleFunctionScope(int roleCode, int functionCode)
    {
        if (_matrix.TryGetValue(roleCode, out var functions)
            && functions.TryGetValue(functionCode, out var scope)
            && !string.IsNullOrWhiteSpace(scope))
            return scope;
        return _matrixFunctions.FirstOrDefault(x => x.FunctionCode == functionCode)?.ScopeCode
            ?? AuthorizationScopeCodes.Own;
    }

    private string GetRoleFunctionMode(int roleCode, int functionCode)
    {
        if (_matrixModes.TryGetValue(roleCode, out var modes)
            && modes.TryGetValue(functionCode, out var mode)
            && !string.IsNullOrWhiteSpace(mode))
            return mode;
        return "Personal";
    }

    private void ToggleRoleFunction(int roleCode, int functionCode, bool enabled)
    {
        if (!_matrix.TryGetValue(roleCode, out var functions))
        {
            functions = new Dictionary<int, string>();
            _matrix[roleCode] = functions;
        }
        if (!_matrixModes.TryGetValue(roleCode, out var modes))
            _matrixModes[roleCode] = modes = new Dictionary<int, string>();

        if (enabled)
        {
            functions[functionCode] = GetRoleFunctionScope(roleCode, functionCode);
            modes[functionCode] = GetRoleFunctionMode(roleCode, functionCode);
        }
        else
        {
            functions.Remove(functionCode);
            modes.Remove(functionCode);
        }
    }

    private void SetRoleFunctionMode(int roleCode, int functionCode, string mode)
    {
        if (!_matrixModes.TryGetValue(roleCode, out var modes))
            _matrixModes[roleCode] = modes = new Dictionary<int, string>();
        modes[functionCode] = string.IsNullOrWhiteSpace(mode) ? "Personal" : mode;
    }

    private void SetRoleFunctionScope(int roleCode, int functionCode, string scope)
    {
        if (!_matrix.TryGetValue(roleCode, out var functions))
            _matrix[roleCode] = functions = new Dictionary<int, string>();
        functions[functionCode] = string.IsNullOrWhiteSpace(scope) ? AuthorizationScopeCodes.Own : scope;
    }

    private int GetMatrixCount(int roleCode)
        => _matrix.TryGetValue(roleCode, out var functions) ? functions.Count : 0;

    private async Task ResetPasswordToDefaultAsync()
    {
        var employeeCode = _resetEmployeeCode.Trim();

        if (string.IsNullOrWhiteSpace(employeeCode))
            return;

        var target = _users.FirstOrDefault(x =>
            string.Equals(x.EmployeeCode?.Trim(), employeeCode, StringComparison.OrdinalIgnoreCase));

        if (target == null)
        {
            Snackbar.Add(Language.T("security.khongTimThayTaiKhoan", employeeCode), Severity.Error);
            return;
        }

        if (!target.IsActive)
        {
            Snackbar.Add(Language.T("security.taiKhoanDangKhongHoat", employeeCode), Severity.Warning);
            return;
        }

        _resettingPassword = true;
        try
        {
            var result = await UserService.ResetPasswordAsync(target.IdUser, "FVN@123");

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheResetMatKhau"), Severity.Error);
                return;
            }

            Snackbar.Add(
                Language.T("security.daResetMatKhauCho", target.FullName, target.EmployeeCode),
                Severity.Success);
        }
        finally
        {
            _resettingPassword = false;
        }
    }

    private async Task SaveRoleFunctionsAsync(SecurityRoleDto role)
    {
        if (!_matrix.TryGetValue(role.RoleCode, out var functions))
            functions = new Dictionary<int, string>();

        _savingRoleCode = role.RoleCode;
        try
        {
            var functionCodes = functions.Keys.OrderBy(x => x).ToList();
            var scopeOverrides = functions.ToDictionary(x => x.Key, x => (string?)x.Value);
            var accessModeOverrides = _matrixModes.TryGetValue(role.RoleCode, out var modes)
                ? modes.ToDictionary(x => x.Key, x => (string?)x.Value)
                : new Dictionary<int, string?>();

            var result = await SecurityService.SetRoleFunctionsAsync(
                role.RoleCode, functionCodes, scopeOverrides, accessModeOverrides);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheLuuMaTran"), Severity.Error);
                return;
            }

            var saved = result.Data;
            if (saved != null)
            {
                var index = _roles.FindIndex(x => x.RoleCode == role.RoleCode);
                if (index >= 0) _roles[index] = saved;
                _matrix[role.RoleCode] = saved.FunctionScopes.ToDictionary(x => x.Key, x => x.Value);
                _matrixModes[role.RoleCode] = saved.FunctionAccessModes.ToDictionary(x => x.Key, x => x.Value);
            }

            if (_selected != null)
                await SelectUserAsync(_selected);

            Snackbar.Add(Language.T("security.daLuuMaTranCho", role.RoleName), Severity.Success);
        }
        finally
        {
            _savingRoleCode = null;
        }
    }

    private Task SelectUser(TableRowClickEventArgs<UserAccountDto> args)
        => args.Item is null ? Task.CompletedTask : SelectUserAsync(args.Item);

    private async Task SelectUserAsync(UserAccountDto user)
    {
        _selected = user;
        var result = await SecurityService.GetUserPermissionsAsync(_selected.IdUser);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message ?? Language.T("security.khongTaiDuocQuyen"), Severity.Error);
            return;
        }

        _snapshot = result.Data;
        _selectedRoles = _snapshot?.RoleCodes.ToHashSet() ?? new();
    }

    private void RolesChanged(IEnumerable<int> values)
        => _selectedRoles = values.ToHashSet();

    private async Task SaveRolesAsync()
    {
        if (_selected == null) return;
        _saving = true;
        try
        {
            var result = await SecurityService.SetUserRolesAsync(
                _selected.IdUser, _selectedRoles.ToList());

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheLuuRole"), Severity.Error);
                return;
            }

            _snapshot = result.Data;
            Snackbar.Add(Language.T("security.daCapNhatRoleVa"), Severity.Success);
        }
        finally { _saving = false; }
    }
}
