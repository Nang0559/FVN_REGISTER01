@page "/admin/security/function-registry"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject ISecurityClientService SecurityService
@inject ISnackbar Snackbar

<PageTitle>@Language.T("security.securityFunctionRegistry")</PageTitle>

@if (!_authorized)
{
    <MudAlert Severity="Severity.Warning">@Language.T("security.noPermission")</MudAlert>
}
else
{
<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800">@Language.T("security.functionRegistry")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("security.dongBoDanhSachChuc")</MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="ScanAsync" Disabled="_busy">@Language.T("security.quetChucNang")</MudButton>
    </MudStack>

    @if (_summary != null)
    {
        <MudGrid>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">@Language.T("security.discovered")</MudText><MudText Typo="Typo.h6">@_summary.Discovered</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">@Language.T("security.matched")</MudText><MudText Typo="Typo.h6">@_summary.Matched</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">@Language.T("security.choDangKy")</MudText><MudText Typo="Typo.h6">@_summary.PendingRegistration</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">@Language.T("security.choNgung")</MudText><MudText Typo="Typo.h6">@_summary.PendingRetirement</MudText></MudPaper></MudItem>
            <MudItem xs="6" md="2"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">@Language.T("security.conflict")</MudText><MudText Typo="Typo.h6">@_summary.Conflict</MudText></MudPaper></MudItem>
        </MudGrid>
    }

    <MudTabs Rounded="true" Elevation="0">
        <MudTabPanel Text="@Language.T("security.choDangKy")" Icon="@Icons.Material.Filled.NewReleases">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                @Language.T("security.functionDaCoMaSe")
            </MudText>
            <MudTable T="SecurityFunctionRegistryItemDto" Items="PendingRegistration" Dense="true" Hover="true" Bordered="true" Loading="_busy">
                <HeaderContent><MudTh>FunctionKey</MudTh><MudTh>@Language.T("common.code2")</MudTh><MudTh>@Language.T("common.module")</MudTh><MudTh>@Language.T("common.action2")</MudTh><MudTh>@Language.T("security.source")</MudTh><MudTh>@Language.T("security.actions")</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd><b>@context.FunctionKey</b><br /><MudText Typo="Typo.caption">@context.DefinitionName</MudText></MudTd>
                    <MudTd>@(context.FunctionCode > 0 ? context.FunctionCode.ToString() : Language.T("security.chuaGan"))</MudTd><MudTd>@context.ModuleCode</MudTd><MudTd>@context.ActionCode</MudTd><MudTd>@context.SourceType</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RegisterOrPrepareAsync(context))">
                            @(context.FunctionCode > 0 ? Language.T("workspace.register") : Language.T("security.ganMa"))
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => IgnoreAsync(context))">@Language.T("security.boQua")</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@Language.T("security.choNgungThayThe")" Icon="@Icons.Material.Filled.WarningAmber">
            <MudTable T="SecurityFunctionRegistryItemDto" Items="PendingRetirement" Dense="true" Hover="true" Bordered="true">
                <HeaderContent><MudTh>FunctionKey</MudTh><MudTh>@Language.T("common.code2")</MudTh><MudTh>@Language.T("security.lastSeen")</MudTh><MudTh>@Language.T("security.thayThe")</MudTh><MudTh>@Language.T("security.actions")</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd><b>@context.FunctionKey</b><br /><MudText Typo="Typo.caption">@context.DefinitionName</MudText></MudTd>
                    <MudTd>@context.FunctionCode</MudTd><MudTd>@context.LastSeenAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>
                        <MudSelect T="string" Value="@_replacementByFunction.GetValueOrDefault(context.FunctionKey)" ValueChanged="@(v => SetReplacement(context.FunctionKey, v))" Dense="true" Variant="Variant.Outlined">
                            <MudSelectItem Value="@string.Empty">@Language.T("security.chon")</MudSelectItem>
                            @foreach (var target in ActiveFunctions)
                            {
                                <MudSelectItem Value="@target.FunctionKey">@target.FunctionKey</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => RetireAsync(context))">@Language.T("security.ngung")</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => ReplaceAsync(context))" Disabled="@(!HasReplacement(context.FunctionKey))">@Language.T("security.thayThe")</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@Language.T("security.conflictTatCa")" Icon="@Icons.Material.Filled.Rule">
            <MudTable T="SecurityFunctionRegistryItemDto" Items="_items" Dense="true" Hover="true" Bordered="true">
                <HeaderContent><MudTh>@Language.T("common.key")</MudTh><MudTh>@Language.T("common.status2")</MudTh><MudTh>@Language.T("common.code2")</MudTh><MudTh>@Language.T("security.registered")</MudTh><MudTh>@Language.T("security.lastSeen")</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd><b>@context.FunctionKey</b></MudTd><MudTd><MudChip T="string" Size="Size.Small">@context.LifecycleStatus</MudChip></MudTd><MudTd>@context.FunctionCode</MudTd><MudTd>@(context.Registered ? "Yes" : "No")</MudTd><MudTd>@context.LastSeenAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@Language.T("security.crudFunction")" Icon="@Icons.Material.Filled.Edit">
            <MudPaper Class="pa-4" Outlined="true">
                <MudGrid>
                    <MudItem xs="12" md="2"><MudNumericField T="int" Label="FunctionCode" @bind-Value="_functionCode" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField Label="FunctionKey" @bind-Value="_functionKey" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField Label="FunctionName" @bind-Value="_functionName" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField Label="@Language.T("security.detail")" @bind-Value="_functionDetail" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField Label="ModuleCode" @bind-Value="_moduleCode" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="3"><MudTextField Label="ActionCode" @bind-Value="_actionCode" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="3"><MudSelect T="string" Label="ScopeCode" @bind-Value="_scopeCode" Variant="Variant.Outlined"><MudSelectItem Value="@("None")">@Language.T("security.none")</MudSelectItem><MudSelectItem Value="@("Own")">@Language.T("security.own")</MudSelectItem><MudSelectItem Value="@("Employee")">@Language.T("security.employee")</MudSelectItem><MudSelectItem Value="@("Department")">@Language.T("common.department2")</MudSelectItem><MudSelectItem Value="@("All")">@Language.T("security.all")</MudSelectItem></MudSelect></MudItem>
                    <MudItem xs="12" md="3"><MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFunctionAsync">@Language.T("security.luuFunction")</MudButton></MudItem>
                </MudGrid>
                <MudDivider Class="my-4" />
                <MudTable T="SecurityFunctionDto" Items="_functions" Dense="true" Hover="true">
                    <HeaderContent><MudTh>@Language.T("common.code2")</MudTh><MudTh>@Language.T("common.module")</MudTh><MudTh>@Language.T("common.action2")</MudTh><MudTh>@Language.T("security.detail")</MudTh><MudTh /></HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FunctionCode</MudTd><MudTd>@context.ModuleCode</MudTd><MudTd>@context.ActionCode</MudTd><MudTd>@context.Detail</MudTd>
                        <MudTd><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => DeleteFunctionAsync(context.IdFunction))">@Language.T("security.xoaNgung")</MudButton></MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@Language.T("security.crudRole")" Icon="@Icons.Material.Filled.Group">
            <MudPaper Class="pa-4" Outlined="true">
                <MudGrid>
                    <MudItem xs="12" md="2"><MudNumericField T="int" Label="RoleCode" @bind-Value="_roleCode" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField Label="RoleName" @bind-Value="_roleName" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="4"><MudTextField Label="@Language.T("security.detail")" @bind-Value="_roleDetail" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" md="2"><MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoleAsync">@Language.T("security.luuRole2")</MudButton></MudItem>
                </MudGrid>
                <MudDivider Class="my-4" />
                <MudTable T="SecurityRoleDto" Items="_roles" Dense="true" Hover="true">
                    <HeaderContent><MudTh>@Language.T("common.code2")</MudTh><MudTh>@Language.T("security.role")</MudTh><MudTh>@Language.T("security.detail")</MudTh><MudTh>@Language.T("security.system")</MudTh><MudTh /></HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.RoleCode</MudTd><MudTd>@context.RoleName</MudTd><MudTd>@context.Detail</MudTd><MudTd>@(context.IsSystem ? "Yes" : "No")</MudTd>
                        <MudTd><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => DeleteRoleAsync(context.Id))">@Language.T("security.xoaNgung")</MudButton></MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudStack>
}

@code {
    private List<SecurityFunctionRegistryItemDto> _items = new();
    private List<SecurityFunctionDto> _functions = new();
    private List<SecurityRoleDto> _roles = new();
    private SecurityFunctionDiscoverySummaryDto? _summary;
    private bool _busy;
    private bool _authorized;
    private string? _selectedKey;
    private readonly Dictionary<string, string> _replacementByFunction = new(StringComparer.OrdinalIgnoreCase);
    private int _functionCode;
    private string _functionKey = string.Empty;
    private string _functionName = string.Empty;
    private string _functionDetail = string.Empty;
    private string? _moduleCode;
    private string? _actionCode;
    private string _scopeCode = "None";
    private int _roleCode;
    private string _roleName = string.Empty;
    private string? _roleDetail;

    private IEnumerable<SecurityFunctionRegistryItemDto> PendingRegistration => _items.Where(x => x.LifecycleStatus == "PendingRegistration" && !x.IsIgnored);
    private IEnumerable<SecurityFunctionRegistryItemDto> PendingRetirement => _items.Where(x => x.LifecycleStatus == "PendingRetirement");
    private IEnumerable<SecurityFunctionRegistryItemDto> ActiveFunctions => _items.Where(x => x.Registered && x.LifecycleStatus == "Active");

    protected override async Task OnInitializedAsync()
    {
        var permissions = await SecurityService.GetMyPermissionsAsync();
        _authorized = permissions.IsSuccess && permissions.Data?.Has(SecurityFunctionCodes.SecurityManageFunctions) == true;
        if (_authorized)
            await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try { await ScanAsync(false); await LoadCatalogsAsync(); }
        finally { _busy = false; }
    }

    private async Task ScanAsync() => await ScanAsync(true);
    private async Task ScanAsync(bool showMessage)
    {
        var result = await SecurityService.ScanSecurityFunctionsAsync();
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheQuetChucNang"), Severity.Error); return; }
        _summary = result.Data;
        await LoadCatalogsAsync();
        if (showMessage) Snackbar.Add(Language.T("security.daQuetVaDoiChieu"), Severity.Success);
    }

    private async Task LoadCatalogsAsync()
    {
        var registry = await SecurityService.GetSecurityFunctionRegistryAsync();
        if (registry.IsSuccess) _items = registry.Data?.ToList() ?? new();
        var functions = await SecurityService.GetFunctionsAsync();
        if (functions.IsSuccess) _functions = functions.Data ?? new();
        var roles = await SecurityService.GetRolesAsync();
        if (roles.IsSuccess) _roles = roles.Data ?? new();
    }

    private async Task RegisterOrPrepareAsync(SecurityFunctionRegistryItemDto item)
    {
        if (item.FunctionCode <= 0)
        {
            SelectForRegistration(item);
            Snackbar.Add(Language.T("security.laCandidateChuaCoFunctioncode", item.FunctionKey), Severity.Info);
            return;
        }

        var request = new RegisterDiscoveredFunctionRequest(
            item.DefinitionName,
            $"Security capability {item.FunctionKey}",
            item.ModuleCode,
            item.ActionCode,
            item.ScopeCode);

        _busy = true;
        try
        {
            var result = await SecurityService.RegisterSecurityFunctionAsync(item.FunctionKey, request);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheDangKy", item.FunctionKey), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("security.daDangKyFunction", item.FunctionKey), Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void SelectForRegistration(SecurityFunctionRegistryItemDto item)
    {
        _selectedKey = item.FunctionKey;
        _functionCode = item.FunctionCode;
        _functionKey = item.FunctionKey;
        _functionName = item.DefinitionName;
        _functionDetail = $"Security capability {item.FunctionKey}";
        _moduleCode = item.ModuleCode;
        _actionCode = item.ActionCode;
        _scopeCode = item.ScopeCode ?? "None";
    }

    private async Task SaveFunctionAsync()
    {
        var request = new SecurityFunctionUpsertRequest(_functionCode, _functionKey, _functionName, _functionDetail, _moduleCode, _actionCode, _scopeCode);
        var result = await SecurityService.UpsertSecurityFunctionAsync(request);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheLuuFunction"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.daLuuFunction"), Severity.Success); await ReloadAsync();
    }

    private async Task DeleteFunctionAsync(int idFunction)
    {
        if (idFunction <= 0) return;
        var result = await SecurityService.DeleteSecurityFunctionAsync(idFunction);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheXoaNgungFunction"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.functionDaDuocXoaHoac"), Severity.Success); await ReloadAsync();
    }

    private async Task SaveRoleAsync()
    {
        var result = await SecurityService.UpsertSecurityRoleAsync(new SecurityRoleUpsertRequest(_roleCode, _roleName, _roleDetail));
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheLuuRole2"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.daLuuRole"), Severity.Success); await ReloadAsync();
    }

    private async Task DeleteRoleAsync(int id)
    {
        var result = await SecurityService.DeleteSecurityRoleAsync(id);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheXoaNgungRole"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.roleDaDuocXoaHoac"), Severity.Success); await ReloadAsync();
    }

    private async Task IgnoreAsync(SecurityFunctionRegistryItemDto item)
    {
        var result = await SecurityService.IgnoreSecurityFunctionAsync(item.FunctionKey);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheBoQua"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.daBoQua", item.FunctionKey), Severity.Info); await ReloadAsync();
    }

    private void SetReplacement(string key, string value) => _replacementByFunction[key] = value;
    private bool HasReplacement(string key) => _replacementByFunction.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value);

    private async Task RetireAsync(SecurityFunctionRegistryItemDto item)
    {
        var result = await SecurityService.RetireSecurityFunctionAsync(item.FunctionKey);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheNgungFunction"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.daNgung", item.FunctionKey), Severity.Success); await ReloadAsync();
    }

    private async Task ReplaceAsync(SecurityFunctionRegistryItemDto item)
    {
        if (!HasReplacement(item.FunctionKey)) return;
        var result = await SecurityService.ReplaceSecurityFunctionAsync(item.FunctionKey, new ReplaceFunctionRequest(_replacementByFunction[item.FunctionKey]));
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? Language.T("security.khongTheThayTheFunction"), Severity.Error); return; }
        Snackbar.Add(Language.T("security.daDanhDauDuocThay", item.FunctionKey), Severity.Success); await ReloadAsync();
    }
}