@page "/admin/public-forms"
@attribute [Authorize]

@using FVN_REGISTER.Contract.Dtos.PublicForms
@using FVN_REGISTER.Contract.Requests.PublicForms
@using FVN_REGISTER.Shared.Handlers
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web

@inherits AppComponentBase

@inject IHttpClientWithAuth Http
@inject ISnackbar Snackbar

<PageTitle>@Language.T("public.forms")</PageTitle>

<MudText Typo="Typo.h5">
    <b>@Language.T("public.forms")</b>
</MudText>

<MudText Typo="Typo.body2"
         Color="Color.Secondary"
         Class="mb-4">
    @Language.T("public.hrTuTaoBieuMau")
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_form.FormCode"
                          Label="@Language.T("public.maBieuMau")"
                          Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_form.Title"
                          Label="@Language.T("public.tieuDe")"
                          Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_form.Description"
                          Label='@Language.T("common.description")'
                          Variant="Variant.Outlined" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudDatePicker Date="@_form.StartAt"
                           DateChanged="SetStartDate"
                           Label="@Language.T("public.ngayBatDau")"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           DateFormat="dd/MM/yyyy" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudDatePicker Date="@_form.EndAt"
                           DateChanged="SetEndDate"
                           Label="@Language.T("public.ngayKetThuc")"
                           Variant="Variant.Outlined"
                           Clearable="true"
                           MinDate="@(_form.StartAt?.Date)"
                           DateFormat="dd/MM/yyyy" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @Language.T("public.ngayKetThucDuocTinh")
            </MudText>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSwitch T="bool"
                       @bind-Value="_form.AllowMultipleSubmit">
                @Language.T("public.choPhepDangKyNhieu")
            </MudSwitch>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSwitch T="bool"
                       @bind-Value="_form.RequireApproval">
                @Language.T("public.yeuCauApproval")
            </MudSwitch>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.h6">@Language.T("public.doiTuongDangKy")</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        @Language.T("public.chonTuDuLieuGoc")
    </MudText>

    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudSelect T="string"
                       Value="@_audienceType"
                       ValueChanged="OnAudienceTypeChanged"
                       Label="@Language.T("public.doiTuongDangKy")"
                       Variant="Variant.Outlined">
                <MudSelectItem Value="@("AllCompany")">@Language.T("public.company")</MudSelectItem>
                <MudSelectItem Value="@("Department")">@Language.T("ot.department")</MudSelectItem>
                <MudSelectItem Value="@("Position")">@Language.T("equipment.location")</MudSelectItem>
                <MudSelectItem Value="@("Employee")">@Language.T("ot.employee")</MudSelectItem>
            </MudSelect>
        </MudItem>

        @if (_audienceType != "AllCompany")
        {
            <MudItem xs="12">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1">
                            @AudienceLabel
                        </MudText>

                        <MudSpacer />

                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                            @Language.T("common.daChon", _selectedAudienceValues.Count)
                        </MudChip>
                    </MudStack>

                    @if (_audienceType == "Employee")
                    {
                        <MudGrid Class="mt-2">
                            <MudItem xs="12" sm="9">
                                <MudTextField @bind-Value="_employeeSearch"
                                              Label="@Language.T("public.timMaNvTenPhong")"
                                              Variant="Variant.Outlined"
                                              Immediate="false"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnKeyDown="OnEmployeeSearchKeyDown" />
                            </MudItem>
                            <MudItem xs="12" sm="3">
                                <MudButton FullWidth="true"
                                           Class="mt-1"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="SearchEmployeesAsync">
                                    @Language.T("common.search")
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_employeeLoading)
                        {
                            <MudProgressLinear Class="mt-3" Indeterminate="true" />
                        }
                        else
                        {
                            <MudTable Items="_employeeItems"
                                      Dense="true"
                                      Hover="true"
                                      Class="mt-3">
                                <HeaderContent>
                                    <MudTh Style="width:56px"></MudTh>
                                    <MudTh>@Language.T("common.employeeCode")</MudTh>
                                    <MudTh>@Language.T("common.employeeName")</MudTh>
                                    <MudTh>@Language.T("public.phongViTri")</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudCheckBox T="bool"
                                                     Value="@_selectedAudienceValues.Contains(context.Code)"
                                                     ValueChanged="@(value => SetAudienceSelection(context, value))"
                                                     Color="Color.Primary" />
                                    </MudTd>
                                    <MudTd>@context.Code</MudTd>
                                    <MudTd>@context.Name</MudTd>
                                    <MudTd>@context.Secondary</MudTd>
                                </RowTemplate>
                            </MudTable>

                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween"
                                      AlignItems="AlignItems.Center"
                                      Class="mt-2">
                                <MudText Typo="Typo.caption">
                                    @Language.T("public.trangTongNhanVien", _employeePage, Math.Max(1, _employeeTotalPages), _employeeTotalCount)
                                </MudText>

                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Disabled="@(_employeePage <= 1)"
                                               OnClick="PreviousEmployeePageAsync">
                                        @Language.T("common.previous")
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Disabled="@(_employeePage >= _employeeTotalPages)"
                                               OnClick="NextEmployeePageAsync">
                                        @Language.T("common.next")
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        }
                    }
                    else
                    {
                        <MudPaper Class="mt-3 pa-2" Style="max-height:360px; overflow-y:auto;" Outlined="true">
                            @if (_masterLoading)
                            {
                                <MudProgressLinear Indeterminate="true" />
                            }
                            else if (!_masterItems.Any())
                            {
                                <MudAlert Severity="Severity.Info">
                                    @Language.T("public.khongCoDuLieuMaster")
                                </MudAlert>
                            }
                            else
                            {
                                @foreach (var item in _masterItems)
                                {
                                    <MudCheckBox T="bool"
                                                 Value="@_selectedAudienceValues.Contains(item.Code)"
                                                 ValueChanged="@(value => SetAudienceSelection(item, value))"
                                                 Label="@($"{item.Code} - {item.Name}")"
                                                 Color="Color.Primary" />
                                }
                            }
                        </MudPaper>
                    }

                    @if (_selectedAudienceValues.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2">
                            @Language.T("common.daChon", string.Join(", ", _selectedAudienceLabels.Values.OrderBy(x => x)))
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        }
        else
        {
            <MudItem xs="12" sm="8">
                <MudAlert Severity="Severity.Info">
                    <b>@Language.T("public.company")</b>@Language.T("public.apDungChoTatCa")
                </MudAlert>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">@Language.T("public.cauHoi")</MudText>
        <MudSpacer />
        <MudButton OnClick="AddQuestion" Variant="Variant.Outlined">
            @Language.T("public.themCauHoi")
        </MudButton>
    </MudStack>

    @foreach (var q in _form.Questions.OrderBy(x => x.Sequence))
    {
        <MudPaper Class="pa-3 mt-3" Outlined="true">
            <MudGrid>
                <MudItem xs="12" sm="3">
                    <MudTextField @bind-Value="q.QuestionCode"
                                  Label="@Language.T("common.code2")"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="q.QuestionText"
                                  Label="@Language.T("public.cauHoi")"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudSelect T="string"
                               @bind-Value="q.QuestionType"
                               Label='@Language.T("common.type")'
                               Variant="Variant.Outlined">
                        @foreach (var t in Types)
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="1">
                    <MudSwitch T="bool" @bind-Value="q.IsRequired">
                        @Language.T("common.required")
                    </MudSwitch>
                </MudItem>
            </MudGrid>

            @if (q.QuestionType == "SingleChoice" || q.QuestionType == "MultiChoice")
            {
                @foreach (var o in q.Options)
                {
                    <MudTextField Class="mt-2"
                                  @bind-Value="o.OptionText"
                                  Label="@o.OptionCode"
                                  Variant="Variant.Outlined" />
                }

                <MudButton Size="Size.Small"
                           OnClick="@(() => q.Options.Add(new SavePublicFormOptionRequest
                           {
                               OptionCode = $"OPT{q.Options.Count + 1}",
                               Sequence = q.Options.Count + 1
                           }))">
                    @Language.T("public.option")
                </MudButton>
            }
        </MudPaper>
    }

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync">
            @Language.T("common.luuNhap")
        </MudButton>
    </MudStack>
</MudPaper>

<MudTable Items="_items" Dense="true" Hover="true">
    <HeaderContent>
        <MudTh>@Language.T("common.code")</MudTh>
        <MudTh>@Language.T("common.tieuDe")</MudTh>
        <MudTh>@Language.T("common.thoiGian")</MudTh>
        <MudTh>@Language.T("common.status")</MudTh>
        <MudTh>@Language.T("public.doiTuong")</MudTh>
        <MudTh>@Language.T("common.action")</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.FormCode</MudTd>
        <MudTd><b>@context.Title</b></MudTd>
        <MudTd>
            @(context.StartAt?.ToString("dd/MM/yyyy") ?? Language.T("public.chuaDat"))
            -
            @(context.EndAt?.ToString("dd/MM/yyyy") ?? Language.T("public.khongGioiHan"))
        </MudTd>
        <MudTd>@context.Status</MudTd>
        <MudTd>
            @if (context.Audiences.Any(x => x.ScopeType == "AllCompany"))
            {
                <MudChip T="string" Size="Size.Small">@Language.T("public.company")</MudChip>
            }
            else
            {
                @string.Join(", ", context.Audiences.Select(x => $"{x.ScopeType}:{x.ScopeValue}"))
            }
        </MudTd>
        <MudTd>
            @if (context.Status == "Draft")
            {
                <MudButton Size="Size.Small"
                           Variant="Variant.Outlined"
                           OnClick="@(() => EditAsync(context.Id))">
                    @Language.T("common.edit")
                </MudButton>
            }

            <MudButton Size="Size.Small"
                       OnClick="@(() => PublishAsync(context.Id))"
                       Disabled="@(context.Status != "Draft")">
                @Language.T("common.publish")
            </MudButton>

            <MudButton Size="Size.Small"
                       Color="Color.Error"
                       OnClick="@(() => CloseAsync(context.Id))"
                       Disabled="@(context.Status == "Closed" || context.Status == "Archived")">
                @Language.T("public.close")
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private static readonly string[] Types =
    {
        "Text", "Textarea", "Number", "Date", "Time", "DateTime",
        "SingleChoice", "MultiChoice", "YesNo", "Department", "Employee", "File"
    };

    private List<PublicFormDto> _items = new();
    private SavePublicFormRequest _form = NewForm();
    private int? _editingId;

    private string _audienceType = "AllCompany";
    private HashSet<string> _selectedAudienceValues = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _selectedAudienceLabels = new(StringComparer.OrdinalIgnoreCase);

    private List<PublicFormAudienceLookupDto> _masterItems = new();
    private bool _masterLoading;
    private string _employeeSearch = string.Empty;
    private List<PublicFormAudienceLookupDto> _employeeItems = new();
    private bool _employeeLoading;
    private int _employeePage = 1;
    private const int EmployeePageSize = 25;
    private int _employeeTotalCount;
    private int _employeeTotalPages = 1;

    private string AudienceLabel => _audienceType switch
    {
        "Department" => Language.T("public.chonPhongBan"),
        "Position" => Language.T("public.chonViTri"),
        "Employee" => Language.T("public.chonNhanVien"),
        _ => Language.T("public.doiTuong")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var r = await Http.GetAsync<List<PublicFormDto>>("api/public-forms/manage");

        if (r.IsSuccess)
        {
            _items = r.Data ?? new List<PublicFormDto>();
        }
        else
        {
            Snackbar.Add(r.Message ?? Language.T("public.khongTaiDuocForm"), Severity.Error);
        }
    }

    private async Task EditAsync(int id)
    {
        var response = await Http.GetAsync<PublicFormDto>($"api/public-forms/{id}");
        if (!response.IsSuccess || response.Data == null)
        {
            Snackbar.Add(response.Message ?? Language.T("message.loadFailed"), Severity.Error);
            return;
        }

        var form = response.Data;
        _editingId = id;
        _form = new SavePublicFormRequest
        {
            FormCode = form.FormCode,
            Title = form.Title,
            Description = form.Description,
            CategoryCode = form.CategoryCode,
            StartAt = form.StartAt,
            EndAt = form.EndAt,
            AllowMultipleSubmit = form.AllowMultipleSubmit,
            RequireApproval = form.RequireApproval,
            MaxSubmissions = form.MaxSubmissions,
            Audiences = form.Audiences.Select(x => new SavePublicFormAudienceRequest
            {
                ScopeType = x.ScopeType,
                ScopeValue = x.ScopeValue
            }).ToList(),
            Questions = form.Questions.OrderBy(x => x.Sequence).Select(q => new SavePublicFormQuestionRequest
            {
                QuestionCode = q.QuestionCode,
                QuestionText = q.QuestionText,
                QuestionType = q.QuestionType,
                HelpText = q.HelpText,
                Placeholder = q.Placeholder,
                IsRequired = q.IsRequired,
                Sequence = q.Sequence,
                Options = q.Options.OrderBy(x => x.Sequence).Select(o => new SavePublicFormOptionRequest
                {
                    OptionCode = o.OptionCode,
                    OptionText = o.OptionText,
                    Sequence = o.Sequence
                }).ToList()
            }).ToList()
        };

        _audienceType = _form.Audiences.FirstOrDefault()?.ScopeType ?? "AllCompany";
        _selectedAudienceValues = _form.Audiences
            .Where(x => !string.Equals(x.ScopeType, "AllCompany", StringComparison.OrdinalIgnoreCase))
            .Select(x => x.ScopeValue)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _selectedAudienceLabels = _selectedAudienceValues.ToDictionary(x => x, x => x, StringComparer.OrdinalIgnoreCase);

        if (_audienceType == "Department" || _audienceType == "Position")
            await LoadMasterAudienceAsync(_audienceType);
        else if (_audienceType == "Employee")
            await LoadEmployeesAsync(1);

        await InvokeAsync(StateHasChanged);
    }

    private void SetStartDate(DateTime? value)
    {
        _form.StartAt = value?.Date;

        if (_form.EndAt.HasValue && _form.StartAt.HasValue && _form.EndAt.Value.Date < _form.StartAt.Value.Date)
            _form.EndAt = null;
    }

    private void SetEndDate(DateTime? value)
    {
        _form.EndAt = value.HasValue
            ? value.Value.Date.AddDays(1).AddTicks(-1)
            : null;
    }

    private async Task OnAudienceTypeChanged(string value)
    {
        _audienceType = value;
        _selectedAudienceValues.Clear();
        _selectedAudienceLabels.Clear();
        _masterItems.Clear();
        _employeeItems.Clear();
        _employeePage = 1;
        _employeeTotalCount = 0;
        _employeeTotalPages = 1;

        if (value == "Department" || value == "Position")
            await LoadMasterAudienceAsync(value);
        else if (value == "Employee")
            await LoadEmployeesAsync(1);
    }

    private async Task LoadMasterAudienceAsync(string type)
    {
        _masterLoading = true;
        try
        {
            var endpoint = type == "Department"
                ? "api/public-forms/audience/departments"
                : "api/public-forms/audience/positions";

            var r = await Http.GetAsync<List<PublicFormAudienceLookupDto>>(endpoint);
            if (r.IsSuccess)
                _masterItems = r.Data ?? new();
            else
                Snackbar.Add(r.Message ?? Language.T("public.khongTaiDuocDuLieu2"), Severity.Error);
        }
        finally
        {
            _masterLoading = false;
        }
    }

    private async Task LoadEmployeesAsync(int page)
    {
        _employeeLoading = true;
        try
        {
            var search = Uri.EscapeDataString(_employeeSearch.Trim());
            var r = await Http.GetAsync<PublicFormAudienceEmployeePageDto>(
                $"api/public-forms/audience/employees?search={search}&page={page}&pageSize={EmployeePageSize}");

            if (r.IsSuccess && r.Data != null)
            {
                _employeeItems = r.Data.Items ?? new();
                _employeePage = r.Data.Page;
                _employeeTotalCount = r.Data.TotalCount;
                _employeeTotalPages = Math.Max(1, r.Data.TotalPages);
            }
            else
            {
                Snackbar.Add(r.Message ?? Language.T("public.khongTaiDuocDanhSach2"), Severity.Error);
            }
        }
        finally
        {
            _employeeLoading = false;
        }
    }

    private Task SearchEmployeesAsync()
        => LoadEmployeesAsync(1);

    private async Task OnEmployeeSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchEmployeesAsync();
    }

    private async Task PreviousEmployeePageAsync()
    {
        if (_employeePage > 1)
            await LoadEmployeesAsync(_employeePage - 1);
    }

    private async Task NextEmployeePageAsync()
    {
        if (_employeePage < _employeeTotalPages)
            await LoadEmployeesAsync(_employeePage + 1);
    }

    private void SetAudienceSelection(PublicFormAudienceLookupDto item, bool selected)
    {
        if (selected)
        {
            _selectedAudienceValues.Add(item.Code);
            _selectedAudienceLabels[item.Code] = $"{item.Code} - {item.Name}";
        }
        else
        {
            _selectedAudienceValues.Remove(item.Code);
            _selectedAudienceLabels.Remove(item.Code);
        }
    }

    private List<SavePublicFormAudienceRequest> BuildAudienceRequests()
    {
        if (_audienceType == "AllCompany")
        {
            return new List<SavePublicFormAudienceRequest>
            {
                new() { ScopeType = "AllCompany", ScopeValue = null }
            };
        }

        return _selectedAudienceValues
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Select(x => new SavePublicFormAudienceRequest
            {
                ScopeType = _audienceType,
                ScopeValue = x
            })
            .ToList();
    }

    private async Task SaveAsync()
    {
        var audiences = BuildAudienceRequests();

        if (audiences.Count == 0)
        {
            Snackbar.Add(Language.T("public.banChuaChonDoiTuong"), Severity.Warning);
            return;
        }

        if (_form.EndAt.HasValue && _form.StartAt.HasValue && _form.EndAt.Value < _form.StartAt.Value)
        {
            Snackbar.Add(Language.T("public.ngayKetThucPhaiLon"), Severity.Warning);
            return;
        }

        _form.Audiences = audiences;

        var r = _editingId.HasValue
            ? await Http.PutAsync<PublicFormDto>($"api/public-forms/{_editingId.Value}", _form)
            : await Http.PostAsync<PublicFormDto>("api/public-forms", _form);

        if (r.IsSuccess)
        {
            Snackbar.Add(_editingId.HasValue
                ? Language.T("common.updated")
                : Language.T("public.daLuuBieuMauNhap"), Severity.Success);
            _editingId = null;
            _form = NewForm();
            _audienceType = "AllCompany";
            _selectedAudienceValues.Clear();
            _selectedAudienceLabels.Clear();
            _masterItems.Clear();
            _employeeItems.Clear();
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(r.Message ?? Language.T("message.saveFailed"), Severity.Error);
        }
    }

    private void AddQuestion()
    {
        _form.Questions.Add(new SavePublicFormQuestionRequest
        {
            QuestionCode = $"Q{_form.Questions.Count + 1}",
            QuestionText = "",
            Sequence = _form.Questions.Count + 1
        });
    }

    private async Task PublishAsync(int id)
    {
        var r = await Http.PostAsync<object>($"api/public-forms/{id}/publish", new { });

        if (r.IsSuccess)
        {
            Snackbar.Add(Language.T("public.daPublish"), Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(r.Message ?? Language.T("public.publishThatBai"), Severity.Error);
        }
    }

    private async Task CloseAsync(int id)
    {
        var r = await Http.PostAsync<object>($"api/public-forms/{id}/close", new { });

        if (r.IsSuccess)
        {
            Snackbar.Add(Language.T("public.daDong"), Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(r.Message ?? Language.T("public.closeThatBai"), Severity.Error);
        }
    }

    private static SavePublicFormRequest NewForm()
    {
        return new SavePublicFormRequest
        {
            AllowMultipleSubmit = false,
            StartAt = null,
            EndAt = null,
            Audiences = new()
            {
                new SavePublicFormAudienceRequest
                {
                    ScopeType = "AllCompany",
                    ScopeValue = null
                }
            },
            Questions = new()
            {
                new SavePublicFormQuestionRequest
                {
                    QuestionCode = "Q1",
                    QuestionText = "",
                    QuestionType = "Text",
                    IsRequired = true,
                    Sequence = 1
                }
            }
        };
    }
}
