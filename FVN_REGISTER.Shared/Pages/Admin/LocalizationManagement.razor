@page "/admin/localization"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Language
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@inherits AppComponentBase
@inject ISecurityClientService SecurityService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@Language.T("language.title")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
        <div>
            <MudText Typo="Typo.h5">@Language.T("language.title")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Language.T("language.subtitle")</MudText>
        </div>
        @if (_canView)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                @if (_canAudit)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FindInPage" OnClick="AuditAsync" Disabled="@_loadingAudit">
                        @(_loadingAudit ? Language.T("common.loading") : Language.T("language.scan"))
                    </MudButton>
                }
                @if (_canExport)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportAsync" Disabled="@_exporting">
                        @Language.T("language.exportExcel")
                    </MudButton>
                }
                @if (_canManage)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewEntry">
                        @Language.T("language.newEntry")
                    </MudButton>
                }
            </MudStack>
        }
    </MudStack>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!_canView)
    {
        <MudAlert Severity="Severity.Warning">@Language.T("language.noViewPermission")</MudAlert>
    }
    else
    {
        <MudTabs Rounded="true" Elevation="1">
            <MudTabPanel Text="@Language.T("language.catalog")" Icon="@Icons.Material.Filled.Translate">
                <MudGrid Spacing="3" Class="pa-3">
                    <MudItem xs="12" lg="8">
                        <MudPaper Outlined="true" Class="pa-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h6">@Language.T("language.catalog")</MudText>
                                <MudChip T="string" Size="Size.Small">@_entries.Count @Language.T("language.entries")</MudChip>
                            </MudStack>

                            <MudGrid Spacing="2" Class="mt-1">
                                <MudItem xs="12" sm="5">
                                    <MudTextField T="string" @bind-Value="_search" Label="@Language.T("common.search")" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="string" @bind-Value="_module" Label="@Language.T("language.module")" Variant="Variant.Outlined" Dense="true">
                                        <MudSelectItem Value="@string.Empty">@Language.T("common.all")</MudSelectItem>
                                        @foreach (var module in _modules)
                                        {
                                            <MudSelectItem Value="@module">@module</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-1" OnClick="LoadAsync">@Language.T("common.refresh")</MudButton>
                                </MudItem>
                            </MudGrid>

                            @if (_canImport)
                            {
                                <MudPaper Outlined="true" Class="pa-3 mt-3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">@Language.T("language.importExcel")</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("language.importFormat")</MudText>
                                        </div>
                                        <MudFileUpload T="IBrowserFile" FilesChanged="OnImportFileChanged" Accept=".xlsx,.xlsm" MaxFileSize="25000000">
                                            <ButtonTemplate Context="upload">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@upload.OpenFilePickerAsync">@Language.T("language.chooseExcel")</MudButton>
                                            </ButtonTemplate>
                                        </MudFileUpload>
                                    </MudStack>
                                    @if (_importFile != null)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                                            <MudText Typo="Typo.caption">@_importFile.Name</MudText>
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="ImportAsync" Disabled="@_importing">@(_importing ? Language.T("common.loading") : Language.T("language.import"))</MudButton>
                                        </MudStack>
                                    }
                                </MudPaper>
                            }

                            <MudTable Items="FilteredEntries" Dense="true" Hover="true" Striped="true" Class="mt-3" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>Key</MudTh>
                                    <MudTh>@Language.T("language.module")</MudTh>
                                    <MudTh>VI</MudTh>
                                    <MudTh>JA</MudTh>
                                    <MudTh>@Language.T("common.action")</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><MudText Typo="Typo.caption">@context.Key</MudText></MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small">@context.Module</MudChip></MudTd>
                                    <MudTd><MudText Typo="Typo.body2">@context.Vi</MudText></MudTd>
                                    <MudTd><MudText Typo="Typo.body2">@context.Ja</MudText></MudTd>
                                    <MudTd>
                                        @if (_canManage)
                                        {
                                            <MudStack Row="true" Spacing="1">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditEntry(context))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAsync(context))" />
                                            </MudStack>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" lg="4">
                        <MudPaper Outlined="true" Class="pa-4 sticky-editor">
                            <MudText Typo="Typo.h6">@(_editing ? Language.T("language.editEntry") : Language.T("language.newEntry"))</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("language.editorHint")</MudText>
                            <MudTextField T="string" @bind-Value="_draft.Key" Label="Key" Variant="Variant.Outlined" Disabled="@(!_canManage || _editing)" Class="mt-3" />
                            <MudSelect T="string" @bind-Value="_draft.Module" Label="@Language.T("language.module")" Variant="Variant.Outlined" Disabled="@(!_canManage)" Class="mt-2">
                                @foreach (var module in EditorModules)
                                {
                                    <MudSelectItem Value="@module">@module</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" @bind-Value="_draft.Vi" Label="VI" Variant="Variant.Outlined" Lines="3" Disabled="@(!_canManage)" Class="mt-2" />
                            <MudTextField T="string" @bind-Value="_draft.Ja" Label="JA" Variant="Variant.Outlined" Lines="3" Disabled="@(!_canManage)" Class="mt-2" />
                            @if (_canManage)
                            {
                                <MudStack Row="true" Class="mt-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_saving">@(_saving ? Language.T("common.loading") : Language.T("common.save"))</MudButton>
                                    <MudButton Variant="Variant.Outlined" OnClick="NewEntry">@Language.T("common.cancel")</MudButton>
                                </MudStack>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@Language.T("language.audit")" Icon="@Icons.Material.Filled.FindInPage">
                <MudPaper Outlined="true" Class="pa-4">
                    @if (!_canAudit)
                    {
                        <MudAlert Severity="Severity.Warning">@Language.T("language.noAuditPermission")</MudAlert>
                    }
                    else
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <div>
                                <MudText Typo="Typo.h6">@Language.T("language.audit")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @(_audit == null ? Language.T("language.auditHint") : $"{Language.T("language.lastScan")}: {_audit.ScannedAt:dd/MM/yyyy HH:mm:ss}")
                                </MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AuditAsync" Disabled="@_loadingAudit">@Language.T("language.scan")</MudButton>
                        </MudStack>

                        @if (_audit != null)
                        {
                            <MudGrid Spacing="2" Class="mt-3">
                                <MudItem xs="6" sm="3" md="2"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.h4">@_audit.Summary.Total</MudText><MudText Typo="caption">@Language.T("language.totalIssues")</MudText></MudPaper></MudItem>
                                <MudItem xs="6" sm="3" md="2"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.h5">@_audit.Summary.HardCodedUi</MudText><MudText Typo="caption">@Language.T("language.hardcoded")</MudText></MudPaper></MudItem>
                                <MudItem xs="6" sm="3" md="2"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.h5">@_audit.Summary.MissingKey</MudText><MudText Typo="caption">@Language.T("language.missingKey")</MudText></MudPaper></MudItem>
                                <MudItem xs="6" sm="3" md="2"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.h5">@_audit.Summary.MissingJa</MudText><MudText Typo="caption">@Language.T("language.missingJa")</MudText></MudPaper></MudItem>
                                <MudItem xs="6" sm="3" md="2"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.h5">@_audit.Summary.MissingVi</MudText><MudText Typo="caption">@Language.T("language.missingVi")</MudText></MudPaper></MudItem>
                                <MudItem xs="6" sm="3" md="2"><MudPaper Outlined="true" Class="pa-3"><MudText Typo="Typo.h5">@_audit.Summary.UnusedKey</MudText><MudText Typo="caption">@Language.T("language.unused")</MudText></MudPaper></MudItem>
                            </MudGrid>

                            @if (!_audit.SourceAvailable)
                            {
                                <MudAlert Severity="Severity.Warning" Class="mt-3">@Language.T("language.sourceUnavailable")</MudAlert>
                            }

                            <MudTable Items="_audit.Findings" Dense="true" Hover="true" Class="mt-3">
                                <HeaderContent>
                                    <MudTh>@Language.T("language.type")</MudTh>
                                    <MudTh>@Language.T("language.source")</MudTh>
                                    <MudTh>Key</MudTh>
                                    <MudTh>@Language.T("language.detected")</MudTh>
                                    <MudTh>@Language.T("common.action")</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><MudChip T="string" Size="Size.Small">@context.Type</MudChip></MudTd>
                                    <MudTd><MudText Typo="Typo.caption">@context.SourceFile:@context.Line</MudText></MudTd>
                                    <MudTd><MudText Typo="Typo.caption">@context.ExistingKey</MudText></MudTd>
                                    <MudTd><MudText Typo="Typo.body2">@context.DetectedText</MudText></MudTd>
                                    <MudTd>
                                        @if (_canManage && (context.Type == "HardCodedUi" || context.Type == "MissingKey"))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => DefineFromFinding(context))">@Language.T("language.define")</MudButton>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<style>
    .sticky-editor { position: sticky; top: 16px; }
</style>

@code {
    private const int LanguageView = 3201;
    private const int LanguageManage = 3202;
    private const int LanguageImport = 3203;
    private const int LanguageExport = 3204;
    private const int LanguageAudit = 3205;

    private PermissionSnapshotDto? _permissions;
    private bool _loaded, _saving, _importing, _exporting, _loadingAudit, _editing;
    private bool _canView, _canManage, _canImport, _canExport, _canAudit;
    private string _search = string.Empty;
    private string _module = string.Empty;
    private List<LocalizationEntryDto> _entries = new();
    private List<string> _modules = new();
    private LocalizationUpsertRequest _draft = new();
    private IBrowserFile? _importFile;
    private LocalizationAuditResultDto? _audit;

    private IEnumerable<LocalizationEntryDto> FilteredEntries =>
        _entries.Where(x =>
            (string.IsNullOrWhiteSpace(_module) || string.Equals(x.Module, _module, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_search) ||
             x.Key.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             x.Vi.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             x.Ja.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<string> EditorModules =>
        _modules.Concat(new[] { "common" }).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loaded = false;
        try
        {
            var permission = await SecurityService.GetMyPermissionsAsync();
            if (!permission.IsSuccess)
            {
                Snackbar.Add(permission.Message, Severity.Error);
                return;
            }

            _permissions = permission.Data;
            _canView = _permissions?.Has(LanguageView) == true;
            _canManage = _permissions?.Has(LanguageManage) == true;
            _canImport = _permissions?.Has(LanguageImport) == true;
            _canExport = _permissions?.Has(LanguageExport) == true;
            _canAudit = _permissions?.Has(LanguageAudit) == true;

            if (_canView)
            {
                var catalog = await SecurityService.GetLocalizationCatalogAsync();
                if (catalog.IsSuccess && catalog.Data != null)
                {
                    _entries = catalog.Data.Entries ?? new();
                    _modules = catalog.Data.Modules ?? new();
                }
            }
            NewEntry();
        }
        finally
        {
            _loaded = true;
        }
    }

    private void NewEntry()
    {
        _editing = false;
        _draft = new LocalizationUpsertRequest { Module = string.IsNullOrWhiteSpace(_module) ? "common" : _module };
    }

    private void EditEntry(LocalizationEntryDto entry)
    {
        _editing = true;
        _draft = new LocalizationUpsertRequest
        {
            Key = entry.Key,
            Module = entry.Module,
            Vi = entry.Vi,
            Ja = entry.Ja
        };
    }

    private void DefineFromFinding(LocalizationAuditFindingDto finding)
    {
        _editing = false;
        _draft = new LocalizationUpsertRequest
        {
            Key = finding.ExistingKey ?? finding.SuggestedKey ?? "common.newKey",
            Module = InferModule(finding.ExistingKey ?? finding.SuggestedKey),
            Vi = finding.ViValue ?? finding.DetectedText ?? string.Empty,
            Ja = finding.JaValue ?? string.Empty
        };
        if (string.IsNullOrWhiteSpace(_draft.Ja) && !string.IsNullOrWhiteSpace(_draft.Vi))
            _draft.Ja = _draft.Vi;
        Snackbar.Add(Language.T("language.defineReady"), Severity.Info);
    }

    private async Task SaveAsync()
    {
        if (!_canManage) return;
        _saving = true;
        try
        {
            var result = await SecurityService.UpsertLocalizationAsync(_draft);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }
            Snackbar.Add(Language.T("language.saved"), Severity.Success);
            await LoadCatalogOnlyAsync();
            NewEntry();
        }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(LocalizationEntryDto entry)
    {
        if (!_canManage) return;
        var ok = await JS.InvokeAsync<bool>("confirm", Language.T("language.confirmDelete", entry.Key));
        if (!ok) return;

        var result = await SecurityService.DeleteLocalizationAsync(entry.Key);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message, Severity.Error);
            return;
        }
        Snackbar.Add(Language.T("language.deleted"), Severity.Success);
        await LoadCatalogOnlyAsync();
        NewEntry();
    }

    private async Task LoadCatalogOnlyAsync()
    {
        var result = await SecurityService.GetLocalizationCatalogAsync();
        if (result.IsSuccess && result.Data != null)
        {
            _entries = result.Data.Entries ?? new();
            _modules = result.Data.Modules ?? new();
        }
    }

    private void OnImportFileChanged(IBrowserFile? file) => _importFile = file;

    private async Task ImportAsync()
    {
        if (!_canImport || _importFile == null) return;
        _importing = true;
        try
        {
            await using var stream = _importFile.OpenReadStream(25_000_000);
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            content.Add(fileContent, "file", _importFile.Name);

            var result = await SecurityService.ImportLocalizationAsync(content);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("language.imported", result.Data?.Imported ?? 0), Severity.Success);
            _importFile = null;
            await LoadCatalogOnlyAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally { _importing = false; }
    }

    private async Task ExportAsync()
    {
        if (!_canExport) return;
        _exporting = true;
        try
        {
            var result = await SecurityService.ExportLocalizationAsync();
            if (!result.IsSuccess || result.Data == null)
            {
                Snackbar.Add(result.Message, Severity.Error);
                return;
            }

            var base64 = Convert.ToBase64String(result.Data);
            await JS.InvokeVoidAsync(
                "fvnFileDownload.downloadBase64",
                $"FVN_Localization_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        finally { _exporting = false; }
    }

    private async Task AuditAsync()
    {
        if (!_canAudit) return;
        _loadingAudit = true;
        try
        {
            var result = await SecurityService.AuditLocalizationAsync();
            if (result.IsSuccess)
                _audit = result.Data;
            else
                Snackbar.Add(result.Message, Severity.Error);
        }
        finally { _loadingAudit = false; }
    }

    private static string InferModule(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return "common";
        var dot = key.IndexOf('.');
        return dot > 0 ? key[..dot] : "common";
    }
}
