@page "/admin/attendance-symbol-rules"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Calendar
@using Microsoft.AspNetCore.Authorization
@using FVN_REGISTER.Shared.Handlers
@using FVN_REGISTER.Shared.Services.Calendar
@inject IHttpClientWithAuth Http
@inject ISnackbar Snackbar
<PageTitle>Rule ký hiệu chấm công</PageTitle>
<MudStack Spacing="3">
<MudStack Row="true" AlignItems="AlignItems.Center"><MudIcon Icon="@Icons.Material.Filled.Rule" Color="Color.Primary" Size="Size.Large"/><div><MudText Typo="Typo.h5" Style="font-weight:700">Rule ký hiệu chấm công / OT</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">Ca và In/Out lấy từ HRM; màn hình này chỉ định nghĩa cách sinh ký hiệu lịch.</MudText></div><MudSpacer/><MudButton Variant="Variant.Outlined" OnClick="LoadAsync" Disabled="_loading">Tải lại</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewRule">Thêm rule</MudButton></MudStack>
<MudGrid><MudItem xs="12" md="7"><MudTable Items="_rules" Dense="true" Hover="true" Striped="true" Loading="_loading"><HeaderContent><MudTh>Rule</MudTh><MudTh>Loại ngày</MudTh><MudTh>Ca</MudTh><MudTh>Priority</MudTh><MudTh>Trạng thái</MudTh><MudTh></MudTh></HeaderContent><RowTemplate><MudTd><b>@context.RuleCode</b><br/><MudText Typo="Typo.caption">@context.RuleName</MudText></MudTd><MudTd>@context.DayType</MudTd><MudTd>@context.ShiftCode</MudTd><MudTd>@context.Priority</MudTd><MudTd>@(context.IsActive?"Active":"Inactive")</MudTd><MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(()=>EditRule(context))"/>@if(context.IsActive){<MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(()=>Deactivate(context))"/>}</MudTd></RowTemplate></MudTable></MudItem>
<MudItem xs="12" md="5"><MudPaper Class="pa-4" Outlined="true"><MudText Typo="Typo.h6">@(_editingId is null?"Tạo rule":"Sửa rule")</MudText><MudGrid Class="mt-2"><MudItem xs="6"><MudTextField @bind-Value="_edit.RuleCode" Label="RuleCode" Variant="Variant.Outlined"/></MudItem><MudItem xs="6"><MudTextField @bind-Value="_edit.RuleName" Label="Tên rule" Variant="Variant.Outlined"/></MudItem><MudItem xs="6"><MudSelect T="string" @bind-Value="_edit.DayType" Label="Loại ngày" Variant="Variant.Outlined">@foreach(var x in DayTypes){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="6"><MudTextField @bind-Value="_edit.ShiftCode" Label="ShiftCode HRM" Variant="Variant.Outlined"/></MudItem><MudItem xs="4"><MudNumericField T="int" @bind-Value="_edit.Priority" Label="Priority" Variant="Variant.Outlined"/></MudItem><MudItem xs="4"><MudNumericField T="int" @bind-Value="_block" Label="Block phút" Variant="Variant.Outlined"/></MudItem><MudItem xs="4"><MudSelect T="string" @bind-Value="_rounding" Label="Làm tròn" Variant="Variant.Outlined"><MudSelectItem Value="@("FLOOR")">FLOOR</MudSelectItem><MudSelectItem Value="@("ROUND")">ROUND</MudSelectItem><MudSelectItem Value="@("CEILING")">CEILING</MudSelectItem></MudSelect></MudItem><MudItem xs="6"><MudNumericField T="int?" @bind-Value="_edit.MinActualMinutes" Label="Min In/Out" Variant="Variant.Outlined"/></MudItem><MudItem xs="6"><MudNumericField T="int?" @bind-Value="_fixedOt" Label="OT cố định phút" Variant="Variant.Outlined"/></MudItem></MudGrid><MudDivider Class="my-3"/><MudStack Row="true"><MudText><b>Segments</b></MudText><MudSpacer/><MudButton Size="Size.Small" OnClick="AddSegment">Thêm</MudButton></MudStack>@foreach(var s in _edit.Segments){<MudGrid Class="mt-1"><MudItem xs="2"><MudSelect T="string" @bind-Value="s.SegmentType" Label="Type"><MudSelectItem Value="@("WORK")">WORK</MudSelectItem><MudSelectItem Value="@("OT")">OT</MudSelectItem></MudSelect></MudItem><MudItem xs="2"><MudTextField @bind-Value="s.Start" Label="Từ"/></MudItem><MudItem xs="2"><MudTextField @bind-Value="s.End" Label="Đến"/></MudItem><MudItem xs="5"><MudTextField @bind-Value="s.SymbolTemplate" Label="Ký hiệu / template" HelperText="C1, K{hours}, T{hours}, TK{hours}"/></MudItem><MudItem xs="1"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(()=>RemoveSegment(s))"/></MudItem></MudGrid>}<MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3"><MudButton OnClick="NewRule">Hủy</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRule" Disabled="_saving">Lưu</MudButton></MudStack></MudPaper></MudItem></MudGrid>
<MudPaper Class="pa-4" Outlined="true"><MudStack Row="true"><MudText Typo="Typo.h6">Test Rule</MudText><MudSpacer/><MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="TestRule">Tính thử</MudButton></MudStack><MudGrid><MudItem xs="3"><MudDatePicker @bind-Date="_testDate" Label="Ngày"/></MudItem><MudItem xs="3"><MudSelect T="string" @bind-Value="_testDayType" Label="Loại ngày">@foreach(var x in DayTypes){<MudSelectItem Value="@x">@x</MudSelectItem>}</MudSelect></MudItem><MudItem xs="2"><MudTextField @bind-Value="_testShift" Label="Shift"/></MudItem><MudItem xs="2"><MudTextField @bind-Value="_testIn" Label="In HH:mm"/></MudItem><MudItem xs="2"><MudTextField @bind-Value="_testOut" Label="Out HH:mm"/></MudItem></MudGrid>@if(_testResult is not null){<MudAlert Severity="@(_testResult.Matched?Severity.Success:Severity.Warning)" Class="mt-2"><b>@(_testResult.Matched?$"Rule: {_testResult.RuleCode}":"Không match rule")</b><br/>Công: @(_testResult.WorkSymbol??"-") | OT: @(_testResult.OtSymbol??"-")<br/>@_testResult.Explanation</MudAlert>}</MudPaper>
</MudStack>
@code {
private static readonly string[] DayTypes=["NORMAL","COMPANY_SATURDAY","SUNDAY","NATIONAL_HOLIDAY","COMPANY_HOLIDAY","COMPENSATORY","OTHER"];
private AttendanceSymbolRuleClientService? _client;private List<AttendanceSymbolRuleDto> _rules=new();private AttendanceSymbolRuleUpsertRequest _edit=NewRequest();private int? _editingId;private int _block=15;private string _rounding="FLOOR";private int? _fixedOt;private bool _loading,_saving;private DateTime? _testDate=DateTime.Today;private string _testDayType="NORMAL",_testShift="C1",_testIn="05:49",_testOut="14:05";private AttendanceSymbolRuleTestResultDto? _testResult;private AttendanceSymbolRuleClientService Client=>_client??throw new InvalidOperationException("Rule client chưa được khởi tạo.");
protected override async Task OnInitializedAsync(){_client=new AttendanceSymbolRuleClientService(Http);await LoadAsync();}
private async Task LoadAsync(){_loading=true;try{var r=await Client.GetAllAsync();if(r.IsSuccess&&r.Data is not null)_rules=r.Data;else Snackbar.Add(r.Message??"Không thể tải rule",Severity.Error);}finally{_loading=false;}}
private void NewRule(){_editingId=null;_edit=NewRequest();_block=15;_rounding="FLOOR";_fixedOt=null;}
private void EditRule(AttendanceSymbolRuleDto x){_editingId=x.Id;_edit=new(){RuleCode=x.RuleCode,RuleName=x.RuleName,DayType=x.DayType,ShiftCode=x.ShiftCode,ShiftId=x.ShiftId,Priority=x.Priority,MinActualMinutes=x.MinActualMinutes,MaxActualMinutes=x.MaxActualMinutes,CheckInFrom=x.CheckInFrom,CheckInTo=x.CheckInTo,IsActive=x.IsActive,Segments=x.Segments.Select(s=>new AttendanceSymbolRuleSegmentDto{SegmentType=s.SegmentType,Start=s.Start,End=s.End,SymbolTemplate=s.SymbolTemplate,FixedMinutes=s.FixedMinutes}).ToList()};}
private async Task SaveRule(){_saving=true;try{_edit.BlockMinutes=_block;_edit.RoundingMode=_rounding;_edit.FixedOtMinutes=_fixedOt;_edit.AllocationMode=_fixedOt is >0?"FIXED_OT":"STANDARD";var r=_editingId is null?await Client.CreateAsync(_edit):await Client.UpdateAsync(_editingId.Value,_edit);if(r.IsSuccess){Snackbar.Add("Đã lưu rule",Severity.Success);await LoadAsync();NewRule();}else Snackbar.Add(r.Message??"Không thể lưu",Severity.Error);}finally{_saving=false;}}
private async Task Deactivate(AttendanceSymbolRuleDto x){var r=await Client.DeleteAsync(x.Id);if(r.IsSuccess){await LoadAsync();Snackbar.Add("Đã ngừng rule",Severity.Success);}else Snackbar.Add(r.Message??"Không thể ngừng rule",Severity.Error);}
private void AddSegment()=>_edit.Segments.Add(new(){SegmentType="OT",Start="14:00",End="18:00",SymbolTemplate="K{hours}"});private void RemoveSegment(AttendanceSymbolRuleSegmentDto s){if(_edit.Segments.Count>1)_edit.Segments.Remove(s);}
private async Task TestRule(){if(!_testDate.HasValue||!TimeSpan.TryParse(_testIn,out var tin)||!TimeSpan.TryParse(_testOut,out var tout)){Snackbar.Add("In/Out không hợp lệ",Severity.Warning);return;}var ci=_testDate.Value.Date.Add(tin);var co=_testDate.Value.Date.Add(tout);if(co<=ci)co=co.AddDays(1);var r=await Client.TestAsync(new(){WorkDate=DateOnly.FromDateTime(_testDate.Value),DayType=_testDayType,ShiftCode=_testShift,CheckIn=ci,CheckOut=co});_testResult=r.Data;}
private static AttendanceSymbolRuleUpsertRequest NewRequest()=>new(){RuleCode="NEW-RULE",RuleName="Rule mới",DayType="NORMAL",ShiftCode="C1",Priority=100,Segments=[new(){SegmentType="WORK",Start="06:00",End="14:00",SymbolTemplate="C1"},new(){SegmentType="OT",Start="14:00",End="18:00",SymbolTemplate="K{hours}"}]};
}
