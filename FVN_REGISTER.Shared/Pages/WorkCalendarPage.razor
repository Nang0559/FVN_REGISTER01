@page "/calendar"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Calendar
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Services.OTs
@using FVN_REGISTER.Shared.Services.Execution
@using FVN_REGISTER.Shared.Components.Calendar
@using FVN_REGISTER.Shared.Services.Calendar
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@inject NavigationManager NavigationManager
@inject IWorkCalendarClientService CalendarService
@inject IDialogService DialogService
@inject ISecurityClientService SecurityService
@inject ICurrentUserClientService CurrentUser
@inject IOTClientService OTClient
@inject IExecutionReconciliationClientService ExecutionService
@inject ISnackbar Snackbar

<PageTitle>Lịch làm việc của tôi</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-5">
    <MudPaper Elevation="0" Class="pa-6 mb-4"
              Style="border-radius:24px; background:linear-gradient(135deg, rgba(25,118,210,.12), rgba(0,150,136,.08)); border:1px solid rgba(25,118,210,.10)">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
            <div>
                <MudText Typo="Typo.overline" Color="Color.Primary">FVN REGISTER • CALENDAR</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:850">
                    @(IsCurrentEmployee ? "Lịch làm việc của tôi" : "Lịch làm việc theo phạm vi quản lý")
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                    Một ô ngày hợp nhất lịch công ty, ca, chấm công, đăng ký và các vấn đề cần xử lý.
                </MudText>
            </div>

            @if (_managedEmployees.Count > 0)
            {
                <MudSelect T="string"
                           Value="@_selectedEmployeeCode"
                           ValueChanged="OnEmployeeChanged"
                           Label="Phạm vi lịch"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Style="min-width:280px">
                    @foreach (var employee in _managedEmployees)
                    {
                        <MudSelectItem Value="@employee.EmployeeCode">
                            @employee.EmployeeCode · @employee.EmployeeName
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Home"
                       OnClick="@(() => NavigationManager.NavigateTo("/"))">
                Trang chủ
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_alerts.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius:18px">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Color="Color.Warning" />
                    <MudText Typo="Typo.h6" Style="font-weight:750">Cần xử lý trong tháng</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                        @_alerts.Count
                    </MudChip>
                </MudStack>

                @foreach (var alert in _alerts)
                {
                    <MudPaper Outlined="true"
                              Class="pa-3"
                              Style="border-radius:12px; border-left:4px solid var(--mud-palette-warning);">
                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center"
                                  Wrap="Wrap.Wrap"
                                  Spacing="2">
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:700">
                                    @alert.WorkDate.ToString("dd/MM/yyyy") · @alert.ModuleCode
                                </MudText>
                                <MudText Typo="Typo.body2">@alert.Summary</MudText>
                            </div>

                            @if (alert.RequiresAction && !string.IsNullOrWhiteSpace(alert.DetailRoute))
                            {
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Color="Color.Warning"
                                           OnClick="@(() => OpenRoute(alert.DetailRoute))">
                                    Xử lý
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="pa-3" Style="border-radius:18px">
        <WorkCalendar @ref="_calendar"
                      @key="_selectedEmployeeCode"
                      EmployeeCode="@_selectedEmployeeCode"
                      ModuleContext="ALL"
                      OnDaySelected="HandleDaySelected" />
    </MudPaper>
</MudContainer>

@code {
    private readonly List<CalendarAlertItemDto> _alerts = new();
    private readonly List<ManagedEmployeeDto> _managedEmployees = new();
    private WorkCalendar? _calendar;
    private string? _selectedEmployeeCode;
    private string? _currentEmployeeCode;

    private bool IsCurrentEmployee =>
        !string.IsNullOrWhiteSpace(_currentEmployeeCode)
        && string.Equals(_selectedEmployeeCode, _currentEmployeeCode, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.InitializeAsync();

            _currentEmployeeCode = CurrentUser.User?.EmployeeCode?.Trim();
            _selectedEmployeeCode = _currentEmployeeCode;

            var managed = await SecurityService.GetMyManagedEmployeesAsync();
            if (managed.IsSuccess && managed.Data != null)
                _managedEmployees.AddRange(managed.Data);

            if (!string.IsNullOrWhiteSpace(_currentEmployeeCode)
                && !_managedEmployees.Any(x =>
                    string.Equals(x.EmployeeCode?.Trim(), _currentEmployeeCode, StringComparison.OrdinalIgnoreCase)))
            {
                _managedEmployees.Insert(0, new ManagedEmployeeDto
                {
                    EmployeeCode = _currentEmployeeCode,
                    EmployeeName = CurrentUser.User?.FullName ?? _currentEmployeeCode
                });
            }

            await LoadAlertsAsync();
        }
        catch
        {
            // Calendar itself should remain usable if the alert list is temporarily unavailable.
        }
    }

    private async Task LoadAlertsAsync()
    {
        _alerts.Clear();

        if (string.IsNullOrWhiteSpace(_selectedEmployeeCode))
            return;

        var today = DateTime.Today;
        var from = new DateTime(today.Year, today.Month, 1);
        var to = from.AddMonths(1).AddDays(-1);

        var result = await CalendarService.GetAlertsForEmployeeAsync(
            _selectedEmployeeCode,
            from,
            to);

        if (result.IsSuccess && result.Data != null)
            _alerts.AddRange(result.Data);
    }

    private async Task OnEmployeeChanged(string? employeeCode)
    {
        _selectedEmployeeCode = string.IsNullOrWhiteSpace(employeeCode)
            ? _currentEmployeeCode
            : employeeCode.Trim();

        await LoadAlertsAsync();
    }

    private async Task HandleDaySelected(CalendarDayDto day)
    {
        var parameters = new DialogParameters
        {
            [nameof(CalendarDayDialog.Day)] = day,
            [nameof(CalendarDayDialog.OnRegistrationSelected)] =
                EventCallback.Factory.Create<CalendarRegistrationDto>(
                    this,
                    registration =>
                    {
                        OpenRegistration(registration.ModuleCode, day.Date);
                        return Task.CompletedTask;
                    }),
            [nameof(CalendarDayDialog.OnActionSelected)] =
                EventCallback.Factory.Create<CalendarActionRequestDto>(
                    this,
                    HandleCalendarActionAsync)
        };

        await DialogService.ShowAsync<CalendarDayDialog>(
            $"Lịch ngày {day.Date:dd/MM/yyyy}",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });
    }

    private void OpenRegistration(string moduleCode, DateOnly date)
    {
        var route = moduleCode switch
        {
            "LEAVE" => $"/leave/create?date={date:yyyy-MM-dd}",
            "OT" => $"/ot/create?date={date:yyyy-MM-dd}",
            "TRIP" => $"/trip/create?date={date:yyyy-MM-dd}",
            _ => "/calendar"
        };

        NavigationManager.NavigateTo(route);
    }

    private async Task HandleCalendarActionAsync(CalendarActionRequestDto request)
    {
        switch (request.ActionCode)
        {
            case "OPEN_OT":
                NavigationManager.NavigateTo($"/ot/create?date={request.Date:yyyy-MM-dd}");
                return;

            case "OPEN_HR_FEEDBACK":
                await OpenHrFeedbackAsync(request);
                return;

            case "CANCEL_OT":
                if (request.RequestId is not int requestId)
                {
                    Snackbar.Add("Không xác định được đơn OT cần hủy.", Severity.Error);
                    return;
                }

                if (string.IsNullOrWhiteSpace(request.Reason))
                {
                    Snackbar.Add("Vui lòng nhập lý do hủy OT.", Severity.Warning);
                    return;
                }

                var result = await OTClient.CancelAsync(requestId, request.Reason);

                Snackbar.Add(
                    result.Message ?? (result.IsSuccess ? "Đã hủy OT." : "Không thể hủy OT."),
                    result.IsSuccess ? Severity.Success : Severity.Error);

                if (result.IsSuccess)
                {
                    if (_calendar is not null)
                        await _calendar.RefreshAsync();

                    await LoadAlertsAsync();
                    await InvokeAsync(StateHasChanged);
                }

                return;
        }
    }

    private async Task OpenHrFeedbackAsync(CalendarActionRequestDto request)
    {
        if (string.IsNullOrWhiteSpace(_currentEmployeeCode)
            || !string.Equals(_selectedEmployeeCode, _currentEmployeeCode, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add(
                "Chức năng phản hồi ngày công chỉ gửi cho chính nhân viên đang đăng nhập.",
                Severity.Warning);
            return;
        }

        long reconciliationId;

        if (request.ReconciliationId is long existingReconciliationId)
        {
            reconciliationId = existingReconciliationId;
        }
        else
        {
            var ensure = await ExecutionService.EnsureAttendanceFeedbackAsync(request.Date);
            if (!ensure.IsSuccess || ensure.Data is null)
            {
                Snackbar.Add(
                    ensure.Message ?? "Không tạo được hồ sơ phản hồi ngày công.",
                    Severity.Error);
                return;
            }

            reconciliationId = ensure.Data.Id;
        }

        if (string.IsNullOrWhiteSpace(_selectedEmployeeCode))
        {
            Snackbar.Add("Không xác định được nhân viên của lịch đang mở.", Severity.Error);
            return;
        }

        var result = await CalendarService.GetForEmployeeAsync(
            _selectedEmployeeCode,
            request.Date.ToDateTime(TimeOnly.MinValue),
            request.Date.ToDateTime(TimeOnly.MinValue));

        if (!result.IsSuccess || result.Data is null)
        {
            Snackbar.Add(
                result.Message ?? "Không tải được dữ liệu chấm công của ngày cần phản hồi.",
                Severity.Error);
            return;
        }

        var selectedDay = result.Data.Days.FirstOrDefault(x => x.Date == request.Date);
        var issue = selectedDay?.Issues.FirstOrDefault(x => x.Code == request.IssueCode);
        var action = issue?.Actions.FirstOrDefault(x => x.Code == request.ActionCode);

        if (selectedDay is null || issue is null || action is null)
        {
            Snackbar.Add(
                "Không tìm thấy nội dung chênh lệch cần phản hồi. Vui lòng tải lại lịch.",
                Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(CalendarAttendanceFeedbackDialog.Day)] = selectedDay,
            [nameof(CalendarAttendanceFeedbackDialog.Issue)] = issue,
            [nameof(CalendarAttendanceFeedbackDialog.Action)] = action,
            [nameof(CalendarAttendanceFeedbackDialog.ReconciliationId)] = reconciliationId
        };

        await DialogService.ShowAsync<CalendarAttendanceFeedbackDialog>(
            "Phản hồi ngày công",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        if (_calendar is not null)
            await _calendar.RefreshAsync();

        await LoadAlertsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OpenRoute(string? route)
    {
        if (!string.IsNullOrWhiteSpace(route))
            NavigationManager.NavigateTo(route);
    }
}