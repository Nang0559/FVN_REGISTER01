@page "/report/operations"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Reports
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Shared.Pages.Reports
@using FVN_REGISTER.Shared.Services.Leaves
@using FVN_REGISTER.Shared.Services.Equipment
@using FVN_REGISTER.Contract.Dtos.Equipment
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inject IReportClientService ReportService
@inject IEquipmentClientService EquipmentClient
@inject ISecurityClientService Security
@inject ISnackbar Snackbar
@inherits AppComponentBase

<MudText Typo="Typo.h5" Class="mb-4"><MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />@Language.T("report.baoCaoNghiepVu")</MudText>

@if (_permissionLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (IsModuleAllowed)
    {
        <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChanged" Class="mb-4">
            @if (ModuleKey == "trip")
            {
                <MudTabPanel Text="@Language.T("common.theoPhongBan")" />
                <MudTabPanel Text="@Language.T("common.theoNhanVien")" />
                <MudTabPanel Text='@Language.T("common.detail")' />
                <MudTabPanel Text="@Language.T("common.trangThaiDuyet")" />
            }
            else if (ModuleKey == "equipment")
            {
                <MudTabPanel Text="@Language.T("common.theoPhongBan")" />
                <MudTabPanel Text="@Language.T("report.cayThietBiChecklist")" />
                <MudTabPanel Text='@Language.T("equipment.repair")' />
            }
            else if (ModuleKey == "attendance")
            {
                <MudTabPanel Text="@Language.T("report.tongHop")" />
                <MudTabPanel Text='@Language.T("common.detail")' />
            }
        </MudTabs>
        @if (ModuleKey == "equipment" && _tab == 1)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudGrid>
                    <MudItem xs="12" sm="3">
                        <MudDatePicker @bind-Date="_query.FromDate" Label='@Language.T("trip.fromDate")' Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudDatePicker @bind-Date="_query.ToDate" Label='@Language.T("trip.toDate")' Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudSelect T="int?" Label='@Language.T("ot.department")' @bind-Value="_query.DeptCode" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                            @foreach(var d in _departments ?? new()) { <MudSelectItem T="int?" Value="@ToDeptValue(d.Key)">@d.Value</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadInspectionTreeAsync">
                            @Language.T("report.capNhatCay")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <EquipmentChecklistTree Assets="_inspectionAssets" Tasks="_inspectionTasks" />
        }
        else
        {
        <ReportBase @ref="_base" ReportType="_type" Query="_query">
            <AdditionalFilters>
                <MudItem xs="12" sm="3">
                    <MudSelect T="int?" Label='@Language.T("ot.department")' @bind-Value="_query.DeptCode" Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="@(null)">@Language.T("report.tatCa")</MudSelectItem>
                        @foreach(var d in _departments ?? new()) { <MudSelectItem T="int?" Value="@ToDeptValue(d.Key)">@d.Value</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                @if (_type is ReportType.TripSummaryByEmployee or ReportType.TripDetail or ReportType.AttendanceDetail)
                {
                    <MudItem xs="12" sm="3">
                        <MudAutocomplete T="KeyValuePair<string,string>" Label='@Language.T("ot.employee")' Value="@_employee" ValueChanged="OnEmployeeChanged" SearchFunc="SearchEmployees" ToStringFunc="@(x=>x.Value)" Clearable="true" />
                    </MudItem>
                }
            </AdditionalFilters>
        </ReportBase>
        }
    }
    else if (_permission != null)
    {
        <MudAlert Severity="Severity.Warning">@Language.T("report.taiKhoanKhongCoQuyen")</MudAlert>
    }
}

@code {
    [SupplyParameterFromQuery(Name="module")] public string? Module { get; set; }
    private PermissionSnapshotDto? _permission;
    private bool _permissionLoading=true;
    private int _tab;
    private ReportBase? _base;
    private List<KeyValuePair<string,string>>? _departments;
    private static int? ToDeptValue(string? code) => int.TryParse(code, out var v) ? v : null;
    private KeyValuePair<string,string> _employee;
    private ReportQueryDto _query=new(){FromDate=new DateTime(DateTime.Now.Year,1,1),ToDate=DateTime.Today,IncludeChart=true};
    private List<EquipmentAssetDto> _inspectionAssets = new();
    private List<EquipmentInspectionReportRowDto> _inspectionTasks = new();

    private bool CanTrip => _permission?.Has(SecurityFunctionCodes.TripView)==true;
    private bool CanEquipment => _permission?.Has(SecurityFunctionCodes.EquipmentView)==true;
    private bool CanEquipmentInspectionReport => _permission?.Has(SecurityFunctionCodes.EquipmentInspectionReport)==true;
    private bool CanAttendance => _permission?.Has(SecurityFunctionCodes.AttendanceView)==true;
    private string ModuleKey => (Module ?? "trip").ToLowerInvariant();
    private bool IsModuleAllowed => ModuleKey switch { "trip" => CanTrip, "equipment" => CanEquipment || CanEquipmentInspectionReport, "attendance" => CanAttendance, _ => false };

    private ReportType _type => Module?.ToLowerInvariant() switch
    {
        "equipment" => _tab switch { 0=>ReportType.EquipmentSummaryByDept, 1=>ReportType.EquipmentAssetDetail, _=>ReportType.EquipmentRepairSummary },
        "attendance" => _tab==0 ? ReportType.AttendanceSummary : ReportType.AttendanceDetail,
        _ => _tab switch { 0=>ReportType.TripSummaryByDept, 1=>ReportType.TripSummaryByEmployee, 2=>ReportType.TripDetail, _=>ReportType.TripApprovalStatus }
    };

    protected override async Task OnInitializedAsync()
    {
        var r=await Security.GetMyPermissionsAsync();
        if(r.IsSuccess) _permission=r.Data;
        var d=await ReportService.GetLookupDepartmentsAsync();
        if(d.IsSuccess) _departments=d.Data;
        _permissionLoading=false;
        if (ModuleKey == "equipment" && CanEquipmentInspectionReport)
            await LoadInspectionTreeAsync();
    }

    private async Task OnTabChanged(int i)
    {
        _tab=i; _query.EmployeeCode=null; _query.DeptCode=null;
        if (ModuleKey == "equipment" && _tab == 1)
            await LoadInspectionTreeAsync();
        else if (_base!=null)
            await Task.Delay(20);
        if (_base!=null && !(ModuleKey == "equipment" && _tab == 1))
            await _base.LoadReport();
    }

    private async Task LoadInspectionTreeAsync()
    {
        if (!CanEquipmentInspectionReport) { _inspectionAssets = new(); _inspectionTasks = new(); return; }
        var assets = await EquipmentClient.GetRegisteredInspectionAssetsAsync(_query.DeptCode?.ToString());
        if (assets.IsSuccess) _inspectionAssets = assets.Data ?? new();
        var report = await EquipmentClient.GetInspectionDashboardAsync(
            _query.FromDate ?? DateTime.Today.AddMonths(-1),
            _query.ToDate ?? DateTime.Today,
            _query.DeptCode?.ToString());
        if (report.IsSuccess) _inspectionTasks = report.Data?.Rows ?? new();
        else Snackbar.Add(report.Message ?? Language.T("report.khongTaiDuocChecklistThiet"), Severity.Error);
    }
    private void OnEmployeeChanged(KeyValuePair<string,string> x){_employee=x;_query.EmployeeCode=string.IsNullOrWhiteSpace(x.Key)?null:x.Key;}
    private async Task<IEnumerable<KeyValuePair<string,string>>> SearchEmployees(string value,CancellationToken ct)
    { var r=await ReportService.SearchLookupEmployeesAsync(value??string.Empty,ct); return r.IsSuccess&&r.Data!=null?r.Data:Array.Empty<KeyValuePair<string,string>>(); }
}

@code {
    // Intentionally kept as a small presentational component so the report center
    // does not depend on the equipment management page.
}
