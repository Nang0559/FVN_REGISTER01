@page "/reports"
@attribute [Authorize]
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Contract.Dtos.Security
@using Microsoft.AspNetCore.Authorization
@inject ISecurityClientService Security
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
    @Language.T("report.trungTamBaoCaoThong")
</MudText>

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    @Language.T("report.chiHienThiCacNhom")
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_permission == null)
{
    <MudAlert Severity="Severity.Error">@Language.T("report.khongTaiDuocThongTin")</MudAlert>
}
else
{
    <MudGrid>
        @if (_permission.Has(SecurityFunctionCodes.LeaveView))
        {
            <MudItem xs="12" sm="6" md="4"><MudCard><MudCardContent><MudText Typo="Typo.h6">@Language.T("nav.reportLeave")</MudText><MudText>@Language.T("report.phepDuocCapSuDung")</MudText></MudCardContent><MudCardActions><MudButton Color="Color.Primary" OnClick="@(()=>Nav.NavigateTo("/report/leave"))">@Language.T("report.moBaoCao")</MudButton></MudCardActions></MudCard></MudItem>
        }
        @if (_permission.Has(SecurityFunctionCodes.OTView))
        {
            <MudItem xs="12" sm="6" md="4"><MudCard><MudCardContent><MudText Typo="Typo.h6">@Language.T("report.tangCaOt")</MudText><MudText>@Language.T("report.gioOtTheoPhongNhan")</MudText></MudCardContent><MudCardActions><MudButton Color="Color.Primary" OnClick="@(()=>Nav.NavigateTo("/report/ot"))">@Language.T("report.moBaoCao")</MudButton></MudCardActions></MudCard></MudItem>
        }
        @if (_permission.Has(SecurityFunctionCodes.TripView))
        {
            <MudItem xs="12" sm="6" md="4"><MudCard><MudCardContent><MudText Typo="Typo.h6">@Language.T("trip.title")</MudText><MudText>@Language.T("report.tongHopChuyenDiChi")</MudText></MudCardContent><MudCardActions><MudButton Color="Color.Primary" OnClick="@(()=>Nav.NavigateTo("/report/operations?module=trip"))">@Language.T("report.moBaoCao")</MudButton></MudCardActions></MudCard></MudItem>
        }
        @if (_permission.Has(SecurityFunctionCodes.EquipmentView))
        {
            <MudItem xs="12" sm="6" md="4"><MudCard><MudCardContent><MudText Typo="Typo.h6">@Language.T("equipment.title")</MudText><MudText>@Language.T("report.taiSanTheoPhongChi")</MudText></MudCardContent><MudCardActions><MudButton Color="Color.Primary" OnClick="@(()=>Nav.NavigateTo("/report/operations?module=equipment"))">@Language.T("report.moBaoCao")</MudButton></MudCardActions></MudCard></MudItem>
        }
        @if (_permission.Has(SecurityFunctionCodes.AttendanceView))
        {
            <MudItem xs="12" sm="6" md="4"><MudCard><MudCardContent><MudText Typo="Typo.h6">@Language.T("hrm.attendance")</MudText><MudText>@Language.T("report.tongHopVaChiTiet")</MudText></MudCardContent><MudCardActions><MudButton Color="Color.Primary" OnClick="@(()=>Nav.NavigateTo("/report/operations?module=attendance"))">@Language.T("report.moBaoCao")</MudButton></MudCardActions></MudCard></MudItem>
        }
    </MudGrid>
}
@code {
    private PermissionSnapshotDto? _permission;
    private bool _loading = true;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var r = await Security.GetMyPermissionsAsync();
            if (r.IsSuccess) _permission = r.Data;
        }
        finally { _loading = false; }
    }
}