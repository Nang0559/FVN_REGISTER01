@page "/execution"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FVN_REGISTER.Contract.Dtos.Execution
@using Microsoft.AspNetCore.Components.Forms
@using FVN_REGISTER.Shared.Services.Execution
@inject IExecutionReconciliationClientService ExecutionService
@inject ISnackbar Snackbar

<PageTitle>@Language.T("nav.executionReconciliation")</PageTitle>

@if (_detail is not null)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">
                @Language.T("execution.chiTiet", _detail.Reconciliation.ModuleCode, _detail.Reconciliation.SourceId)
            </MudText>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CloseDetail">@Language.T("common.close")</MudButton>
        </MudStack>

        <MudGrid Class="mt-2">
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">
                    @Language.T("execution.trangThai") <b>@_detail.Reconciliation.ReconciliationStatus</b>
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">
                    Planned: @_detail.Reconciliation.PlannedState
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2">
                    Actual: @_detail.Reconciliation.ActualState
                </MudText>
            </MudItem>
        </MudGrid>

        @if (_detail.Confirmation is not null)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1">@Language.T("execution.xacNhanNhanVien")</MudText>
            <MudText Typo="Typo.body2">
                Decision: <b>@_detail.Confirmation.Decision</b> —
                Status: <b>@_detail.Confirmation.Status</b>
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_detail.Confirmation.Comment))
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">@_detail.Confirmation.Comment</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_detail.Confirmation.ReviewNote))
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2">
                    @Language.T("execution.ghiChuReview", _detail.Confirmation.ReviewNote)
                </MudAlert>
            }
        }

        @if (_detail.Evidence.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1">@Language.T("execution.evidence2")</MudText>
            <MudTable Items="_detail.Evidence" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@Language.T("common.type")</MudTh>
                    <MudTh>FileId</MudTh>
                    <MudTh>@Language.T("execution.thamChieu")</MudTh>
                    <MudTh>@Language.T("execution.review")</MudTh>
                    <MudTh>@Language.T("execution.ghiChuHr")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.EvidenceType</MudTd>
                    <MudTd>@(context.FileId?.ToString() ?? "-")</MudTd>
                    <MudTd>@(context.ReferenceNo ?? context.ExternalUrl ?? "-")</MudTd>
                    <MudTd>@context.ReviewStatus</MudTd>
                    <MudTd>@(context.ReviewNote ?? "-")</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @if (_detail.EmployeeDecision is not null)
        {
            <MudDivider Class="my-3" />
            <MudAlert Severity="@(_detail.EmployeeDecision.Status == "Accepted" ? Severity.Success : _detail.EmployeeDecision.Status == "Disputed" ? Severity.Warning : Severity.Info)">
                <b>Trạng thái xác nhận kết quả:</b> @_detail.EmployeeDecision.Status
                — Vòng khiếu nại: @_detail.EmployeeDecision.AppealRound / @_detail.EmployeeDecision.MaxAppealRounds
                @if (!string.IsNullOrWhiteSpace(_detail.EmployeeDecision.Comment))
                {
                    <div class="mt-1">@_detail.EmployeeDecision.Comment</div>
                }
            </MudAlert>

            @if (_detail.EmployeeDecision.CanRespond)
            {
                <MudStack Row="true" Spacing="2" Class="mt-3">
                    <MudButton Color="Color.Success" Variant="Variant.Filled"
                               Disabled="_employeeDecisionBusy"
                               OnClick="@(() => DecideEmployeeAsync("ACCEPT"))">
                        Đồng ý & đóng vấn đề
                    </MudButton>
                    @if (_detail.EmployeeDecision.CanAppeal)
                    {
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined"
                                   Disabled="_employeeDecisionBusy"
                                   OnClick="@(() => DecideEmployeeAsync("APPEAL"))">
                            Không đồng ý / Khiếu nại
                        </MudButton>
                        @if (_detail.Confirmation is not null)
                        {
                            <MudButton Color="Color.Info" Variant="Variant.Outlined"
                                       OnClick="@(() => OpenEvidenceAsync(_detail.Reconciliation))">
                                Bổ sung evidence
                            </MudButton>
                        }
                    }
                </MudStack>
            }

            @if (_employeeAppealOpen)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3">
                    <MudText Typo="Typo.subtitle2">Nội dung khiếu nại</MudText>
                    <MudTextField @bind-Value="_employeeDecisionComment"
                                  Lines="4" Variant="Variant.Outlined"
                                  Label="Lý do / nội dung khiếu nại"
                                  Class="mt-2" />
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                        <MudButton OnClick="@(() => _employeeAppealOpen = false)">Hủy</MudButton>
                        <MudButton Color="Color.Warning" Variant="Variant.Filled"
                                   Disabled="_employeeDecisionBusy"
                                   OnClick="@(() => DecideEmployeeAsync("APPEAL"))">
                            Gửi khiếu nại
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
        }

        @if (_detail.History.Count > 0)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle1">Lịch sử xử lý</MudText>
            <MudList T="object" Dense="true" Class="mt-2">
                @foreach (var h in _detail.History)
                {
                    <MudListItem T="object">
                        <MudText Typo="Typo.body2">
                            <b>@h.EventType</b> — @h.FromStatus → @h.ToStatus
                        </MudText>
                        <MudText Typo="Typo.caption">
                            @h.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            · @(h.ActorEmployeeCode ?? "Hệ thống")
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(h.Reason))
                        {
                            <MudText Typo="Typo.body2">@h.Reason</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        }

        @if (_detail.HrResolution is not null)
        {
            <MudDivider Class="my-3" />
            <MudAlert Severity="@(_detail.HrResolution.Decision == "OK" ? Severity.Success : Severity.Warning)">
                <b>HR: @_detail.HrResolution.Decision</b> —
                @_detail.HrResolution.Reason
            </MudAlert>
        }
    </MudPaper>
}

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">@Language.T("nav.executionReconciliation")</MudText>
        <MudStack Row="true" Spacing="1">
            <MudDatePicker @bind-Date="_from" Label='@Language.T("trip.fromDate")' />
            <MudDatePicker @bind-Date="_to" Label='@Language.T("trip.toDate")' />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">@Language.T("common.taiLai")</MudButton>
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Language.T("execution.khongCoReconciliationTrongKhoang")</MudAlert>
    }
    else
    {
        <MudTable Items="_items" Hover="true" Dense="true" Striped="true">
            <HeaderContent>
                <MudTh>@Language.T("ot.date")</MudTh>
                <MudTh>@Language.T("common.module")</MudTh>
                <MudTh>@Language.T("common.nguon")</MudTh>
                <MudTh>@Language.T("execution.participant")</MudTh>
                <MudTh>@Language.T("execution.duKien")</MudTh>
                <MudTh>@Language.T("execution.thucTe")</MudTh>
                <MudTh>@Language.T("common.status")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel='@Language.T("ot.date")'>@context.WorkDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Module">@context.ModuleCode</MudTd>
                <MudTd DataLabel='@Language.T("common.nguon")'>@context.SourceType / @context.SourceId</MudTd>
                <MudTd DataLabel="Participant">@(context.ParticipantId ?? "-")</MudTd>
                <MudTd DataLabel='@Language.T("execution.duKien")'>@(context.PlannedState ?? "-")</MudTd>
                <MudTd DataLabel='@Language.T("execution.thucTe")'>@(context.ActualState ?? "-")</MudTd>
                <MudTd DataLabel='@Language.T("common.status")'>@context.ReconciliationStatus</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               OnClick="@(() => OpenDetailAsync(context.Id))">
                        @Language.T("common.detail")
                    </MudButton>
                    @if (context.RequiresConfirmation)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (context.ConfirmationId != null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@Language.T("execution.daGuiXacNhan")</MudChip>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="@(() => OpenConfirmationAsync(context))">
                                @Language.T("common.confirm")
                            </MudButton>
                            @if (context.ConfirmationId != null && context.RequiresEvidence)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                           OnClick="@(() => OpenEvidenceAsync(context))">
                                    @Language.T("execution.boSungEvidence")
                                </MudButton>
                            }
                        </MudStack>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

    @if (_confirmationOpen && _selected is not null)
    {
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">@Language.T("execution.xacNhan", _selected.ModuleCode, _selected.SourceId)</MudText>
            <MudSelect T="string" @bind-Value="_decision" Label="@Language.T("execution.ketLuan")" Variant="Variant.Outlined" Class="mt-3">
                <MudSelectItem Value="@("CONFIRMED")">@Language.T("execution.xacNhanDung")</MudSelectItem>
                <MudSelectItem Value="@("REJECTED")">@Language.T("execution.tuChoiCanXuLy")</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_comment" Label='@Language.T("common.note")' Variant="Variant.Outlined" Lines="3" Class="mt-3" />
            <MudCheckBox @bind-Value="_evidenceRequired" Label="@Language.T("execution.yeuCauBoSungBang")" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-3">
                <MudButton OnClick="CloseConfirmation">@Language.T("common.cancel")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitConfirmationAsync">@Language.T("execution.guiXacNhan")</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_evidenceOpen && _selected is not null)
    {
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6">@Language.T("execution.boSungEvidence")</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">
                @Language.T("execution.coTheDungMaTham", _selected.ModuleCode, _selected.SourceId)
            </MudText>
            <MudTextField @bind-Value="_evidenceType" Label="@Language.T("execution.loaiEvidence")" Variant="Variant.Outlined" Required="true" />
            <MudTextField @bind-Value="_referenceNo" Label="@Language.T("execution.soThamChieu")" Variant="Variant.Outlined" Class="mt-2" />
            <MudTextField @bind-Value="_externalUrl" Label="@Language.T("execution.urlChungTuHttpHttps")" Variant="Variant.Outlined" Class="mt-2" />
            <MudTextField @bind-Value="_evidenceDescription" Label='@Language.T("common.description")' Variant="Variant.Outlined" Lines="3" Class="mt-2" />
            <MudNumericField T="int?" @bind-Value="_fileId" Label="@Language.T("execution.fileidChungTuDaUpload")" Variant="Variant.Outlined" Class="mt-2" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-3">
                <MudButton OnClick="CloseEvidence">@Language.T("common.cancel")</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitEvidenceAsync">@Language.T("execution.guiEvidence")</MudButton>
            </MudStack>
        </MudPaper>
    }

@code {
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today.AddDays(30);
    private List<ExecutionReconciliationDto> _items = [];
    private bool _loading;
    private bool _confirmationOpen;
    private ExecutionReconciliationDto? _selected;
    private string _decision = "CONFIRMED";
    private string? _comment;
    private bool _evidenceRequired;
    private bool _evidenceOpen;
    private string _evidenceType = "DOCUMENT";
    private string? _referenceNo;
    private string? _externalUrl;
    private string? _evidenceDescription;
    private int? _fileId;
    private IBrowserFile? _evidenceFile;
    private ExecutionReconciliationDetailDto? _detail;
    private bool _employeeDecisionBusy;
    private bool _employeeAppealOpen;
    private string? _employeeDecisionComment;

    [SupplyParameterFromQuery(Name = "reconciliationId")]
    public long? ReconciliationId { get; set; }

    private long? _openedQueryReconciliationId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ReconciliationId.HasValue
            && ReconciliationId.Value > 0
            && _openedQueryReconciliationId != ReconciliationId.Value)
        {
            _openedQueryReconciliationId = ReconciliationId.Value;
            await OpenDetailAsync(ReconciliationId.Value, adjustDateRange: true);
        }
    }

    private async Task LoadAsync()
    {
        if (_from is null || _to is null) return;
        if (_to.Value.Date < _from.Value.Date)
        {
            Snackbar.Add(Language.T("common.khoangNgayKhongHopLe"), Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var result = await ExecutionService.GetMineAsync(
                DateOnly.FromDateTime(_from.Value.Date),
                DateOnly.FromDateTime(_to.Value.Date));

            if (result.IsSuccess && result.Data is not null)
                _items = result.Data.ToList();
            else
                Snackbar.Add(result.Message ?? Language.T("execution.khongTaiDuocDuLieu"), Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecideEmployeeAsync(string decision)
    {
        if (_detail is null) return;

        if (decision == "APPEAL")
        {
            if (!_employeeAppealOpen)
            {
                _employeeAppealOpen = true;
                return;
            }

            if (string.IsNullOrWhiteSpace(_employeeDecisionComment))
            {
                Snackbar.Add("Vui lòng nhập nội dung khiếu nại.", Severity.Warning);
                return;
            }
        }

        _employeeDecisionBusy = true;
        try
        {
            var result = await ExecutionService.DecideEmployeeResolutionAsync(
                _detail.Reconciliation.Id,
                new ExecutionEmployeeDecisionRequest
                {
                    Decision = decision,
                    Comment = decision == "APPEAL" ? _employeeDecisionComment : null
                });

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? "Không thể cập nhật kết quả.", Severity.Error);
                return;
            }

            _employeeAppealOpen = false;
            _employeeDecisionComment = null;
            Snackbar.Add(
                decision == "ACCEPT"
                    ? "Đã xác nhận kết quả. Vấn đề đã được đóng."
                    : "Đã gửi khiếu nại. Case đã chuyển sang vòng xử lý tiếp theo.",
                Severity.Success);

            await OpenDetailAsync(_detail.Reconciliation.Id);
            await LoadAsync();
        }
        finally
        {
            _employeeDecisionBusy = false;
        }
    }

    private Task OpenConfirmationAsync(ExecutionReconciliationDto item)
    {
        _selected = item;
        _decision = "CONFIRMED";
        _comment = null;
        _evidenceRequired = item.RequiresEvidence;
        _confirmationOpen = true;
        return Task.CompletedTask;
    }

    private void CloseConfirmation() => _confirmationOpen = false;

    private async Task OpenDetailAsync(long reconciliationId, bool adjustDateRange = false)
    {
        var result = await ExecutionService.GetDetailAsync(reconciliationId);
        if (!result.IsSuccess || result.Data is null)
        {
            Snackbar.Add(result.Message ?? Language.T("execution.khongTaiDuocChiTiet"), Severity.Error);
            return;
        }

        if (adjustDateRange)
        {
            var workDate = result.Data.Reconciliation.WorkDate.ToDateTime(TimeOnly.MinValue);
            _from = workDate.AddDays(-30);
            _to = workDate.AddDays(30);
            await LoadAsync();
        }

        _detail = result.Data;
    }

    private void CloseDetail() => _detail = null;

    private Task OpenEvidenceAsync(ExecutionReconciliationDto item)
    {
        _selected = item;
        _evidenceOpen = true;
        _evidenceType = "DOCUMENT";
        _referenceNo = null;
        _externalUrl = null;
        _evidenceDescription = null;
        _fileId = null;
        _evidenceFile = null;
        return Task.CompletedTask;
    }

    private void CloseEvidence() => _evidenceOpen = false;

    private async Task SubmitEvidenceAsync()
    {
        if (_selected?.ConfirmationId is not long confirmationId)
        {
            Snackbar.Add(Language.T("execution.chuaCoConfirmationDeBo"), Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_evidenceType))
        {
            Snackbar.Add(Language.T("execution.vuiLongNhapLoaiEvidence"), Severity.Warning);
            return;
        }

        if (_evidenceFile is not null)
        {
            var upload = await ExecutionService.UploadEvidenceFileAsync(
                confirmationId,
                _evidenceFile);

            if (!upload.IsSuccess || upload.Data <= 0)
            {
                Snackbar.Add(upload.Message ?? Language.T("execution.khongTheUploadFileEvidence"), Severity.Error);
                return;
            }

            _fileId = upload.Data;
        }

        var result = await ExecutionService.AddEvidenceAsync(
            confirmationId,
            new ExecutionEvidenceRequest(
                _evidenceType,
                _fileId,
                _referenceNo,
                _externalUrl,
                _evidenceDescription));

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message ?? Language.T("execution.khongTheThemEvidence"), Severity.Error);
            return;
        }

        Snackbar.Add(Language.T("execution.daGuiEvidence"), Severity.Success);
        _evidenceOpen = false;
        await LoadAsync();
        if (_selected is not null)
            await OpenDetailAsync(_selected.Id);
    }

    private void OnEvidenceFileSelected(InputFileChangeEventArgs e)
    {
        _evidenceFile = e.File;
        _fileId = null;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.##} KB";
        return $"{bytes / (1024d * 1024d):0.##} MB";
    }

    private async Task SubmitConfirmationAsync()
    {
        if (_selected is null) return;

        var result = await ExecutionService.SubmitConfirmationAsync(
            _selected.Id,
            new ExecutionConfirmationRequest(_decision, _comment, _evidenceRequired));

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Message ?? Language.T("execution.khongGuiDuocXacNhan"), Severity.Error);
            return;
        }

        Snackbar.Add(Language.T("execution.daGuiXacNhan2"), Severity.Success);
        _confirmationOpen = false;
        await LoadAsync();
        if (_selected is not null)
            await OpenDetailAsync(_selected.Id);
    }
}