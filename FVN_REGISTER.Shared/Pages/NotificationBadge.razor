@using FVN_REGISTER.Contract.Dtos.Notifications
@using FVN_REGISTER.Shared.Services.Notifications
@using FVN_REGISTER.Shared.Utils
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client

@inject INotificationClientService NotificationService
@inject ITokenStorage TokenStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@inject ILogger<NotificationBadge> Logger

@implements IAsyncDisposable

<MudBadge Content="@NotificationService.UnreadCount" Overlap="true" Color="Color.Error"
          Visible="@(NotificationService.UnreadCount > 0)" Max="99">
    <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                   Color="Color.Inherit"
                   OnClick="TogglePanel" />
</MudBadge>

@if (_showPanel)
{
    <MudPaper Elevation="8"
              Style="position:absolute; top:56px; right:8px; width:340px; z-index:9999; max-height:480px; overflow-y:auto;"
              Class="pa-0">
        <MudList T="NotificationDto" Dense="true">
            <MudListItem>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Thông báo</MudText>
                    @if (NotificationService.UnreadCount > 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="MarkAllRead">Đọc tất cả</MudButton>
                    }
                </MudStack>
            </MudListItem>
            <MudDivider />

            @if (!_initialized)
            {
                <MudListItem>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Đang tải...</MudText>
                    </MudStack>
                </MudListItem>
            }
            else if (!NotificationService.Notifications.Any())
            {
                <MudListItem>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Không có thông báo mới</MudText>
                </MudListItem>
            }
            else
            {
                @foreach (var item in NotificationService.Notifications)
                {
                    <MudListItem OnClick="@(() => ClickItem(item) )"
                                 Class="@(item.IsRead ? string.Empty : "mud-background-gray")">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2" Style="font-weight:500">@item.Title</MudText>
                            @if (!string.IsNullOrWhiteSpace(item.Body))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Body</MudText>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                @item.CreatedAt.ToString("HH:mm dd/MM")
                            </MudText>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
            }
        </MudList>
    </MudPaper>
}

@code {
    [Parameter] public string DeviceId { get; set; } = string.Empty;

    private HubConnection? _hub;
    private string _lastDeviceId = string.Empty;
    private bool _showPanel;
    private bool _initialized;
    private bool _disposed;

    protected override void OnInitialized()
    {
        NotificationService.OnChanged += OnNotificationsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed || string.IsNullOrWhiteSpace(DeviceId) || DeviceId == _lastDeviceId || _hub != null)
            return;

        _lastDeviceId = DeviceId;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        try
        {
            await NotificationService.InitializeAsync();
            await NotificationService.LoadListAsync();
            _initialized = true;

            var token = await WaitForTokenAsync();
            if (!string.IsNullOrWhiteSpace(token))
                await ConnectSignalRAsync(token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[NOTIFY-BADGE] Initialization failed");
            _initialized = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<string?> WaitForTokenAsync(int maxRetries = 5)
    {
        for (var i = 0; i < maxRetries; i++)
        {
            if (AuthStateProvider is CustomAuthStateProvider provider &&
                !string.IsNullOrWhiteSpace(provider.CurrentToken))
            {
                return provider.CurrentToken;
            }

            try
            {
                var token = await TokenStorage.GetTokenAsync();
                if (!string.IsNullOrWhiteSpace(token)) return token;
            }
            catch
            {
                // JS/SecureStorage may not be ready yet.
            }

            await Task.Delay(300);
        }

        return null;
    }

    private async Task ConnectSignalRAsync(string token)
    {
        try
        {
            var apiBase = GetApiBaseUrl();
            var deviceId = string.IsNullOrWhiteSpace(DeviceId) ? $"web-{Guid.NewGuid():N}" : DeviceId;
            var hubUrl = $"{apiBase}/hubs/notification?deviceId={Uri.EscapeDataString(deviceId)}";

            _hub = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    var cleanToken = token.Trim().Trim('"');
                    options.AccessTokenProvider = () => Task.FromResult<string?>(cleanToken);
                })
                .WithAutomaticReconnect(new[]
                {
                    TimeSpan.Zero,
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10),
                    TimeSpan.FromSeconds(30)
                })
                .Build();

            _hub.On<int>("BadgeUpdated", count =>
            {
                if (_disposed) return;
                _ = InvokeAsync(StateHasChanged);
            });

            _hub.On<NotificationPushDto>("ReceiveNotification", push =>
            {
                if (_disposed) return;
                NotificationService.HandlePush(push);
                _ = InvokeAsync(StateHasChanged);

                if (push.Latest != null)
                {
                    Snackbar.Add(push.Latest.Title ?? "Có thông báo mới", Severity.Info,
                        config => config.VisibleStateDuration = 4000);
                }
            });

            _hub.On<string>("ForceLogout", message =>
            {
                if (_disposed) return;
                Snackbar.Add(message ?? "Phiên đăng nhập đã kết thúc.", Severity.Warning);
                _ = InvokeAsync(() => Nav.NavigateTo("/login", forceLoad: true));
            });

            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[NOTIFY-BADGE] SignalR connection failed; REST notifications remain available");
            _hub = null;
        }
    }

    private string GetApiBaseUrl()
    {
        var baseUrl = Configuration["ApiSettings:BaseUrl"] ?? "https://localhost:7135/";
        var uri = new Uri(baseUrl);
        return $"{uri.Scheme}://{uri.Host}{(uri.IsDefaultPort ? string.Empty : $":{uri.Port}")}";
    }

    private async Task TogglePanel()
    {
        _showPanel = !_showPanel;
        if (_showPanel)
            await NotificationService.LoadListAsync();
    }

    private async Task ClickItem(NotificationDto item)
    {
        if (!item.IsRead)
            await NotificationService.MarkReadAsync(item.Id);

        _showPanel = false;
        if (!string.IsNullOrWhiteSpace(item.ActionUrl))
            Nav.NavigateTo(item.ActionUrl);
    }

    private async Task MarkAllRead()
    {
        await NotificationService.MarkAllReadAsync();
        _showPanel = false;
    }

    private void OnNotificationsChanged()
        => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        NotificationService.OnChanged -= OnNotificationsChanged;

        if (_hub != null)
        {
            try
            {
                await _hub.StopAsync();
                await _hub.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "[NOTIFY-BADGE] Error disposing SignalR connection");
            }
        }
    }
}
