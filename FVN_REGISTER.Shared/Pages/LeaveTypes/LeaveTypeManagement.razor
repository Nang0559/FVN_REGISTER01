@page "/admin/leave-types"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.LeaveTypes
@using FVN_REGISTER.Shared.Services.Leaves
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase

@inject ILeaveTypeClientService LeaveTypeService
@inject ISnackbar Snackbar

<PageTitle>Hình thức nghỉ - FCC</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">Hình thức nghỉ phép</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Quản lý loại nghỉ bằng contract DTO của Application/API.</MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartCreate">Thêm mới</MudButton>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_search" Immediate="true" Clearable="true" Label="Tìm theo mã hoặc tên" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="bool?" @bind-Value="_isActive" Label="Trạng thái" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="bool?" Value="true">Đang dùng</MudSelectItem>
                <MudSelectItem T="bool?" Value="false">Tạm dừng</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="bool?" @bind-Value="_isCountedAsLeave" Label="Tính phép" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="bool?" Value="true">Có</MudSelectItem>
                <MudSelectItem T="bool?" Value="false">Không</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_editing)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "Thêm loại nghỉ" : "Chỉnh sửa loại nghỉ")</MudText>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_edit.LeaveTypeCode" Label="Mã loại nghỉ *" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="5"><MudTextField @bind-Value="_edit.LeaveTypeName" Label="Tên loại nghỉ *" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="_edit.LeaveTypeName2" Label="Tên phụ" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField @bind-Value="_edit.HRMCode" Label="HRM Code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="6" sm="3"><MudCheckBox @bind-Value="_edit.IsCountedAsLeave" Label="Tính phép năm" /></MudItem>
                <MudItem xs="6" sm="3"><MudCheckBox @bind-Value="_edit.IsActive" Label="Đang sử dụng" /></MudItem>
            </MudGrid>
        </MudForm>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
            <MudButton Variant="Variant.Text" OnClick="CancelEdit">Hủy</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="Save">@(_saving ? "Đang lưu..." : "Lưu")</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="FilteredItems" Hover="true" Dense="true" Striped="true">
        <HeaderContent>
            <MudTh>Mã</MudTh><MudTh>Tên</MudTh><MudTh>Tên phụ</MudTh><MudTh>HRM</MudTh><MudTh>Tính phép</MudTh><MudTh>Trạng thái</MudTh><MudTh>Thao tác</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Mã">@context.LeaveTypeCode</MudTd>
            <MudTd DataLabel="Tên">@context.LeaveTypeName</MudTd>
            <MudTd DataLabel="Tên phụ">@(context.LeaveTypeName2 ?? "-")</MudTd>
            <MudTd DataLabel="HRM">@(context.HRMCode ?? "-")</MudTd>
            <MudTd DataLabel="Tính phép"><MudChip T="string" Size="Size.Small" Color="@(context.IsCountedAsLeave ? Color.Warning : Color.Default)">@(context.IsCountedAsLeave ? "Có" : "Không")</MudChip></MudTd>
            <MudTd DataLabel="Trạng thái"><MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Đang dùng" : "Tạm dừng")</MudChip></MudTd>
            <MudTd DataLabel="Thao tác">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => StartEdit(context))" />
                <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" Size="Size.Small" OnClick="@(() => Toggle(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => Delete(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudAlert Severity="Severity.Info">Không có dữ liệu phù hợp.</MudAlert></NoRecordsContent>
    </MudTable>
}

@code {
    private List<LeaveTypeDto> _items = new();
    private string? _search;
    private bool? _isActive;
    private bool? _isCountedAsLeave;
    private bool _loading;
    private bool _editing;
    private bool _saving;
    private MudForm? _form;
    private LeaveTypeUpsertDto _edit = new();

    private IEnumerable<LeaveTypeDto> FilteredItems => _items
        .Where(x => !_isActive.HasValue || x.IsActive == _isActive.Value)
        .Where(x => !_isCountedAsLeave.HasValue || x.IsCountedAsLeave == _isCountedAsLeave.Value)
        .Where(x => string.IsNullOrWhiteSpace(_search)
                 || x.LeaveTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || x.LeaveTypeName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                 || (x.LeaveTypeName2?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(x => x.LeaveTypeCode);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await LeaveTypeService.GetListAsync(ct: CancellationToken.None);
            if (result.IsSuccess && result.Data != null) _items = result.Data;
            else Snackbar.Add(result.Message ?? "Không thể tải loại nghỉ.", Severity.Error);
        }
        finally { _loading = false; }
    }

    private void StartCreate() { _edit = new LeaveTypeUpsertDto { IsActive = true }; _editing = true; }

    private void StartEdit(LeaveTypeDto item)
    {
        _edit = new LeaveTypeUpsertDto
        {
            Id = item.Id,
            LeaveTypeCode = item.LeaveTypeCode,
            LeaveTypeName = item.LeaveTypeName,
            LeaveTypeName2 = item.LeaveTypeName2,
            IsCountedAsLeave = item.IsCountedAsLeave,
            HRMCode = item.HRMCode,
            IsActive = item.IsActive
        };
        _editing = true;
    }

    private void CancelEdit() { _editing = false; _edit = new LeaveTypeUpsertDto(); }

    private async Task Save()
    {
        if (_form != null) { await _form.ValidateAsync(); if (!_form.IsValid) return; }
        _saving = true;
        try
        {
            if (_edit.Id == 0)
            {
                var result = await LeaveTypeService.CreateAsync(_edit);
                if (!result.IsSuccess) { Snackbar.Add(result.Message ?? "Tạo loại nghỉ thất bại.", Severity.Error); return; }
            }
            else
            {
                var result = await LeaveTypeService.UpdateAsync(_edit.Id, _edit);
                if (!result.IsSuccess) { Snackbar.Add(result.Message ?? "Cập nhật loại nghỉ thất bại.", Severity.Error); return; }
            }
            Snackbar.Add("Đã lưu loại nghỉ.", Severity.Success);
            CancelEdit();
            await LoadAsync();
        }
        finally { _saving = false; }
    }

    private async Task Toggle(LeaveTypeDto item)
    {
        var result = await LeaveTypeService.ToggleAsync(item.Id);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? "Không thể thay đổi trạng thái.", Severity.Error); return; }
        await LoadAsync();
    }

    private async Task Delete(LeaveTypeDto item)
    {
        var result = await LeaveTypeService.DeleteAsync(item.Id);
        if (!result.IsSuccess) { Snackbar.Add(result.Message ?? "Không thể xóa loại nghỉ.", Severity.Error); return; }
        Snackbar.Add("Đã xóa loại nghỉ.", Severity.Success);
        await LoadAsync();
    }
}
