@using FVN_REGISTER.Shared.Components
@page "/trip/create"
@attribute [Authorize]
@namespace FVN_REGISTER.Shared.Pages
@using FVN_REGISTER.Contract.Dtos.Trips
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Requests.Approvals
@using FVN_REGISTER.Shared.Components.Calendar
@using FVN_REGISTER.Shared.Services.Approvals
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.Trips
@using Microsoft.AspNetCore.Authorization
@inject ITripClientService TripService
@inject IApprovalRouteClientService ApprovalRouteService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inherits AppComponentBase

<PageTitle>@Language.T("trip.create")</PageTitle>

<MudPaper Class="pa-2 mb-4" Elevation="1">
    <MudText Typo="Typo.subtitle1">@Language.T("leave.sharedCalendar")</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        @Language.T("leave.sharedCalendarDescription")
    </MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CalendarMonth"
               OnClick="@(() => Navigation.NavigateTo("/calendar"))">
        @Language.T("leave.openCalendar")
    </MudButton>
</MudPaper>

<MudStack Spacing="2">
    <MudPaper Class="pa-3" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Class="mr-2" />
                    @Language.T("trip.create")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Language.T("trip.taoNhapTruocSauDo")
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.History" Href="/trip/history">
                @Language.T("nav.history")
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudForm @ref="_form">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@Language.T("trip.thongTinChuyenCongTac")</MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_startDate"
                                   Label="@Language.T("trip.ngayBatDau")"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="@Language.T("trip.vuiLongChonNgayBat")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_endDate"
                                   Label="@Language.T("trip.ngayKetThuc")"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Required="true"
                                   RequiredError="@Language.T("trip.vuiLongChonNgayKet")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_destination"
                                  Label="@Language.T("trip.diaDiemCongTac")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="@Language.T("trip.vuiLongNhapDiaDiem")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_customerOrPartner"
                                  Label="@Language.T("trip.khachHangDoiTac")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_purpose"
                                  Label="@Language.T("trip.mucDichCongTac")"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="@Language.T("trip.vuiLongNhapMucDich")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_transportMethod"
                                  Label="@Language.T("trip.phuongTien")"
                                  Placeholder="@Language.T("trip.oToMayBayTau")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_estimatedCost"
                                     Label="@Language.T("trip.chiPhiDuKienVnd")"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_companionEmployeeCodes"
                                  Label="@Language.T("trip.nhanVienDiCung")"
                                  HelperText="@Language.T("trip.nhapMaNhanVienPhan")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_accommodation"
                                  Label="@Language.T("trip.luuTru")"
                                  Placeholder="@Language.T("trip.khachSanNoiODu")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_note"
                                  Label='@Language.T("common.note")'
                                  Lines="2"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            @if (_approvalRoute != null)
            {
                <ApprovalRouteSelector @ref="_approvalSelector" Route="@_approvalRoute" />
            }

            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                    @_validationMessage
                </MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Text" OnClick="Reset" Disabled="@_saving">@Language.T("trip.xoaNhapLieu")</MudButton>
                <MudButton Color="Color.Primary"
                            Variant="Variant.Outlined"
                            OnClick="SaveDraft"
                            Disabled="@_saving"
                            StartIcon="@Icons.Material.Filled.Save">
                    @Language.T("common.luuNhap")
                </MudButton>
                <MudButton Color="Color.Primary"
                            Variant="Variant.Filled"
                            OnClick="SaveAndSubmit"
                            Disabled="@_saving"
                            StartIcon="@Icons.Material.Filled.Send">
                    @Language.T("common.guiDuyet")
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudStack>

@code {
    private MudForm? _form;

    [Parameter, SupplyParameterFromQuery(Name = "date")]
    public DateTime? CalendarDate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadApprovalRouteAsync();
        if (CalendarDate.HasValue)
        {
            _startDate = CalendarDate.Value.Date;
            _endDate = CalendarDate.Value.Date;
        }
    }
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;
    private string _destination = string.Empty;
    private string _purpose = string.Empty;
    private string? _customerOrPartner;
    private string? _transportMethod;
    private string? _companionEmployeeCodes;
    private decimal? _estimatedCost;
    private string? _accommodation;
    private string? _note;
    private string? _validationMessage;
    private bool _saving;
    private ApprovalRoutePreviewDto? _approvalRoute;
    private ApprovalRouteSelector? _approvalSelector;

    private CreateTripRequestDto BuildRequest() => new()
    {
        StartDate = _startDate!.Value.Date,
        EndDate = _endDate!.Value.Date,
        Destination = _destination.Trim(),
        Purpose = _purpose.Trim(),
        CustomerOrPartner = Clean(_customerOrPartner),
        TransportMethod = Clean(_transportMethod),
        CompanionEmployeeCodes = Clean(_companionEmployeeCodes),
        EstimatedCost = _estimatedCost,
        Accommodation = Clean(_accommodation),
        Note = Clean(_note),
        ApprovalSelections = _approvalSelector?.GetSelections() ?? new()
    };

    private static string? Clean(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private bool ValidateInput()
    {
        _validationMessage = null;

        if (!_startDate.HasValue || !_endDate.HasValue)
            _validationMessage = Language.T("trip.vuiLongChonDayDu");
        else if (_endDate.Value.Date < _startDate.Value.Date)
            _validationMessage = Language.T("public.ngayKetThucPhaiLon");
        else if (string.IsNullOrWhiteSpace(_destination))
            _validationMessage = Language.T("trip.diaDiemCongTacLa");
        else if (string.IsNullOrWhiteSpace(_purpose))
            _validationMessage = Language.T("trip.mucDichCongTacLa");
        else if (_estimatedCost < 0)
            _validationMessage = Language.T("trip.chiPhiDuKienKhong");
        else if ((_approvalSelector?.GetSelections() ?? new()).Any(x => string.IsNullOrWhiteSpace(x.ApproverCode)))
            _validationMessage = Language.T("common.vuiLongChonNguoiPhe");

        return _validationMessage == null;
    }

    private async Task SaveDraft()
    {
        if (!ValidateInput()) return;

        _saving = true;
        try
        {
            var result = await TripService.CreateDraftAsync(BuildRequest());
            if (!result.IsSuccess || result.Data == null)
            {
                Snackbar.Add(result.Message ?? Language.T("trip.luuNhapThatBai"), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("trip.daLuuNhap", result.Data?.TripCode ?? ""), Severity.Success);
            Navigation.NavigateTo($"/trip/history");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAndSubmit()
    {
        if (!ValidateInput()) return;

        _saving = true;
        try
        {
            var selections = _approvalSelector?.GetSelections() ?? new();
            var draft = await TripService.CreateDraftAsync(BuildRequest());
            if (!draft.IsSuccess || draft.Data == null)
            {
                Snackbar.Add(draft.Message ?? Language.T("trip.khongTheTaoDangKy"), Severity.Error);
                return;
            }

            var submitted = await TripService.SubmitAsync(draft.Data!.Id, selections);
            if (!submitted.IsSuccess)
            {
                Snackbar.Add(submitted.Message ?? Language.T("trip.khongTheGuiDangKy"), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("trip.daGuiDangKyCong"), Severity.Success);
            Navigation.NavigateTo("/trip/history");
        }
        finally
        {
            _saving = false;
        }
    }

    private void Reset()
    {
        _startDate = DateTime.Today;
        _endDate = DateTime.Today;
        _destination = string.Empty;
        _purpose = string.Empty;
        _customerOrPartner = null;
        _transportMethod = null;
        _companionEmployeeCodes = null;
        _estimatedCost = null;
        _accommodation = null;
        _note = null;
        _validationMessage = null;
    }
    private async Task LoadApprovalRouteAsync()
    {
        var result = await ApprovalRouteService.GetPreviewAsync(RequestModule.Trip);
        if (result.IsSuccess)
            _approvalRoute = result.Data;
        else
            Snackbar.Add(result.Message ?? Language.T("common.khongTaiDuocLuongPhe"), Severity.Warning);

        await InvokeAsync(StateHasChanged);
    }

}
