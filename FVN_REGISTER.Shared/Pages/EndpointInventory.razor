@page "/endpoint-inventory"
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.Security
@inject IEndpointInventoryClientService Inventory
@inject IEndpointGovernanceClientService Governance
@inject ISecurityClientService Security
@inject ISnackbar Snackbar

<PageTitle>@Language.T("endpoint.endpointInventory")</PageTitle>
<MudContainer MaxWidth="MaxWidth.False" Class="pa-4"><MudStack Spacing="3"><div><MudText Typo="Typo.h5">@Language.T("endpoint.endpointInventory")</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("endpoint.danhSachMayDoEndpoint")</MudText></div><MudGrid><MudItem xs="12" md="7"><MudPaper Class="pa-3"><MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"><MudText Typo="Typo.h6">@Language.T("endpoint.endpoints")</MudText><MudButton Variant="Variant.Outlined" OnClick="LoadAsync">@Language.T("common.refresh")</MudButton></MudStack><MudTable Items="_endpoints" Dense="true" Hover="true" Striped="true" Class="mt-2" OnRowClick="@((TableRowClickEventArgs<EndpointInventorySummaryDto> args) => SelectEndpoint(args))"><HeaderContent><MudTh>@Language.T("endpoint.computer")</MudTh><MudTh>@Language.T("endpoint.deviceKey")</MudTh><MudTh>@Language.T("common.status2")</MudTh><MudTh>@Language.T("endpoint.lastSeen")</MudTh><MudTh>@Language.T("endpoint.software2")</MudTh><MudTh>@Language.T("endpoint.service2")</MudTh><MudTh>@Language.T("endpoint.antivirus")</MudTh><MudTh>@Language.T("endpoint.definition")</MudTh><MudTh>@Language.T("endpoint.equipment")</MudTh></HeaderContent><RowTemplate><MudTd>@context.ComputerName</MudTd><MudTd>@context.DeviceKey</MudTd><MudTd>@context.Status</MudTd><MudTd>@context.LastSeenUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd><MudTd>@context.SoftwareCount</MudTd><MudTd>@context.ServiceCount</MudTd><MudTd>@(context.AntivirusCount == 0 ? "Không phát hiện" : $"{context.AntivirusHealthyCount}/{context.AntivirusCount} bảo vệ")</MudTd><MudTd>@(context.LatestAntivirusDefinitionUpdatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Không có dữ liệu")</MudTd><MudTd>@(context.EquipmentCode is null ? "Chưa liên kết" : $"{context.EquipmentCode} - {context.EquipmentName}")</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-3">@Language.T("endpoint.chuaCoEndpoint")</MudText></NoRecordsContent></MudTable></MudPaper></MudItem><MudItem xs="12" md="5">@if(_selected is null){<MudAlert Severity="Severity.Info">@Language.T("endpoint.chonMotEndpointDeXem")</MudAlert>}else{<MudPaper Class="pa-3"><MudText Typo="Typo.h6">@_selected.ComputerName</MudText><MudText Typo="Typo.body2">@_selected.DeviceKey · @_selected.Status</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Equipment: @(_selected.EquipmentCode is null ? "Chưa liên kết" : $"{_selected.EquipmentCode} - {_selected.EquipmentName}")</MudText><MudAlert Class="mt-2" Severity="@(_selected.AntivirusCount > 0 && _selected.AntivirusHealthyCount == _selected.AntivirusCount ? Severity.Success : Severity.Warning)">Antivirus: @_selected.AntivirusHealthyCount/@_selected.AntivirusCount protected · Database update: @(_selected.LatestAntivirusDefinitionUpdatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Không có dữ liệu")</MudAlert><MudStack Row="true" Spacing="2" Class="mt-2"><MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanEvaluate" OnClick="EvaluateSelectedAsync">@Language.T("endpoint.danhGiaCompliance")</MudButton><MudButton Variant="Variant.Outlined" Disabled="!CanCreateRequest" OnClick="CreateRequestAsync">@Language.T("endpoint.guiYeuCauCaiSoftware")</MudButton></MudStack>@if(CanLinkEquipment){<MudDivider Class="my-3"/><MudText Typo="Typo.subtitle2">@Language.T("endpoint.lienKetEquipmentAsset")</MudText><MudStack Row="true" Spacing="2" Class="mt-1"><MudNumericField T="int?" Label="@Language.T("endpoint.equipmentAssetId")" @bind-Value="_equipmentAssetId" Min="1"/><MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="!_equipmentAssetId.HasValue" OnClick="LinkEquipmentAsync">@Language.T("endpoint.lienKet")</MudButton></MudStack><MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("endpoint.chiCapNhatEquipmentassetidCua")</MudText>}<MudDivider Class="my-3"/><MudText Typo="Typo.subtitle2">@Language.T("endpoint.findingDangMo")</MudText><MudTable Items="_findings" Dense="true" Hover="true" Class="mt-2"><HeaderContent><MudTh>@Language.T("hrm.result")</MudTh><MudTh>@Language.T("endpoint.item")</MudTh><MudTh>@Language.T("endpoint.policy")</MudTh><MudTh>@Language.T("common.code")</MudTh></HeaderContent><RowTemplate><MudTd><MudChip T="string" Color="@FindingColor(context.Result)" Size="Size.Small">@context.Result</MudChip></MudTd><MudTd>@context.ObservedName</MudTd><MudTd>v@context.PolicyVersion</MudTd><MudTd>@context.FindingCode</MudTd></RowTemplate><NoRecordsContent><MudText Class="pa-2">@Language.T("endpoint.khongCoFindingDangMo")</MudText></NoRecordsContent></MudTable>@if(_showRequestForm){<MudDivider Class="my-3"/><MudText Typo="Typo.subtitle2">@Language.T("endpoint.softwareInstallationRequest")</MudText><MudTextField Label="@Language.T("endpoint.tenPhanMem")" @bind-Value="_requestItem" Required="true"/><MudTextField Label="@Language.T("endpoint.publisher")" @bind-Value="_requestPublisher"/><MudTextField Label="@Language.T("common.version")" @bind-Value="_requestVersion"/><MudTextField Label='@Language.T("common.reason")' Lines="3" @bind-Value="_requestReason" Required="true"/><MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitRequestAsync">@Language.T("endpoint.taoYeuCau")</MudButton>}</MudPaper>}</MudItem></MudGrid></MudStack></MudContainer>
@code { private List<EndpointInventorySummaryDto> _endpoints=new();private EndpointInventorySummaryDto? _selected;private List<EndpointComplianceFindingDto> _findings=new();private HashSet<int> _permissions=new();private bool _showRequestForm;private int? _equipmentAssetId;private string? _requestItem,_requestPublisher,_requestVersion,_requestReason;private bool CanEvaluate=>_permissions.Contains(SecurityFunctionCodes.EndpointComplianceView);private bool CanCreateRequest=>_permissions.Contains(SecurityFunctionCodes.EndpointInstallRequestCreate);private bool CanLinkEquipment=>_permissions.Contains(SecurityFunctionCodes.EquipmentAssign);protected override async Task OnInitializedAsync()=>await LoadAsync();private async Task LoadAsync(){var permissions=await Security.GetMyPermissionsAsync();_permissions=permissions.Data?.FunctionCodes??new();var response=await Inventory.GetAllAsync();_endpoints=response.Data??new();}private async Task SelectEndpoint(TableRowClickEventArgs<EndpointInventorySummaryDto> args){if(args.Item is null)return;var endpoint=args.Item;_selected=endpoint;_showRequestForm=false;_equipmentAssetId=null;var response=await Governance.GetFindingsAsync(endpoint.EndpointId,true);_findings=response.Data??new();}private async Task EvaluateSelectedAsync(){if(_selected is null||!CanEvaluate)return;var response=await Inventory.EvaluateAsync(_selected.EndpointId);if(response.IsSuccess){Snackbar.Add($"Đã đánh giá {_selected.ComputerName} inventory.",Severity.Success);var findings=await Governance.GetFindingsAsync(_selected.EndpointId,true);_findings=findings.Data??new();}else Snackbar.Add(response.Message,Severity.Error);}private async Task LinkEquipmentAsync(){if(_selected is null||!_equipmentAssetId.HasValue||!CanLinkEquipment)return;var response=await Inventory.LinkEquipmentAsync(_selected.EndpointId,_equipmentAssetId.Value);if(response.IsSuccess){Snackbar.Add(Language.T("endpoint.daLienKetEndpointVoi"),Severity.Success);var selectedId=_selected.EndpointId;await LoadAsync();_selected=_endpoints.FirstOrDefault(x=>x.EndpointId==selectedId);}else Snackbar.Add(response.Message,Severity.Error);}private Task CreateRequestAsync(){_showRequestForm=true;return Task.CompletedTask;}private async Task SubmitRequestAsync(){if(_selected is null||string.IsNullOrWhiteSpace(_requestItem)||string.IsNullOrWhiteSpace(_requestReason))return;var endpointId=_selected.EndpointId;var response=await Governance.CreateRequestAsync(new EndpointGovernanceRequestCreateDto(EndpointGovernanceRequestType.InstallSoftware,endpointId,null,null,_requestItem,_requestPublisher,_requestVersion,_requestReason));if(response.IsSuccess){Snackbar.Add(Language.T("endpoint.daTaoInstallationRequestDe"),Severity.Success);_showRequestForm=false;_requestItem=_requestPublisher=_requestVersion=_requestReason=null;}else Snackbar.Add(response.Message,Severity.Error);}private static Color FindingColor(EndpointComplianceResult result)=>result switch{EndpointComplianceResult.Compliant=>Color.Success,EndpointComplianceResult.NonCompliant=>Color.Error,EndpointComplianceResult.Exception=>Color.Warning,_=>Color.Info};}
