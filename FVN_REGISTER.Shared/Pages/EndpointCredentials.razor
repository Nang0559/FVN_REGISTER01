@page "/endpoint-credentials"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudAlert Severity="Severity.Info">
        Quản lý credential Endpoint Agent hiện được thực hiện từ <b>Sổ thiết bị</b> để bảo đảm mỗi credential luôn gắn với đúng Equipment và Agent.
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/equipment"))">Mở Sổ thiết bị</MudButton>
    </MudAlert>
</MudContainer>

@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/equipment", replace: true);
}
