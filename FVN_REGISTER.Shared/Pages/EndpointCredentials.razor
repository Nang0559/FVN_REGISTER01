@page "/endpoint-credentials"
@using FVN_REGISTER.Application.Interfaces.Security
@using FVN_REGISTER.Core.Constants
@using FVN_REGISTER.Shared.Services.Security
@inject IEndpointCredentialClientService Credentials
@inject ISecurityClientService Security
@inject ISnackbar Snackbar

<PageTitle>Endpoint Credentials</PageTitle>
<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5">Endpoint Agent Credentials</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Mỗi máy tính có một Device Key và một API Key riêng. API Key chỉ hiển thị một lần khi cấp hoặc rotate.
        </MudText>
        <MudAlert Severity="Severity.Warning">
            Không lưu API Key vào database, log hoặc ticket. Sau khi cài Agent trên PC, hãy kiểm tra heartbeat và inventory.
        </MudAlert>
        <MudPaper Class="pa-4">
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField Label="Device Key" Required="true" @bind-Value="_deviceKey" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="Computer Name" @bind-Value="_computerName" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="int?" Label="Equipment Asset ID (tuỳ chọn)" @bind-Value="_equipmentAssetId" Min="1" /></MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Disabled="@(!CanCheck || string.IsNullOrWhiteSpace(_deviceKey) || _checking)" OnClick="CheckStatusAsync">Kiểm tra Device</MudButton>
                </MudItem>
            </MudGrid>
            @if (_status is not null)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1">@_status.DeviceKey</MudText>
                        @if (!_status.EndpointExists)
                        { <MudChip T="string" Size="Size.Small" Color="Color.Info">Chưa đăng ký</MudChip> }
                        else if (_status.HasActiveCredential)
                        { <MudChip T="string" Size="Size.Small" Color="Color.Success">Credential đang hoạt động</MudChip> }
                        else
                        { <MudChip T="string" Size="Size.Small" Color="Color.Warning">Không có credential hoạt động</MudChip> }
                    </MudStack>
                    @if (_status.ExpiresAtUtc.HasValue)
                    { <MudText Typo="Typo.body2">Hết hạn: @_status.ExpiresAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText> }
                </MudPaper>
            }
            <MudStack Row="true" Spacing="2" Class="mt-3">
                @if (_status?.HasActiveCredential == true)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!CanRotate || _busy)" OnClick="ProvisionOrRotateAsync">Rotate API Key</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanProvision || _busy)" OnClick="ProvisionOrRotateAsync">Cấp API Key</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@(!CanRevoke || _busy || string.IsNullOrWhiteSpace(_deviceKey) || _status?.HasActiveCredential != true)" OnClick="RevokeAsync">Revoke</MudButton>
            </MudStack>
        </MudPaper>
        @if (!string.IsNullOrWhiteSpace(_newSecret))
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">API Key mới</MudText>
                <MudAlert Severity="Severity.Error" Class="my-2">API Key chỉ được hiển thị lần này. Hãy lưu vào cấu hình Agent của đúng PC trước khi đóng màn hình.</MudAlert>
                <MudText Typo="Typo.body2">Device: @_provisionedDeviceKey</MudText>
                <MudText Typo="Typo.body2">Expires: @_expiresAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                <MudTextField Label="API Key" Value="@_newSecret" ReadOnly="true" FullWidth="true" />
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private HashSet<int> _permissions = new();
    private string? _deviceKey, _computerName, _newSecret, _provisionedDeviceKey;
    private int? _equipmentAssetId;
    private DateTimeOffset? _expiresAt;
    private EndpointCredentialStatusDto? _status;
    private bool _checking, _busy;
    private bool CanCheck => _permissions.Contains(SecurityFunctionCodes.EndpointCredentialProvision) || _permissions.Contains(SecurityFunctionCodes.EndpointCredentialRotate);
    private bool CanProvision => _permissions.Contains(SecurityFunctionCodes.EndpointCredentialProvision);
    private bool CanRotate => _permissions.Contains(SecurityFunctionCodes.EndpointCredentialRotate);
    private bool CanRevoke => _permissions.Contains(SecurityFunctionCodes.EndpointCredentialRevoke);

    protected override async Task OnInitializedAsync()
    {
        var p = await Security.GetMyPermissionsAsync();
        _permissions = p.Data?.FunctionCodes ?? new();
    }

    private async Task CheckStatusAsync()
    {
        if (!CanCheck || string.IsNullOrWhiteSpace(_deviceKey)) return;
        _checking = true;
        try
        {
            var result = await Credentials.GetStatusAsync(_deviceKey.Trim());
            if (result.IsSuccess && result.Data is not null) { _status = result.Data; _newSecret = null; }
            else { _status = null; Snackbar.Add(result.Message, Severity.Error); }
        }
        finally { _checking = false; }
    }

    private async Task ProvisionOrRotateAsync()
    {
        if (string.IsNullOrWhiteSpace(_deviceKey) || _busy) return;
        var rotating = _status?.HasActiveCredential == true;
        if (rotating ? !CanRotate : !CanProvision) return;
        _busy = true;
        try
        {
            var request = new EndpointCredentialProvisionDto(_deviceKey.Trim(), string.IsNullOrWhiteSpace(_computerName) ? null : _computerName.Trim(), _equipmentAssetId);
            var result = await Credentials.ProvisionAsync(request);
            if (result.IsSuccess && result.Data is not null)
            {
                _newSecret = result.Data.ApiKey;
                _provisionedDeviceKey = result.Data.DeviceKey;
                _expiresAt = result.Data.ExpiresAtUtc;
                _status = new EndpointCredentialStatusDto(result.Data.DeviceKey, true, true, result.Data.ExpiresAtUtc);
                Snackbar.Add(rotating ? "Đã rotate API Key. Hãy lưu secret ngay." : "Đã cấp API Key. Hãy lưu secret ngay.", Severity.Success);
            }
            else Snackbar.Add(result.Message, Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task RevokeAsync()
    {
        if (!CanRevoke || string.IsNullOrWhiteSpace(_deviceKey) || _busy) return;
        _busy = true;
        try
        {
            var result = await Credentials.RevokeAsync(_deviceKey.Trim());
            if (result.IsSuccess)
            {
                _newSecret = null;
                if (_status is not null) _status = _status with { HasActiveCredential = false, ExpiresAtUtc = null };
                Snackbar.Add("Đã thu hồi API Key.", Severity.Success);
            }
            else Snackbar.Add(result.Message, Severity.Error);
        }
        finally { _busy = false; }
    }
}
