@page "/history/{KindCode}"
@attribute [Authorize]
@using FVN_REGISTER.Contract.Dtos.Histories
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Core.Extensions
@using FVN_REGISTER.Shared.Components.OT
@using FVN_REGISTER.Shared.Dialogs.Leaves
@using FVN_REGISTER.Shared.Services.Histories
@using FVN_REGISTER.Shared.Utils.Helpers
@using Microsoft.AspNetCore.Authorization
@inherits AppComponentBase
@implements IDisposable

@inject IHistoryClientService HistoryService
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>Lịch sử yêu cầu</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5"><MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />@Title</MudText>
</MudStack>

@if (_balance != null)
{
    <MudGrid Class="mb-4">
        @if (Kind == RequestModule.Leave)
        {
            <MudItem xs="6" sm="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">TỔNG PHÉP</MudText><MudText Typo="Typo.h6">@((_balance.Entitled ?? 0m).ToString("N1"))</MudText></MudPaper></MudItem>
            <MudItem xs="6" sm="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">ĐÃ DÙNG</MudText><MudText Typo="Typo.h6">@((_balance.Used ?? 0m).ToString("N1"))</MudText></MudPaper></MudItem>
            <MudItem xs="6" sm="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">CÒN LẠI</MudText><MudText Typo="Typo.h6">@((_balance.Remaining ?? 0m).ToString("N1"))</MudText></MudPaper></MudItem>
            <MudItem xs="6" sm="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">CHỜ DUYỆT</MudText><MudText Typo="Typo.h6">@_balance.PendingCount</MudText></MudPaper></MudItem>
        }
        else
        {
            <MudItem xs="6" sm="4"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">TỔNG GIỜ OT</MudText><MudText Typo="Typo.h6">@_balance.TotalOTHours?.ToString("N1") h</MudText></MudPaper></MudItem>
            <MudItem xs="6" sm="4"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">ĐÃ DUYỆT</MudText><MudText Typo="Typo.h6">@_balance.ApprovedOTHours?.ToString("N1") h</MudText></MudPaper></MudItem>
            <MudItem xs="6" sm="4"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">CHỜ DUYỆT</MudText><MudText Typo="Typo.h6">@_balance.PendingCount</MudText></MudPaper></MudItem>
        }
    </MudGrid>
}

<MudPaper Class="pa-3 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudSelect T="int" @bind-Value="_year" Label="Năm" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var year in _years) { <MudSelectItem Value="@year">@year</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="string" @bind-Value="_status" Label="Trạng thái" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@("Pending")">Chờ duyệt</MudSelectItem>
                <MudSelectItem Value="@("Approved")">Đã duyệt</MudSelectItem>
                <MudSelectItem Value="@("Rejected")">Từ chối</MudSelectItem>
                <MudSelectItem Value="@("Cancelled")">Đã hủy</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="2"><MudDatePicker @bind-Date="_fromDate" Label="Từ ngày" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" /></MudItem>
        <MudItem xs="6" sm="2"><MudDatePicker @bind-Date="_toDate" Label="Đến ngày" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" /></MudItem>
        <MudItem xs="12" sm="2"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">Tìm kiếm</MudButton></MudItem>
    </MudGrid>
</MudPaper>

<MudTable T="HistoryItemDto" ServerData="ServerReload" @ref="_table" Dense="true" Hover="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Ngày</MudTh><MudTh>Loại</MudTh><MudTh>Thời gian</MudTh><MudTh>Số lượng</MudTh><MudTh>Trạng thái</MudTh><MudTh>Tiến trình</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.SubmittedAt.ToString("dd/MM/yyyy")</MudTd>
        <MudTd>@context.Kind.ToDisplayName()</MudTd>
        <MudTd>
            @if (context.Kind == RequestModule.Leave)
            { <span>@context.StartDate?.ToString("dd/MM/yyyy") → @context.EndDate?.ToString("dd/MM/yyyy")</span> }
            else
            { <span>@context.OTDate?.ToString("dd/MM/yyyy")</span> }
        </MudTd>
        <MudTd>@(context.Kind == RequestModule.Leave ? context.TotalDay?.ToString("N1") + " ngày" : context.TotalOTHours?.ToString("N1") + " h")</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Style="@($"background:{context.StatusColor};color:white")">@context.StatusDisplay</MudChip></MudTd>
        <MudTd><OTApprovalProgressBar Steps="@context.ApprovalSteps" /></MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => OpenDetail(context))" />
            @if (context.CanCancel) { <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" OnClick="@(() => Cancel(context))" /> }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Class="pa-4" Color="Color.Secondary">Không có dữ liệu.</MudText></NoRecordsContent>
    <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 20, 50 }" /></PagerContent>
</MudTable>

@code {
    [Parameter] public string KindCode { get; set; } = "leave";
    private RequestModule Kind => KindCode.ToRequestModule();
    private string Title => Kind.ToDisplayName();
    private MudTable<HistoryItemDto>? _table;
    private BalanceSummaryDto? _balance;
    private bool _loading;
    private int _year = DateTime.Now.Year;
    private string? _status;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private readonly List<int> _years = Enumerable.Range(DateTime.Now.Year - 3, 5).Reverse().ToList();
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        _balance = null;
        var result = await HistoryService.GetBalanceAsync(Kind, _year, _cts.Token);
        if (result.IsSuccess) _balance = result.Data;
    }

    private async Task<TableData<HistoryItemDto>> ServerReload(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            var filter = new HistoryFilterDto
            {
                Kind = Kind, Year = _year, Status = _status, FromDate = _fromDate, ToDate = _toDate,
                Page = state.Page + 1, PageSize = state.PageSize
            };
            var result = await HistoryService.GetHistoryAsync(filter, ct);
            if (result.IsSuccess && result.Data != null)
                return new TableData<HistoryItemDto> { Items = result.Data.Data, TotalItems = result.Data.TotalCount };
            Snackbar.Add(result.Message ?? "Lỗi tải lịch sử.", Severity.Warning);
        }
        finally { _loading = false; }
        return new TableData<HistoryItemDto> { Items = Array.Empty<HistoryItemDto>(), TotalItems = 0 };
    }

    private async Task Reload()
    {
        if (_table != null) await _table.ReloadServerData();
        var result = await HistoryService.GetBalanceAsync(Kind, _year, _cts.Token);
        if (result.IsSuccess) _balance = result.Data;
    }

    private async Task OpenDetail(HistoryItemDto item)
    {
        var result = await HistoryService.GetDetailAsync(Kind, item.Id, _cts.Token);
        if (!result.IsSuccess || result.Data == null) { Snackbar.Add(result.Message ?? "Lỗi tải chi tiết.", Severity.Error); return; }
        var parameters = new DialogParameters<RequestDetailDialog> { { x => x.Detail, result.Data } };
        await Dialog.ShowAsync<RequestDetailDialog>("Chi tiết yêu cầu", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task Cancel(HistoryItemDto item)
    {
        var confirmed = await Dialog.ShowMessageBoxAsync("Xác nhận hủy", $"Hủy đơn #{item.Id}?", yesText: "Hủy đơn", cancelText: "Không");
        if (confirmed != true) return;
        var result = await HistoryService.CancelAsync(Kind, item.Id, "Người dùng hủy", _cts.Token);
        Snackbar.Add(result.IsSuccess ? "Đã hủy thành công." : result.Message ?? "Lỗi hủy.", result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess && _table != null) await _table.ReloadServerData();
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}
