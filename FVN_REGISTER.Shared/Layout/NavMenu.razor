@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@inject ISecurityClientService SecurityService
@inject FVN_REGISTER.Shared.Handlers.IHttpClientWithAuth PublicHttp
@using MudBlazor
@inject ICurrentUserClientService CurrentUser
@implements IDisposable

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="ml-4 my-3">@Language.T("nav.dashboard")</MudText>
    <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Language.T("nav.home")</MudNavLink>
    @if (CanPersonal(SecurityFunctionCodes.CalendarView) || CanPersonal(SecurityFunctionCodes.LeaveView) || CanPersonal(SecurityFunctionCodes.OTView) || CanPersonal(SecurityFunctionCodes.TripView) || CanPersonal(SecurityFunctionCodes.LateEarlyView) || CanPersonal(SecurityFunctionCodes.AttendanceView))
    {
        <MudNavLink href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth">@Language.T("nav.workCalendar")</MudNavLink>
    }
    @if (CanManagement(SecurityFunctionCodes.ExecutionReview))
    {
        <MudNavLink href="/execution" Icon="@Icons.Material.Filled.FactCheck">@Language.T("nav.executionReconciliation")</MudNavLink>
    }
    @if (CanAny(SecurityFunctionCodes.LeaveApprove, SecurityFunctionCodes.OTApprove, SecurityFunctionCodes.TripApprove, SecurityFunctionCodes.LateEarlyApprove, SecurityFunctionCodes.EquipmentApprove, SecurityFunctionCodes.EndpointSoftwarePolicyApprove, SecurityFunctionCodes.EndpointServicePolicyApprove))
    {
        <MudNavLink href="/work/inbox" Icon="@Icons.Material.Filled.Inbox">@Language.T("nav.workInbox")</MudNavLink>
    }

    <MudNavGroup Title="@PublicGroupTitle" Icon="@Icons.Material.Filled.Campaign" IconColor="@NoticeColor" Expanded="false">
        <MudNavLink href="/public-information" Icon="@Icons.Material.Filled.Public">@Language.T("nav.publicInformation")@if (_noticeCount > 0) { <MudChip T="string" Size="Size.Small" Color="@NoticeColor" Class="ml-2">@_noticeCount</MudChip> }</MudNavLink>
        <MudNavLink href="/public-forms" Icon="@Icons.Material.Filled.Assignment">@Language.T("nav.publicForms")</MudNavLink>
        @if (_publicCaps?.CanManageInformation == true) { <MudNavLink href="/admin/public-information" Icon="@Icons.Material.Filled.Campaign">@Language.T("public.quanLyNoiDungCong")</MudNavLink> }
        @if (_publicCaps?.CanManageForms == true) { <MudNavLink href="/admin/public-forms" Icon="@Icons.Material.Filled.EditNote">@Language.T("nav.publicFormsManage")</MudNavLink> }
        @if (_publicCaps?.CanViewResults == true) { <MudNavLink href="/admin/public-forms/submissions" Icon="@Icons.Material.Filled.Assessment">@Language.T("public.tongHopDangKyBieu")</MudNavLink> }
    </MudNavGroup>

    @if (CanAny(SecurityFunctionCodes.SecurityAccessChangeView, SecurityFunctionCodes.SecurityAccessChangeCreate, SecurityFunctionCodes.SecurityAccessChangeApprove, SecurityFunctionCodes.SecurityAccessChangeExecute))
    { <MudNavGroup Title="@Language.T("nav.accessChange")" Icon="@Icons.Material.Filled.ManageAccounts" Expanded="false">@if (CanAny(SecurityFunctionCodes.SecurityAccessChangeView, SecurityFunctionCodes.SecurityAccessChangeCreate)){<MudNavLink href="/security/access-change" Icon="@Icons.Material.Filled.SwapHoriz">@Language.T("nav.accessChangeRequest")</MudNavLink>}</MudNavGroup> }

    @if (CanAny(SecurityFunctionCodes.LeaveApprove, SecurityFunctionCodes.OTApprove, SecurityFunctionCodes.TripApprove, SecurityFunctionCodes.EquipmentApprove, SecurityFunctionCodes.EndpointSoftwarePolicyApprove, SecurityFunctionCodes.EndpointServicePolicyApprove))
    { <MudNavGroup Title="@Language.T("nav.approval")" Icon="@Icons.Material.Filled.CheckCircle" Expanded="false"><MudNavLink href="/approvals" Icon="@Icons.Material.Filled.List">@Language.T("nav.approvalPending")</MudNavLink></MudNavGroup> }

    @if (CanPersonal(SecurityFunctionCodes.LeaveView) || CanPersonal(SecurityFunctionCodes.LeaveCreate))
    {
        <MudNavGroup Title="@Language.T("nav.leave")" Icon="@Icons.Material.Filled.EventBusy" Expanded="true">
            @if (CanPersonal(SecurityFunctionCodes.LeaveView))
            {
                <MudNavLink href="/leave" Icon="@Icons.Material.Filled.Dashboard">@Language.T("nav.leaveOverview")</MudNavLink>
                <MudNavLink href="/leave/history" Icon="@Icons.Material.Filled.History">@Language.T("nav.leaveHistory")</MudNavLink>
            }
            @if (CanPersonal(SecurityFunctionCodes.LeaveCreate))
            {
                <MudNavLink href="/leave/create" Icon="@Icons.Material.Filled.Add">@Language.T("nav.leaveCreate")</MudNavLink>
            }
        </MudNavGroup>
    }
    @if (CanPersonal(SecurityFunctionCodes.OTView) || CanPersonal(SecurityFunctionCodes.OTCreate) || _otRegistrar)
    {
        <MudNavGroup Title="@Language.T("nav.ot")" Icon="@Icons.Material.Filled.Timelapse" Expanded="false">
            @if (CanPersonal(SecurityFunctionCodes.OTView))
            {
                <MudNavLink href="/ot" Icon="@Icons.Material.Filled.Dashboard">@Language.T("nav.otOverview")</MudNavLink>
                <MudNavLink href="/ot/history" Icon="@Icons.Material.Filled.ManageHistory">@Language.T("nav.otHistory")</MudNavLink>
            }
            @if (CanPersonal(SecurityFunctionCodes.OTCreate) && _otRegistrar)
            {
                <MudNavLink href="/ot/create" Icon="@Icons.Material.Filled.AddAlarm">@Language.T("nav.otCreate")</MudNavLink>
            }
            @if (_otRegistrar)
            {
                <MudNavLink href="/ot/supervisor-requests" Icon="@Icons.Material.Filled.SupervisorAccount">Yêu cầu OT từ nhân viên</MudNavLink>
            }
        </MudNavGroup>
    }
    @if (CanPersonal(SecurityFunctionCodes.TripView) || CanPersonal(SecurityFunctionCodes.TripCreate))
    {
        <MudNavGroup Title="@Language.T("nav.trip")" Icon="@Icons.Material.Filled.FlightTakeoff" Expanded="false">
            @if (CanPersonal(SecurityFunctionCodes.TripView))
            {
                <MudNavLink href="/trip" Icon="@Icons.Material.Filled.Dashboard">@Language.T("nav.tripOverview")</MudNavLink>
                <MudNavLink href="/trip/history" Icon="@Icons.Material.Filled.History">@Language.T("nav.tripHistory")</MudNavLink>
            }
            @if (CanPersonal(SecurityFunctionCodes.TripCreate))
            {
                <MudNavLink href="/trip/create" Icon="@Icons.Material.Filled.Add">@Language.T("nav.tripCreate")</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (CanPersonal(SecurityFunctionCodes.LateEarlyView) || CanPersonal(SecurityFunctionCodes.LateEarlyCreate))
    {
        <MudNavGroup Title="Đi muộn / Về sớm" Icon="@Icons.Material.Filled.AccessTime" Expanded="false">
            @if (CanPersonal(SecurityFunctionCodes.LateEarlyView))
            {
                <MudNavLink href="/late-early/history" Icon="@Icons.Material.Filled.History">Lịch sử đăng ký</MudNavLink>
            }
            @if (CanPersonal(SecurityFunctionCodes.LateEarlyCreate))
            {
                <MudNavLink href="/late-early/create" Icon="@Icons.Material.Filled.AddAlarm">Tạo đăng ký / Đăng ký hộ</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (CanAny(SecurityFunctionCodes.EndpointView, SecurityFunctionCodes.EndpointInventoryView, SecurityFunctionCodes.EndpointSoftwareCatalogView, SecurityFunctionCodes.EndpointServiceCatalogView, SecurityFunctionCodes.EndpointCredentialProvision, SecurityFunctionCodes.EndpointCredentialRevoke))
    {
        <MudNavGroup Title="@Language.T("nav.endpointGovernance")" Icon="@Icons.Material.Filled.Security" Expanded="false">
            @if (CanAny(SecurityFunctionCodes.EndpointSoftwareCatalogView, SecurityFunctionCodes.EndpointServiceCatalogView, SecurityFunctionCodes.EndpointSoftwareCatalogManage, SecurityFunctionCodes.EndpointServiceCatalogManage)) { <MudNavLink href="/endpoint-governance" Icon="@Icons.Material.Filled.Policy">@Language.T("nav.endpointCatalog")</MudNavLink> }
            @if (Can(SecurityFunctionCodes.EndpointInventoryView)) { <MudNavLink href="/endpoint-inventory" Icon="@Icons.Material.Filled.Devices">@Language.T("nav.endpointInventory")</MudNavLink> }
            @if (CanAny(SecurityFunctionCodes.EndpointCredentialProvision, SecurityFunctionCodes.EndpointCredentialRevoke)) { <MudNavLink href="/endpoint-credentials" Icon="@Icons.Material.Filled.VpnKey">@Language.T("nav.endpointCredentials")</MudNavLink> }
        </MudNavGroup>
    }

    @if (CanPersonal(SecurityFunctionCodes.EquipmentView) || CanManagement(SecurityFunctionCodes.EquipmentView))
    {
        <MudNavGroup Title="@Language.T("nav.equipment")" Icon="@Icons.Material.Filled.Devices" Expanded="false">
            <MudNavLink href="/equipment" Icon="@Icons.Material.Filled.Devices">@Language.T("nav.equipmentRegister")</MudNavLink>
            @if (CanManagement(SecurityFunctionCodes.EquipmentImport))
            {
                <MudNavLink href="/equipment/workspace" Icon="@Icons.Material.Filled.UploadFile">@Language.T("nav.equipmentImport")</MudNavLink>
            }
        </MudNavGroup>
    }

    @if (CanAny(SecurityFunctionCodes.DepartmentView, SecurityFunctionCodes.EmployeeView, SecurityFunctionCodes.LeaveTypeView, SecurityFunctionCodes.ApproverView, SecurityFunctionCodes.HrmSyncViewStatus, SecurityFunctionCodes.HrmSyncReview, SecurityFunctionCodes.HrmUserRoleRuleManage, SecurityFunctionCodes.ApprovalPolicyManage, SecurityFunctionCodes.AttendanceCalculate, SecurityFunctionCodes.DepartmentStatusView, SecurityFunctionCodes.BackgroundJobView))
    {
        <MudNavGroup Title="@Language.T("nav.data")" Icon="@Icons.Material.Filled.Storage" Expanded="false">
            @if (Can(SecurityFunctionCodes.DepartmentView)){<MudNavLink href="/admin/departments" Icon="@Icons.Material.Filled.Business">@Language.T("nav.departments")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.EmployeeView)){<MudNavLink href="/admin/employees" Icon="@Icons.Material.Filled.People">@Language.T("nav.employees")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.ApproverView)){<MudNavLink href="/admin/approvers" Icon="@Icons.Material.Filled.VerifiedUser">@Language.T("nav.approvers")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.LeaveTypeView)){<MudNavLink href="/admin/leave-types" Icon="@Icons.Material.Filled.Category">@Language.T("nav.leaveTypes")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.HrmSyncViewStatus)){<MudNavLink href="/admin/hrm-sync" Icon="@Icons.Material.Filled.Sync">@Language.T("nav.hrmSync")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.BackgroundJobView)){<MudNavLink href="/admin/background-jobs" Icon="@Icons.Material.Filled.Schedule">@Language.T("jobs.nav")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.HrmSyncReview)){<MudNavLink href="/admin/hrm-sync-review" Icon="@Icons.Material.Filled.WarningAmber">@Language.T("nav.hrmConflict")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.HrmUserRoleRuleManage)){<MudNavLink href="/admin/hrm-role-rules" Icon="@Icons.Material.Filled.Rule">@Language.T("nav.hrmRoleRules")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.ApprovalPolicyManage)){<MudNavLink href="/admin/approval-policies" Icon="@Icons.Material.Filled.Policy">@Language.T("nav.approvalPolicy")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.ExecutionPolicyManage)){<MudNavLink href="/admin/execution-policies" Icon="@Icons.Material.Filled.Rule">Chính sách đối soát công</MudNavLink>}
            @if (Can(SecurityFunctionCodes.WorkCalendarSymbolRuleManage)){<MudNavLink href="/admin/attendance-symbol-rules" Icon="@Icons.Material.Filled.Rule">Rule ký hiệu chấm công</MudNavLink>}
            @if (CanManagement(SecurityFunctionCodes.DepartmentStatusView)){<MudNavLink href="/leave/department-status" Icon="@Icons.Material.Filled.Assessment">@Language.T("nav.departmentStatus")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.AttendanceCalculate)){<MudNavLink href="/hrm/attendance-calculation" Icon="@Icons.Material.Filled.AccessTime">@Language.T("nav.attendanceCalculation")</MudNavLink>}
            @if (Can(SecurityFunctionCodes.AttendanceCalculate)){<MudNavLink href="/admin/hrm-attendance-calculation-jobs" Icon="@Icons.Material.Filled.Schedule">Theo dõi job tính công</MudNavLink>}
        </MudNavGroup>
        <MudNavGroup Title="@Language.T("nav.otManagement")" Icon="@Icons.Material.Filled.Timelapse" Expanded="false">@if(CanManagement(SecurityFunctionCodes.OTView)){<MudNavLink href="/ot/list" Icon="@Icons.Material.Filled.FormatListBulleted">@Language.T("nav.otList")</MudNavLink>}@if(CanManagement(SecurityFunctionCodes.OTLimitManage)){<MudNavLink href="/admin/ot-limit-rules" Icon="@Icons.Material.Filled.Rule">@Language.T("nav.otLimits")</MudNavLink>}</MudNavGroup>
    }

    @if (CanManagement(SecurityFunctionCodes.ExecutionReview)){<MudNavGroup Title="@Language.T("nav.hrReconciliation")" Icon="@Icons.Material.Filled.Rule" Expanded="false"><MudNavLink href="/execution/hr" Icon="@Icons.Material.Filled.FactCheck">@Language.T("nav.hrQueue")</MudNavLink></MudNavGroup>}
    @if (CanManagement(SecurityFunctionCodes.PayrollView)){<MudNavGroup Title="@Language.T("nav.payroll")" Icon="@Icons.Material.Filled.Payments" Expanded="false"><MudNavLink href="/payroll/table" Icon="@Icons.Material.Filled.TableView">@Language.T("nav.payrollTable")</MudNavLink></MudNavGroup>}
    @if (CanManagement(SecurityFunctionCodes.LeaveView) || CanManagement(SecurityFunctionCodes.OTView) || CanManagement(SecurityFunctionCodes.TripView) || CanManagement(SecurityFunctionCodes.EquipmentView) || CanManagement(SecurityFunctionCodes.AttendanceView)){<MudNavGroup Title="@Language.T("nav.reports")" Icon="@Icons.Material.Filled.Assessment" Expanded="false"><MudNavLink href="/reports" Icon="@Icons.Material.Filled.Dashboard">@Language.T("nav.reportCenter")</MudNavLink>@if(CanManagement(SecurityFunctionCodes.LeaveView)){<MudNavLink href="/report/leave" Icon="@Icons.Material.Filled.BeachAccess">@Language.T("nav.reportLeave")</MudNavLink>}@if(CanManagement(SecurityFunctionCodes.OTView)){<MudNavLink href="/report/ot" Icon="@Icons.Material.Filled.MoreTime">@Language.T("nav.reportOt")</MudNavLink>}@if(CanManagement(SecurityFunctionCodes.TripView)){<MudNavLink href="/report/operations?module=trip" Icon="@Icons.Material.Filled.FlightTakeoff">@Language.T("nav.reportTrip")</MudNavLink>}@if(CanManagement(SecurityFunctionCodes.EquipmentView)){<MudNavLink href="/report/operations?module=equipment" Icon="@Icons.Material.Filled.Devices">@Language.T("nav.reportEquipment")</MudNavLink>}@if(CanManagement(SecurityFunctionCodes.AttendanceView)){<MudNavLink href="/report/operations?module=attendance" Icon="@Icons.Material.Filled.AccessTime">@Language.T("nav.reportAttendance")</MudNavLink>}</MudNavGroup>}

    @if (Can(SecurityFunctionCodes.UserManagementView) || Can(SecurityFunctionCodes.SecurityView))
    {
        <MudNavGroup Title="@Language.T("nav.system")" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            @if(Can(SecurityFunctionCodes.UserManagementView)){<MudNavLink href="/admin/managers" Icon="@Icons.Material.Filled.AdminPanelSettings">@Language.T("nav.admin")</MudNavLink>}
            @if(Can(SecurityFunctionCodes.SecurityView)){<MudNavLink href="/admin/security" Icon="@Icons.Material.Filled.Security">@Language.T("nav.securityCenter")</MudNavLink><MudNavLink href="/admin/sessions" Icon="@Icons.Material.Filled.Devices">@Language.T("common.sessions")</MudNavLink>}
            @if(Can(SecurityFunctionCodes.SecurityManageFunctions)){<MudNavLink href="/admin/security/function-registry" Icon="@Icons.Material.Filled.AppRegistration">@Language.T("nav.functionRegistry")</MudNavLink>}
            @if(Can(SecurityFunctionCodes.EmailTemplateManage)){<MudNavLink href="/admin/email-templates" Icon="@Icons.Material.Filled.Email">@Language.T("nav.emailTemplates")</MudNavLink>}
            @if(Can(SecurityFunctionCodes.EmailTemplateManage)){<MudNavLink href="/admin/email-profiles" Icon="@Icons.Material.Filled.Dns">@Language.T("nav.emailProfiles")</MudNavLink>}
            @if(Can(SecurityFunctionCodes.LanguageView)){<MudNavLink href="/admin/localization" Icon="@Icons.Material.Filled.Translate">@Language.T("nav.localization")</MudNavLink>}
            @if(Can(SecurityFunctionCodes.EmailQueueManage)){<MudNavLink href="/admin/email-queue" Icon="@Icons.Material.Filled.MarkEmailRead">@Language.T("nav.emailQueue")</MudNavLink>}
            @if(CanManagement(SecurityFunctionCodes.WorkCalendarView)){<MudNavLink href="/admin/work-calendar" Icon="@Icons.Material.Filled.CalendarMonth">@Language.T("nav.workCalendarManagement")</MudNavLink>}
        </MudNavGroup>
    }
</MudNavMenu>
@code { private bool _otRegistrar; private PermissionSnapshotDto? _permissions; private FVN_REGISTER.Contract.Dtos.PublicForms.PublicCapabilitiesDto? _publicCaps; private int _noticeCount; private bool _noticeImportant; private Color NoticeColor => _noticeCount == 0 ? Color.Default : _noticeImportant ? Color.Error : Color.Warning; private string PublicGroupTitle => _noticeCount > 0 ? Language.T("nav.public") + " (" + _noticeCount + ")" : Language.T("nav.public"); protected override async Task OnInitializedAsync(){Language.LanguageChanged+=OnLanguageChanged;var result=await SecurityService.GetMyPermissionsAsync();if(result.IsSuccess)_permissions=result.Data;await LoadOtRegistrarAsync();await LoadPublicCapabilitiesAsync();} private async Task LoadOtRegistrarAsync(){try{var d=await PublicHttp.GetAsync<bool>("api/registration-policy/is-registrar?registerType=OT",showLoading:false);_otRegistrar=d.IsSuccess&&d.Data;}catch{_otRegistrar=false;}} private async Task LoadPublicCapabilitiesAsync(){try{var forms=await PublicHttp.GetAsync<FVN_REGISTER.Contract.Dtos.PublicForms.PublicCapabilitiesDto>("api/public-forms/capabilities",showLoading:false);var info=await PublicHttp.GetAsync<FVN_REGISTER.Contract.Dtos.PublicForms.PublicCapabilitiesDto>("api/public-information/capabilities",showLoading:false);var notice=await PublicHttp.GetAsync<FVN_REGISTER.Contract.Dtos.PublicForms.PublicNoticeSummaryDto>("api/public-portal/summary",showLoading:false);if(notice.IsSuccess&&notice.Data!=null){_noticeCount=notice.Data.TotalCount;_noticeImportant=notice.Data.HasImportant;}_publicCaps=new(){CanRegister=forms.IsSuccess&&forms.Data?.CanRegister==true,CanManageForms=forms.IsSuccess&&forms.Data?.CanManageForms==true,CanViewResults=forms.IsSuccess&&forms.Data?.CanViewResults==true,CanManageInformation=info.IsSuccess&&info.Data?.CanManageInformation==true};}catch{_publicCaps=null;}} private void OnLanguageChanged(object? sender,EventArgs e)=>_=InvokeAsync(StateHasChanged); private bool Can(int functionCode)=>_permissions?.Has(functionCode)==true; private bool CanPersonal(int functionCode)=>_permissions?.HasPersonal(functionCode)==true; private bool CanManagement(int functionCode)=>_permissions?.HasManagement(functionCode)==true; private bool CanAny(params int[] functionCodes)=>functionCodes.Any(Can); public void Dispose()=>Language.LanguageChanged-=OnLanguageChanged; }