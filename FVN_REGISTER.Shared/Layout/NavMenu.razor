@using FVN_REGISTER.Shared.Services.Users
@using FVN_REGISTER.Shared.Utils
@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Shared.Services.Security
@using FVN_REGISTER.Core.Constants
@inject ISecurityClientService SecurityService
@using MudBlazor
@inject ICurrentUserClientService CurrentUser

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="ml-4 my-3">DASHBOARD</MudText>
    <MudNavLink href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Trang chủ</MudNavLink>
    <MudNavLink href="/calendar" Icon="@Icons.Material.Filled.CalendarMonth">Lịch làm việc</MudNavLink>
    <MudNavLink href="/execution" Icon="@Icons.Material.Filled.FactCheck">Đối soát thực tế</MudNavLink>
    <MudNavLink href="/work/inbox" Icon="@Icons.Material.Filled.Inbox">Trung tâm công việc</MudNavLink>

    <MudNavGroup Title="Public" Icon="@Icons.Material.Filled.Campaign" Expanded="false">
        <MudNavLink href="/public-information" Icon="@Icons.Material.Filled.Public">Thông tin công khai</MudNavLink>
        <MudNavLink href="/public-forms" Icon="@Icons.Material.Filled.Assignment">Biểu mẫu đăng ký</MudNavLink>
        @if (Can(SecurityFunctionCodes.PublicFormManage)) { <MudNavLink href="/admin/public-forms" Icon="@Icons.Material.Filled.EditNote">Quản lý biểu mẫu đăng ký</MudNavLink> }
    </MudNavGroup>

    @if (CanAny(SecurityFunctionCodes.SecurityAccessChangeView, SecurityFunctionCodes.SecurityAccessChangeCreate, SecurityFunctionCodes.SecurityAccessChangeApprove, SecurityFunctionCodes.SecurityAccessChangeExecute))
    { <MudNavGroup Title="Thay đổi quyền" Icon="@Icons.Material.Filled.ManageAccounts" Expanded="false">@if (CanAny(SecurityFunctionCodes.SecurityAccessChangeView, SecurityFunctionCodes.SecurityAccessChangeCreate)){<MudNavLink href="/security/access-change" Icon="@Icons.Material.Filled.SwapHoriz">Phiếu thay đổi quyền / bàn giao</MudNavLink>}</MudNavGroup> }

    @if (CanAny(SecurityFunctionCodes.LeaveApprove, SecurityFunctionCodes.OTApprove, SecurityFunctionCodes.TripApprove, SecurityFunctionCodes.EquipmentApprove, SecurityFunctionCodes.EndpointSoftwarePolicyApprove, SecurityFunctionCodes.EndpointServicePolicyApprove))
    { <MudNavGroup Title="Phê duyệt" Icon="@Icons.Material.Filled.CheckCircle" Expanded="false"><MudNavLink href="/approvals" Icon="@Icons.Material.Filled.List">Danh sách chờ duyệt</MudNavLink></MudNavGroup> }

    @if (Can(SecurityFunctionCodes.LeaveCreate)) { <MudNavGroup Title="Nghỉ phép" Icon="@Icons.Material.Filled.EventBusy" Expanded="true"><MudNavLink href="/leave" Icon="@Icons.Material.Filled.Dashboard">Tổng quan</MudNavLink><MudNavLink href="/leave/create" Icon="@Icons.Material.Filled.Add">Tạo đơn mới</MudNavLink><MudNavLink href="/leave/history" Icon="@Icons.Material.Filled.History">Lịch sử nghỉ phép</MudNavLink></MudNavGroup> }
    @if (Can(SecurityFunctionCodes.OTCreate)) { <MudNavGroup Title="Làm thêm giờ (OT)" Icon="@Icons.Material.Filled.Timelapse" Expanded="false"><MudNavLink href="/ot" Icon="@Icons.Material.Filled.Dashboard">Tổng quan</MudNavLink><MudNavLink href="/ot/create" Icon="@Icons.Material.Filled.AddAlarm">Đăng ký OT</MudNavLink><MudNavLink href="/ot/history" Icon="@Icons.Material.Filled.ManageHistory">Lịch sử OT</MudNavLink></MudNavGroup> }
    @if (Can(SecurityFunctionCodes.TripCreate)) { <MudNavGroup Title="Công tác" Icon="@Icons.Material.Filled.FlightTakeoff" Expanded="false"><MudNavLink href="/trip" Icon="@Icons.Material.Filled.Dashboard">Tổng quan</MudNavLink><MudNavLink href="/trip/create" Icon="@Icons.Material.Filled.Add">Đăng ký công tác</MudNavLink><MudNavLink href="/trip/history" Icon="@Icons.Material.Filled.History">Lịch sử công tác</MudNavLink></MudNavGroup> }

    @if (CanAny(SecurityFunctionCodes.EndpointView, SecurityFunctionCodes.EndpointInventoryView, SecurityFunctionCodes.EndpointSoftwareCatalogView, SecurityFunctionCodes.EndpointServiceCatalogView, SecurityFunctionCodes.EndpointCredentialProvision, SecurityFunctionCodes.EndpointCredentialRevoke))
    {
        <MudNavGroup Title="Endpoint Governance" Icon="@Icons.Material.Filled.Security" Expanded="false">
            @if (CanAny(SecurityFunctionCodes.EndpointSoftwareCatalogView, SecurityFunctionCodes.EndpointServiceCatalogView, SecurityFunctionCodes.EndpointSoftwareCatalogManage, SecurityFunctionCodes.EndpointServiceCatalogManage)) { <MudNavLink href="/endpoint-governance" Icon="@Icons.Material.Filled.Policy">Software / Service Catalog</MudNavLink> }
            @if (Can(SecurityFunctionCodes.EndpointInventoryView)) { <MudNavLink href="/endpoint-inventory" Icon="@Icons.Material.Filled.Devices">Endpoint Inventory</MudNavLink> }
            @if (CanAny(SecurityFunctionCodes.EndpointCredentialProvision, SecurityFunctionCodes.EndpointCredentialRevoke)) { <MudNavLink href="/endpoint-credentials" Icon="@Icons.Material.Filled.VpnKey">Agent Credentials</MudNavLink> }
        </MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.EquipmentView))
    { <MudNavGroup Title="Thiết bị" Icon="@Icons.Material.Filled.Devices" Expanded="false"><MudNavLink href="/equipment" Icon="@Icons.Material.Filled.Dashboard">Sổ quản lý thiết bị</MudNavLink>@if(Can(SecurityFunctionCodes.EquipmentImport)){<MudNavLink href="/equipment/workspace" Icon="@Icons.Material.Filled.UploadFile">Import Excel thiết bị</MudNavLink>}</MudNavGroup> }

    @if (CanAny(SecurityFunctionCodes.DepartmentView, SecurityFunctionCodes.EmployeeView, SecurityFunctionCodes.LeaveTypeView, SecurityFunctionCodes.ApproverView, SecurityFunctionCodes.HrmSyncViewStatus, SecurityFunctionCodes.HrmSyncReview, SecurityFunctionCodes.HrmUserRoleRuleManage, SecurityFunctionCodes.ApprovalPolicyManage, SecurityFunctionCodes.AttendanceCalculate, SecurityFunctionCodes.DepartmentStatusView))
    {
        <MudNavGroup Title="Dữ liệu" Icon="@Icons.Material.Filled.Storage" Expanded="false">
            @if (Can(SecurityFunctionCodes.DepartmentView)){<MudNavLink href="/admin/departments" Icon="@Icons.Material.Filled.Business">Bộ phận</MudNavLink>}
            @if (Can(SecurityFunctionCodes.EmployeeView)){<MudNavLink href="/admin/employees" Icon="@Icons.Material.Filled.People">Nhân viên</MudNavLink>}
            @if (Can(SecurityFunctionCodes.ApproverView)){<MudNavLink href="/admin/approvers" Icon="@Icons.Material.Filled.VerifiedUser">Approver</MudNavLink>}
            @if (Can(SecurityFunctionCodes.LeaveTypeView)){<MudNavLink href="/admin/leave-types" Icon="@Icons.Material.Filled.Category">Hình thức nghỉ</MudNavLink>}
            @if (Can(SecurityFunctionCodes.HrmSyncViewStatus)){<MudNavLink href="/admin/hrm-sync" Icon="@Icons.Material.Filled.Sync">Đồng bộ HRM</MudNavLink>}
            @if (Can(SecurityFunctionCodes.HrmSyncReview)){<MudNavLink href="/admin/hrm-sync-review" Icon="@Icons.Material.Filled.WarningAmber">Conflict HRM</MudNavLink>}
            @if (Can(SecurityFunctionCodes.HrmUserRoleRuleManage)){<MudNavLink href="/admin/hrm-role-rules" Icon="@Icons.Material.Filled.Rule">Role HRM → User</MudNavLink>}
            @if (Can(SecurityFunctionCodes.ApprovalPolicyManage)){<MudNavLink href="/admin/approval-policies" Icon="@Icons.Material.Filled.Policy">Approval Policy</MudNavLink>}
            @if (Can(SecurityFunctionCodes.DepartmentStatusView)){<MudNavLink href="/leave/department-status" Icon="@Icons.Material.Filled.Assessment">Trạng thái phòng ban</MudNavLink>}
            @if (Can(SecurityFunctionCodes.AttendanceCalculate)){<MudNavLink href="/hrm/attendance-calculation" Icon="@Icons.Material.Filled.AccessTime">Tính giờ theo HRM</MudNavLink>}
        </MudNavGroup>
        <MudNavGroup Title="Quản lý OT" Icon="@Icons.Material.Filled.Timelapse" Expanded="false">@if(Can(SecurityFunctionCodes.OTView)){<MudNavLink href="/ot/list" Icon="@Icons.Material.Filled.FormatListBulleted">Danh sách đơn OT</MudNavLink>}@if(Can(SecurityFunctionCodes.OTLimitManage)){<MudNavLink href="/admin/ot-limit-rules" Icon="@Icons.Material.Filled.Rule">Hạn mức OT</MudNavLink>}</MudNavGroup>
    }

    @if (Can(SecurityFunctionCodes.ExecutionReview)){<MudNavGroup Title="Đối soát HR" Icon="@Icons.Material.Filled.Rule" Expanded="false"><MudNavLink href="/execution/hr" Icon="@Icons.Material.Filled.FactCheck">Hàng chờ HR</MudNavLink></MudNavGroup>}
    @if (Can(SecurityFunctionCodes.PayrollView)){<MudNavGroup Title="Tính lương" Icon="@Icons.Material.Filled.Payments" Expanded="false"><MudNavLink href="/payroll/table" Icon="@Icons.Material.Filled.TableView">Bảng công tính lương</MudNavLink></MudNavGroup>}
    @if (CanAny(SecurityFunctionCodes.LeaveView,SecurityFunctionCodes.OTView,SecurityFunctionCodes.TripView,SecurityFunctionCodes.EquipmentView,SecurityFunctionCodes.AttendanceView)){<MudNavGroup Title="Báo cáo & thống kê" Icon="@Icons.Material.Filled.Assessment" Expanded="false"><MudNavLink href="/reports" Icon="@Icons.Material.Filled.Dashboard">Trung tâm báo cáo</MudNavLink>@if(Can(SecurityFunctionCodes.LeaveView)){<MudNavLink href="/report/leave" Icon="@Icons.Material.Filled.BeachAccess">Nghỉ phép</MudNavLink>}@if(Can(SecurityFunctionCodes.OTView)){<MudNavLink href="/report/ot" Icon="@Icons.Material.Filled.MoreTime">OT</MudNavLink>}@if(Can(SecurityFunctionCodes.TripView)){<MudNavLink href="/report/operations?module=trip" Icon="@Icons.Material.Filled.FlightTakeoff">Công tác</MudNavLink>}@if(Can(SecurityFunctionCodes.EquipmentView)){<MudNavLink href="/report/operations?module=equipment" Icon="@Icons.Material.Filled.Devices">Thiết bị</MudNavLink>}@if(Can(SecurityFunctionCodes.AttendanceView)){<MudNavLink href="/report/operations?module=attendance" Icon="@Icons.Material.Filled.AccessTime">Chấm công</MudNavLink>}</MudNavGroup>}

    @if (Can(SecurityFunctionCodes.UserManagementView) || _permissions?.RoleCodes.Contains(1) == true)
    {
        <MudNavGroup Title="Hệ thống" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            @if(Can(SecurityFunctionCodes.UserManagementView)){<MudNavLink href="/admin/managers" Icon="@Icons.Material.Filled.AdminPanelSettings">Quản trị viên</MudNavLink>}
            @if(Can(SecurityFunctionCodes.SecurityView)){<MudNavLink href="/admin/security" Icon="@Icons.Material.Filled.Security">Security Center</MudNavLink><MudNavLink href="/admin/sessions" Icon="@Icons.Material.Filled.Devices">Thiết bị & phiên đăng nhập</MudNavLink>}
            @if(_permissions?.RoleCodes.Contains(1)==true){<MudNavLink href="/admin/security/function-registry" Icon="@Icons.Material.Filled.AppRegistration">Đăng ký chức năng hệ thống</MudNavLink>}
            @if(Can(SecurityFunctionCodes.EmailTemplateManage)){<MudNavLink href="/admin/email-templates" Icon="@Icons.Material.Filled.Email">Email mẫu</MudNavLink>}
            @if(Can(SecurityFunctionCodes.EmailQueueManage)){<MudNavLink href="/admin/email-queue" Icon="@Icons.Material.Filled.MarkEmailRead">Email chờ gửi</MudNavLink>}
            @if(Can(SecurityFunctionCodes.WorkCalendarView)){<MudNavLink href="/admin/work-calendar" Icon="@Icons.Material.Filled.CalendarMonth">Năm & ngày nghỉ</MudNavLink>}
        </MudNavGroup>
    }
</MudNavMenu>
@code { private PermissionSnapshotDto? _permissions; protected override async Task OnInitializedAsync(){var result=await SecurityService.GetMyPermissionsAsync();if(result.IsSuccess)_permissions=result.Data;} private bool Can(int functionCode)=>_permissions?.Has(functionCode)==true; private bool CanAny(params int[] functionCodes)=>functionCodes.Any(Can); }