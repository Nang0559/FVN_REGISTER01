@using FVN_REGISTER.Shared.Components.Loading
@using FVN_REGISTER.Shared.Pages
@using FVN_REGISTER.Shared.Utils
@using Microsoft.AspNetCore.Components.Authorization
@inject CustomAuthStateProvider AuthStateProvider
@inject ITokenStorage TokenStorage

<CascadingAuthenticationState>
    <MudThemeProvider Theme="_currentTheme" />
    <GlobalLoadingOverlay />
    <MudPopoverProvider />
    <MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.ExtraSmall" />
    <MudSnackbarProvider />

    @if (!_authReady)
    {
        <div class="d-flex align-center justify-center" style="min-height:100vh" role="status" aria-label="Đang khôi phục phiên đăng nhập">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else
    {
        <Router AppAssembly="@typeof(Layout.MainLayout).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @if (!context.User.Identity?.IsAuthenticated ?? true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <RouteStatusPopup Message="@Language.T("route.forbidden")" Severity="Severity.Error" />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>@Language.T("route.notFound")</PageTitle>
                <LayoutView Layout="@typeof(Layout.MainLayout)">
                    <RouteStatusPopup Message="@Language.T("route.notFound")" Severity="Severity.Warning" />
                </LayoutView>
            </NotFound>
        </Router>
    }
</CascadingAuthenticationState>

@code {
    private bool _authReady;

    private readonly MudTheme _currentTheme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1E88E5",
            Secondary = "#FF8F00",
            AppbarBackground = "#1E88E5",
            Background = "#F5F5F7"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Roboto", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // The router is deliberately held until localStorage is accessible, so
        // AuthorizeRouteView cannot redirect to /login before token restoration.
        await AuthStateProvider.RestoreFromStorageAsync(TokenStorage);
        _authReady = true;
        StateHasChanged();
    }
}