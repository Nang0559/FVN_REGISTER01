@using FVN_REGISTER.Contract.Dtos.Leaves
@using FVN_REGISTER.Core.Enums
@inject FVN_REGISTER.Shared.Services.Leaves.ILeaveCreateClientService LeaveService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
            Chi tiết đơn nghỉ
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (Item == null)
        {
            <MudAlert Severity="Severity.Warning">Không có dữ liệu đơn nghỉ.</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mb-3">
                <tbody>
                    <tr><td>Ngày đăng ký</td><td>@Item.RegisterDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    <tr><td>Thời gian</td><td>@Item.StartDate.ToString("dd/MM/yyyy") → @Item.EndDate.ToString("dd/MM/yyyy")</td></tr>
                    <tr><td>Loại nghỉ</td><td>@Item.LeaveTypeName (@Item.LeaveTypeCode)</td></tr>
                    <tr><td>Số ngày</td><td>@Item.TotalDay ngày, tính phép @Item.TotalLeaveDay ngày</td></tr>
                    <tr><td>Lý do</td><td>@(string.IsNullOrWhiteSpace(Item.Reason) ? "-" : Item.Reason)</td></tr>
                    <tr><td>Trạng thái</td><td>@GetStatusText(Item.Status)</td></tr>
                    <tr><td>Mã đơn</td><td>@(string.IsNullOrWhiteSpace(Item.LeaveCode) ? Item.RequestId.ToString() : Item.LeaveCode)</td></tr>
                </tbody>
            </MudSimpleTable>

            @if (CanCancel)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">Yêu cầu hủy đơn</MudText>
                <MudTextField @bind-Value="_cancelReason" Label="Lý do hủy *" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Class="mt-2" OnClick="ConfirmCancel" Color="Color.Error" Variant="Variant.Filled" Disabled="@_isCancelling" FullWidth="true">
                    @(_isCancelling ? "Đang xử lý..." : "Hủy cả đơn")
                </MudButton>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LeaveCalendarEventDto Item { get; set; } = default!;
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _cancelReason = string.Empty;
    private bool _isCancelling;

    // Cancellation is allowed by the request workflow only before an approval
    // decision has been processed. The API remains the source of truth.
    private bool CanCancel => Item != null &&
        string.Equals(Item.Status, ApprovalStatus.Pending.ToString(), StringComparison.OrdinalIgnoreCase);

    private async Task ConfirmCancel()
    {
        if (Item == null) return;
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            Snackbar.Add("Vui lòng nhập lý do hủy", Severity.Warning);
            return;
        }

        _isCancelling = true;
        try
        {
            var result = await LeaveService.CancelLeaveAsync(Item.RequestId, _cancelReason.Trim());
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? "Hủy đơn thất bại", Severity.Error);
                return;
            }

            Snackbar.Add("Đã hủy đơn nghỉ thành công", Severity.Success);
            await OnCancelled.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private void Close() => MudDialog.Cancel();

    private static string GetStatusText(string? status) => status switch
    {
        nameof(ApprovalStatus.Approved) => "Đã duyệt",
        nameof(ApprovalStatus.Rejected) => "Từ chối",
        nameof(ApprovalStatus.Cancelled) => "Đã hủy",
        nameof(ApprovalStatus.InProgress) => "Đang xử lý",
        nameof(ApprovalStatus.Draft) => "Nháp",
        nameof(ApprovalStatus.NeedsRevision) => "Yêu cầu chỉnh sửa",
        _ => "Chờ duyệt"
    };
}
