@using FVN_REGISTER.Contract.Dtos.Leaves
@using FVN_REGISTER.Core.Enums
@inject FVN_REGISTER.Shared.Services.Leaves.ILeaveCreateClientService LeaveService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
            @Language.T("leave.chiTietDonNghi")
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (Item == null)
        {
            <MudAlert Severity="Severity.Warning">@Language.T("leave.khongCoDuLieuDon")</MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Class="mb-3">
                <tbody>
                    <tr><td>@Language.T("common.ngayDangKy")</td><td>@Item.RegisterDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    <tr><td>@Language.T("common.thoiGian")</td><td>@Item.StartDate.ToString("dd/MM/yyyy") → @Item.EndDate.ToString("dd/MM/yyyy")</td></tr>
                    <tr><td>@Language.T("common.loaiNghi")</td><td>@Item.LeaveTypeName (@Item.LeaveTypeCode)</td></tr>
                    <tr><td>@Language.T("common.soNgay")</td><td>@Language.T("leave.ngayTinhPhepNgay", Item.TotalDay, Item.TotalLeaveDay)</td></tr>
                    <tr><td>@Language.T("common.reason")</td><td>@(string.IsNullOrWhiteSpace(Item.Reason) ? "-" : Item.Reason)</td></tr>
                    <tr><td>@Language.T("common.status")</td><td>@GetStatusText(Item.Status)</td></tr>
                    <tr><td>@Language.T("common.maDon")</td><td>@(string.IsNullOrWhiteSpace(Item.LeaveCode) ? Item.RequestId.ToString() : Item.LeaveCode)</td></tr>
                </tbody>
            </MudSimpleTable>

            @if (CanCancel)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">@Language.T("leave.yeuCauHuyDon")</MudText>
                <MudTextField @bind-Value="_cancelReason" Label="@Language.T("leave.lyDoHuy")" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Class="mt-2" OnClick="ConfirmCancel" Color="Color.Error" Variant="Variant.Filled" Disabled="@_isCancelling" FullWidth="true">
                    @(_isCancelling ? Language.T("common.dangXuLy") : Language.T("leave.huyCaDon"))
                </MudButton>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">@Language.T("common.close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LeaveCalendarEventDto Item { get; set; } = default!;
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _cancelReason = string.Empty;
    private bool _isCancelling;

    // Cancellation is allowed by the request workflow only before an approval
    // decision has been processed. The API remains the source of truth.
    private bool CanCancel => Item != null &&
        string.Equals(Item.Status, ApprovalStatus.Pending.ToString(), StringComparison.OrdinalIgnoreCase);

    private async Task ConfirmCancel()
    {
        if (Item == null) return;
        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            Snackbar.Add(Language.T("leave.vuiLongNhapLyDo3"), Severity.Warning);
            return;
        }

        _isCancelling = true;
        try
        {
            var result = await LeaveService.CancelLeaveAsync(Item.RequestId, _cancelReason.Trim());
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("leave.huyDonThatBai"), Severity.Error);
                return;
            }

            Snackbar.Add(Language.T("leave.daHuyDonNghiThanh"), Severity.Success);
            await OnCancelled.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private void Close() => MudDialog.Cancel();

    private string GetStatusText(string? status) => status switch
    {
        nameof(ApprovalStatus.Approved) => Language.T("leave.statusApproved"),
        nameof(ApprovalStatus.Rejected) => Language.T("common.reject"),
        nameof(ApprovalStatus.Cancelled) => Language.T("leave.statusCancelled"),
        nameof(ApprovalStatus.InProgress) => Language.T("leave.statusInProgress"),
        nameof(ApprovalStatus.Draft) => Language.T("leave.statusDraft"),
        nameof(ApprovalStatus.NeedsRevision) => Language.T("leave.yeuCauChinhSua"),
        _ => Language.T("leave.statusPending")
    };
}
