@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.OTs

@inject IOTClientService OTService
@inject ISnackbar Snackbar
@inject ILogger<OTDetailDialog> Logger

<MudDialog>
    <TitleContent><MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"><MudIcon Icon="@Icons.Material.Filled.Timelapse" /><MudText Typo="Typo.h6">@Language.T("ot.chiTietDonOt")</MudText>@if (_detail != null){<MudChip T="string" Size="Size.Small" Color="@GetStatusColor(_detail.RequestStatus)">@_detail.StatusText</MudChip>}</MudStack></TitleContent>
    <DialogContent>
        @if (_loadingDetail) { <MudProgressLinear Indeterminate="true" /> }
        else if (_detail != null)
        {
            <MudGrid Spacing="3">
                <MudItem xs="12"><MudText Typo="Typo.subtitle2">@Language.T("ot.thongTinChung")</MudText><MudDivider /></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Language.T("ot.ngayOt")</MudText><MudText>@_detail.OTDate.ToString("dd/MM/yyyy")</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Language.T("ot.loaiOt")</MudText><MudText>@_detail.OTTypeCode</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Language.T("ot.nguoiLap")</MudText><MudText>@_detail.RequesterName (@_detail.RequesterCode)</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Language.T("ot.department")</MudText><MudText>@_detail.DeptName</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Language.T("ot.tongGio")</MudText><MudText>@_detail.TotalOtHours.ToString("N1") h</MudText></MudItem>
                <MudItem xs="12"><MudText Typo="Typo.caption">@Language.T("ot.mucDichMoTa")</MudText><MudText>@_detail.OtPurpose — @_detail.Description</MudText></MudItem>
                <MudItem xs="12"><MudText Typo="Typo.subtitle2">@Language.T("ot.nhanVienThamGia2", _detail.Details.Count)</MudText><MudDivider Class="mb-2" /><MudSimpleTable Dense="true" Hover="true"><thead><tr><th>@Language.T("common.employeeCode")</th><th>@Language.T("common.employeeName")</th><th>@Language.T("common.hangMuc")</th><th>@Language.T("ot.gio")</th><th>@Language.T("ot.validation")</th></tr></thead><tbody>@foreach(var emp in _detail.Details){<tr><td>@emp.EmployeeCode</td><td>@emp.EmployeeName</td><td>@emp.OTReasonCategoryCode</td><td>@emp.StartTime.ToString(@"hh\:mm") - @emp.EndTime.ToString(@"hh\:mm") (@emp.OTHours.ToString("N1")h)</td><td><MudChip T="string" Size="Size.Small" Color="@GetValidationColor(emp.ValidationStatus)">@emp.ValidationStatus</MudChip></td></tr>}</tbody></MudSimpleTable></MudItem>
                @if (_detail.ApprovalSteps.Any())
                {
                    <MudItem xs="12"><MudText Typo="Typo.subtitle2">@Language.T("ot.luongPheDuyet")</MudText><MudDivider Class="mb-2" />
                        @foreach(var step in _detail.ApprovalSteps.OrderBy(x => x.Level))
                        {
                            <MudStack Row="true" Spacing="2" Class="mb-2"><MudIcon Icon="@(step.IsRequired ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Color="@(step.IsRequired ? Color.Primary : Color.Default)" /><MudText Typo="Typo.body2">@Language.T("ot.stepLine", step.Level, step.RoleName, step.ApproverName ?? Language.T("ot.unassigned"), step.StatusText)</MudText></MudStack>
                        }
                    </MudItem>
                }
            </MudGrid>
        }
        else { <MudAlert Severity="Severity.Warning">@Language.T("ot.khongTimThayDuLieu2")</MudAlert> }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Close">@Language.T("common.close")</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int OTRequestId { get; set; }
    private OTRequestDto? _detail;
    private bool _loadingDetail = true;
    protected override async Task OnInitializedAsync() => await LoadDetailAsync();
    private async Task LoadDetailAsync()
    {
        if (OTRequestId <= 0) { _loadingDetail = false; return; }
        try { var result = await OTService.GetDetailAsync(OTRequestId); if (result.IsSuccess) _detail = result.Data; else Snackbar.Add(result.Message ?? Language.T("common.khongTaiDuocChiTiet"), Severity.Warning); }
        catch (Exception ex) { Logger.LogError(ex, "[OT_DETAIL_DIALOG] Load error id={Id}", OTRequestId); Snackbar.Add(Language.T("common.loiTaiChiTiet"), Severity.Error); }
        finally { _loadingDetail = false; }
    }
    private void Close() => MudDialog.Close(DialogResult.Ok(true));
    private static Color GetStatusColor(ApprovalStatus status) => status switch { ApprovalStatus.Approved => Color.Success, ApprovalStatus.Rejected => Color.Error, ApprovalStatus.Cancelled => Color.Default, _ => Color.Warning };
    private static Color GetValidationColor(ValidationStatus status) => status switch { ValidationStatus.Valid => Color.Success, ValidationStatus.Warning => Color.Warning, ValidationStatus.Invalid => Color.Error, _ => Color.Default };
}
