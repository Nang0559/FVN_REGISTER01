@using FVN_REGISTER.Contract.Dtos.OT

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />Chọn nhân viên OT <MudChip T="string" Size="Size.Small">@Employees.Count người</MudChip></MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_searchText" Label="Tìm tên hoặc mã nhân viên" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mb-3" />
        <MudCheckBox T="bool" Value="@IsAllSelected" ValueChanged="ToggleAll" Label="Chọn tất cả" />
        <MudDivider Class="mb-2" />
        <div style="max-height:400px;overflow-y:auto;">
            @foreach (var emp in Filtered)
            {
                var disabled = emp.EmployeeCode == CurrentUserCode || AlreadySelected.Contains(emp.EmployeeCode);
                <MudPaper Elevation="0" Class="pa-2 mb-1" Style="border:1px solid var(--mud-palette-divider);">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudCheckBox T="bool" Value="@_selected.Contains(emp.EmployeeCode)" ValueChanged="@(v => Toggle(emp.EmployeeCode, v))" Disabled="@disabled" />
                        <MudAvatar Color="Color.Primary" Size="Size.Small">@(emp.EmployeeName.FirstOrDefault())</MudAvatar>
                        <div><MudText Typo="Typo.body2"><b>@emp.EmployeeName</b></MudText><MudText Typo="Typo.caption">@emp.EmployeeCode — @emp.DeptCode — @emp.DeptName — @emp.PositionCode — @emp.PositionName</MudText></div>
                        @if (disabled && emp.EmployeeCode != CurrentUserCode) { <MudSpacer /><MudChip T="string" Size="Size.Small" Color="Color.Success">Đã thêm</MudChip> }
                    </MudStack>
                </MudPaper>
            }
        </div>
    </DialogContent>
    <DialogActions><MudButton OnClick="Cancel">Hủy</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm" Disabled="@(!_selected.Any())">Thêm @_selected.Count</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<EmployeeSelectDto> Employees { get; set; } = new();
    [Parameter] public HashSet<string> AlreadySelected { get; set; } = new();
    [Parameter] public string CurrentUserCode { get; set; } = string.Empty;
    private string _searchText = string.Empty;
    private HashSet<string> _selected = new();
    private IEnumerable<EmployeeSelectDto> Filtered => string.IsNullOrWhiteSpace(_searchText) ? Employees : Employees.Where(x => x.EmployeeName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) || x.EmployeeCode.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
    private bool IsAllSelected => Filtered.Any() && Filtered.Where(x => x.EmployeeCode != CurrentUserCode && !AlreadySelected.Contains(x.EmployeeCode)).All(x => _selected.Contains(x.EmployeeCode));
    private void Toggle(string code, bool value) { if (value) _selected.Add(code); else _selected.Remove(code); }
    private void ToggleAll(bool value) { if (value) foreach (var e in Filtered.Where(x => x.EmployeeCode != CurrentUserCode && !AlreadySelected.Contains(x.EmployeeCode))) _selected.Add(e.EmployeeCode); else _selected.Clear(); }
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_selected));
    private void Cancel() => MudDialog.Cancel();
}
