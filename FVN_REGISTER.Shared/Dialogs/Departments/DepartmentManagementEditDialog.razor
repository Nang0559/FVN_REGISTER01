@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Shared.Services.Departments

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddBusiness)" Class="mr-2" />
            @(IsEdit ? "Chỉnh sửa Bộ phận" : "Thêm Bộ phận mới")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Model="@Model">
            <MudTextField T="string" Label="Mã bộ phận" @bind-Value="Model.DeptCode" For="@(() => Model.DeptCode)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="IsEdit" Class="mb-4" />
            <MudTextField T="string" Label="Tên bộ phận" @bind-Value="Model.DeptName" For="@(() => Model.DeptName)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
            <MudSwitch T="bool" @bind-Value="Model.IsActive" Color="Color.Success" Label="Kích hoạt bộ phận" />
        </MudForm>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_errorMessage</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">
            @(_isSaving ? "Đang lưu..." : "Lưu")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DepartmentUpsertDto Model { get; set; } = new();
    [Inject] private IDepartmentManagementClientService DepartmentService { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isSaving;
    private string? _errorMessage;
    private bool IsEdit => Model.Id > 0;

    private async Task Submit()
    {
        _errorMessage = null;
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isSaving = true;
        try
        {
            var result = IsEdit
                ? await DepartmentService.UpdateAsync(Model.Id, Model)
                : await DepartmentService.CreateAsync(Model);

            if (result.IsSuccess)
                MudDialog.Close(DialogResult.Ok(true));
            else
                _errorMessage = result.Message ?? "Có lỗi xảy ra, vui lòng thử lại.";
        }
        finally { _isSaving = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
