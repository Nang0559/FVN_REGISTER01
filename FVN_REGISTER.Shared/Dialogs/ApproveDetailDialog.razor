@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Shared.Services.Approvals

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Language.T("approval.chiTietDon", Item.EmployeeName)</MudText></TitleContent>
    <DialogContent>
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td><b>@Language.T("common.employeeCode")</b></td><td>@Item.EmployeeCode</td></tr>
                <tr><td><b>@Language.T("approval.loaiDon")</b></td><td>@GetKindLabel(Item.Kind)</td></tr>
                <tr><td><b>@Language.T("common.thoiGian")</b></td><td>@(Item.FromDate?.ToString("dd/MM/yyyy") ?? "—") → @(Item.ToDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                <tr><td><b>@Language.T("common.soLuong")</b></td><td>@FormatUnits(Item)</td></tr>
                <tr><td><b>@Language.T("common.department")</b></td><td>@Item.DeptName</td></tr>
                <tr><td><b>@Language.T("approval.level")</b></td><td>@GetCurrentApprovalLevel(Item)</td></tr>
            </tbody>
        </MudSimpleTable>
        <MudTextField @bind-Value="_comment" Label="@Language.T("approval.yKienLyDoTu")" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@Language.T("common.close")</MudButton>
        <MudButton Color="Color.Error" Disabled="@(string.IsNullOrWhiteSpace(_comment) || _busy)" OnClick="Reject">@Language.T("common.reject")</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" Disabled="_busy" OnClick="Approve">@(_busy ? Language.T("common.dangXuLy") : Language.T("common.approve"))</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public PendingApprovalItemDto Item { get; set; } = default!;
    [Parameter] public int Level { get; set; }
    [Inject] IApprovalListClientService ApprovalService { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;
    private string _comment = string.Empty;
    private bool _busy;


    private static int GetCurrentApprovalLevel(PendingApprovalItemDto item) =>
        item.ApprovalSteps
            .OrderBy(s => s.Level)
            .FirstOrDefault(s => s.IsRequired && s.IsApproved == null)?.Level ?? 0;

    private string GetKindLabel(FVN_REGISTER.Core.Enums.RequestModule kind) => kind switch
    {
        FVN_REGISTER.Core.Enums.RequestModule.Leave => Language.T("dashboard.leaveType"),
        FVN_REGISTER.Core.Enums.RequestModule.Overtime => Language.T("approval.tangCa"),
        FVN_REGISTER.Core.Enums.RequestModule.Trip => Language.T("dashboard.tripType"),
        FVN_REGISTER.Core.Enums.RequestModule.Equipment => Language.T("help.EQUIPMENT_WORKSPACE.title"),
        _ => kind.ToString()
    };

    private string FormatUnits(PendingApprovalItemDto item)
    {
        var unit = item.Kind == FVN_REGISTER.Core.Enums.RequestModule.Overtime ? Language.T("calendar.hours") : Language.T("dashboard.days");
        return $"{item.TotalUnits:N1} {unit}";
    }

    private async Task Approve()
    {
        _busy = true;
        try { var result = await ApprovalService.ApproveAsync(new List<int> { Item.RequestId }, Item.Kind, Level > 0 ? Level : GetCurrentApprovalLevel(Item), _comment); Snackbar.Add(result.IsSuccess ? Language.T("approval.daPheDuyet") : result.Message ?? Language.T("common.error"), result.IsSuccess ? Severity.Success : Severity.Error); if (result.IsSuccess) MudDialog.Close(DialogResult.Ok(true)); }
        finally { _busy = false; }
    }

    private async Task Reject()
    {
        _busy = true;
        try { var result = await ApprovalService.RejectAsync(new List<int> { Item.RequestId }, Item.Kind, Level > 0 ? Level : GetCurrentApprovalLevel(Item), _comment); Snackbar.Add(result.IsSuccess ? Language.T("approval.daTuChoi") : result.Message ?? Language.T("common.error"), result.IsSuccess ? Severity.Info : Severity.Error); if (result.IsSuccess) MudDialog.Close(DialogResult.Ok(true)); }
        finally { _busy = false; }
    }
}
