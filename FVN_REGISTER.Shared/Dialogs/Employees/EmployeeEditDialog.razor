@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Contract.Dtos.Employees
@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Shared.Services.Approvals
@using FVN_REGISTER.Shared.Services.Employees

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@(Model.Id == 0 ? Icons.Material.Filled.PersonAdd : Icons.Material.Filled.Edit)"
                     Color="Color.Primary" />
            <MudText Typo="Typo.h6">
                @(Model.Id == 0 ? "Thêm nhân viên mới" : "Chỉnh sửa nhân viên")
            </MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" Class="pt-2">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Label="Mã nhân viên (*)"
                                  @bind-Value="Model.EmployeeCode"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Nhập mã nhân viên"
                                  Disabled="@(Model.Id != 0)" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Họ tên (*)"
                                  @bind-Value="Model.EmployeeName"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Nhập họ tên" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Bộ phận (*)"
                               @bind-Value="Model.DeptCode"
                               Variant="Variant.Outlined"
                               Disabled="LockDept"
                               Required="true"
                               RequiredError="Chọn bộ phận">
                        @foreach (var dept in Departments)
                        {
                            <MudSelectItem Value="@dept.DeptCode">@dept.DeptCode — @dept.DeptName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="Chức vụ (*)"
                               @bind-Value="Model.PositionCode"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="Chọn chức vụ">
                        @foreach (var position in _positions)
                        {
                            <MudSelectItem Value="@position.PositionCode">
                                @position.PositionCode — @position.PositionName
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Email (*)"
                                  @bind-Value="Model.EmailAddress"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Nhập email"
                                  InputType="InputType.Email" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="Số điện thoại"
                                  @bind-Value="Model.PhoneNumber"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               Label="Giới tính"
                               @bind-Value="Model.GenderCode"
                               Variant="Variant.Outlined"
                               Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)1)">Nam</MudSelectItem>
                        <MudSelectItem T="int?" Value="@((int?)2)">Nữ</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Ngày sinh"
                                   @bind-Date="Model.BirthDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Ngày vào làm"
                                   @bind-Date="Model.FirstWorkingDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Ngày nghỉ việc"
                                   @bind-Date="Model.EndWorkingDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Label="Tổng phép năm (ngày)"
                                     @bind-Value="Model.TotalLeaveDays"
                                     Variant="Variant.Outlined"
                                     Min="0" Max="30" Step="0.5m" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?"
                               Label="Cấp duyệt"
                               @bind-Value="Model.LevelApprove"
                               Variant="Variant.Outlined"
                               Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)1)">Cấp 1</MudSelectItem>
                        <MudSelectItem T="int?" Value="@((int?)2)">Cấp 2</MudSelectItem>
                        <MudSelectItem T="int?" Value="@((int?)3)">Cấp 3</MudSelectItem>
                        <MudSelectItem T="int?" Value="@((int?)4)">Cấp 4</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool"
                               @bind-Value="Model.IsActive"
                               Label="@(Model.IsActive ? "Đang làm việc" : "Đã nghỉ")"
                               Color="Color.Success"
                               Class="mt-3" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Hủy</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="_isSaving">
            @(_isSaving ? "Đang lưu..." : (Model.Id == 0 ? "Thêm mới" : "Lưu thay đổi"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private IEmployeeManagementClientService EmployeeService { get; set; } = default!;
    [Inject] private IApprovalPolicyClientService ApprovalPolicyService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    [Parameter] public EmployeeUpsertDto Model { get; set; } = new() { IsActive = true };
    [Parameter] public List<DepartmentDto> Departments { get; set; } = new();
    [Parameter] public bool LockDept { get; set; }

    private MudForm _form = default!;
    private bool _isSaving;
    private List<ApprovalPolicyPositionDto> _positions = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await ApprovalPolicyService.GetPositionsAsync();
        if (result.IsSuccess)
            _positions = result.Data?.Where(x => x.IsActive).OrderBy(x => x.PositionCode).ToList() ?? new();
        else
            Snackbar.Add(result.Message ?? "Không tải được danh sách chức vụ.", Severity.Error);
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _isSaving = true;
        try
        {
            var result = Model.Id == 0
                ? await EmployeeService.CreateAsync(Model)
                : await EmployeeService.UpdateAsync(Model.Id, Model);

            if (result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? "Thành công!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Có lỗi xảy ra", Severity.Error);
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
