@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Dtos.Depts
@using FVN_REGISTER.Contract.Dtos.OT
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.Approvals

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Model.Id == 0 ? Language.T("approval.themApproverMoi") : Language.T("approval.chinhSuaApprover"))</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="string" Label="@Language.T("approval.boPhanCuaApprover")" Value="Model.DeptCode" ValueChanged="OnDeptChanged" Variant="Variant.Outlined" Disabled="LockDept" Required="true">
                        @foreach (var dept in Departments.Where(x => x.DeptCode != "ALL"))
                        { <MudSelectItem Value="@dept.DeptCode">@dept.DeptCode — @dept.DeptName</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="Model.ApproveForDeptCode" Label="@Language.T("approval.apDungPheDuyetCho")" Variant="Variant.Outlined" Required="true">
                        @foreach (var dept in Departments)
                        { <MudSelectItem Value="@dept.DeptCode">@dept.DeptCode — @dept.DeptName</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="Model.Level" Label="@Language.T("approval.capDuyet")" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="1">@Language.T("common.cap1")</MudSelectItem><MudSelectItem Value="2">@Language.T("common.cap2")</MudSelectItem><MudSelectItem Value="3">@Language.T("common.cap3")</MudSelectItem><MudSelectItem Value="4">@Language.T("common.cap4")</MudSelectItem><MudSelectItem Value="5">@Language.T("approval.cap5")</MudSelectItem><MudSelectItem Value="6">@Language.T("approval.cap6")</MudSelectItem><MudSelectItem Value="7">@Language.T("approval.cap7")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6"><MudSwitch @bind-Value="Model.IsActive" Label="@(Model.IsActive ? Language.T("common.enabled") : Language.T("email.voHieuHoa"))" Color="Color.Success" /></MudItem>
                <MudItem xs="12">
                    <MudSelect T="RequestModule" @bind-Value="Model.RequestType" Label="@Language.T("approval.loaiDon2")" Variant="Variant.Outlined">
                        <MudSelectItem Value="@RequestModule.Leave">@Language.T("nav.reportLeave")</MudSelectItem>
                        <MudSelectItem Value="@RequestModule.Overtime">@Language.T("nav.reportOt")</MudSelectItem>
                        <MudSelectItem Value="@RequestModule.Trip">@Language.T("trip.title")</MudSelectItem>
                        <MudSelectItem Value="@RequestModule.Equipment">@Language.T("approval.thietBiRequirement")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string" Label="@Language.T("approval.chonNhanVien")" Value="Model.ApproverCode" ValueChanged="OnEmployeeSelected" Variant="Variant.Outlined" Disabled="@(_employees.Count == 0)" Required="true">
                        @foreach (var emp in _employees.Where(x => x.IsApprover))
                        { <MudSelectItem Value="@emp.EmployeeCode">@emp.EmployeeCode - @emp.EmployeeName — @emp.DeptCode — @emp.DeptName — @emp.PositionCode — @emp.PositionName</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.ApproverName" Label='@Language.T("common.employeeName")' Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="Model.ApproverEmail" Label='@Language.T("common.email")' Variant="Variant.Outlined" InputType="InputType.Email" ReadOnly="true" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="Model.RoleName" Label="@Language.T("approval.tenVaiTro")" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Language.T("common.cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_saving">@(_saving ? Language.T("common.dangLuu") : Language.T("common.save"))</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IApproverClientService ApproverService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Parameter] public ApproverDto Model { get; set; } = new() { IsActive = true };
    [Parameter] public List<DepartmentDto> Departments { get; set; } = new();
    [Parameter] public bool LockDept { get; set; }

    private MudForm? _form;
    private bool _saving;
    private List<EmployeeSelectDto> _employees = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Model.DeptCode)) await LoadEmployees(Model.DeptCode);
    }

    private async Task OnDeptChanged(string value)
    {
        Model.DeptCode = value;
        Model.ApproverCode = string.Empty;
        Model.ApproverName = string.Empty;
        Model.ApproverEmail = string.Empty;
        await LoadEmployees(value);
    }

    private async Task LoadEmployees(string? deptCode)
    {
        _employees = new();
        if (string.IsNullOrWhiteSpace(deptCode)) return;
        var result = await ApproverService.GetEmployeesAsync(deptCode);
        if (result.IsSuccess && result.Data != null) _employees = result.Data;
    }

    private void OnEmployeeSelected(string code)
    {
        Model.ApproverCode = code;
        var emp = _employees.FirstOrDefault(x => x.EmployeeCode == code);
        if (emp != null) { Model.ApproverName = emp.EmployeeName; Model.ApproverEmail = emp.Email; }
    }

    private async Task Submit()
    {
        if (_form != null) { await _form.ValidateAsync(); if (!_form.IsValid) return; }
        _saving = true;
        try
        {
            var result = Model.Id == 0 ? await ApproverService.CreateAsync(Model) : await ApproverService.UpdateAsync(Model.Id, Model);
            Snackbar.Add(result.IsSuccess ? result.Message ?? Language.T("common.thanhCong") : result.Message ?? Language.T("common.coLoiXayRa"), result.IsSuccess ? Severity.Success : Severity.Error);
            if (result.IsSuccess) MudDialog.Close(DialogResult.Ok(true));
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
