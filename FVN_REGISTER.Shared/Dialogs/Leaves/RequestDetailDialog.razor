@using FVN_REGISTER.Contract.Dtos.Histories
@using System.Text.Json

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Chi tiết #@Detail?.Id — @Detail?.Kind</MudText>
    </TitleContent>
    <DialogContent>
        @if (Detail != null)
        {
            <MudGrid>
                <MudItem xs="6"><MudText Typo="Typo.caption">TRẠNG THÁI</MudText><MudText>@Detail.StatusDisplay</MudText></MudItem>
                <MudItem xs="6"><MudText Typo="Typo.caption">NGÀY GỬI</MudText><MudText>@Detail.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</MudText></MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            @if (Detail.Leave != null || Detail.OT != null)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2">Chi tiết yêu cầu</MudText>
                <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background-grey);">
                    <pre style="white-space:pre-wrap;word-break:break-word;margin:0;">@FormatPayload(Detail.Leave ?? (object?)Detail.OT)</pre>
                </MudPaper>
            }

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Tiến trình phê duyệt</MudText>
            <MudTimeline TimelineAlign="TimelineAlign.Start">
                @foreach (var step in Detail.ApprovalSteps.OrderBy(x => x.Level))
                {
                    <MudTimelineItem Color="@GetStepColor(step.IsApproved)" Size="Size.Small">
                        <ItemContent>
                            <MudText Typo="Typo.body2"><strong>Cấp @step.Level</strong> — @step.ApproverName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(step.IsApproved == true ? "Đã duyệt" : step.IsApproved == false ? "Từ chối" : "Chờ xử lý")
                                @if (step.ApproveTime.HasValue) { @($" lúc {step.ApproveTime:HH:mm dd/MM/yyyy}") }
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(step.Comment)) { <MudText Typo="Typo.caption">@step.Comment</MudText> }
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="Close">Đóng</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HistoryItemDetailDto? Detail { get; set; }

    private void Close() => MudDialog.Close();

    private static string FormatPayload(object? payload)
        => payload == null ? "—" : JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });

    private static Color GetStepColor(bool? approved) => approved switch
    {
        true => Color.Success,
        false => Color.Error,
        _ => Color.Default
    };
}
