@* FILE: FVN_REGISTER.Shared/Components/Dialogs/ResetPasswordDialog.razor *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-2" />
            Reset mật khẩu: <b>@UserName</b>
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="_newPassword"
                      Label="Mật khẩu mới (*)"
                      InputType="@_inputType"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.End"
                      AdornmentIcon="@_eyeIcon"
                      OnAdornmentClick="ToggleVisibility" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-1">
                @_error
            </MudText>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Hủy</MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Warning">
            Reset
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string UserName { get; set; } = string.Empty;

    private string _newPassword = string.Empty;
    private string _error = string.Empty;
    private bool _visible;
    private InputType _inputType => _visible ? InputType.Text : InputType.Password;
    private string _eyeIcon => _visible
        ? Icons.Material.Filled.Visibility
        : Icons.Material.Filled.VisibilityOff;

    private void ToggleVisibility() => _visible = !_visible;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = "Vui lòng nhập mật khẩu mới.";
            return;
        }
        if (_newPassword.Length < 6)
        {
            _error = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }
        MudDialog.Close(DialogResult.Ok(_newPassword));
    }

    private void Cancel() => MudDialog.Cancel();
}
