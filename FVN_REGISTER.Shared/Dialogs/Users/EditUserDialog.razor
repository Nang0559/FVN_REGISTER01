@using FVN_REGISTER.Contract.Dtos.Usermanagers
@using FVN_REGISTER.Shared.Services.Security
@inject ISecurityClientService SecurityService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" />
            Sửa quyền tài khoản
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudSelect T="int" @bind-Value="Request.PermissionCode"
                   Label="Quyền (*)"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            <MudSelectItem Value="2">Administrator</MudSelectItem>
            <MudSelectItem Value="4">Approver</MudSelectItem>
            <MudSelectItem Value="5">User</MudSelectItem>
        </MudSelect>
        <MudStack Class="mt-4" Spacing="1">
            <MudText Typo="Typo.subtitle2">Quyền module thiết bị</MudText>
            <MudCheckBox @bind-Value="_equipmentAccess">Sổ quản lý thiết bị</MudCheckBox>
            <MudCheckBox @bind-Value="_equipmentImportAccess">Import Excel thiết bị</MudCheckBox>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Chỉ user được cấp quyền mới nhìn thấy và gọi được chức năng tương ứng.
            </MudText>
        </MudStack>

        <MudTextField @bind-Value="Request.DeptCode"
                      Label="Mã phòng ban"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-3" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Hủy</MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Lưu thay đổi
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public UpdateUserRequest Request { get; set; } = new();

    private int? _equipmentFunctionId;
    private int? _equipmentImportFunctionId;
    private bool _equipmentAccess;
    private bool _equipmentImportAccess;

    protected override async Task OnInitializedAsync()
    {
        var result = await SecurityService.GetFunctionsAsync();
        if (!result.IsSuccess || result.Data == null) return;

        _equipmentFunctionId = result.Data.FirstOrDefault(x => x.FunctionCode == 2301)?.IdFunction;
        _equipmentImportFunctionId = result.Data.FirstOrDefault(x => x.FunctionCode == 2306)?.IdFunction;
        _equipmentAccess = _equipmentFunctionId.HasValue && Request.FunctionIds?.Contains(_equipmentFunctionId.Value) == true;
        _equipmentImportAccess = _equipmentImportFunctionId.HasValue && Request.FunctionIds?.Contains(_equipmentImportFunctionId.Value) == true;
    }

    private void Submit()
    {
        var ids = Request.FunctionIds?.Distinct().ToList() ?? new List<int>();
        SetFunction(ids, _equipmentFunctionId, _equipmentAccess);
        SetFunction(ids, _equipmentImportFunctionId, _equipmentImportAccess);
        Request.FunctionIds = ids;
        MudDialog.Close(DialogResult.Ok(Request));
    }

    private static void SetFunction(List<int> ids, int? functionId, bool enabled)
    {
        if (!functionId.HasValue) return;
        if (enabled)
        {
            if (!ids.Contains(functionId.Value)) ids.Add(functionId.Value);
        }
        else
        {
            ids.Remove(functionId.Value);
        }
    }
    private void Cancel() => MudDialog.Cancel();
}
