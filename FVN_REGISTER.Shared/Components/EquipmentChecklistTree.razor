@using FVN_REGISTER.Contract.Dtos.Equipment
@inject NavigationManager Navigation

<MudPaper Outlined="true" Class="pa-3">
    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
        @Language.T("equipment.cayThietBi")
    </MudText>

    @if (Assets.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Language.T("equipment.khongCoThietBiTrong")</MudAlert>
    }
    else
    {
        <div class="equipment-tree">
            @foreach (var asset in Assets.OrderBy(x => x.DeptCode).ThenBy(x => x.EquipmentCode))
            {
                var checks = Tasks.Where(x => string.Equals(x.EquipmentCode, asset.EquipmentCode, StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(x => x.ScheduledDate).ThenBy(x => x.DueAt).ToList();

                <div class="equipment-node">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel>
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Devices" />
                                    <MudText><b>@asset.EquipmentCode</b> — @asset.EquipmentName</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@asset.DeptCode</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="@(asset.IsQrActive ? Color.Success : Color.Default)">
                                        @(asset.IsQrActive ? Language.T("equipment.qrHoatDong") : Language.T("equipment.qrChuaHoatDong"))
                                    </MudChip>
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                <MudStack Spacing="1" Class="ml-8">
                                    <MudText Typo="Typo.body2">@Language.T("equipment.taiSanSerialViTri", asset.AssetCode, asset.SerialNumber, asset.Location)</MudText>

                                    @if (checks.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @Language.T("equipment.khongCoChecklistDuocPhan")
                                        </MudText>
                                    }
                                    else
                                    {
                                        @foreach (var check in checks)
                                        {
                                            <MudPaper Outlined="true" Class="pa-3">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" />
                                                        <div>
                                                            <MudText Typo="Typo.subtitle2">@check.TemplateName</MudText>
                                                            <MudText Typo="Typo.caption">
                                                                @Language.T("equipment.nguoiCheck2", check.ScheduledDate.ToString("dd/MM/yyyy"), check.InspectorEmployeeCode)
                                                            </MudText>
                                                        </div>
                                                    </MudStack>
                                                    <MudStack Row="true" Spacing="1">
                                                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(check.Status)">@StatusText(check.Status)</MudChip>
                                                        @if (!string.IsNullOrWhiteSpace(check.Result))
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@check.Result</MudChip>
                                                        }
                                                    </MudStack>
                                                </MudStack>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="ml-7">
                                                    <MudText Typo="Typo.caption">
                                                        @Language.T("equipment.han2", check.DueAt.ToString("dd/MM/yyyy HH:mm"))
                                                        @if (check.ApprovedAt.HasValue)
                                                        {
                                                            <span> @Language.T("equipment.duyet", check.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm"))</span>
                                                        }
                                                    </MudText>
                                                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew"
                                                               OnClick="@(() => Navigation.NavigateTo($"/equipment/inspection/{check.TaskId}"))">
                                                        @Language.T("equipment.moChecklist")
                                                    </MudButton>
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    }
                                </MudStack>
                            </ChildContent>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter] public new IReadOnlyList<EquipmentAssetDto> Assets { get; set; } = Array.Empty<EquipmentAssetDto>();
    [Parameter] public IReadOnlyList<EquipmentInspectionReportRowDto> Tasks { get; set; } = Array.Empty<EquipmentInspectionReportRowDto>();

    private static Color StatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        "Overdue" => Color.Error,
        "WaitingApproval" => Color.Warning,
        "InProgress" => Color.Info,
        _ => Color.Default
    };

    private string StatusText(string status) => status switch
    {
        "Scheduled" => Language.T("equipment.daLapLich"),
        "InProgress" => Language.T("equipment.dangKiemTra"),
        "WaitingApproval" => Language.T("leave.statusPending"),
        "Approved" => Language.T("leave.statusApproved"),
        "Rejected" => Language.T("equipment.canKiemTraLai"),
        "Overdue" => Language.T("equipment.quaHan"),
        "Cancelled" => Language.T("leave.statusCancelled"),
        _ => status
    };
}
