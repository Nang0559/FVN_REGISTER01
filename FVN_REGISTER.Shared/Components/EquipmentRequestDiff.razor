@using System.Globalization
@using System.Text.Json
@using FVN_REGISTER.Contract.Dtos.Equipment
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Contract.Dtos.EquipmentImport
@inject ILanguageService Language

@if (Request is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
        <MudText Typo="Typo.subtitle2">@(_isChange ? Language.T("equipment.diff.titleChange") : Language.T("equipment.diff.titleNew"))</MudText>
        @if (_isChange)
        {
            <MudChip T="string" Size="Size.Small" Color="@(_changedCount > 0 ? Color.Warning : Color.Default)" Variant="Variant.Outlined">@Language.T("equipment.diff.changedCount", _changedCount)</MudChip>
        }
    </MudStack>
    @if (_isChange && !_hasBefore)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">@Language.T("equipment.diff.noBefore")</MudAlert>
    }
    <div style="overflow-x:auto">
        <MudSimpleTable Dense="true" Hover="true" Outlined="true">
            <thead>
                <tr>
                    <th>@Language.T("equipment.diff.field")</th>
                    @if (_isChange)
                    {
                        <th>@Language.T("equipment.diff.before")</th>
                    }
                    <th>@(_isChange ? Language.T("equipment.diff.after") : Language.T("equipment.diff.value"))</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr style="@(row.Changed ? "background:rgba(255,193,7,.18)" : null)">
                        <td>@row.Label</td>
                        @if (_isChange)
                        {
                            <td>@row.Before</td>
                        }
                        <td>@if (row.Changed) {
                        <b>@row.After</b>
                    } else
                    {

                        @row.After
                    }
    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</div>
}

@code {
    [Parameter] public EquipmentRequestDto? Request { get; set; }
    /// <summary>Schema custom fields (labels/order) of the parent import batch, when known.</summary>
    [Parameter] public List<ExcelSchemaFieldDto>? CustomFields { get; set; }
    /// <summary>Custom values to show when the request has no stored CustomDataJson (drafts created before it existed).</summary>
    [Parameter] public IDictionary<string, string?>? FallbackCustom { get; set; }

    private sealed record DiffRow(string Label, string Before, string After, bool Changed);

    // Labels are resolved on every OnParametersSet so a language switch is picked up when the parent re-renders.
    private (string Key, string Label)[] FieldList => new[]
    {
        ("EquipmentCode", Language.T("equipment.field.equipmentCode")),
        ("EquipmentName", Language.T("equipment.field.equipmentName")),
        ("AssetCode", Language.T("equipment.field.assetCode")),
        ("SerialNumber", Language.T("equipment.field.serial")),
        ("Specification", Language.T("equipment.field.specification")),
        ("PurchasePrice", Language.T("equipment.field.purchasePrice")),
        ("PurchaseDate", Language.T("equipment.field.purchaseDate")),
        ("ExpectedDepreciationDate", Language.T("equipment.field.depreciationDate")),
        ("Location", Language.T("equipment.field.location")),
        ("Note", Language.T("equipment.field.note")),
        ("ManagedByEmployeeCode", Language.T("equipment.field.managedBy")),
        ("ResponsibleEmployeeCode", Language.T("equipment.field.responsible")),
        ("OperatingResponsibleDeptCode", Language.T("equipment.field.operatingDept")),
        ("OperatingResponsibleEmployeeCode", Language.T("equipment.field.operatingEmployee")),
    };

    private List<DiffRow> _rows = new();
    private bool _isChange;
    private bool _hasBefore;
    private int _changedCount;

    protected override void OnParametersSet()
    {
        _rows = new();
        _changedCount = 0;
        if (Request is null) return;

        _isChange = Request.RequestKind == EquipmentRequestKind.AssetChange;
        var before = Parse(Request.AssetBeforeSnapshotJson);
        var after = Parse(Request.AssetAfterSnapshotJson);
        _hasBefore = before.Count > 0;

        // Fallback to the request's own columns when no "after" snapshot exists (registrations / legacy drafts).
        if (after.Count == 0)
        {
            after["EquipmentName"] = Request.EquipmentName;
            after["AssetCode"] = Request.AssetCode;
            after["SerialNumber"] = Request.SerialNumber;
            after["Specification"] = Request.Specification;
            after["PurchasePrice"] = Request.PurchasePrice.ToString(CultureInfo.InvariantCulture);
            after["PurchaseDate"] = Request.PurchaseDate?.ToString("o", CultureInfo.InvariantCulture);
            after["ExpectedDepreciationDate"] = Request.ExpectedDepreciationDate?.ToString("o", CultureInfo.InvariantCulture);
            after["Location"] = Request.Location;
            after["Note"] = Request.Note;
            after["ResponsibleEmployeeCode"] = Request.ResponsibleEmployeeCode;
            after["OperatingResponsibleDeptCode"] = Request.DeptCode.ToString(CultureInfo.InvariantCulture);
        }

        foreach (var (key, label) in FieldList)
        {
            before.TryGetValue(key, out var b);
            after.TryGetValue(key, out var a);
            var fb = Format(key, b);
            var fa = Format(key, a);
            if (fb == "—" && fa == "—") continue;
            var changed = _isChange && _hasBefore && !string.Equals(fb, fa, StringComparison.Ordinal);
            if (changed) _changedCount++;
            _rows.Add(new DiffRow(label, fb, fa, changed));
        }

        // Schema-driven (custom) fields: asset CustomDataJson inside the snapshots, or the request's own CustomDataJson.
        var beforeCustom = ParseCustom(before.TryGetValue("CustomDataJson", out var bc) ? bc : null);
        var afterCustom = ParseCustom(after.TryGetValue("CustomDataJson", out var ac) ? ac : null);
        foreach (var pair in ParseCustom(Request.CustomDataJson)) afterCustom[pair.Key] = pair.Value;
        if (afterCustom.Count == 0 && FallbackCustom != null)
            foreach (var pair in FallbackCustom) afterCustom[pair.Key] = pair.Value;

        var customKeys = (CustomFields?.Select(f => f.FieldKey) ?? Enumerable.Empty<string>())
            .Concat(afterCustom.Keys).Concat(beforeCustom.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        foreach (var key in customKeys)
        {
            beforeCustom.TryGetValue(key, out var cb);
            afterCustom.TryGetValue(key, out var ca);
            var cfb = string.IsNullOrWhiteSpace(cb) ? "—" : cb.Trim();
            var cfa = string.IsNullOrWhiteSpace(ca) ? "—" : ca.Trim();
            var field = CustomFields?.FirstOrDefault(f => string.Equals(f.FieldKey, key, StringComparison.OrdinalIgnoreCase));
            if (cfb == "—" && cfa == "—" && field is null) continue;
            var customChanged = _isChange && _hasBefore && !string.Equals(cfb, cfa, StringComparison.Ordinal);
            if (customChanged) _changedCount++;
            _rows.Add(new DiffRow(field is null ? key : EquipmentCustomFieldsEditor.LabelOf(field), cfb, cfa, customChanged));
        }
    }

    private static Dictionary<string, string?> ParseCustom(string? json) => EquipmentCustomFieldsEditor.Parse(json);

    private static Dictionary<string, string?> Parse(string? json)
    {
        var result = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(json)) return result;
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object) return result;
            foreach (var p in doc.RootElement.EnumerateObject())
            {
                result[p.Name] = p.Value.ValueKind switch
                {
                    JsonValueKind.Null or JsonValueKind.Undefined => null,
                    JsonValueKind.String => p.Value.GetString(),
                    _ => p.Value.GetRawText()
                };
            }
        }
        catch (JsonException) { }
        return result;
    }

    private static string Format(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        if (key is "PurchaseDate" or "ExpectedDepreciationDate"
            && DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var date))
            return date.ToString("dd/MM/yyyy");
        if (key == "PurchasePrice" && decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var price))
            return price.ToString("N0");
        return value.Trim();
    }
}
