@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Contract.Requests.Security
@using FVN_REGISTER.Contract.Dtos.Usermanagers
@using FVN_REGISTER.Shared.Services.Security
@inject ISecurityClientService SecurityService
@inject ISnackbar Snackbar

@if (User == null)
{
    <MudAlert Severity="Severity.Info">@Language.T("security.chonMotTaiKhoanDe2")</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Outlined="true" Style="border-radius:14px">
                <MudText Typo="Typo.h6">@User.FullName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@User.EmployeeCode · @User.DeptCode</MudText>
                <MudDivider Class="my-3" />
                <MudSelect T="string" Label="@Language.T("security.nodeToChuc")" @bind-Value="_nodeType" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Company")">@Language.T("security.company")</MudSelectItem>
                    <MudSelectItem Value="@("Factory")">@Language.T("security.factory")</MudSelectItem>
                    <MudSelectItem Value="@("Department")">@Language.T("common.department2")</MudSelectItem>
                    <MudSelectItem Value="@("SubDepartment")">SubDepartment</MudSelectItem>
                </MudSelect>
                <MudTextField Class="mt-2" Label="NodeCode" @bind-Value="_nodeCode" Variant="Variant.Outlined" />
                <MudTextField Class="mt-2" Label="FactoryCode" @bind-Value="_factoryCode" Variant="Variant.Outlined" />
                <MudNumericField T="int?" Class="mt-2" Label="DeptCode" @bind-Value="_deptCode" HideSpinButtons="true" Variant="Variant.Outlined" />
                <MudNumericField T="int?" Class="mt-2" Label="SubDepartmentCode" @bind-Value="_subDepartmentCode" HideSpinButtons="true" Variant="Variant.Outlined" />
                <MudSwitch Class="mt-2" T="bool" @bind-Value="_includeChildren" Color="Color.Primary">@Language.T("security.baoPhuNodeCon")</MudSwitch>
                <MudTextField Class="mt-2" Label='@Language.T("common.note")' @bind-Value="_remark" Variant="Variant.Outlined" />
                <MudStack Row="true" Class="mt-3" Spacing="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add">@Language.T("common.add")</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="Save" Disabled="_saving || !_dirty">
                        @(_saving ? Language.T("common.dangLuu") : Language.T("security.luuManagedscope"))
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Outlined="true" Style="border-radius:14px">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">@Language.T("security.phamViHienTai")</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" OnClick="LoadAsync">@Language.T("common.refresh")</MudButton>
                </MudStack>
                @if (_scopes.Count == 0)
                {
                    <MudAlert Class="mt-3" Severity="Severity.Info" Variant="Variant.Outlined">
                        @Language.T("security.chuaCoManagedscopeUserChi")
                    </MudAlert>
                }
                @foreach (var scope in _scopes)
                {
                    <MudPaper Class="pa-2 mt-2" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.subtitle2">@scope.NodeType · @(scope.NodeCode ?? scope.DeptCode?.ToString() ?? scope.SubDepartmentCode?.ToString() ?? scope.FactoryCode ?? "-")</MudText>
                                <MudText Typo="Typo.caption">Factory=@(scope.FactoryCode ?? "-") · Dept=@(scope.DeptCode?.ToString() ?? "-") · Sub=@(scope.SubDepartmentCode?.ToString() ?? "-")</MudText>
                            </div>
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small">@(scope.IncludeChildren ? Language.T("security.baoPhuNodeCon") : Language.T("security.chiNode"))</MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => Remove(scope))" />
                        </MudStack>
                    </MudPaper>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public UserAccountDto? User { get; set; }

    private List<ManagedScopeDto> _scopes = new();
    private string _nodeType = "Department";
    private string _nodeCode = string.Empty;
    private string _factoryCode = string.Empty;
    private int? _deptCode;
    private int? _subDepartmentCode;
    private string _remark = string.Empty;
    private bool _includeChildren = true;
    private bool _saving;
    private bool _dirty;
    private int? _loadedUserId;

    protected override async Task OnParametersSetAsync()
    {
        if (User?.IdUser != _loadedUserId)
        {
            _loadedUserId = User?.IdUser;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (User == null) return;
        var result = await SecurityService.GetManagedScopesAsync(User.IdUser);
        if (result.IsSuccess)
        {
            _scopes = result.Data ?? new();
            _dirty = false;
        }
        else
        {
            Snackbar.Add(result.Message ?? Language.T("security.khongTaiDuocManagedscope"), Severity.Error);
        }
    }

    private void Add()
    {
        if (User == null) return;

        var nodeType = (_nodeType ?? string.Empty).Trim();
        var nodeCode = NullIfWhite(_nodeCode);
        var factoryCode = NullIfWhite(_factoryCode);
        var deptCode = _deptCode;
        var subDepartmentCode = _subDepartmentCode;

        var valid = nodeType switch
        {
            "Company" => true,
            "Factory" => !string.IsNullOrWhiteSpace(factoryCode) || !string.IsNullOrWhiteSpace(nodeCode),
            "Department" => deptCode != null || !string.IsNullOrWhiteSpace(nodeCode),
            "SubDepartment" => subDepartmentCode != null || !string.IsNullOrWhiteSpace(nodeCode),
            _ => false
        };

        if (!valid)
        {
            Snackbar.Add(
                nodeType switch
                {
                    "Factory" => Language.T("security.factoryCanFactorycodeHoac"),
                    "Department" => Language.T("security.departmentCanDeptcodeHoac"),
                    "SubDepartment" => Language.T("security.subdepartmentCan"),
                    _ => Language.T("security.nodetypeManagedscopeKhongHopLe")
                },
                Severity.Warning);
            return;
        }

        _scopes.Add(new ManagedScopeDto
        {
            EmployeeCode = User.EmployeeCode ?? string.Empty,
            NodeType = nodeType,
            NodeCode = nodeCode,
            FactoryCode = factoryCode,
            DeptCode = deptCode,
            SubDepartmentCode = subDepartmentCode,
            IncludeChildren = _includeChildren,
            Remark = NullIfWhite(_remark)
        });

        _dirty = true;
        _nodeCode = _factoryCode = _remark = string.Empty;
        _deptCode = _subDepartmentCode = null;
    }

    private void Remove(ManagedScopeDto scope)
    {
        if (_scopes.Remove(scope))
            _dirty = true;
    }

    private async Task Save()
    {
        if (User == null || !_dirty) return;
        _saving = true;
        try
        {
            var result = await SecurityService.SetManagedScopesAsync(
                User.IdUser,
                _scopes.Select(x => new ManagedScopeRequest
                {
                    NodeType = x.NodeType,
                    NodeCode = x.NodeCode,
                    FactoryCode = x.FactoryCode,
                    DeptCode = x.DeptCode,
                    SubDepartmentCode = x.SubDepartmentCode,
                    IncludeChildren = x.IncludeChildren,
                    Remark = x.Remark
                }).ToList());
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("security.khongTheLuuManagedscope"), Severity.Error);
                return;
            }
            await LoadAsync();
            Snackbar.Add(Language.T("security.daLuuManagedscope"), Severity.Success);
        }
        finally { _saving = false; }
    }

    private static string? NullIfWhite(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
