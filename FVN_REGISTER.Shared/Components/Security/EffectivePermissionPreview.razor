@using FVN_REGISTER.Contract.Dtos.Security
@using FVN_REGISTER.Contract.Dtos.Usermanagers
@using FVN_REGISTER.Shared.Services.Security
@inject ISecurityClientService SecurityService

@if (User == null)
{
    <MudAlert Severity="Severity.Info">@Language.T("security.chonMotTaiKhoanDe")</MudAlert>
}
else if (_preview == null)
{
    <MudAlert Severity="Severity.Info">@Language.T("security.dangTaiEffectivePermission")</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="3"><MudText Typo="Typo.caption">@Language.T("security.role")</MudText><MudText>@string.Join(", ", _preview.RoleNames)</MudText></MudItem>
        <MudItem xs="12" md="3"><MudText Typo="Typo.caption">@Language.T("security.menu")</MudText><MudText>@string.Join(", ", _preview.VisibleMenus)</MudText></MudItem>
        <MudItem xs="12" md="3"><MudText Typo="Typo.caption">ManagedScope</MudText><MudText>@_preview.ManagedScopes.Count node</MudText></MudItem>
        <MudItem xs="12" md="3"><MudText Typo="Typo.caption">@Language.T("security.policies")</MudText><MudText>@_preview.ApprovalPolicies.Count match</MudText></MudItem>
    </MudGrid>

    <MudDivider Class="my-3" />
    <MudText Typo="Typo.subtitle2">@Language.T("security.actions2")</MudText>
    @foreach (var group in _preview.Actions.GroupBy(x => x.ModuleCode))
    {
        <MudPaper Class="pa-2 mt-2" Outlined="true">
            <MudText Typo="Typo.caption"><b>@group.Key</b></MudText>
            @foreach (var action in group.OrderBy(x => x.FunctionCode))
            {
                <MudChip T="string" Size="Size.Small" Class="ma-1">@action.ActionCode · @action.AccessMode · @action.ScopeCode</MudChip>
            }
        </MudPaper>
    }

    <MudText Typo="Typo.subtitle2" Class="mt-3">@Language.T("security.policies")</MudText>
    @if (_preview.ApprovalPolicies.Count == 0)
    {
        <MudAlert Class="mt-2" Severity="Severity.Warning" Variant="Variant.Outlined">
            @Language.T("security.khongCoPolicyMatchTheo")
        </MudAlert>
    }
    else
    {
        <MudTable Items="_preview.ApprovalPolicies" Dense="true" Hover="true" Bordered="true" Class="mt-2">
            <HeaderContent>
                <MudTh>@Language.T("common.module")</MudTh><MudTh>@Language.T("security.dept")</MudTh><MudTh>@Language.T("security.requesterPosition")</MudTh>
                <MudTh>@Language.T("security.approvalPosition")</MudTh><MudTh>@Language.T("common.level")</MudTh><MudTh>@Language.T("security.sequence")</MudTh><MudTh>@Language.T("common.required2")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.RequestTypeName</MudTd>
                <MudTd>@context.DeptCode</MudTd>
                <MudTd>@(context.PositionCode ?? "*")</MudTd>
                <MudTd>@context.ApprovalPositionCode</MudTd>
                <MudTd>@context.Level</MudTd>
                <MudTd>@context.Sequence</MudTd>
                <MudTd>@(context.Required ? "Yes" : "No")</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudText Typo="Typo.subtitle2" Class="mt-3">@Language.T("security.businessState")</MudText>
    @foreach (var item in _preview.BusinessStateConstraints)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-1">@item</MudAlert>
    }
}

@code {
    [Parameter] public UserAccountDto? User { get; set; }

    private EffectivePermissionPreviewDto? _preview;
    private int? _loadedUserId;

    protected override async Task OnParametersSetAsync()
    {
        if (User?.IdUser != _loadedUserId)
        {
            _loadedUserId = User?.IdUser;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (User == null) return;
        var result = await SecurityService.GetEffectivePermissionPreviewAsync(User.IdUser);
        if (result.IsSuccess) _preview = result.Data;
    }
}
