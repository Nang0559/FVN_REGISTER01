@using FVN_REGISTER.Shared.Services.Language
@using FVN_REGISTER.Shared.Services.Loading
@implements IDisposable
@inject ILoadingService Loading
@inject ILanguageService Language

@if (Loading.IsLoading)
{
    <div class="fcc-global-loading"
         role="status"
         aria-live="polite"
         aria-busy="true">
        <div class="fcc-global-loading-card">
            <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
            <MudText Typo="Typo.body1">
                @(Loading.Message ?? Language.T("common.loading"))
            </MudText>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
        => Loading.StateChanged += OnLoadingStateChanged;

    private void OnLoadingStateChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
        => Loading.StateChanged -= OnLoadingStateChanged;
}
