@using FVN_REGISTER.Contract.Dtos.LeaveTypes
@using FVN_REGISTER.Shared.Services.Leaves
@inject ILeaveTypeClientService LeaveTypeService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsNew ? Icons.Material.Filled.AddCircle : Icons.Material.Filled.Edit)" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@(IsNew ? Language.T("leave.themHinhThucNghi") : Language.T("leave.chinhSuaHinhThucNghi"))</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="@Language.T("leave.maHinhThucNghi")"
                          @bind-Value="Model.LeaveTypeCode"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                          Disabled="@(!IsNew)" Required="true" RequiredError="@Language.T("leave.vuiLongNhapMa")"
                          MaxLength="50" />

            <MudTextField T="string" Label="@Language.T("leave.tenHinhThucNghi")"
                          @bind-Value="Model.LeaveTypeName"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                          Required="true" RequiredError="@Language.T("leave.vuiLongNhapTen")" MaxLength="200" />

            <MudTextField T="string" Label="@Language.T("leave.tenPhu")"
                          @bind-Value="Model.LeaveTypeName2"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                          MaxLength="200" />

            <MudTextField T="string" Label="@Language.T("leave.maHrmTuongUng")"
                          @bind-Value="Model.HRMCode"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                          MaxLength="50" HelperText="@Language.T("leave.deTrongNeuKhongDong")" />

            <MudDivider Class="mb-3" />

            <MudStack Row="true" Spacing="4" Class="mb-2">
                <MudTooltip Text="@Language.T("leave.loaiNghiNayCoBi")">
                    <MudSwitch T="bool" @bind-Value="Model.IsCountedAsLeave"
                               Color="Color.Primary"
                               Label="@(Model.IsCountedAsLeave ? Language.T("leave.tinhVaoPhepNam") : Language.T("leave.khongTinhPhep"))" />
                </MudTooltip>

                <MudTooltip Text="@Language.T("leave.hinhThucNghiDangDuoc")">
                    <MudSwitch T="bool" @bind-Value="Model.IsActive"
                               Color="Color.Success"
                               Label="@(Model.IsActive ? Language.T("leave.dangKichHoat") : Language.T("leave.tamDung"))" />
                </MudTooltip>
            </MudStack>

            <MudPaper Elevation="0" Class="pa-3 mt-2" Style="border:1px dashed #bdbdbd; border-radius:10px; background:#fafafa">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@Language.T("leave.xemTruoc")</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudChip T="string" Color="@(Model.IsCountedAsLeave ? Color.Warning : Color.Default)" Size="Size.Small">
                        @(Model.IsCountedAsLeave ? Language.T("common.tinhPhep") : Language.T("leave.khongTinh"))
                    </MudChip>
                    <MudChip T="string" Color="@(Model.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                        @(Model.IsActive ? Language.T("leave.dangDung") : Language.T("leave.tamDung"))
                    </MudChip>
                    @if (!string.IsNullOrWhiteSpace(Model.LeaveTypeCode))
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">@Model.LeaveTypeCode</MudChip>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.LeaveTypeName))
                    {
                        <MudText Typo="Typo.body2" Style="font-weight:600">@Model.LeaveTypeName</MudText>
                    }
                </MudStack>
            </MudPaper>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_isSaving">@Language.T("common.cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit" Disabled="@_isSaving">
            @(_isSaving ? Language.T("common.dangLuu") : (IsNew ? Language.T("leave.themMoi") : Language.T("user.luuThayDoi")))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LeaveTypeUpsertDto Model { get; set; } = new();

    private MudForm? _form;
    private bool _isSaving;
    private bool IsNew => Model.Id == 0;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (_form != null) { await _form.ValidateAsync(); if (!_form.IsValid) return; }

        _isSaving = true;
        try
        {
            var result = IsNew
                ? await LeaveTypeService.CreateAsync(Model)
                : await LeaveTypeService.UpdateAsync(Model.Id, Model);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Message ?? Language.T("leave.loiHeThong"), Severity.Error);
                return;
            }

            Snackbar.Add(result.Message ?? (IsNew ? Language.T("leave.themThanhCong") : Language.T("leave.capNhatThanhCong")), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _isSaving = false;
        }
    }
}
