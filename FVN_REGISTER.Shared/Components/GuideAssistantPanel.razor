@using FVN_REGISTER.Contract.Dtos.Help
@using FVN_REGISTER.Shared.Services.Help
@implements IDisposable
@inject IHttpClientWithAuth Http
@inject NavigationManager Navigation

<MudPaper Outlined="@(!Compact)" Elevation="0" Class="@RootClass" Style="@RootStyle">
    @if (!Compact)
    {
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Hỏi đáp hướng dẫn sử dụng</MudText>
        </MudStack>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            @if (_turns.Count > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy" OnClick="Clear">Xóa hội thoại</MudButton>
            }
            <MudIconButton Icon="@(_open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" OnClick="Toggle" />
        </MudStack>
    </MudStack>
    }
    <MudCollapse Expanded="@(_open || Compact)">
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
        Trợ lý trả lời từ hướng dẫn sử dụng và các tài liệu đã được phê duyệt mà tài khoản của bạn được xem. Hãy đối chiếu với mục nguồn bên dưới câu trả lời.
    </MudText>

    @foreach (var turn in _turns)
    {
        if (turn.Role == "user")
        {
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
                <MudPaper Elevation="0" Class="pa-2 px-3" Style="background:var(--mud-palette-primary-hover); max-width:85%">
                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@turn.Text</MudText>
                </MudPaper>
            </MudStack>
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-3 mb-3" Elevation="0">
                @if (turn.Status == "Error")
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">@turn.Text</MudAlert>
                }
                else
                {
                    <div class="guide-md">@turn.Html</div>
                    if (turn.Status == "PartiallySupported")
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Câu trả lời chưa được gắn nguồn chính xác; hãy kiểm tra lại ở các mục bên dưới.</MudText>
                    }
                    if (turn.Sources.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Nguồn:</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var source in turn.Sources)
                            {
                                if (source.Kind == "Document")
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                             Icon="@Icons.Material.Filled.Description">Tài liệu: @source.Title</MudChip>
                                }
                                else if (!string.IsNullOrWhiteSpace(source.Feature) && !string.Equals(source.Feature, Feature, StringComparison.OrdinalIgnoreCase))
                                {
                                    var target = source.Feature;
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                             Icon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => Open(target!))">@source.Title</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@source.Title</MudChip>
                                }
                            }
                        </MudStack>
                    }
                }
            </MudPaper>
        }
    }

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            @(_elapsedSeconds < 3
                ? "Đang tìm trong tài liệu hướng dẫn…"
                : $"Đang soạn câu trả lời… {_elapsedSeconds} giây (mô hình AI chạy trên máy chủ nội bộ nên có thể mất vài chục giây)")
        </MudText>
    }

    @if (_turns.Count == 0 && !_busy)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @foreach (var suggestion in Suggestions)
            {
                var text = suggestion;
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => AskAsync(text))">@text</MudChip>
            }
        </MudStack>
    }

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudTextField T="string" @bind-Value="_question" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="Nhập câu hỏi, ví dụ: Cách đăng ký OT cho nhiều người?" MaxLength="1000"
                      Disabled="_busy" OnKeyDown="OnKeyDown" Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_question))"
                   StartIcon="@Icons.Material.Filled.Send" OnClick="@(() => AskAsync(_question))">Hỏi</MudButton>
    </MudStack>
        @if (Compact && _turns.Count > 0)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy" OnClick="Clear" Class="mt-1">Xóa hội thoại</MudButton>
        }
    </MudCollapse>
</MudPaper>

@code {
    /// <summary>Feature code of the screen being read (ranks passages of that screen first). Never grants access.</summary>
    [Parameter] public string? Feature { get; set; }

    /// <summary>Floating-window mode (see GuideChatLauncher): no frame, no own header and never collapsed.</summary>
    [Parameter] public bool Compact { get; set; }

    private string RootClass => Compact ? "pa-3" : "pa-4 mb-5";
    private string RootStyle => Compact ? string.Empty : "border-color:var(--mud-palette-primary)";

    private sealed class Turn
    {
        public string Role { get; init; } = "user";
        public string Text { get; init; } = string.Empty;
        public MarkupString Html { get; init; }
        public string Status { get; init; } = "Completed";
        public List<GuideSourceDto> Sources { get; init; } = new();
    }

    private static readonly string[] Suggestions =
    {
        "Cách đăng ký nghỉ phép?",
        "Đăng ký OT như thế nào?",
        "Dấu ? màu cam trên lịch nghĩa là gì?",
        "Escalated có phải là bị từ chối không?"
    };

    private readonly List<Turn> _turns = new();
    private readonly CancellationTokenSource _disposed = new();
    private string? _question;
    private bool _busy;
    private bool _open = true;
    private int _elapsedSeconds;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy && !string.IsNullOrWhiteSpace(_question))
            await AskAsync(_question);
    }

    private void Clear() => _turns.Clear();

    private void Toggle() => _open = !_open;

    private void Open(string feature) =>
        // forceLoad: /huong-dan reads ?feature= only when the page is created, so a client-side navigation would keep the old topic.
        Navigation.NavigateTo($"/huong-dan?feature={Uri.EscapeDataString(feature)}", forceLoad: true);

    private async Task AskAsync(string? question)
    {
        var text = question?.Trim();
        if (_busy || string.IsNullOrWhiteSpace(text)) return;

        var request = new GuideAskRequestDto
        {
            Query = text,
            Feature = Feature,
            History = _turns.Where(t => t.Status != "Error")
                .TakeLast(6)
                .Select(t => new GuideChatTurnDto { Role = t.Role, Content = t.Text })
                .ToList()
        };

        _turns.Add(new Turn { Role = "user", Text = text });
        _question = string.Empty;
        _busy = true;
        _elapsedSeconds = 0;
        using var ticker = CancellationTokenSource.CreateLinkedTokenSource(_disposed.Token);
        _ = TickAsync(ticker.Token);
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync<GuideAnswerDto>("api/ai/guide/ask", request, _disposed.Token, showLoading: false);
            if (!response.IsSuccess || response.Data is null)
            {
                _turns.Add(new Turn { Role = "assistant", Status = "Error", Text = string.IsNullOrWhiteSpace(response.Message) ? "Không lấy được câu trả lời. Vui lòng thử lại." : response.Message });
                return;
            }

            var data = response.Data;
            _turns.Add(new Turn
            {
                Role = "assistant",
                Text = data.Answer,
                Html = new MarkupString(GuideMarkdown.ToHtml(data.Answer)),
                Status = data.Status,
                Sources = data.Sources
            });
        }
        catch (OperationCanceledException)
        {
            // The page was closed while waiting.
        }
        catch (Exception)
        {
            _turns.Add(new Turn { Role = "assistant", Status = "Error", Text = "Không kết nối được trợ lý AI. Vui lòng thử lại sau." });
        }
        finally
        {
            ticker.Cancel();
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TickAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                _elapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
