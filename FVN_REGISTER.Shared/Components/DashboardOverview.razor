@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Dtos.Actions
@using FVN_REGISTER.Contract.Dtos.Dashboard
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Core.Enums
@implements IDisposable

@if (Data == null)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-10">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2">@Language.T("dashboard.loading")</MudText>
    </MudStack>
}
else
{
    @if (Data.Widgets.Any())
    {
        <MudGrid Class="mb-4">
            @foreach (var widget in Data.Widgets)
            {
                <MudItem xs="6" sm="3">
                    <MudPaper Class="@($"pa-4 mud-theme-{widget.Color.ToLowerInvariant()}")" Elevation="4" Style="height:110px; border-radius:12px; cursor:pointer" @onclick="@(() => OnWidgetClick(widget.Link))">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2" Style="opacity:0.8">@GetWidgetTitle(widget.Title)</MudText>
                                <MudText Typo="Typo.h4"><b>@widget.Value</b></MudText>
                            </MudStack>
                            <MudIcon Icon="@widget.Icon" Size="Size.Large" Style="opacity:0.5" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    @if (Data.PendingApprovals.Any())
    {
        var pending = Data.PendingApprovals.SelectMany(x => x.Requests).OrderBy(x => x.FromDate).Take(8).ToList();
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">@Language.T("dashboard.pendingMine")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.pendingCount", pending.Count)</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/approvals"))">@Language.T("dashboard.viewAll")</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudList T="PendingApprovalItemDto" Dense="true">
                    @foreach (var item in pending)
                    {
                        <MudListItem T="PendingApprovalItemDto" OnClick="@(() => Navigation.NavigateTo("/approvals"))">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2"><b>@item.EmployeeName</b> — @GetKindDisplay(item.Kind)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.EmployeeCode — @item.DeptName</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small">@Language.T("dashboard.level", GetCurrentApprovalLevel(item))</MudChip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudCardContent>
        </MudCard>
    }

    <MudGrid>
        @if (Data.Leave?.PersonalBalance != null)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">@Language.T("dashboard.leave")</MudText></CardHeaderContent>
                        <CardHeaderActions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/history/leave"))">@Language.T("dashboard.history")</MudButton></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4"><MudText Typo="Typo.caption">@Language.T("dashboard.entitled")</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.TotalEntitled.ToString("N1") @Language.T("dashboard.days")</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption">@Language.T("dashboard.used")</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.Used.ToString("N1") @Language.T("dashboard.days")</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption">@Language.T("dashboard.remaining")</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.Remaining.ToString("N1") @Language.T("dashboard.days")</MudText></MudItem>
                        </MudGrid>
                        @if (Data.Leave.PersonalBalance.NextLeaveDate.HasValue)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                                @Language.T("dashboard.nextLeave"): <b>@Data.Leave.PersonalBalance.NextLeaveDate.Value.ToString("dd/MM/yyyy")</b>
                                @if (!string.IsNullOrWhiteSpace(Data.Leave.PersonalBalance.NextLeaveTypeName))
                                {
                                    <span> — @Data.Leave.PersonalBalance.NextLeaveTypeName</span>
                                }
                                <span> • @Language.T("dashboard.upcomingDays", Data.Leave.PersonalBalance.UpcomingDays.ToString("N1"))</span>
                            </MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">@Language.T("dashboard.noUpcomingLeave")</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        @if (Data.OT?.PersonalBalance != null)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">@Language.T("dashboard.ot")</MudText></CardHeaderContent>
                        <CardHeaderActions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/history/ot"))">@Language.T("dashboard.history")</MudButton></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">@Language.T("dashboard.otWeek")</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisWeek.ToString("N1") / @(Data.OT.PersonalBalance.WeeklyLimit?.ToString("N1") ?? "—") h</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">@Language.T("dashboard.otMonth")</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisMonth.ToString("N1") / @Data.OT.PersonalBalance.MonthlyLimit.ToString("N1") h</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">@Language.T("dashboard.otYear")</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisYear.ToString("N1") / @Data.OT.PersonalBalance.YearlyLimit.ToString("N1") h</MudText></MudItem>
                        </MudGrid>
                        @if (Data.OT.PersonalBalance.IsNearWeeklyLimit || Data.OT.PersonalBalance.IsNearMonthlyLimit || Data.OT.PersonalBalance.IsNearYearlyLimit)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                                @Language.T("dashboard.otLimitWarning", Data.OT.PersonalBalance.RemainingWeekly?.ToString("N1") ?? "—", Data.OT.PersonalBalance.RemainingMonthly.ToString("N1"), Data.OT.PersonalBalance.RemainingYearly.ToString("N1"))
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (Data.ShowManagerView && Data.DeptWarning != null)
    {
        var warning = Data.DeptWarning;
        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">@Language.T("dashboard.deptSituation", warning.DeptName)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.managerOnly")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.staff")</MudText><MudText Typo="Typo.h6">@warning.TotalStaff</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.absent")</MudText><MudText Typo="Typo.h6">@warning.CurrentAbsent</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.pending")</MudText><MudText Typo="Typo.h6">@warning.PendingRequests</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.absenceRate")</MudText><MudText Typo="Typo.h6">@warning.AbsenceRate.ToString("N1")%</MudText></MudItem>
                </MudGrid>
                @if (!string.IsNullOrWhiteSpace(warning.WarningMessage))
                {
                    <MudAlert Class="mt-3" Severity="@(warning.IsCritical ? Severity.Warning : Severity.Info)">@warning.WarningMessage</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    }

    @if (Data.ShowManagerView && Data.DepartmentStatistics.Any())
    {
        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.subtitle1">@Language.T("dashboard.leaveStatistics")</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable Items="Data.DepartmentStatistics" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>@Language.T("dashboard.department")</MudTh><MudTh>@Language.T("dashboard.staff")</MudTh><MudTh>@Language.T("dashboard.present")</MudTh><MudTh>@Language.T("dashboard.leaveRequests")</MudTh><MudTh>@Language.T("dashboard.pending")</MudTh><MudTh>@Language.T("dashboard.leaveRate")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.DepartmentName</MudTd>
                        <MudTd>@context.TotalEmployees</MudTd>
                        <MudTd>@context.PresentEmployeesCount</MudTd>
                        <MudTd>@context.TotalLeaveCount</MudTd>
                        <MudTd>@context.PendingLeaveCount</MudTd>
                        <MudTd>@context.LeaveRate.ToString("N1")%</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
}

@code {
    [Parameter] public DashboardResponse? Data { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    private string GetKindDisplay(RequestModule kind) => kind switch { RequestModule.Overtime => Language.T("dashboard.overtimeType"), RequestModule.Trip => Language.T("dashboard.tripType"), RequestModule.Leave => Language.T("dashboard.leaveType"), _ => kind.ToString() };
    private int GetCurrentApprovalLevel(PendingApprovalItemDto item) => item.ApprovalSteps.OrderBy(x => x.Level).FirstOrDefault(x => x.IsRequired && x.IsApproved == null)?.Level ?? 0;
    private string GetWidgetTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title)) return string.Empty;
        return title.Trim() switch
        {
            "Đơn chờ duyệt" => Language.T("dashboard.pending"),
            "Nghỉ phép" => Language.T("dashboard.leaveType"),
            "OT" => Language.T("dashboard.overtimeType"),
            "Công tác" => Language.T("dashboard.tripType"),
            _ => title
        };
    }

    private void OpenActionWork()
    {
        var action = Data?.Actions.FirstOrDefault();
        if (action is not null && !string.IsNullOrWhiteSpace(action.DetailRoute))
        {
            Navigation.NavigateTo(action.DetailRoute);
            return;
        }

        Navigation.NavigateTo("/work/inbox");
    }

    private void OpenAction(ActionItemDto action)
    {
        if (!string.IsNullOrWhiteSpace(action.DetailRoute))
            Navigation.NavigateTo(action.DetailRoute);
        else
            Navigation.NavigateTo("/work/inbox");
    }

    private void OnWidgetClick(string? link)
    {
        if (!string.IsNullOrWhiteSpace(link))
            Navigation.NavigateTo(link);
    }

    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
}
