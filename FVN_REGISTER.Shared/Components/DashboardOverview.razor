@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Dtos.Dashboard
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Core.Enums

@if (Data == null)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-10">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2">Đang nạp thông số hệ thống FCC...</MudText>
    </MudStack>
}
else
{
    @if (Data.Widgets.Any())
    {
        <MudGrid Class="mb-4">
            @foreach (var widget in Data.Widgets)
            {
                <MudItem xs="6" sm="3">
                    <MudPaper Class="@($"pa-4 mud-theme-{widget.Color.ToLowerInvariant()}")" Elevation="4" Style="height:110px; border-radius:12px; cursor:pointer" @onclick="@(() => OnWidgetClick(widget.Link))">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2" Style="opacity:0.8">@widget.Title</MudText>
                                <MudText Typo="Typo.h4"><b>@widget.Value</b></MudText>
                            </MudStack>
                            <MudIcon Icon="@widget.Icon" Size="Size.Large" Style="opacity:0.5" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    @if (Data.PendingApprovals.Any())
    {
        var pending = Data.PendingApprovals.SelectMany(x => x.Requests).OrderBy(x => x.FromDate).Take(8).ToList();
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">Đơn đang chờ tôi xử lý</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@pending.Count đơn gần nhất</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/approvals"))">Xem tất cả</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudList T="PendingApprovalItemDto" Dense="true">
                    @foreach (var item in pending)
                    {
                        <MudListItem T="PendingApprovalItemDto" OnClick="@(() => Navigation.NavigateTo("/approvals"))">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2"><b>@item.EmployeeName</b> — @GetKindDisplay(item.Kind)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.EmployeeCode — @item.DeptName</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small">Cấp @GetCurrentApprovalLevel(item)</MudChip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudCardContent>
        </MudCard>
    }

    <MudGrid>
        @if (Data.Leave?.PersonalBalance != null)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">Phép của tôi</MudText></CardHeaderContent>
                        <CardHeaderActions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/history/leave"))">Lịch sử</MudButton></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4"><MudText Typo="Typo.caption">Được hưởng</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.TotalEntitled.ToString("N1") ngày</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption">Đã nghỉ</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.Used.ToString("N1") ngày</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption">Còn lại</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.Remaining.ToString("N1") ngày</MudText></MudItem>
                        </MudGrid>
                        @if (Data.Leave.PersonalBalance.NextLeaveDate.HasValue)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                                Sắp nghỉ: <b>@Data.Leave.PersonalBalance.NextLeaveDate.Value.ToString("dd/MM/yyyy")</b>
                                @if (!string.IsNullOrWhiteSpace(Data.Leave.PersonalBalance.NextLeaveTypeName))
                                {
                                    <span> — @Data.Leave.PersonalBalance.NextLeaveTypeName</span>
                                }
                                <span> • Tổng các đợt nghỉ sắp tới: @Data.Leave.PersonalBalance.UpcomingDays.ToString("N1") ngày</span>
                            </MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">Chưa có ngày nghỉ đã duyệt sắp tới.</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        @if (Data.OT?.PersonalBalance != null)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">OT của tôi</MudText></CardHeaderContent>
                        <CardHeaderActions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/history/ot"))">Lịch sử</MudButton></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">OT tuần</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisWeek.ToString("N1") / @(Data.OT.PersonalBalance.WeeklyLimit?.ToString("N1") ?? "—") h</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">OT tháng</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisMonth.ToString("N1") / @Data.OT.PersonalBalance.MonthlyLimit.ToString("N1") h</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">OT năm</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisYear.ToString("N1") / @Data.OT.PersonalBalance.YearlyLimit.ToString("N1") h</MudText></MudItem>
                        </MudGrid>
                        @if (Data.OT.PersonalBalance.IsNearWeeklyLimit || Data.OT.PersonalBalance.IsNearMonthlyLimit || Data.OT.PersonalBalance.IsNearYearlyLimit)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                                Có giới hạn OT đang gần chạm. Tuần: @(Data.OT.PersonalBalance.RemainingWeekly?.ToString("N1") ?? "—")h,
                                tháng: @Data.OT.PersonalBalance.RemainingMonthly.ToString("N1")h,
                                năm: @Data.OT.PersonalBalance.RemainingYearly.ToString("N1")h.
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (Data.ShowManagerView && Data.DeptWarning != null)
    {
        var warning = Data.DeptWarning;
        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">Tình hình phòng ban — @warning.DeptName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Chỉ hiển thị khi tài khoản có quyền quản lý.</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">Nhân sự</MudText><MudText Typo="Typo.h6">@warning.TotalStaff</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">Đang vắng</MudText><MudText Typo="Typo.h6">@warning.CurrentAbsent</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">Chờ duyệt</MudText><MudText Typo="Typo.h6">@warning.PendingRequests</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">Tỷ lệ vắng</MudText><MudText Typo="Typo.h6">@warning.AbsenceRate.ToString("N1")%</MudText></MudItem>
                </MudGrid>
                @if (!string.IsNullOrWhiteSpace(warning.WarningMessage))
                {
                    <MudAlert Class="mt-3" Severity="@(warning.IsCritical ? Severity.Warning : Severity.Info)">@warning.WarningMessage</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    }

    @if (Data.ShowManagerView && Data.DepartmentStatistics.Any())
    {
        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.subtitle1">Thống kê nghỉ phép phòng ban</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudTable Items="Data.DepartmentStatistics" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Phòng ban</MudTh><MudTh>Nhân sự</MudTh><MudTh>Đang có mặt</MudTh><MudTh>Đơn nghỉ</MudTh><MudTh>Chờ duyệt</MudTh><MudTh>Tỷ lệ nghỉ</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.DepartmentName</MudTd>
                        <MudTd>@context.TotalEmployees</MudTd>
                        <MudTd>@context.PresentEmployeesCount</MudTd>
                        <MudTd>@context.TotalLeaveCount</MudTd>
                        <MudTd>@context.PendingLeaveCount</MudTd>
                        <MudTd>@context.LeaveRate.ToString("N1")%</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
}

@code {
    [Parameter] public DashboardResponse? Data { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private static int GetCurrentApprovalLevel(PendingApprovalItemDto item) => item.ApprovalSteps.OrderBy(x => x.Level).FirstOrDefault(x => x.IsRequired && x.IsApproved == null)?.Level ?? 0;
    private static string GetKindDisplay(RequestModule kind) => kind switch { RequestModule.Overtime => "OT", RequestModule.Trip => "Công tác", RequestModule.Leave => "Nghỉ phép", _ => kind.ToString() };

    private void OnWidgetClick(string? link)
    {
        if (!string.IsNullOrWhiteSpace(link))
            Navigation.NavigateTo(link);
    }
}