@using FVN_REGISTER.Contract.Dtos.Approvals
@using FVN_REGISTER.Contract.Dtos.Actions
@using FVN_REGISTER.Contract.Dtos.Dashboard
@using FVN_REGISTER.Contract.Responses
@using FVN_REGISTER.Core.Enums
@using FVN_REGISTER.Shared.Services.Dashboards
@implements IDisposable

@if (Data == null)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-10">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2">@Language.T("dashboard.loading")</MudText>
    </MudStack>
}
else
{
    @if (Data.Widgets.Any())
    {
        <MudGrid Class="mb-4">
            @foreach (var widget in Data.Widgets)
            {
                <MudItem xs="6" sm="3">
                    <MudPaper Class="@($"pa-4 mud-theme-{widget.Color.ToLowerInvariant()}")" Elevation="4" Style="height:110px; border-radius:12px; cursor:pointer" @onclick="@(() => OnWidgetClick(widget.Link))">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2" Style="opacity:0.8">@GetWidgetTitle(widget.Title)</MudText>
                                <MudText Typo="Typo.h4"><b>@widget.Value</b></MudText>
                            </MudStack>
                            <MudIcon Icon="@widget.Icon" Size="Size.Large" Style="opacity:0.5" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }


    @if (AttendanceShiftRows.Count > 0)
    {
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">@Language.T("dashboard.attendanceByShift")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.attendanceByShiftNote", AttendanceShiftDate.ToString("dd/MM/yyyy"))</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @foreach (var shift in AttendanceShiftRows)
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2"><b>@shift.DepartmentName — @shift.ShiftAbbr</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.calculatedEmployees"): @shift.CalculatedEmployees</MudText>
                            </MudStack>
                            <MudStack Row="true" Spacing="2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@Language.T("dashboard.checkedIn"): @shift.CheckedInEmployees</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@Language.T("dashboard.checkedOut"): @shift.CheckedOutEmployees</MudChip>
                                @if (shift.MissingCheckInOrOut > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@Language.T("dashboard.missingPunch"): @shift.MissingCheckInOrOut</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                        <MudTable Items="shift.Employees" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>@Language.T("dashboard.staff")</MudTh>
                                <MudTh>@Language.T("dashboard.checkIn")</MudTh>
                                <MudTh>@Language.T("dashboard.checkOut")</MudTh>
                                <MudTh>@Language.T("dashboard.attendanceSymbol")</MudTh>
                                <MudTh>@Language.T("dashboard.attendanceStatus")</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Language.T("dashboard.staff")">@context.EmployeeCode — @context.EmployeeName</MudTd>
                                <MudTd DataLabel="@Language.T("dashboard.checkIn")">@(context.CheckInTime?.ToString("HH:mm") ?? "—")</MudTd>
                                <MudTd DataLabel="@Language.T("dashboard.checkOut")">@(context.CheckOutTime?.ToString("HH:mm") ?? "—")</MudTd>
                                <MudTd DataLabel="@Language.T("dashboard.attendanceSymbol")">@context.AttendanceDisplayValue</MudTd>
                                <MudTd DataLabel="@Language.T("dashboard.attendanceStatus")">@GetAttendanceStatus(context.Status)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
            </MudCardContent>
        </MudCard>
    }

    @if (Data.PendingApprovals.Any())
    {
        var pending = Data.PendingApprovals.SelectMany(x => x.Requests).OrderBy(x => x.FromDate).Take(8).ToList();
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">@Language.T("dashboard.pendingMine")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.pendingCount", pending.Count)</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/approvals"))">@Language.T("dashboard.viewAll")</MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <MudList T="PendingApprovalItemDto" Dense="true">
                    @foreach (var item in pending)
                    {
                        <MudListItem T="PendingApprovalItemDto" OnClick="@(() => Navigation.NavigateTo("/approvals"))">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2"><b>@item.EmployeeName</b> — @GetKindDisplay(item.Kind)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.EmployeeCode — @item.DeptName</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small">@Language.T("dashboard.level", GetCurrentApprovalLevel(item))</MudChip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudCardContent>
        </MudCard>
    }

    <MudGrid>
        @if (Data.Leave?.PersonalBalance != null)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">@Language.T("dashboard.leave")</MudText></CardHeaderContent>
                        <CardHeaderActions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/history/leave"))">@Language.T("dashboard.history")</MudButton></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="4"><MudText Typo="Typo.caption">@Language.T("dashboard.entitled")</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.TotalEntitled.ToString("N1") @Language.T("dashboard.days")</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption">@Language.T("dashboard.used")</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.Used.ToString("N1") @Language.T("dashboard.days")</MudText></MudItem>
                            <MudItem xs="4"><MudText Typo="Typo.caption">@Language.T("dashboard.remaining")</MudText><MudText Typo="Typo.h6">@Data.Leave.PersonalBalance.Remaining.ToString("N1") @Language.T("dashboard.days")</MudText></MudItem>
                        </MudGrid>
                        @if (Data.Leave.PersonalBalance.NextLeaveDate.HasValue)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                                @Language.T("dashboard.nextLeave"): <b>@Data.Leave.PersonalBalance.NextLeaveDate.Value.ToString("dd/MM/yyyy")</b>
                                @if (!string.IsNullOrWhiteSpace(Data.Leave.PersonalBalance.NextLeaveTypeName))
                                {
                                    <span> — @Data.Leave.PersonalBalance.NextLeaveTypeName</span>
                                }
                                <span> • @Language.T("dashboard.upcomingDays", Data.Leave.PersonalBalance.UpcomingDays.ToString("N1"))</span>
                            </MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">@Language.T("dashboard.noUpcomingLeave")</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        @if (Data.OT?.PersonalBalance != null)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent><MudText Typo="Typo.subtitle1">@Language.T("dashboard.ot")</MudText></CardHeaderContent>
                        <CardHeaderActions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/history/ot"))">@Language.T("dashboard.history")</MudButton></CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">@Language.T("dashboard.otWeek")</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisWeek.ToString("N1") / @(Data.OT.PersonalBalance.WeeklyLimit?.ToString("N1") ?? "—") h</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">@Language.T("dashboard.otMonth")</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisMonth.ToString("N1") / @Data.OT.PersonalBalance.MonthlyLimit.ToString("N1") h</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">@Language.T("dashboard.otYear")</MudText><MudText Typo="Typo.h6">@Data.OT.PersonalBalance.UsedHoursThisYear.ToString("N1") / @Data.OT.PersonalBalance.YearlyLimit.ToString("N1") h</MudText></MudItem>
                        </MudGrid>
                        @if (Data.OT.PersonalBalance.IsNearWeeklyLimit || Data.OT.PersonalBalance.IsNearMonthlyLimit || Data.OT.PersonalBalance.IsNearYearlyLimit)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                                @Language.T("dashboard.otLimitWarning", Data.OT.PersonalBalance.RemainingWeekly?.ToString("N1") ?? "—", Data.OT.PersonalBalance.RemainingMonthly.ToString("N1"), Data.OT.PersonalBalance.RemainingYearly.ToString("N1"))
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @if (Data.ShowManagerView && Data.DeptWarning != null)
    {
        var warning = Data.DeptWarning;
        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">@Language.T("dashboard.deptSituation", warning.DeptName)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.managerOnly")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.staff")</MudText><MudText Typo="Typo.h6">@warning.TotalStaff</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.absent")</MudText><MudText Typo="Typo.h6">@warning.CurrentAbsent</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.pending")</MudText><MudText Typo="Typo.h6">@warning.PendingRequests</MudText></MudItem>
                    <MudItem xs="6" sm="3"><MudText Typo="Typo.caption">@Language.T("dashboard.absenceRate")</MudText><MudText Typo="Typo.h6">@warning.AbsenceRate.ToString("N1")%</MudText></MudItem>
                </MudGrid>
                @if (!string.IsNullOrWhiteSpace(warning.WarningMessage))
                {
                    <MudAlert Class="mt-3" Severity="@(warning.IsCritical ? Severity.Warning : Severity.Info)">@warning.WarningMessage</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    }

    @if (Data.DepartmentStatistics.Any())
    {
        var departments = Data.DepartmentStatistics;
        var totalStaff = departments.Sum(x => x.TotalEmployees);
        var presentStaff = departments.Sum(x => x.PresentEmployeesCount);
        var attendanceRate = totalStaff > 0
            ? Math.Clamp(presentStaff * 100d / totalStaff, 0d, 100d)
            : 0d;
        var leaveToday = departments.Sum(x => x.TodayLeaveEmployeesCount);
        var tripToday = departments.Sum(x => x.TodayTripEmployeesCount);
        var otToday = departments.Sum(x => x.TodayOTEmployeesCount);

        <MudPaper Outlined="true" Class="pa-4 mt-4 mb-4" Style="border-radius:14px">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Style="font-weight:700">@Language.T("dashboard.departmentOverview")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.todayDepartmentOverview")</MudText>
                </MudStack>
                <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Medium" Color="Color.Secondary" />
            </MudStack>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-3" Style="height:100%;min-height:126px;border-radius:12px;background:var(--mud-palette-background-grey)">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("dashboard.attendanceRate")</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <div style="@($"width:68px;height:68px;flex:0 0 68px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--mud-palette-success) {attendanceRate.ToString(System.Globalization.CultureInfo.InvariantCulture)}%, var(--mud-palette-divider) 0)")">
                                <div style="width:52px;height:52px;border-radius:50%;background:var(--mud-palette-surface);display:flex;flex-direction:column;align-items:center;justify-content:center">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;line-height:1.1">@attendanceRate.ToString("N0")%</MudText>
                                    <MudText Typo="Typo.overline" Style="font-size:8px;line-height:1.2">@Language.T("dashboard.presentShort")</MudText>
                                </div>
                            </div>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.h6" Style="font-weight:700">@presentStaff/@totalStaff</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Language.T("dashboard.presentEmployees")</MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-3" Style="height:100%;min-height:126px;border-radius:12px;background:var(--mud-palette-background-grey)">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("dashboard.todayLeave")</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Style="color:#ed6c02" />
                            <MudText Typo="Typo.h5" Style="font-weight:700">@leaveToday <MudText Inline="true" Typo="Typo.body2">@Language.T("dashboard.people")</MudText></MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@Language.T("dashboard.approvedLeaveTodayNote")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-3" Style="height:100%;min-height:126px;border-radius:12px;background:var(--mud-palette-background-grey)">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("dashboard.todayTrip")</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudIcon Icon="@Icons.Material.Outlined.WorkOutline" Size="Size.Large" Style="color:#2979ff" />
                            <MudText Typo="Typo.h5" Style="font-weight:700">@tripToday <MudText Inline="true" Typo="Typo.body2">@Language.T("dashboard.people")</MudText></MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@Language.T("dashboard.approvedTripTodayNote")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-3" Style="height:100%;min-height:126px;border-radius:12px;background:var(--mud-palette-background-grey)">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Language.T("dashboard.todayOT")</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Large" Style="color:#7b1fa2" />
                            <MudText Typo="Typo.h5" Style="font-weight:700">@otToday <MudText Inline="true" Typo="Typo.body2">@Language.T("dashboard.people")</MudText></MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@Language.T("dashboard.approvedOTTodayNote")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
                @Language.T("dashboard.departmentOverviewDataNote")
            </MudText>
        </MudPaper>
    }
}

@code {
    [Parameter] public DashboardResponse? Data { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IDashboardClientService DashboardClient { get; set; } = default!;
    private List<AttendanceShiftDashboardDto> AttendanceShiftRows { get; set; } = new();
    private DateOnly AttendanceShiftDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    private bool _attendanceLoaded;

    protected override async Task OnParametersSetAsync()
    {
        if (_attendanceLoaded || Data is null) return;
        _attendanceLoaded = true;
        var result = await DashboardClient.GetAttendanceShiftDashboardAsync(AttendanceShiftDate);
        if (result.IsSuccess && result.Data is not null)
            AttendanceShiftRows = result.Data.ToList();
    }

    private string GetAttendanceStatus(string status) => status switch
    {
        "CHECKED_OUT" => Language.T("dashboard.statusCheckedOut"),
        "CHECKED_IN" => Language.T("dashboard.statusCheckedIn"),
        "MISSING_CHECK_IN" => Language.T("dashboard.statusMissingCheckIn"),
        _ => Language.T("dashboard.statusNoPunch")
    };

    protected override void OnInitialized() => Language.LanguageChanged += OnLanguageChanged;
    private void OnLanguageChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);
    private static double GetWorkingRate(double rate) => double.IsFinite(rate) ? Math.Clamp(rate, 0d, 100d) : 0d;
    private string GetKindDisplay(RequestModule kind) => kind switch { RequestModule.Overtime => Language.T("dashboard.overtimeType"), RequestModule.Trip => Language.T("dashboard.tripType"), RequestModule.Leave => Language.T("dashboard.leaveType"), _ => kind.ToString() };
    private int GetCurrentApprovalLevel(PendingApprovalItemDto item) => item.ApprovalSteps.OrderBy(x => x.Level).FirstOrDefault(x => x.IsRequired && x.IsApproved == null)?.Level ?? 0;
    private string GetWidgetTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title)) return string.Empty;
        return title.Trim() switch
        {
            "Đơn chờ duyệt" => Language.T("dashboard.pending"),
            "Nghỉ phép" => Language.T("dashboard.leaveType"),
            "OT" => Language.T("dashboard.overtimeType"),
            "Công tác" => Language.T("dashboard.tripType"),
            "dashboard.equipmentAssigned" => Language.T("dashboard.equipmentAssigned"),
            "dashboard.equipmentRequests" => Language.T("dashboard.equipmentRequests"),
            "dashboard.equipmentPending" => Language.T("dashboard.equipmentPending"),
            "dashboard.equipmentApproved" => Language.T("dashboard.equipmentApproved"),
            _ => title
        };
    }

    private void OpenActionWork()
    {
        var action = Data?.Actions.FirstOrDefault();
        if (action is not null && !string.IsNullOrWhiteSpace(action.DetailRoute))
        {
            Navigation.NavigateTo(action.DetailRoute);
            return;
        }

        Navigation.NavigateTo("/work/inbox");
    }

    private void OpenAction(ActionItemDto action)
    {
        if (!string.IsNullOrWhiteSpace(action.DetailRoute))
            Navigation.NavigateTo(action.DetailRoute);
        else
            Navigation.NavigateTo("/work/inbox");
    }

    private void OnWidgetClick(string? link)
    {
        if (!string.IsNullOrWhiteSpace(link))
            Navigation.NavigateTo(link);
    }

    public void Dispose() => Language.LanguageChanged -= OnLanguageChanged;
}
