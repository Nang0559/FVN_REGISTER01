@using Microsoft.AspNetCore.Components.Routing
@using FVN_REGISTER.Shared.Services.Help
@implements IDisposable
@inject NavigationManager Navigation

@if (!_hidden)
{
    @* The window stays in the DOM while closed (display:none) so the conversation and any pending answer survive closing it. *@
    <div style="@WindowStyle">
        <MudPaper Elevation="8" Class="d-flex flex-column" Style="max-height:min(640px, calc(100vh - 140px)); overflow:hidden; border-radius:12px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="pa-2 px-3"
                      Style="background:var(--mud-palette-primary); color:var(--mud-palette-primary-text);">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                    <MudText Typo="Typo.subtitle1">Trợ lý hướng dẫn</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="0">
                    <MudTooltip Text="Mở tài liệu hướng dẫn đầy đủ">
                        <MudIconButton Icon="@Icons.Material.Filled.MenuBook" Color="Color.Inherit" Size="Size.Small" OnClick="OpenGuide" />
                    </MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Size="Size.Small" OnClick="Close" />
                </MudStack>
            </MudStack>
            <div style="overflow-y:auto;">
                <GuideAssistantPanel Feature="@_feature" Compact="true" />
            </div>
        </MudPaper>
    </div>

    <MudFab Color="Color.Primary" Style="position:fixed; right:24px; bottom:24px; z-index:1300;"
            StartIcon="@(_open ? Icons.Material.Filled.Close : Icons.Material.Filled.SmartToy)"
            aria-label="Trợ lý hướng dẫn" OnClick="Toggle" />
}

@code {
    private bool _open;
    private bool _hidden;
    private string? _feature;

    private string WindowStyle =>
        "position:fixed; right:24px; bottom:88px; width:min(420px, calc(100vw - 32px)); z-index:1300;" + (_open ? string.Empty : " display:none;");

    protected override void OnInitialized()
    {
        Refresh(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void Refresh(string uri)
    {
        var relative = Navigation.ToBaseRelativePath(uri);
        // /huong-dan already shows the assistant at the top of the page.
        _hidden = string.Equals(HelpRegistry.Normalize(relative).FirstOrDefault(), "huong-dan", StringComparison.OrdinalIgnoreCase);
        // Only a ranking hint for the server; it never grants access to a guide section.
        _feature = HelpRegistry.Resolve(relative);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Refresh(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private void OpenGuide()
    {
        _open = false;
        var url = string.IsNullOrWhiteSpace(_feature) ? "/huong-dan" : $"/huong-dan?feature={Uri.EscapeDataString(_feature)}";
        Navigation.NavigateTo(url);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
