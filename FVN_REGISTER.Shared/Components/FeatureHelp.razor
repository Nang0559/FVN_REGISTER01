@using Microsoft.AspNetCore.Components.Routing
@using FVN_REGISTER.Shared.Services.Language
@using FVN_REGISTER.Shared.Services.Help
@using FVN_REGISTER.Shared.Services.Security
@inject ISecurityClientService SecurityClient
@implements IDisposable
@inject NavigationManager Navigation
@inject ILanguageService Language

<MudTooltip Text='@Language.T("help.tooltip")'>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" Size="Size.Medium" OnClick="Open" />
</MudTooltip>

<MudDrawer @bind-Open="_open" Anchor="Anchor.Right" Elevation="8" Width="420px" Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
            <div>
                <MudText Typo="Typo.h6">@(_featureCode is null ? Language.T("help.notAvailable.title") : _content.Title)</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("help.context") • @(_featureCode ?? "/" + _route)</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
        </MudStack>
    </MudDrawerHeader>
    <MudDivider />
    <MudDrawerContainer Class="pa-4">
        @if (_permissionDenied)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Tài khoản hiện tại chưa được cấp quyền xem hướng dẫn của chức năng này. Hãy liên hệ quản trị viên nếu bạn cần truy cập.</MudAlert>
        }
        else if (_featureCode is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">@Language.T("help.notAvailable.summary")</MudAlert>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Language.T("help.notAvailable.route"): /@_route</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">@_content.Summary</MudText>
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Language.T("help.flow")</MudText>
            <MudPaper Outlined="true" Class="pa-3 mb-4" Style="white-space:pre-line;font-family:monospace;font-size:.82rem">@_content.Flow</MudPaper>
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Language.T("help.steps")</MudText>
            <MudList T="string" Dense="true" Class="mb-4">
                @foreach (var step in _content.Steps)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircleOutline">@step</MudListItem>
                }
            </MudList>
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Language.T("help.example")</MudText>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">@_content.Example</MudAlert>
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Language.T("help.security")</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">@_content.Security</MudText>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenGuide">@Language.T("help.openGuide")</MudButton>
        }
    </MudDrawerContainer>
</MudDrawer>

@code {
    private bool _open;
    private string _route = string.Empty;
    private string? _featureCode;
    private HelpContent _content = HelpContent.Empty;
    private bool _permissionDenied;

    protected override void OnInitialized()
    {
        Language.LanguageChanged += OnLanguageChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async Task RefreshAsync(string uri)
    {
        _route = string.Join('/', HelpRegistry.Normalize(Navigation.ToBaseRelativePath(uri)));
        var code = HelpRegistry.Resolve(_route);
        _featureCode = HelpRegistry.HasContent(Language.Current, code) ? code : null;
        _permissionDenied = false;
        _content = HelpContent.Empty;
        if (_featureCode is null) return;

        try
        {
            var response = await SecurityClient.GetMyPermissionsAsync();
            if (!response.IsSuccess || response.Data is null || !HelpAccessPolicy.CanView(response.Data, _featureCode))
            {
                _permissionDenied = true;
                _featureCode = null;
                return;
            }
            _content = HelpContent.Load(Language.Current, code!);
        }
        catch
        {
            _permissionDenied = true;
            _featureCode = null;
        }
    }

    private async Task Open()
    {
        await RefreshAsync(Navigation.Uri);
        _open = true;
    }
    private void Close() => _open = false;

    private void OpenGuide()
    {
        if (_featureCode is null) return;
        Navigation.NavigateTo($"/huong-dan?feature={Uri.EscapeDataString(_featureCode)}");
        _open = false;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        if (!_open) return;
        _ = InvokeAsync(async () => { await RefreshAsync(Navigation.Uri); StateHasChanged(); });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_open) return;
        _ = InvokeAsync(async () => { await RefreshAsync(e.Location); StateHasChanged(); });
    }

    public void Dispose()
    {
        Language.LanguageChanged -= OnLanguageChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed record HelpContent(string Title, string Summary, string Flow, IReadOnlyList<string> Steps, string Example, string Security)
    {
        public static readonly HelpContent Empty = new(string.Empty, string.Empty, string.Empty, Array.Empty<string>(), string.Empty, string.Empty);

        public static HelpContent Load(LanguageCode language, string feature) => new(
            LocalizationStore.Get(language, $"help.{feature}.title"),
            LocalizationStore.Get(language, $"help.{feature}.summary"),
            LocalizationStore.Get(language, $"help.{feature}.flow"),
            LocalizationStore.Steps(language, feature),
            LocalizationStore.Get(language, $"help.{feature}.example"),
            LocalizationStore.Get(language, $"help.{feature}.security"));
    }
}