@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Navigation

<MudTooltip Text="Trợ giúp chức năng">
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" Size="Size.Medium" OnClick="Open" />
</MudTooltip>

<MudDrawer @bind-Open="_open" Anchor="Anchor.Right" Elevation="8" Width="420px" Variant="DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100">
            <div>
                <MudText Typo="Typo.h6">@_content.Title</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Trợ giúp ngữ cảnh • @_content.FeatureCode</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
        </MudStack>
    </MudDrawerHeader>
    <MudDivider />
    <MudDrawerContainer Class="pa-4">
        <MudText Typo="Typo.body2" Class="mb-4">@_content.Summary</MudText>
        <MudText Typo="Typo.subtitle2" Class="mb-2">Luồng thao tác</MudText>
        <MudPaper Outlined="true" Class="pa-3 mb-4" Style="white-space:pre-line;font-family:monospace;font-size:.82rem">@_content.Flow</MudPaper>
        <MudText Typo="Typo.subtitle2" Class="mb-2">Các bước</MudText>
        <MudList T="string" Dense="true" Class="mb-4">
            @foreach (var step in _content.Steps)
            {
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircleOutline">@step</MudListItem>
            }
        </MudList>
        <MudText Typo="Typo.subtitle2" Class="mb-2">Ví dụ</MudText>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">@_content.Example</MudAlert>
        <MudText Typo="Typo.subtitle2" Class="mb-2">Quyền & dữ liệu</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">@_content.Security</MudText>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenGuide">Mở tài liệu chi tiết</MudButton>
    </MudDrawerContainer>
</MudDrawer>

@code {
    private bool _open;
    private HelpContent _content = HelpCatalog.Resolve("/");

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _content = HelpCatalog.Resolve(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    private void Open()
    {
        _content = HelpCatalog.Resolve(Navigation.ToBaseRelativePath(Navigation.Uri));
        _open = true;
    }

    private void Close() => _open = false;

    private void OpenGuide()
    {
        Navigation.NavigateTo($"/huong-dan?feature={Uri.EscapeDataString(_content.FeatureCode)}");
        _open = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _content = HelpCatalog.Resolve(Navigation.ToBaseRelativePath(e.Location));
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private sealed record HelpContent(string FeatureCode, string Title, string Summary, string Flow, IReadOnlyList<string> Steps, string Example, string Security);

    private static class HelpCatalog
    {
        public static HelpContent Resolve(string route)
        {
            var segments = NormalizeSegments(route);

            // Mapping ưu tiên từ cụ thể → tổng quát. Không dùng Contains() để tránh
            // URL có chuỗi trùng ngẫu nhiên làm chọn sai bộ trợ giúp.
            if (HasPrefix(segments, "equipment", "checklist")) return EquipmentChecklist;
            if (HasPrefix(segments, "equipment", "schema")) return EquipmentSchema;
            if (HasPrefix(segments, "equipment", "import")) return EquipmentImport;
            if (HasPrefix(segments, "equipment", "repair")) return EquipmentRepair;
            if (HasPrefix(segments, "equipment", "handover")) return EquipmentHandover;
            if (HasPrefix(segments, "equipment")) return Equipment;

            if (HasPrefix(segments, "public-information") || HasPrefix(segments, "thong-tin-cong-khai")) return PublicInfo;
            if (HasPrefix(segments, "security") || HasPrefix(segments, "admin")) return Security;
            if (HasPrefix(segments, "approval") || HasPrefix(segments, "inbox")) return Approval;
            if (HasPrefix(segments, "leave")) return Leave;
            if (HasPrefix(segments, "ot")) return OT;
            if (HasPrefix(segments, "trip")) return Trip;
            return Home;
        }

        private static string[] NormalizeSegments(string route)
        {
            var clean = route.Split('?', '#')[0].Trim('/');
            if (clean.Length == 0) return Array.Empty<string>();
            return clean.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        }

        private static bool HasPrefix(string[] segments, params string[] prefix)
        {
            if (segments.Length < prefix.Length) return false;
            for (var i = 0; i < prefix.Length; i++)
            {
                if (!string.Equals(segments[i], prefix[i], StringComparison.OrdinalIgnoreCase)) return false;
            }
            return true;
        }

        private static readonly HelpContent Home = new("HOME_WORKSPACE", "Workspace cá nhân", "Trang chủ gom việc cần làm, thông báo, phê duyệt và các module mà tài khoản được phép sử dụng.", "USER → ACTION CENTER → MY WORK → NOTIFICATION/APPROVAL → MODULE", new[] { "Kiểm tra việc cần làm.", "Mở thông báo hoặc hồ sơ cần xử lý.", "Dùng các ô module theo quyền được cấp.", "Xem tổng quan quản lý chỉ khi có capability tương ứng." }, "Nhân viên có LeaveView nhưng không có LeaveApprove chỉ thấy thao tác cá nhân; ẩn nút không phải cơ chế bảo mật.", "Capability và data scope được kiểm tra ở server; UI chỉ phản ánh quyền.");
        private static readonly HelpContent Approval = new("APPROVAL_INBOX", "Hộp việc phê duyệt", "Một nơi để xem và xử lý Leave, OT, Trip và Equipment thuộc phạm vi được phép.", "PENDING → SCOPE CHECK → REVIEW → APPROVE/REJECT → AUDIT", new[] { "Lọc theo module.", "Mở chi tiết.", "Chọn các mục cùng cấp xử lý.", "Approve/Reject; server kiểm tra lại scope trước workflow." }, "Nếu chọn 5 đơn nhưng 1 đơn vượt scope, cả batch bị từ chối thay vì silently skip.", "Approve là capability riêng; Approve không tự động cấp All.");
        private static readonly HelpContent Equipment = new("EQUIPMENT_WORKSPACE", "Thiết bị", "Quản lý tài sản thiết bị theo schema, import dữ liệu, checklist, sửa chữa, bàn giao, điều chuyển và phê duyệt; tất cả dùng cùng một Help.", "SCHEMA → DATA → VALIDATE → REVIEW → APPROVAL → COMMIT → AUDIT", new[] { "Chọn phòng ban và schema được phép sử dụng.", "Nhập hoặc import dữ liệu.", "Kiểm tra preview và lỗi.", "Gửi yêu cầu theo workflow hiện hành.", "Theo dõi phê duyệt, lịch sử và trạng thái thiết bị." }, "Một thiết bị có thể phát sinh thêm mới, sửa chữa, điều chuyển, thay người sử dụng hoặc thanh lý; người duyệt xem tổng thể thiết bị cùng lịch sử thay đổi và checklist nếu có.", "Capability và data scope được kiểm tra ở server; Help chỉ hướng dẫn, không cấp quyền.");
        private static readonly HelpContent EquipmentSchema = new("EQUIPMENT_SCHEMA", "Schema thiết bị", "Schema định nghĩa cấu trúc dữ liệu dùng cho thiết bị và có thể được dùng lại cho các loại dữ liệu khác khi nghiệp vụ cho phép.", "CREATE/COPY → DEFINE FIELDS → VALIDATE → PUBLISH/USE", new[] { "Chọn schema của phòng ban hoặc schema được phép sử dụng.", "Tạo mới hoặc nhân bản schema của người khác.", "Chỉnh sửa bản sao của mình; không sửa schema do người khác sở hữu.", "Xác nhận kiểu dữ liệu và cột bắt buộc.", "Lưu và sử dụng schema theo quyền." }, "Người cùng phòng có quyền import Excel có thể xem schema của phòng, nhân bản schema của đồng nghiệp và chỉnh bản sao của mình.", "Quyền tạo/sửa/xóa schema phải được kiểm tra theo owner/department và capability; không dùng UI để bảo vệ thay cho server.");
        private static readonly HelpContent EquipmentImport = new("EQUIPMENT_IMPORT", "Import dữ liệu thiết bị", "Import Excel dùng schema đã được phép sử dụng; hệ thống preview và kiểm tra dữ liệu trước khi ghi chính thức.", "SELECT FILE → READ HEADER → MAP SCHEMA → PREVIEW → VALIDATE → COMMIT", new[] { "Chọn schema.", "Chọn file Excel.", "Đọc header và đối chiếu cột.", "Kiểm tra dữ liệu từng dòng.", "Sửa lỗi rồi preview lại.", "Commit khi hợp lệ." }, "Có thể dùng file mẫu để tự nhận diện tên cột, sau đó người dùng hiệu chỉnh mapping và kiểu dữ liệu trước khi import.", "Import phải kiểm tra capability, scope phòng ban và schema được phép sử dụng ở server.");
        private static readonly HelpContent EquipmentChecklist = new("EQUIPMENT_CHECKLIST", "Checklist thiết bị", "Checklist được áp dụng theo loại thiết bị và chu kỳ ngày/tuần/tháng/quý/năm khi loại thiết bị có cấu hình tương ứng.", "DEVICE TYPE → CHECKLIST TEMPLATE → SCHEDULE → EXECUTE → REVIEW → AUDIT", new[] { "Xác định loại thiết bị.", "Xem checklist được áp dụng.", "Thực hiện theo chu kỳ.", "Ghi nhận kết quả và bằng chứng nếu cần.", "Theo dõi lịch sử checklist tại thiết bị." }, "Laptop có thể có checklist hàng tháng; server có thể có checklist khác theo loại và chính sách IT.", "Checklist không thay đổi quyền Equipment/Approval; việc thực hiện và phê duyệt được kiểm tra theo capability và scope.");
        private static readonly HelpContent EquipmentRepair = new("EQUIPMENT_REPAIR", "Sửa chữa thiết bị", "Yêu cầu sửa chữa được gắn với thiết bị, trạng thái, lịch sử xử lý và approval khi policy yêu cầu.", "REQUEST → REVIEW → APPROVAL → REPAIR → COMPLETE → HISTORY", new[] { "Chọn thiết bị.", "Mô tả sự cố và bằng chứng.", "Gửi yêu cầu.", "Theo dõi xử lý và phê duyệt.", "Ghi nhận hoàn thành và lịch sử." }, "Thay linh kiện hoặc sửa chữa làm thay đổi thông tin thiết bị phải được ghi nhận trong lịch sử thay đổi.", "Không tự thay đổi tài sản ngoài scope; mọi thao tác nhạy cảm phải được service kiểm tra.");
        private static readonly HelpContent EquipmentHandover = new("EQUIPMENT_HANDOVER", "Bàn giao và điều chuyển thiết bị", "Bàn giao, đổi người sử dụng và chuyển bộ thiết bị được quản lý như thay đổi có lịch sử và approval theo policy.", "REQUEST → SNAPSHOT → APPROVAL → HANDOVER/TRANSFER → AUDIT", new[] { "Chọn thiết bị và người nhận/đơn vị đích.", "Xem snapshot trước thay đổi.", "Gửi phê duyệt.", "Thực hiện bàn giao/điều chuyển sau khi được duyệt.", "Lưu lịch sử và bằng chứng." }, "Người duyệt nhìn thấy thiết bị hiện tại, thay đổi đề nghị và lịch sử liên quan trước khi quyết định.", "Approval và data scope được kiểm tra server-side; thay đổi phải có audit.");
        private static readonly HelpContent PublicInfo = new("PUBLIC_INFORMATION_CMS", "CMS thông tin công khai", "Quản trị thông báo, quy định, hướng dẫn và chính sách theo Draft → Published → Archived.", "DRAFT → PREVIEW → PUBLISH → PUBLIC READ → ARCHIVE", new[] { "Tạo bản nháp.", "Nhập nội dung và thời gian hiệu lực.", "Preview.", "Publish.", "Archive khi kết thúc." }, "Quy định có EffectiveFrom 01/10 chỉ xuất hiện trong cửa sổ hiệu lực đã cấu hình.", "Chỉ PublicInformationManage được thay đổi; endpoint public chỉ trả Published hợp lệ.");
        private static readonly HelpContent Security = new("SECURITY_CENTER", "Security Center", "Quản lý role, function/action, effective permission và audit; capability tách khỏi data scope.", "USER → ROLE → FUNCTION/ACTION → SCOPE → AUDIT", new[] { "Xem effective permission.", "Kiểm tra Role → Function/Action.", "Gán role/function.", "Kiểm tra audit." }, "LeaveApprove + Department cho phép duyệt trong phạm vi phòng ban; không đồng nghĩa xem toàn công ty.", "DB là authority; JWT/UI chỉ hỗ trợ UX. Command nhạy cảm phải kiểm tra lại ở service.");
        private static readonly HelpContent Leave = new("LEAVE", "Nghỉ phép", "Đăng ký, chỉnh sửa, hủy và phê duyệt nghỉ phép theo capability và scope.", "CREATE → SUBMIT → PENDING → APPROVE/REJECT → HISTORY", new[] { "Tạo đơn.", "Kiểm tra ngày và loại nghỉ.", "Submit.", "Theo dõi lịch sử hoặc Inbox." }, "Own chỉ xử lý dữ liệu của chính mình; Department mở rộng theo phòng ban.", "Create/Edit/Cancel/Approve là capability độc lập.");
        private static readonly HelpContent OT = new("OT", "Làm thêm giờ", "Đăng ký OT và kiểm tra hạn mức ngày/tuần/tháng/năm trước khi gửi duyệt.", "NHẬP OT → KIỂM TRA NGÀY → TUẦN → THÁNG → NĂM → SUBMIT → APPROVAL → RECONCILE", new[] { "Chọn ngày, loại OT và số giờ.", "Hệ thống kiểm tra hạn mức ngày.", "Kiểm tra tổng OT trong tuần Thứ 2 → Chủ nhật nếu Weekly rule được cấu hình.", "Kiểm tra hạn mức tháng và năm.", "Nếu vượt ngưỡng năm tiêu chuẩn, xử lý theo policy đặc biệt; vượt ngưỡng tối đa thì không đăng ký thêm.", "Submit và theo dõi duyệt/đối soát." }, "Dashboard hiển thị OT tuần/tháng/năm đã Approved. Request Pending vẫn được tính khi server kiểm tra để tránh đăng ký chồng vượt hạn mức.", "OTCreate/OTEdit/OTApprove là capability độc lập. Hạn mức lấy từ F03OTLimitRules theo Dept + Position > Dept > Position > toàn công ty. Không tự đặt hạn mức tuần nếu chưa có rule.");
        private static readonly HelpContent Trip = new("TRIP", "Công tác", "Quản lý công tác theo workflow và scope.", "CREATE → SUBMIT → APPROVAL → COMPLETE", new[] { "Tạo kế hoạch.", "Kiểm tra người đi/phòng ban.", "Submit.", "Theo dõi Approval Inbox." }, "TripCreate chỉ cho target scope hợp lệ; IsAdmin không tự động mở rộng dữ liệu.", "TripCreate/TripEdit/TripApprove là capability độc lập.");
    }
}
