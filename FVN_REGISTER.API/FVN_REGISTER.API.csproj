<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <UserSecretsId>FVN_REGISTER_API</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FVN_REGISTER.Application\FVN_REGISTER.Application.csproj" />
    <ProjectReference Include="..\FVN_REGISTER.Infrastructure\FVN_REGISTER.Infrastructure.csproj" />
    <ProjectReference Include="..\FVN_REGISTER.AI.Application\FVN_REGISTER.AI.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- LocalizationController edits and serves these files, so they must exist in the API's own publish folder
         (<publish>/Localization), not only in the Web project's. -->
    <Content Include="..\FVN_REGISTER.Shared\Localization\*.json" Link="Localization\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- HrmAttendanceExcelExportService loads GA.xls / "OT - GA.xls" from <root>/Templates/HRM.
         The API publish profile uses DeleteExistingFiles=true, so these must be part of the build output
         or every publish wipes them from the server. -->
    <Content Include="Templates\HRM\*.xls" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- The guide assistant (api/ai/guide/ask) answers from the same Markdown that /huong-dan renders. Like Localization above, the files must be in
         the API's own publish folder (<publish>/Guide) because the API publish profile deletes existing files. Edit the .md and replace Guide\*.md on
         the server (or republish) to change the answers; the index reloads when a file changes. -->
    <Content Include="..\MÔ HÌNH\03_TAI_LIEU_HE_THONG\02_HUONG_DAN_SU_DUNG\*.md" Link="Guide\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
