@using System.Net.Http.Headers
@using System.Net.Http.Json
@using FVN_REGISTER.Core.Excel
@inject HttpClient Http

<div class="excel-schema-manager">
    <InputFile OnChange="OnFileSelected" accept=".xls,.xlsx" />
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert alert-info">@_message</div> }
    @if (_inspection is not null)
    {
        <div class="mt-2"><strong>@_inspection.FileName</strong> — @_inspection.Sheets.Count sheet(s)</div>
        <select class="form-select mt-2" @bind="_sheetIndex">
            @foreach (var sheet in _inspection.Sheets) { <option value="@sheet.Index">@sheet.Name</option> }
        </select>
        @if (_selectedSheet is not null)
        {
            <div class="mt-2">Header candidates: @string.Join(", ", _selectedSheet.HeaderCandidates.Select(x => x.RowIndex + 1))</div>
        }
    }
    <button class="btn btn-primary mt-2" disabled="@(_file is null || _busy)" @onclick="SaveDraftAsync">Tạo Draft Schema</button>
    <div class="mt-3">
        @foreach (var schema in _schemas)
        {
            <div class="d-flex align-items-center gap-2 border-bottom py-2">
                <span>@schema.SchemaName v@schema.Version — @schema.Status</span>
                @if (schema.Status == ExcelSchemaStatus.Draft)
                {
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteDraftAsync(schema.Id)">Xoá Draft</button>
                    <button class="btn btn-sm btn-success" @onclick="() => ActivateAsync(schema.Id)">Đưa vào sử dụng</button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string ModuleCode { get; set; } = string.Empty;
    [Parameter] public string EntityCode { get; set; } = string.Empty;
    [Parameter] public EventCallback<ExcelSchemaSummary> SchemaActivated { get; set; }
    private IBrowserFile? _file;
    private ExcelWorkbookInspection? _inspection;
    private int _sheetIndex;
    private bool _busy;
    private string? _message;
    private List<ExcelSchemaSummary> _schemas = [];
    private ExcelSheetInspection? _selectedSheet => _inspection?.Sheets.FirstOrDefault(x => x.Index == _sheetIndex);

    protected override async Task OnInitializedAsync() => await LoadSchemasAsync();

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _file = e.File; _message = null;
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = _file.OpenReadStream(10 * 1024 * 1024);
            var part = new StreamContent(stream); part.Headers.ContentType = new MediaTypeHeaderValue(_file.ContentType ?? "application/octet-stream"); content.Add(part, "file", _file.Name);
            var response = await Http.PostAsync("api/excel/inspect", content);
            if (!response.IsSuccessStatusCode) { _message = await response.Content.ReadAsStringAsync(); return; }
            _inspection = await response.Content.ReadFromJsonAsync<ExcelWorkbookInspection>(); _sheetIndex = _inspection?.Sheets.FirstOrDefault()?.Index ?? 0;
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task SaveDraftAsync()
    {
        if (_file is null || _selectedSheet is null) return;
        _busy = true; try
        {
            var header = _selectedSheet.HeaderCandidates.OrderByDescending(x => x.Score).FirstOrDefault();
            if (header is null) { _message = "Không tìm thấy dòng tiêu đề."; return; }
            var fields = header.Values.Select((v, i) => new ExcelSchemaField($"Column{i + 1}", ExcelFieldDataType.Text.ToString(), false, i, v)).Where(x => !string.IsNullOrWhiteSpace(x.HeaderName)).ToList();
            var request = new ExcelSchemaCreateRequest(ModuleCode, EntityCode, $"{ModuleCode}_{EntityCode}", _file.Name, _sheetIndex, _selectedSheet.Name, header.RowIndex, header.RowIndex + 1, _selectedSheet.LastRowIndex, fields.Select(x => x.SourceColumnIndex).ToList(), fields);
            var response = await Http.PostAsJsonAsync("api/excel/schemas/draft?sourceFileName=" + Uri.EscapeDataString(_file.Name), request);
            _message = response.IsSuccessStatusCode ? "Đã tạo Draft Schema." : await response.Content.ReadAsStringAsync();
            await LoadSchemasAsync();
        }
        finally { _busy = false; }
    }

    private async Task LoadSchemasAsync()
    { if (string.IsNullOrWhiteSpace(ModuleCode) || string.IsNullOrWhiteSpace(EntityCode)) return; var result = await Http.GetFromJsonAsync<List<ExcelSchemaSummary>>($"api/excel/schemas?moduleCode={Uri.EscapeDataString(ModuleCode)}&entityCode={Uri.EscapeDataString(EntityCode)}"); _schemas = result ?? []; }
    private async Task DeleteDraftAsync(int id) { var response = await Http.DeleteAsync($"api/excel/schemas/{id}"); _message = response.IsSuccessStatusCode ? "Đã xoá Draft." : await response.Content.ReadAsStringAsync(); await LoadSchemasAsync(); }
    private async Task ActivateAsync(int id) { var response = await Http.PostAsync($"api/excel/schemas/{id}/activate", null); if (response.IsSuccessStatusCode) { var schema = await response.Content.ReadFromJsonAsync<ExcelSchemaSummary>(); if (schema is not null) await SchemaActivated.InvokeAsync(schema); _message = "Đã đưa Schema vào sử dụng."; } else _message = await response.Content.ReadAsStringAsync(); await LoadSchemasAsync(); }
}
