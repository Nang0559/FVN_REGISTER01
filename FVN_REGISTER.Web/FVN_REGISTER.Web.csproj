<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FVN_REGISTER.Application\FVN_REGISTER.Application.csproj" />
    <ProjectReference Include="..\FVN_REGISTER.Shared\FVN_REGISTER.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Utils\" />
    <!-- The Language Center needs the JSON catalog as physical publish content. -->
    <Content Include="..\FVN_REGISTER.Shared\Localization\*.json" Link="Localization\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- /huong-dan renders the Markdown guide (+ its screenshots) from the Guide folder next to the app. Edit the .md, rebuild/publish (or just replace Guide\*.md on the server). -->
    <Content Include="..\MÔ HÌNH\03_TAI_LIEU_HE_THONG\02_HUONG_DAN_SU_DUNG\*.md" Link="Guide\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\MÔ HÌNH\screenshots\*.*" Link="Guide\screenshots\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>